<< lib/java/JavaChecks.sleela
   Runtime checks that Java performs and the SLeeLa VM reports as a fatal error instead.
   Definition: Java throws NegativeArraySizeException for a negative array size and it can be caught. The
   SLeeLa VM ends the program with a runtime error. The converter (sleelactl java-convert) wraps every
   non-constant array size in size(n), so the exception is thrown by SLeeLa code and a converted program can
   catch it; the message is Java's own (the size). An out-of-range array index needs no wrapper: the VM
   throws it inside a try (SLEELA.syntax 37.5, lib/java/support/SLJavaFaults). The converter option
   --unchecked-sizes omits the wrapper. See lib/java/JAVA.SPEC.md section 4.8 and impl/RUNTIME-AUDIT.md. >>
#sleela 3.0
material;
import java.jdk-28;

class JavaChecks {
  << Full descriptive record for a Java-tier support class. >>
  String metaVersion = "1.0.0";
  int metaId = 0;
  String metaAuthor = "Max Rupplin";
  String metaDate = "2026-11-13";
  String metaCopyright = "MEARVK LLC";
  String metaTrademark = "none";
  String metaCorporation = "MEARVK LLC";
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-13";
  int metaScienceRating = 7;
  String metaNationalSchedule = "The Java Language Specification, Java SE 28 Edition (JLS 10.4 Array Access, 10.3 Array Creation, 11.1.3 Asynchronous Exceptions)";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }


  < The size when it is not negative, else the Java exception (its message is the size). >
  static int size(int n) {
    if (n < 0) { throw new NegativeArraySizeException("" + n); }
    return n;
  }
}
