/*
 * lib/core/SLConditionVariable.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLConditionVariable used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Condition.
// Role: runtime. Responsibility: thread synchronization condition.
class SLConditionVariable {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
