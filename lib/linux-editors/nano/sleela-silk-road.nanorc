## SLeeLa syntax highlighting for nano (SLeeLa Central Asian / Silk Road palette).
## Requires nano >= 5.0 for 24-bit "color #RRGGBB" values.
syntax sleela "\.sleela$"
comment "//"

## keywords, types, literals
color #7fade0 "\<(let|var|const|if|else|while|for|in|return|break|continue|class|interface|extends|implements|new|this|super|import|package|public|private|protected|static|final|true|false|null|nil|and|or|not|try|catch|throw|synchronized|finally|switch|case|default|do|assert|yield|instanceof)\>"
color #45c6c2 "\<(String|SLString|Integer|Int|Long|Double|Float|Boolean|Character|Byte|Short|Void|Object|List|Map|Set|Array|int64|int128|long|double|boolean)\>"
## function-call heads
color #a7c982 "[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\("
## numbers
color #c4a4de "\<[0-9]+\>"
## strings (double- and single-quoted; inner double-quote escaped as \")
color #d9b56d "\"(\\.|[^\"\\])*\""
color #d9b56d "'(\\.|[^'\\])*'"
## annotations and the document pragmas
color #e5a9a0 "@[A-Za-z_][A-Za-z0-9_]*"
color #e5a9a0 "^[[:space:]]*#(sleela|schema)\>.*$"
## document markers (only when alone on a line, optional ;)
color #e5a9a0 "^[[:space:]]*(author|authorial|material|memory|determine)[[:space:]]*;?[[:space:]]*$"
## comments: // line and /* */ block, plus << >> and < > angle forms
color #92a3a0 "//.*$"
color #92a3a0 start="/\*" end="\*/"
color #92a3a0 start="^[[:space:]]*<<" end=">>"
color #92a3a0 "^[[:space:]]*<[^<].*>?$"
## TODO/FIXME/NOTE/XXX inside comments
color #d9b56d "\<(TODO|FIXME|NOTE|XXX)\>"
