#sleela 1.3
// ai.sleela -- SLeeLa source-level AI model declaration.
// The ai* calls are the program-facing contract for the native AI VM bridge.
// Model execution remains under the Standard SLeeLa VM.

class AiModel {
    void main() {
        int model = aiModel("sleela.example", 1, "sleela-ai-1", "native");

        aiInput(model, "data", "sample-data");
        aiInput(model, "file", "sample-file");
        aiInput(model, "audio", "audio-frame");
        aiInput(model, "video", "video-frame");

        aiOperation(model, "inspect");
        aiOperation(model, "classify");
        aiOperation(model, "extract");
        aiOperation(model, "summarize");
        aiOperation(model, "transform");

        aiInstruction(model, "Use the declared XML model and return bounded observations.");
        aiExecute(model);
        print(aiResult(model));
        aiClose(model);
    }
}
