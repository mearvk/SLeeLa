  << java.io.StringReader over the UTF-16 form of its String (plain or UTF-16
     both accepted), reading one code unit at a time. skip may be negative, back
     to the start, as in the JDK. close is a reserved SLeeLa built-in, so the
     reader is never closed and never reports Stream closed. >>
  String srText = null;
  int srLength = 0;
  int srNext = 0;
  int srMark = 0;

  public StringReader(java.lang.String s) {
    if (s == null) { throw new NullPointerException(); }
    if (s instanceof string) { this.srText = javaStringFromUtf8(s); }
    else { this.srText = s; }
    this.srLength = javaStringLength(this.srText);
