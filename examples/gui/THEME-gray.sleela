#sleela 2.5
class ThemeGray {
  int main() {
    SLUserInterface ui = new SLUserInterface(); ui.configure("com.mearvk.examples.ThemeGray");
    if (!ui.open()) { return 1; }
    SLTheme theme = new SLTheme(); theme.gray();
    SLWindow win = ui.openWindow("Gray Theme", 520, 300, theme.handle());
    SLWidget root = win.rootWidget();
    SLLabel label = new SLLabel(); label.createIn(root, "Gray: neutral mid-gray surfaces and cool accent.");
    win.show(); return ui.run();
  }
}
