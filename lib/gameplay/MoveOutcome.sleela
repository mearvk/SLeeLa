/*
 * lib/gameplay/MoveOutcome.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines MoveOutcome, the result record every GameMove returns —
 *   what happened on this turn, in a form the game loop and the player can both
 *   read. It carries a headline, whether the move succeeded, and the concrete
 *   gains (experience, cash, file/tact/rolls) the move produced.
 *
 * MoveOutcome is a NATURAL / LOADABLE MODULE sharing the common module contract
 * (load / loaded / moduleName / describe). It is a plain carrier: moves fill it
 * in, the turn applies it to the Player, and describe() narrates it.
 *
 * Family: gameplay.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class MoveOutcome {

  static final String MODULE = "MoveOutcome";

  int loadedFlag;
  String moveName;     // which move produced this
  String headline;     // one-line summary of what happened
  boolean success;     // did the move land?
  int xpGain;          // experience granted
  int cashGain;        // cash granted (net; may be 0)
  int fileGain;        // courtroom file granted
  int tactGain;        // courtroom tact granted
  int rollsGain;       // courtroom rolls granted

  // --- loadable-module contract ------------------------------------------
  void load() {
    loadedFlag = 1;
    moveName = "";
    headline = "";
    success = false;
    xpGain = 0; cashGain = 0; fileGain = 0; tactGain = 0; rollsGain = 0;
  }
  boolean loaded() { return loadedFlag == 1; }
  String moduleName() { return MODULE; }

  void begin(String move) { load(); moveName = move; }
  void say(String line) { headline = line; }
  void succeed() { success = true; }

  void addXp(int n)    { if (n > 0) { xpGain = xpGain + n; } }
  void addCash(int n)  { cashGain = cashGain + n; }
  void addFile(int n)  { if (n > 0) { fileGain = fileGain + n; } }
  void addTact(int n)  { if (n > 0) { tactGain = tactGain + n; } }
  void addRolls(int n) { if (n > 0) { rollsGain = rollsGain + n; } }

  // Apply everything this outcome granted to a Player, in one shot.
  void applyTo(Player p) {
    if (p == null) { return; }
    p.gainExperience(xpGain);
    p.earn(cashGain);
    p.gainFile(fileGain);
    p.gainTact(tactGain);
    p.gainRolls(rollsGain);
  }

  boolean landed() { return success; }
  String move() { return moveName; }
  String summary() { return headline; }

  String yn(boolean v) { if (v) { return "yes"; } return "no"; }

  String describe() {
    return MODULE + " [" + moveName + "] success=" + yn(success)
         + " xp=" + xpGain + " cash=" + cashGain
         + " file=" + fileGain + " tact=" + tactGain + " rolls=" + rollsGain
         + " :: " + headline;
  }
}
