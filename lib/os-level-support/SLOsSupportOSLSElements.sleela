< SLeeLa Standard Library Definition.
  Definition: Element factories for the common osls_* C ABI.
  These elements describe existing root-library exports and their capability
  groups. They deliberately carry UNREGISTERED as the VM opcode until a real
  host adapter, ABI marshaller and integration tests register them with the VM. >
#sleela 2.5
material;

class SLOsSupportOSLSElements {
  SLOsSupportElement cronNextAfter() {
    SLOsSupportElement e = new SLOsSupportElement();
    e.configure("cronNextAfter", "Scheduling", "OSScheduler", "OP_OSLS_CALL:155/11",
      "osls_cron_next_after", "osls_cron_next_after", "CommonBackend",
      "ReadOnlyQuery", "Implemented", 3, 0);
    e.setResultTerm("StatusAndInt64Epoch");
    return e;
  }

  SLOsSupportElement cronValidate() {
    SLOsSupportElement e = new SLOsSupportElement();
    e.configure("cronValidate", "Scheduling", "OSScheduler", "OP_OSLS_CALL:155/10",
      "osls_cron_validate", "osls_cron_validate", "CommonBackend",
      "ReadOnlyQuery", "Implemented", 1, 0);
    e.setResultTerm("StatusCode");
    return e;
  }

