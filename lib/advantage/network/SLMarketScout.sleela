<< lib/advantage/network/SLMarketScout.sleela
   SLeeLa Standard Library Definition.
   Definition: A deterministic market scout -- the OFFLINE stand-in for a live
   internet search of venue quotes for a single good. It holds a small table of
   (venue, bid, ask) rows and reports the best place to BUY (lowest ask) and the
   best place to SELL (highest bid), plus the cross-venue spread opportunity. >>
#sleela 3.0
material;
artifact;
pure;
gasoline;
<< WHERE LIVE DATA PLUGS IN. This class is pure and deterministic so demos can
   validate by exact output. In production the quote rows would be filled by the
   real transport layer (lib/advantage/transport: HTTPS/SFTP/SSH acquire over a
   keystore-pinned channel) fetching venue price feeds. The scout's PUBLIC shape
   -- addQuote / bestAsk / bestBid / spread / describe -- is identical whether
   the rows came from a canned table or a live fetch, so swapping the source does
   not change any downstream negotiation code. See SLMarketScout.md. >>
class SLMarketScout {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Full identity record for a library-family class. >>
  String metaVersion = "1.0.0";
  int metaId = 10601;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-08";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "Advantage";
  String metaCorporation = "SLeeLa project";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-08";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 7;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < ---- Quote table: parallel arrays, up to 32 venues ---- >
  String good;
  String[] venue = new String[32];
  double[] bid = new double[32];
  double[] ask = new double[32];
  int n = 0;

  void forGood(String g) { good = g; n = 0; }
  String getGood() { return good; }
  int count() { return n; }

  < Append one venue's two-sided quote. bid = what they pay you to SELL to them; >
  < ask = what they charge you to BUY from them. >
  void addQuote(String v, double b, double a) {
    if (n < 32) {
      venue[n] = v;
      bid[n] = b;
      ask[n] = a;
      n = n + 1;
    }
  }

  double bidAt(int i) { return bid[i]; }
  double askAt(int i) { return ask[i]; }
  String venueAt(int i) { return venue[i]; }

  < Index of the lowest ask (cheapest place to BUY). -1 if empty. >
  int bestAskIndex() {
    if (n <= 0) { return -1; }
    int best = 0;
    int i = 1;
    while (i < n) {
      if (ask[i] < ask[best]) { best = i; }
      i = i + 1;
    }
    return best;
  }

  < Index of the highest bid (best place to SELL). -1 if empty. >
  int bestBidIndex() {
    if (n <= 0) { return -1; }
    int best = 0;
    int i = 1;
    while (i < n) {
      if (bid[i] > bid[best]) { best = i; }
      i = i + 1;
    }
    return best;
  }

  double bestAsk() { int i = bestAskIndex(); if (i < 0) { return 0.0; } return ask[i]; }
  double bestBid() { int i = bestBidIndex(); if (i < 0) { return 0.0; } return bid[i]; }
  String buyVenue() { int i = bestAskIndex(); if (i < 0) { return "none"; } return venue[i]; }
  String sellVenue() { int i = bestBidIndex(); if (i < 0) { return "none"; } return venue[i]; }

  << The cross-venue spread: best bid minus best ask. Positive means there is a
     risk-free routing opportunity -- buy at the cheapest venue, sell at the
     dearest -- per unit, before costs and time. >>
  double spread() { return bestBid() - bestAsk(); }

  String describe() {
    return "MarketScout[" + good + "]: buy@" + buyVenue() + "=" + bestAsk()
         + " sell@" + sellVenue() + "=" + bestBid() + " spread=" + spread();
  }
}
