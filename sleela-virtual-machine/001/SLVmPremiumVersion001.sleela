/*
 * sleela-virtual-machine/001/SLVmPremiumVersion001.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLVmPremiumVersion001 -- the loadable SLeeLa manifest for
 *   premium VM generation slvm-1 ("dedicated VM: broker, capabilities, security, OS boundary"), the OOD selector record the native
 *   VM can enumerate and select via `sleela vm select premium 1` (or p1).
 *   It names this generation's C/C++ project directory and admission validator,
 *   composes the cumulative premium capability set through generation 1, and
 *   carries the default configuration profile. build() returns the configured
 *   SLVmRuntime a selection resolves to; nativeBinary() names the binary the
 *   master build produces (vm-build/slvm-1).
 *
 * Faithful to impl/frontend/driver.cpp (kPremium) and virtual-machine/USER-GUIDE.md
 * (per-grade validator list). It extends SLVmPremiumVersion
 * (lib/vm/src/sleela/SLVmPremiumVersion.sleela).
 *
 * Family: vm. Composes SLVmPremiumVersion, SLVmConfig, SLVmRuntime.
 */
#sleela 2.4
class SLVmPremiumVersion001 extends SLVmPremiumVersion {
  void configure() {
    base(1, "slvm-1", "dedicated VM: broker, capabilities, security, OS boundary", "sleela-virtual-machine/001", "security supervisor");
    composeThrough(1);
    // default profile tuning for this generation (user-editable in setup/conference)
    profile.setVerbosity(SLVmConfig.VERBOSITY_NORMAL);
  }
}
