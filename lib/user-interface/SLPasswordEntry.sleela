/*
 * lib/user-interface/SLPasswordEntry.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLPasswordEntry — a SleelaUI password field: a single-line
 *   entry that renders a bullet dot for each character instead of the character
 *   itself, used for secret input. It behaves like SLEntry otherwise (UTF-8
 *   editing, caret, Enter raises an activate event); the underlying text is
 *   still readable through text() so the host can submit it. The constructor
 *   bottoms out in the `uiPasswordEntry` built-in (SleelaUI C ABI
 *   slui_password_entry()).
 *
 * An SLPasswordEntry IS an SLWidget and is keyboard-focusable.
 *
 * Family: user-interface. Native VM/UI work crosses the explicit `ui*` SLVM
 * bridge.
 */
#sleela 1.5
class SLPasswordEntry extends SLWidget {
  // Create a password entry inside `parent` (placeholder defaults to
  // "Password").
  void createIn(SLWidget parent, String placeholder) {
    widget = uiPasswordEntry(parent.handle(), placeholder);
  }
  void createInHandle(int parentHandle, String placeholder) {
    widget = uiPasswordEntry(parentHandle, placeholder);
  }

  // True if Enter was pressed since the last check (latch cleared on read).
  boolean submitted() {
    if (widget < 0) { return false; }
    return uiWidgetTakeActivated(widget) == 1;
  }
}
