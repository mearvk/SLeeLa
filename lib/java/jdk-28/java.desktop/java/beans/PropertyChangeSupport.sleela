  < ---- java.beans.PropertyChangeSupport: bound-property listeners and events ---- >
  << Written from the JDK 28 API specification of java.beans.PropertyChangeSupport.
     It keeps listeners for all properties and listeners for one named
     property. A null listener, or a null name when one is required, is
     ignored. Adding or removing a PropertyChangeListenerProxy acts on the
     named list of its property. firePropertyChange sends no event when the
     old and new values are both non-null and equal. Each event goes first to
     the listeners for all properties, then to the listeners of its property,
     each in the order they were added. getPropertyChangeListeners() returns
     the listeners for all properties followed by one
     PropertyChangeListenerProxy per named listener. Listeners are SLJavaLambda
     values (or proxies of them), see SLJavaBeanEvents. Equality of the values
     is SLeeLa equality: by value for numbers, booleans and Strings, by
     identity for objects (PURPOSE.md row 31). >>
  Any sourceBean;
  Any[] allListeners;
  int allCount;
  String[] namedNames;
  Any[] namedListeners;
  int namedCount;

  public PropertyChangeSupport(java.lang.Object sourceBean) {
    if (sourceBean == null) { throw new NullPointerException(); }
    this.sourceBean = sourceBean;
    this.allListeners = new Any[4];
    this.allCount = 0;
    this.namedNames = new String[4];
    this.namedListeners = new Any[4];
    this.namedCount = 0;
  }

  public void addPropertyChangeListener(java.beans.PropertyChangeListener listener) {
    if (listener == null) { return; }
    if (listener instanceof PropertyChangeListenerProxy) {
      PropertyChangeListenerProxy p = (PropertyChangeListenerProxy) listener;
      addPropertyChangeListener(p.getPropertyName(), p.getListener());
      return;
    }
    if (this.allCount >= arrayLength(this.allListeners)) { this.allListeners = growAny(this.allListeners, this.allCount); }
    this.allListeners[this.allCount] = listener;
    this.allCount = this.allCount + 1;
  }
  public void addPropertyChangeListener(java.lang.String propertyName, java.beans.PropertyChangeListener listener) {
    if (listener == null || propertyName == null) { return; }
    if (this.namedCount >= arrayLength(this.namedListeners)) {
      this.namedListeners = growAny(this.namedListeners, this.namedCount);
      String[] g = new String[arrayLength(this.namedListeners)];
      int i = 0;
      while (i < this.namedCount) { g[i] = this.namedNames[i]; i = i + 1; }
      this.namedNames = g;
    }
    this.namedNames[this.namedCount] = propertyName;
    this.namedListeners[this.namedCount] = listener;
    this.namedCount = this.namedCount + 1;
  }
  public void removePropertyChangeListener(java.beans.PropertyChangeListener listener) {
    if (listener == null) { return; }
    if (listener instanceof PropertyChangeListenerProxy) {
      PropertyChangeListenerProxy p = (PropertyChangeListenerProxy) listener;
      removePropertyChangeListener(p.getPropertyName(), p.getListener());
      return;
    }
    int i = 0;
    while (i < this.allCount) {
      if (this.allListeners[i] == listener) {
        int j = i;
        while (j < this.allCount - 1) { this.allListeners[j] = this.allListeners[j + 1]; j = j + 1; }
        this.allCount = this.allCount - 1;
        this.allListeners[this.allCount] = null;
        return;
      }
      i = i + 1;
    }
  }
  public void removePropertyChangeListener(java.lang.String propertyName, java.beans.PropertyChangeListener listener) {
    if (listener == null || propertyName == null) { return; }
    int i = 0;
    while (i < this.namedCount) {
      if (this.namedListeners[i] == listener && this.namedNames[i] == propertyName) {
        int j = i;
        while (j < this.namedCount - 1) {
          this.namedListeners[j] = this.namedListeners[j + 1];
          this.namedNames[j] = this.namedNames[j + 1];
          j = j + 1;
        }
        this.namedCount = this.namedCount - 1;
        this.namedListeners[this.namedCount] = null;
        this.namedNames[this.namedCount] = null;
        return;
      }
      i = i + 1;
    }
  }
  public Any[] getPropertyChangeListeners() {
    Any[] out = new Any[this.allCount + this.namedCount];
    int i = 0;
    while (i < this.allCount) { out[i] = this.allListeners[i]; i = i + 1; }
    int j = 0;
    while (j < this.namedCount) {
      out[i + j] = new PropertyChangeListenerProxy(this.namedNames[j], this.namedListeners[j]);
      j = j + 1;
    }
    return out;
  }
  public Any[] getPropertyChangeListeners(java.lang.String propertyName) {
    int n = 0;
    int i = 0;
    while (i < this.namedCount) { if (propertyName != null && this.namedNames[i] == propertyName) { n = n + 1; } i = i + 1; }
    Any[] out = new Any[n];
    n = 0;
    i = 0;
    while (i < this.namedCount) {
      if (propertyName != null && this.namedNames[i] == propertyName) { out[n] = this.namedListeners[i]; n = n + 1; }
      i = i + 1;
    }
    return out;
