  < ---- java.util.concurrent.atomic.AtomicStampedReference members (procedural implementation in SLeeLa) ---- >
  << A reference and an int stamp updated together under VM lock 31 (reserved
     for java.util.concurrent.atomic), so a spawned thread never sees one
     without the other. compareAndSet compares the reference with == (value
     equality for numbers, identity for objects) and the stamp by value;
     weakCompareAndSet is the same operation. >>
  Any stRef;
  int stStamp = 0;

  public AtomicStampedReference(Any initialRef, int initialStamp) {
    this.stRef = initialRef;
    this.stStamp = initialStamp;
  }
  public Any getReference() { return this.stRef; }
  public int getStamp() { return this.stStamp; }
  public Any get(int[] stampHolder) {
    lock(31);
    Any r = this.stRef;
    stampHolder[0] = this.stStamp;
    unlock(31);
    return r;
  }
  public void set(Any newReference, int newStamp) {
    lock(31);
    this.stRef = newReference;
    this.stStamp = newStamp;
    unlock(31);
  }
  public boolean compareAndSet(Any expectedReference, Any newReference, int expectedStamp, int newStamp) {
    lock(31);
    boolean ok = false;
    if (this.stRef == expectedReference && this.stStamp == expectedStamp) {
      this.stRef = newReference;
      this.stStamp = newStamp;
      ok = true;
    }
    unlock(31);
    return ok;
  }
  public boolean weakCompareAndSet(Any expectedReference, Any newReference, int expectedStamp, int newStamp) {
    return compareAndSet(expectedReference, newReference, expectedStamp, newStamp);
  }
  public boolean attemptStamp(Any expectedReference, int newStamp) {
    lock(31);
    boolean ok = false;
    if (this.stRef == expectedReference) {
      this.stStamp = newStamp;
      ok = true;
    }
    unlock(31);
    return ok;
  }
