      long days = gfdiv(this.gcTime, 86400000);
      long ms = gfmod(this.gcTime, 86400000);
      long y = gYear(days);
      long mo = gMonth(days) - 1;
      int d = gDay(days);
      if (field == 1) { y = y + amount; } else { mo = mo + amount; }
      long yy = y + gfdiv(mo, 12);
      long mm = gfmod(mo, 12) + 1;
      int len = monthLength((int) yy, (int) mm);
      if (d > len) { d = len; }
      this.gcTime = (gDays(yy, mm, 1) + (d - 1)) * 86400000 + ms;
