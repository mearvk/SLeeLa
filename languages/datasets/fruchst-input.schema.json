{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRUCHST v1 source dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language_tag",
    "source_id",
    "frequency_unit",
    "entries",
    "provenance"
  ],
  "properties": {
    "language_tag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "frequency_unit": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1000,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "frequency",
          "word",
          "definitions"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "frequency": {
            "type": "number",
            "minimum": 0
          },
          "word": {
            "type": "string",
            "minLength": 1
          },
          "definitions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "fr",
              "es"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "fr": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "minProperties": 1
    }
  }
}
