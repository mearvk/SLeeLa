#!/usr/bin/env sh
set -eu
umask 077
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$DIR/../../.." && pwd)
CONFIG=$(printenv SLEELA_SERVER_CONFIG 2>/dev/null || true)
[ -n "$CONFIG" ] || CONFIG="$DIR/config/server.conf"
[ -f "$CONFIG" ] || { echo "serverd: configuration not found: $CONFIG" >&2; exit 1; }
ENGINE=""; INBOX=""; STATE=""; SOURCE=""; LOG=""; RECOVERY=""; MODE="service"; TICK="false"; FOREGROUND="false"; PREFLIGHT="true"; MANIFEST=""; NETWORK="false"
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in ""|\#*) continue;; esac
  case "$line" in *=*) key=$(printf '%s' "$line" | cut -d= -f1); value=$(printf '%s' "$line" | cut -d= -f2-);; *) echo "serverd: invalid configuration line" >&2; exit 2;; esac
  case "$key" in
    engine) ENGINE=$value;; inbox) INBOX=$value;; state) STATE=$value;; server_source) SOURCE=$value;;
    log) LOG=$value;; recovery_log) RECOVERY=$value;; mode) MODE=$value;; tick) TICK=$value;;
    foreground) FOREGROUND=$value;; preflight) PREFLIGHT=$value;; sha256_manifest) MANIFEST=$value;;
    allow_network) NETWORK=$value;; *) echo "serverd: unknown configuration key: $key" >&2; exit 2;;
  esac
done < "$CONFIG"
[ -n "$ENGINE" ] || ENGINE="$ROOT/impl/build/sleela"
[ -n "$INBOX" ] || INBOX="$ROOT/server-edition/inbox/requests.txt"
[ -n "$STATE" ] || STATE="$ROOT/server-edition/state"
[ -n "$SOURCE" ] || SOURCE="$DIR/src/Server.sleela"
[ -n "$LOG" ] || LOG="$STATE/results.log"
[ -n "$RECOVERY" ] || RECOVERY="$STATE/recovery.log"
[ -n "$MANIFEST" ] || MANIFEST="$ROOT/security/important-sha256-manifest.json"
case "$MODE" in local|service) ;; *) echo "serverd: invalid mode" >&2; exit 2;; esac
case "$TICK" in true|false) ;; *) echo "serverd: invalid tick" >&2; exit 2;; esac
case "$FOREGROUND" in true|false) ;; *) echo "serverd: invalid foreground" >&2; exit 2;; esac
case "$PREFLIGHT" in true|false) ;; *) echo "serverd: invalid preflight" >&2; exit 2;; esac
case "$NETWORK" in true|false) ;; *) echo "serverd: invalid allow_network" >&2; exit 2;; esac
preflight() {
  [ -x "$ENGINE" ] || { echo "preflight: engine is not executable: $ENGINE" >&2; return 1; }
  [ -f "$SOURCE" ] || { echo "preflight: source missing: $SOURCE" >&2; return 1; }
  [ -f "$MANIFEST" ] || { echo "preflight: manifest missing: $MANIFEST" >&2; return 1; }
  mkdir -p "$STATE" "$(dirname "$INBOX")"
}
record_recovery() {
  mkdir -p "$STATE"
  printf '%s mode=%s status=%s source=%s engine=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo now)" "$MODE" "$1" "$SOURCE" "$ENGINE" >> "$RECOVERY"
}
if [ "$PREFLIGHT" = true ]; then
  if ! preflight; then record_recovery "PREFLIGHT_FAILED"; exit 1; fi
else
  mkdir -p "$STATE" "$(dirname "$INBOX")"
fi
if [ "$#" -gt 0 ] && [ "$1" = "--preflight" ]; then echo "preflight: PASS"; exit 0; fi
if [ "$#" -gt 0 ] && [ "$1" = "--design-activity" ]; then shift; exec "$ENGINE" design-activity "$@"; fi
[ -f "$INBOX" ] || printf '%s\n' "hello" > "$INBOX"
[ "$TICK" = true ] && printf 'tick %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo now)" >> "$INBOX"
LOCK="$STATE/.serverd3.lock"
mkdir "$LOCK" 2>/dev/null || { echo "serverd: Service 3 is already active" >&2; exit 3; }
trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT HUP INT TERM
record_recovery "STARTED"
if { echo "=== SLeeLa Server Edition Service 3 ==="; cd "$ROOT"; "$ENGINE" run "$SOURCE"; } >> "$LOG" 2>&1; then
  record_recovery "COMPLETED"
else
  rc=$?
  record_recovery "FAILED:$rc"
  [ "$FOREGROUND" = true ] && tail -n 16 "$LOG"
  exit "$rc"
fi
[ "$FOREGROUND" = true ] && tail -n 16 "$LOG"
echo "serverd: Service 3 completed; results=$LOG"
