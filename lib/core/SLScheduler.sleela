/*
 * lib/core/SLScheduler.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLScheduler used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Scheduler.
// Role: runtime. Responsibility: task scheduling.
class SLScheduler {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
