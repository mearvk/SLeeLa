      boolean part = false;
      while (this.parsePos < this.parseLen) {
        boolean neg = false;
        if (peekUnit() == 45) { neg = true; this.parsePos = this.parsePos + 1; }
        else { if (peekUnit() == 43) { this.parsePos = this.parsePos + 1; } }
