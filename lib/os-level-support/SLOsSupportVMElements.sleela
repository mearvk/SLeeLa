    SLOsSupportElement e = new SLOsSupportElement();
    e.configure("changeDir", "PathManagement", "OSPath", "OP_OS_CHDIR:108",
      "osChangeDir", "slos_chdir", "CommonBackend", "StateChangingOperation", "Implemented", 1, 0);
    e.setResultTerm("StatusCode");
    return e;
  }

  SLOsSupportElement hostName() {
    SLOsSupportElement e = new SLOsSupportElement();
    e.configure("hostName", "HostIdentity", "OSHost", "OP_OS_HOSTNAME:109",
      "osHostName", "slos_hostname", "CommonBackend", "ReadOnlyQuery", "Implemented", 0, 0);
    e.setResultTerm("Utf8String");
    return e;
  }

