/*
 * lib/video/VideoRenderer.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type VideoRenderer used within the video library family.
 */
#sleela 1.3
class VideoRenderer {
  VideoFrame frame;
  boolean active;
  void attach(VideoFrame value){frame=value;}
  void start(){active=frame!=null && frame.valid();}
  boolean renderable(){return active && frame!=null && frame.valid();}
  void stop(){active=false;}
}