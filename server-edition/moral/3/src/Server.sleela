#sleela 1.3
// Discord-3™ — SLeeLa Server Edition Service 3.
// Programmatic server name: Discord-3™.
// Remedial server: lifecycle controls are owned by serverd; processing
// semantics remain in this authoritative SLeeLa source.
class Server {
    String inboxPath = "server-edition/inbox/requests.txt";
    String httpVersion = "3.0";
    String logicalPort = "19866";
    int downloadSizeBytes = 0;
    String statePath = "server-edition/state/results.log";
    int requests = 0;
    int reaches = 0;
    int probes = 0;
    int selector = 0;

    void configureSelector() {
        selector = bestOfNew();
        bestOfWeight(selector, 0, 50);
        bestOfWeight(selector, 1, 25);
        bestOfWeight(selector, 2, 10);
        bestOfWeight(selector, 3, 10);
        bestOfWeight(selector, 4, 5);
        bestOfMinVersion(selector, 1);
        bestOfCostBudget(selector, 100);

        int local = bestOfCandidate(selector, "local-remedial",
            "sdps://127.0.0.1:19866", 200, 64, 5, 5, 2, 10, 3);
        int fallback = bestOfCandidate(selector, "local-fallback",
            "tcp://127.0.0.1:8080", 500, 128, 0, 2, 1, 20, 1);

        bestOfCandidateArch(selector, local, 1, 46, 1);
        bestOfCandidateArch(selector, fallback, 0, 0, 0);
    }

    void processRequest(String line) {
        if (line == "") return;
        requests = requests + 1;

        String receipt = Munction.start("remedial-intake")
            .connect("pipe:server-edition/state/intake")
            .send(line)
            .thatch("frame,record")
            .consume()
            .latch()
            .closeWithReceipt();

        reaches = reaches + 1;

        int p = synchroOpen("127.0.0.1", 9);
        if (p >= 0) {
            int rtt = synchroDispatch(p, 64, 20);
            bestOfRecord(selector, 0, rtt);
            probes = probes + 1;
            synchroClose(p);
        }

        print("remedial request " + requests + ": reached; " + receipt);
    }

    void main() {
        print("server: HTTP " + httpVersion + " logical-port=" + logicalPort + " download-size=" + downloadSizeBytes);
        configureSelector();
        int fd = openFile(inboxPath, "r");

        if (fd >= 0) {
            String content = read(fd);
            close(fd);
            if (content != "") processRequest(content);
        } else {
            print("remedial-server: no inbox; idle");
        }

        int route = bestOfBest(selector);
        print("remedial-server: selected route index " + route);
        print("remedial-server: chosen route -> " + bestOfChoice(selector));
        print("remedial-server: requests=" + requests
            + " reaches=" + reaches + " probes=" + probes);

        bestOfClose(selector);
    }
}
