  boolean contains(double x) { return x >= lo && x <= hi; }
  double width() { return hi - lo; }
  double midpoint() { return (lo + hi) / 2.0; }
  boolean overlaps(SLInterval o) { return lo <= o.hi && o.lo <= hi; }
}

