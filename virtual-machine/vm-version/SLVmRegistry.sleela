/*
 * virtual-machine/vm-version/SLVmRegistry.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLVmRegistry — the catalogue of selectable VM versions
 *   (001..010). On system start, or during a conference with the user, the
 *   native VM loads this registry (and each SLVmVersionNNN manifest) into
 *   memory so the user can enumerate the available VMs and select one that is
 *   "more than the Native VM in /impl". The chosen manifest's build() yields a
 *   configured SLVmRuntime, and its nativeMain names the C/C++ entry the native
 *   loader then builds and boots.
 *
 * Selection paths this models: `sleela vm list` / `sleela vm select <NNN>`
 *   from the terminal, or a setup/conference choice. The registry itself holds
 *   no native state; it binds the ten manifests and resolves a selection.
 *
 * Family: vm. Composes SLVmVersion001..010, SLVmRuntime.
 *
 * [SYNC syntax-2.4 2026-10-25] Syntax header raised 2.1 -> 2.4 to match the
 * authoritative current level in impl/frontend/version.h (max supported 2.4).
 */
#sleela 2.4
class SLVmRegistry {
  SLVmVersion001 v1; SLVmVersion002 v2; SLVmVersion003 v3; SLVmVersion004 v4;
  SLVmVersion005 v5; SLVmVersion006 v6; SLVmVersion007 v7; SLVmVersion008 v8;
  SLVmVersion009 v9; SLVmVersion010 v10;
  int count;

  // Load + configure all ten manifests (the system-start / conference step).
  void load() {
    v1 = new SLVmVersion001(); v1.configure();
    v2 = new SLVmVersion002(); v2.configure();
    v3 = new SLVmVersion003(); v3.configure();
    v4 = new SLVmVersion004(); v4.configure();
    v5 = new SLVmVersion005(); v5.configure();
    v6 = new SLVmVersion006(); v6.configure();
    v7 = new SLVmVersion007(); v7.configure();
    v8 = new SLVmVersion008(); v8.configure();
    v9 = new SLVmVersion009(); v9.configure();
    v10 = new SLVmVersion010(); v10.configure();
    count = 10;
  }

  // Enumerate for the user (e.g. `sleela vm list`).
  void list() {
    v1.describe(); v2.describe(); v3.describe(); v4.describe(); v5.describe();
    v6.describe(); v7.describe(); v8.describe(); v9.describe(); v10.describe();
  }

  // Resolve a selection (1..10) to its manifest; returns null if out of range.
  SLVmVersion select(int number) {
    if (number == 1)  { return v1; }
    if (number == 2)  { return v2; }
    if (number == 3)  { return v3; }
    if (number == 4)  { return v4; }
    if (number == 5)  { return v5; }
    if (number == 6)  { return v6; }
    if (number == 7)  { return v7; }
    if (number == 8)  { return v8; }
    if (number == 9)  { return v9; }
    if (number == 10) { return v10; }
    return null;
  }

  // Select + build the runtime (what a terminal `sleela vm select N` resolves to).
  SLVmRuntime boot(int number) {
    SLVmVersion v = select(number);
    if (v == null) { return null; }
    return v.build();
  }

  int available() { return count; }
}
