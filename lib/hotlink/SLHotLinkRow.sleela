<< lib/hotlink/SLHotLinkRow.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLHotLinkRow — one row of the hot-link matrix: a TYPE of
     class that may join a running system, how its code and instances arrive,
     its contract with the host, the trust needed to bring it, and its cap.
     Mirrors a classType element of hotlink-matrix.xsd. >>
#sleela 3.0
material;
artifact;
pure;
gasoline;
< Family: hotlink. Plain data. Trust: 0 anonymous, 1 worker, 2 executive. >
class SLHotLinkRow {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 39221;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-11";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-11";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  String id;
  < linked | native >
  String codeArrival;
  < hot | cold >
  String instanceArrival;
  < port | compartment | native-abi >
  String contract;
  int minTrust;
  int maxInstances;
  < SLIntegrationKind range this type covers; -1 and -1 when not a compartment >
  int kindFirst;
  int kindLast;
  int requiresAuthorizer;
  < none | host-pinned >
  String digestPolicy;
  < verified | declared | unverified >
  String status;

  void configure(String typeId, String code, String instance, String link,
                 int trust, int cap, int first, int last, int authorizer,
                 String digest, String state) {
    id = typeId; codeArrival = code; instanceArrival = instance; contract = link;
    minTrust = trust; maxInstances = cap; kindFirst = first; kindLast = last;
    requiresAuthorizer = authorizer; digestPolicy = digest; status = state;
  }
  String getId() { return id; }
  String getCodeArrival() { return codeArrival; }
  String getInstanceArrival() { return instanceArrival; }
  String getContract() { return contract; }
  int getMinTrust() { return minTrust; }
  int getMaxInstances() { return maxInstances; }
  int getKindFirst() { return kindFirst; }
  int getKindLast() { return kindLast; }
  boolean needsAuthorizer() { return requiresAuthorizer == 1; }
  String getDigestPolicy() { return digestPolicy; }
  String getStatus() { return status; }
  boolean isHot() { return instanceArrival == "hot"; }
  boolean isNativeCode() { return codeArrival == "native"; }
  boolean coversKind(int kind) { return kindFirst >= 0 && kind >= kindFirst && kind <= kindLast; }
}
