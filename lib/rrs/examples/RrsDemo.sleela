<< lib/rrs/examples/RrsDemo.sleela
   SLeeLa Standard Library Definition.
   Definition: A runnable demo of the rrs package: runs three stages of premises
   through the ternary 1/0/2 feed-forward, then observes the same run with the
   signal monitor and reports the potestas culmination. Sibling .sleela files in
   this package are auto-linked by the runner. Signal/stage ordinals are passed
   as integer literals (1 = AFFIRM, 0 = ELIMINATE, 2 = POWER_ADD; stage 0/1/2 =
   conjunctive/responsibility/solidity) because a class static is not reachable
   through an instance in the checker. >>
#sleela 3.0
material;
class RrsDemo {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Baseline identity for a worker-class example. >>
  String metaVersion = "1.0.0";
  int metaId = 8223;
  String metaAuthor = "Max Rupplin";
  String metaDate = "2026-11-06";
  String metaCopyright = "MEARVK LLC";
  String metaTrademark = "none";
  String metaCorporation = "MEARVK LLC";
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-06";
  int metaScienceRating = 5;
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  void main() {
    print("rrs demo -- Reasonable Responsibility Solidity");

    SLRrs rrs = new SLRrs();

    << Stage 1 (conjunctive, stage ordinal 0): two sound premises, no faith.
       signals: 1 = AFFIRM, 2 = POWER_ADD. >>
    int[] s1 = new int[2];
    s1[0] = 1;
    s1[1] = 2;
    boolean[] f1 = new boolean[2];
    f1[0] = false;
    f1[1] = false;
    boolean[] r1 = new boolean[2];
    r1[0] = true;
    r1[1] = true;

    << Stage 2 (responsibility, stage ordinal 1): one affirm, responsibility met. >>
    int[] s2 = new int[1];
    s2[0] = 1;
    boolean[] f2 = new boolean[1];
    f2[0] = false;
    boolean[] r2 = new boolean[1];
    r2[0] = true;

    << Stage 3 (solidity, stage ordinal 2): one power-add, sound. >>
    int[] s3 = new int[1];
    s3[0] = 2;
    boolean[] f3 = new boolean[1];
    f3[0] = false;
    boolean[] r3 = new boolean[1];
    r3[0] = true;

    int st = rrs.feedForward(s1, f1, r1, 2, s2, f2, r2, 1, s3, f3, r3, 1);
    print("status: " + rrs.statusString(st));
    print("total power: " + rrs.getTotalPower());
    print("solid: " + rrs.isSolid());
    print("potestas: " + rrs.potestasName(rrs.getPotestas()));
    print("faith eliminated: " + rrs.getFaithEliminated());

    SLRrsSignalMonitor mon = new SLRrsSignalMonitor();
    mon.resetTally();
    mon.observeStage(0, s1, f1, r1, 2, rrs);
    mon.observeStage(1, s2, f2, r2, 1, rrs);
    mon.observeStage(2, s3, f3, r3, 1, rrs);
    mon.recordOutcome(rrs);
    print("monitor affirm: " + mon.getTallyAffirm());
    print("monitor power-add: " + mon.getTallyPowerAdd());
    print("monitor eliminate: " + mon.getTallyEliminate());
    print("monitor total power: " + mon.getTotalPower());
  }
}
