#sleela 2.1
/*
 * CharacterAbilityStats.sleela
 * SLeeLa CharacterStats component: primary and expanded abilities.
 *
 * This focused value class separates one coherent group of CharacterStats
 * fields for reuse by games, simulations, and interactive fiction. Values and
 * scales are defined by the consuming game's ruleset; no universal caps are
 * assumed unless explicitly enforced by a method.
 */
class CharacterAbilityStats {
    int STR;
    int DEX;
    int CON;
    int INT;
    int WIS;
    int CHA;
    int LCK;
    int PER;
    int WILL;
    int SPI;
    int TEC;
    int CRAFT;

    int abilityModifier(int score) { return (score - 10) / 2; }
    int strengthModifier() { return abilityModifier(STR); }
    int dexterityModifier() { return abilityModifier(DEX); }
    int constitutionModifier() { return abilityModifier(CON); }
    int intelligenceModifier() { return abilityModifier(INT); }
    int wisdomModifier() { return abilityModifier(WIS); }
    int charismaModifier() { return abilityModifier(CHA); }
}
