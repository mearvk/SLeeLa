/*
 * lib/gameplay/ManagementCourtroom.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines ManagementCourtroom, the ledger of a Player's standing —
 *   the file, tact, and rolls they have accumulated by playing well. Move (c),
 *   "create a new desire", is the main way a Player earns a seat here.
 *
 * ManagementCourtroom is a NATURAL / LOADABLE MODULE sharing the common module
 * contract (load / loaded / moduleName / describe). It is pure state: three
 * counters that only ever go up through honest play, and a derived "standing"
 * so a Player knows where they sit in the room.
 *
 * Family: gameplay.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class ManagementCourtroom {

  static final String MODULE = "ManagementCourtroom";

  int loadedFlag;
  int file;    // documented leverage: evidence, memos, the paper trail
  int tact;    // social capital: knowing what to say and when
  int rolls;   // banked extra rolls the player can spend on future turns

  // --- loadable-module contract ------------------------------------------
  void load() { loadedFlag = 1; file = 0; tact = 0; rolls = 0; }
  boolean loaded() { return loadedFlag == 1; }
  String moduleName() { return MODULE; }

  void addFile(int n)  { if (n > 0) { file  = file  + n; } }
  void addTact(int n)  { if (n > 0) { tact  = tact  + n; } }
  void addRolls(int n) { if (n > 0) { rolls = rolls + n; } }

  // Spend a banked roll, if any. Returns true if one was available.
  boolean spendRoll() {
    if (rolls <= 0) { return false; }
    rolls = rolls - 1;
    return true;
  }

  int fileCount() { return file; }
  int tactCount() { return tact; }
  int rollCount() { return rolls; }

  // Overall standing in the room: the three holdings, weighted. Tact talks
  // loudest, file carries weight, banked rolls are nice to have.
  int standing() { return tact * 3 + file * 2 + rolls; }

  String describe() {
    return MODULE + " file=" + file + " tact=" + tact
         + " rolls=" + rolls + " standing=" + standing();
  }
}
