<< SLeeLa Standard Library Definition.
  Definition: OS-support package entry point and source-level component index.
  General taxonomy, VM bridge contract, portable ABI catalogue and per-OS backend
  catalogues are maintained as separate source classes. The host OS remains the
  authority for permissions and actual system operations. >>
#sleela 2.5
material;

class SLOsSupportRuntime {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override each record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 0;
  String metaAuthor = "mearvk";
  String metaDate = "2026-11-05";
  String metaCopyright = "Copyright mearvk LLC";
  String metaTrademark = "none";
  String metaCorporation = "mearvk LLC";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-05";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 8;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String value) { metaVersion = value; }
  int getMetaId() { return metaId; }
  void setMetaId(int value) { metaId = value; }
  String getMetaAuthor() { return metaAuthor; }
  void setMetaAuthor(String value) { metaAuthor = value; }
  String getMetaDate() { return metaDate; }
  void setMetaDate(String value) { metaDate = value; }
  String getMetaCopyright() { return metaCopyright; }
  void setMetaCopyright(String value) { metaCopyright = value; }
  String getMetaTrademark() { return metaTrademark; }
  void setMetaTrademark(String value) { metaTrademark = value; }
  String getMetaCorporation() { return metaCorporation; }
  void setMetaCorporation(String value) { metaCorporation = value; }
  String getMetaOrigin() { return metaOrigin; }
  void setMetaOrigin(String value) { metaOrigin = value; }
  String getMetaBirthDate() { return metaBirthDate; }
  void setMetaBirthDate(String value) { metaBirthDate = value; }
  int getMetaScienceRating() { return metaScienceRating; }
  void setMetaScienceRating(int value) { metaScienceRating = value; }
  String getMetaNationalSchedule() { return metaNationalSchedule; }
  void setMetaNationalSchedule(String value) { metaNationalSchedule = value; }
  String packageName = "os-level-support";
  String boundary = "user-mode OS services through the SLeeLa VM bridge";
  String catalogClass = "SLOsSupportCatalog";
  String elementClass = "SLOsSupportElement";
  String vmElementsClass = "SLOsSupportVMElements";
  String oslsElementsClass = "SLOsSupportOSLSElements";
  String nativeBindingsClass = "SLOsSupportNative";
  String vmBridgeClass = "SLOsSupportVMBridge";
  String windowsBackendClass = "SLOsSupportWindows";
  String linuxBackendClass = "SLOsSupportLinux";
  String macOSBackendClass = "SLOsSupportMacOS";
  String linuxSourceClass = "SLOsSupportLinuxSource";
  String windowsSourceClass = "SLOsSupportWindowsSource";
  String macOSSourceClass = "SLOsSupportMacOSSource";
  String platformSelectorClass = "SLOsSupportPlatform";
  String existingVMBridge = "SleelaVMSystemCallBridge";
  String nativeImplementation = "impl/core/sleela_os.c";

  String getPackageName() { return packageName; }
  String getBoundary() { return boundary; }
  String getCatalogClass() { return catalogClass; }
  String getElementClass() { return elementClass; }
  String getVMElementsClass() { return vmElementsClass; }
  String getOSLSElementsClass() { return oslsElementsClass; }
  String getNativeBindingsClass() { return nativeBindingsClass; }
  String getVMBridgeClass() { return vmBridgeClass; }
  String getExistingVMBridge() { return existingVMBridge; }
  String getNativeImplementation() { return nativeImplementation; }

  String getWindowsBackendClass() { return windowsBackendClass; }
  String getLinuxBackendClass() { return linuxBackendClass; }
  String getMacOSBackendClass() { return macOSBackendClass; }
  String getLinuxSourceClass() { return linuxSourceClass; }
  String getWindowsSourceClass() { return windowsSourceClass; }
  String getMacOSSourceClass() { return macOSSourceClass; }
  String getPlatformSelectorClass() { return platformSelectorClass; }
}
