#sleela 3.0
// SCS-TEST-003 VM subset: safe array operations and string-literal handling.
class ArrayStringValid {
    void main() {
        int[] empty = new int[0];
        int[] single = new int[1];
        int[] values = new int[3];
        values[0] = 11;
        values[1] = 22;
        values[2] = 33;
        print("ARRAY-EMPTY=" + arrayLength(empty));
        print("ARRAY-SINGLE=" + arrayLength(single));
        print("ARRAY-FIRST=" + arrayGet(values, 0));
        print("ARRAY-LAST=" + arrayGet(values, 2));
        if ("USEFFUL" == "USEFFUL") {
            print("STRING-LITERAL-EQUALITY=PASS");
        } else {
            print("STRING-LITERAL-EQUALITY=FAIL");
        }
        print("STRING-FIXTURE=USEFFUL");
    }
}
