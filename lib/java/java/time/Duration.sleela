    checkField("HourOfDay", h, 0, 23);
    checkField("MinuteOfHour", mi, 0, 59);
    checkField("SecondOfMinute", s, 0, 59);
    return ((h * 60 + mi) * 60 + s) * 1000000000 + nano;
  }
