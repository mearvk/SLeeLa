/*
 * lib/reflection/SLMethodInfo.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLMethodInfo used within the reflection library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: reflection. Native implementation crosses an explicit VM/OS bridge.
class SLMethodInfo {
  String name; String type; int count; void configure(String n,String t){name=n;type=t;} void register(){count=count+1;} String getName(){return name;} String getType(){return type;}
}
