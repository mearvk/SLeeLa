/*
 * lib/core/SLEventBus.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLEventBus used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for EventBus.
// Role: runtime. Responsibility: event publication/subscription.
class SLEventBus {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
