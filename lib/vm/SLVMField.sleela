/*
 * lib/vm/SLVMField.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLVMField — the metadata for one declared field of a
 *   class in the secondary Sleela VM: its name, its slot index within an
 *   object's field block (see SLVMHeap layout), its declared type tag, and
 *   whether it is static (class-level) or instance-level.
 *
 * SLVMClass holds an ordered list of these; the loader fills them in while
 * resolving a module so field access opcodes can map a name to a stable slot.
 *
 * Family: vm. Composed by SLVMClass.
 */
#sleela 1.3
class SLVMField {
  String name;
  int slot;        // index into the owning object's field block
  int typeTag;     // one of SLVMValue.TAG_*
  boolean isStatic;

  void configure(String fieldName, int fieldSlot, int declaredType, boolean staticField) {
    name = fieldName;
    slot = fieldSlot;
    typeTag = declaredType;
    isStatic = staticField;
  }

  String fieldName()  { return name; }
  int slotIndex()     { return slot; }
  int declaredType()  { return typeTag; }
  boolean staticField(){ return isStatic; }
  boolean instanceField(){ return !isStatic; }
}
