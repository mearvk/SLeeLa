<< lib/java/support/SLJavaPropertyModel.sleela
   The properties of one Java object (a JavaBean, a configuration, a component)
   as a model: an ordered set of SLJavaProperty values that share one source,
   one java.beans.PropertyChangeSupport and one VetoableChangeSupport, and that
   load from and store to java.util.Properties by name. >>
#sleela 3.0
material;
import java.jdk-28;

<< A Java bean
       class Window { int width; String title; ... getWidth / setWidth ... }
   with a bound width and a constrained title becomes
       SLJavaPropertyModel m = new SLJavaPropertyModel(window);
       m.define("width", "int").bound(true);
       m.define("title", "java.lang.String").constrained(true).bound(true);
       m.set("width", 640);
       m.addPropertyChangeListener(listener);
   and the same model reads a configuration file:
       m.loadFrom(props, "window.");     window.width=800  sets width to 800
       m.storeTo(props, "window.");      writes window.width and window.title
   Listeners are SLJavaLambda values (lib/java/jdk-28/LOWERING.md section 2).
   Names are kept in definition order; defining a name twice throws
   IllegalArgumentException; an unknown name throws IllegalArgumentException
   naming it. >>
class SLJavaPropertyModel {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs. Shared support
     class of the /lib/java Java container; written for SLeeLa, not copied
     from the JDK. It models the bean of the JavaBeans 1.01 specification
     (Sun Microsystems, 1997) together with its java.util.Properties form. >>
  String metaVersion = "1.0.0";
  int metaId = 39408;
  String metaAuthor = "Max Rupplin";
  String metaDate = "2026-11-12";
  String metaCopyright = "MEARVK LLC";
  String metaTrademark = "none";
  String metaCorporation = "MEARVK LLC";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-12";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 6;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "JavaBeans API Specification 1.01 (Sun Microsystems, 1997), chapter 7 Properties";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  Any source;
  PropertyChangeSupport changes;
  VetoableChangeSupport vetoes;
  SLJavaProperty[] props;
  int count;

  SLJavaPropertyModel(Any source_) {
    if (source_ == null) { throw new NullPointerException("SLJavaPropertyModel: a model needs a source object"); }
    this.source = source_;
    this.changes = new PropertyChangeSupport(source_);
    this.vetoes = new VetoableChangeSupport(source_);
    this.props = new SLJavaProperty[8];
    this.count = 0;
  }

  < ---- defining and finding properties ---- >
  SLJavaProperty define(String name, String javaType) {
    if (indexOf(name) >= 0) { throw new IllegalArgumentException("SLJavaPropertyModel: property " + name + " is already defined"); }
    SLJavaProperty p = new SLJavaProperty(name, javaType);
    p.attach(this.source, this.changes, this.vetoes);
    if (this.count >= arrayLength(this.props)) {
      SLJavaProperty[] g = new SLJavaProperty[arrayLength(this.props) * 2];
      int i = 0;
      while (i < this.count) { g[i] = this.props[i]; i = i + 1; }
      this.props = g;
    }
    this.props[this.count] = p;
    this.count = this.count + 1;
    return p;
  }
  int indexOf(String name) {
    int i = 0;
    while (i < this.count) {
      SLJavaProperty p = this.props[i];
      if (p.getName() == name) { return i; }
      i = i + 1;
    }
    return -1;
  }
  boolean has(String name) { return indexOf(name) >= 0; }
  SLJavaProperty property(String name) {
    int i = indexOf(name);
    if (i < 0) { throw new IllegalArgumentException("SLJavaPropertyModel: no property " + name); }
    SLJavaProperty p = this.props[i];
    return p;
  }
  int size() { return this.count; }
  SLJavaProperty propertyAt(int i) {
    if (i < 0 || i >= this.count) { throw new IndexOutOfBoundsException("Index " + i + " out of bounds for length " + this.count); }
    SLJavaProperty p = this.props[i];
    return p;
  }
  String[] names() {
    String[] out = new String[this.count];
    int i = 0;
    while (i < this.count) { SLJavaProperty p = this.props[i]; out[i] = p.getName(); i = i + 1; }
    return out;
  }

  < ---- values ---- >
  Any get(String name) { SLJavaProperty p = property(name); return p.get(); }
  Any set(String name, Any v) { SLJavaProperty p = property(name); return p.set(v); }
  String getText(String name) { SLJavaProperty p = property(name); return p.toText(); }
  void setText(String name, String text) { SLJavaProperty p = property(name); p.setText(text); }

  < ---- listeners (the java.beans API of the model) ---- >
  void addPropertyChangeListener(Any listener) { this.changes.addPropertyChangeListener(listener); }
  void addPropertyChangeListener(String name, Any listener) { this.changes.addPropertyChangeListener(name, listener); }
  void removePropertyChangeListener(Any listener) { this.changes.removePropertyChangeListener(listener); }
  void removePropertyChangeListener(String name, Any listener) { this.changes.removePropertyChangeListener(name, listener); }
  void addVetoableChangeListener(Any listener) { this.vetoes.addVetoableChangeListener(listener); }
  void addVetoableChangeListener(String name, Any listener) { this.vetoes.addVetoableChangeListener(name, listener); }
  void removeVetoableChangeListener(Any listener) { this.vetoes.removeVetoableChangeListener(listener); }
  void removeVetoableChangeListener(String name, Any listener) { this.vetoes.removeVetoableChangeListener(name, listener); }
  PropertyChangeSupport propertyChangeSupport() { return this.changes; }
  VetoableChangeSupport vetoableChangeSupport() { return this.vetoes; }

  < ---- the java.util.Properties form ---- >
  << loadFrom sets every defined, writable property whose key prefix + name is
     present in props (or in its defaults chain), through set, so types are
     checked, vetoes apply and listeners hear the change. A read-only property
     is loaded with initialize instead. Keys the model does not define are
     left alone. Returns the number of properties loaded. >>
  int loadFrom(Properties props, String prefix) {
    if (props == null) { throw new NullPointerException(); }
    String pre = prefix;
    if (pre == null) { pre = ""; }
    int loaded = 0;
    int i = 0;
    while (i < this.count) {
      SLJavaProperty p = this.props[i];
      String text = props.getProperty(pre + p.getName());
      if (text != null && !p.isIndexed()) {
        if (p.isReadOnly()) { p.initialize(p.fromText(text)); }
        else { p.setText(text); }
        loaded = loaded + 1;
      }
      i = i + 1;
    }
    return loaded;
  }
  << storeTo writes prefix + name = text for every property that is not
     indexed and whose value is not null. Returns the number written. >>
  int storeTo(Properties props, String prefix) {
    if (props == null) { throw new NullPointerException(); }
    String pre = prefix;
    if (pre == null) { pre = ""; }
    int stored = 0;
    int i = 0;
    while (i < this.count) {
      SLJavaProperty p = this.props[i];
      String text = null;
      if (!p.isIndexed()) { text = p.toText(); }
      if (text != null) { props.setProperty(pre + p.getName(), text); stored = stored + 1; }
      i = i + 1;
    }
    return stored;
  }
  Properties toProperties() {
    Properties out = new Properties();
    storeTo(out, "");
    return out;
  }

  < one line per property, in definition order >
  String describe() {
    String out = "";
    int i = 0;
    while (i < this.count) {
      SLJavaProperty p = this.props[i];
      if (i > 0) { out = out + "\n"; }
      out = out + p.describe();
      i = i + 1;
    }
    return out;
  }
}
