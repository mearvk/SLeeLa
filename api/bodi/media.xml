<?xml version="1.0" encoding="UTF-8"?>
<bodi version="1">
  <project id="media-monitor" kind="media">
    <audio monitor="true" analysis="level,rms,peak,spectrum"
           codecs="pcm,aac,alac,amr,flac,g711,g722,mp3,opus,vorbis"/>
    <video monitor="true" analysis="luminance,edges,motion"
           codecs="h263,h264,hevc,av1,mpeg1video,mpeg2video,mpeg4,theora,vp8,vp9,ffv1"
           containers="mp4,mkv,webm,ogg,mpeg-ts,mov,avi,3gp"/>
    <image formats="bmp,jpeg,png,gif,apng,webp,tiff,jpeg2000,jpeg-ls,avif,heif,exr,hdr,pam,pnm,dpx"/>
    <listener folder="media-inbox" pattern="*.xml" mode="transform"/>
  </project>
</bodi>