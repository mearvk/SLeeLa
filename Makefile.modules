# =============================================================================
# Makefile.modules -- iteratively install the SLeeLa modules, paced over a
# modest ~10-20 minute window.
#
#   make -f Makefile.modules install-modules          # paced install/build walk
#   make -f Makefile.modules install-modules-fast      # same, no pacing sleeps
#   make -f Makefile.modules install-modules-resume    # continue a prior run
#   make -f Makefile.modules list-modules              # show the module order
#   make -f Makefile.modules modules-status            # show per-module state
#   make -f Makefile.modules clean-modules             # clean every module
#
# Each module is visited in order; the walk runs that module's own `install`
# target when it has one, otherwise `all` (build). It is RESILIENT: a module
# that fails or lacks its OS dependencies is logged and skipped, not fatal, so
# the run always completes and prints a summary. Progress is recorded in a
# resumable state file.
#
# Knobs (pass on the command line or the environment):
#   TARGET_SECONDS  total target wall-clock (default 900; clamped to 600..1200)
#   PACE=on|off     whether to sleep to spread the run across the window (on)
#   RESUME=on|off   skip modules already marked done (on)
#   PREFIX=...      install prefix forwarded to each module (default /usr/local)
#   DESTDIR=...     staged-install root forwarded to each module
#   MODULES="a b c" override the module list/order
#
# This is a standalone, ordinary Makefile: it does not replace the main
# dispatcher (./Makefile), it paces the per-module install/build the main `all`
# does all at once.
# =============================================================================

SHELL := /bin/sh
ROOT  := $(CURDIR)
RUNNER := scripts/install-modules.sh

PREFIX  ?= /usr/local
DESTDIR ?=
TARGET_SECONDS ?= 900
PACE   ?= on
RESUME ?= on

# The module order the runner uses by default (foundational/light first, heavy
# native + OS-linking modules last). Kept in sync with the runner's own default;
# override by passing MODULES="...". Listed here so `list-modules` can show it
# without running the walk.
MODULES ?= config common-rails resolver preferred-routers logger ledger registry \
  regex crypto compression codecs \
  compiler decompiler debugger \
  idea os drivers native \
  wifi-common ofdma \
  http-1.0 http-2.0 http-3.0 http-4.0 http-5.0 http-6.0 http-7.0 http-8.0 http-9.0 \
  autocad churn website-generator linux-editors \
  user-interface ballum video \
  sleela-scripting sleela-terminal server-edition \
  antivirus connector

.PHONY: install-modules install-modules-fast install-modules-resume \
        list-modules modules-status clean-modules help

# Paced iterative install/build of every module (~10-20 min).
install-modules:
	@TARGET_SECONDS="$(TARGET_SECONDS)" PACE="$(PACE)" RESUME="$(RESUME)" \
	 PREFIX="$(PREFIX)" DESTDIR="$(DESTDIR)" MODULES="$(MODULES)" \
	 sh "$(RUNNER)"

# Same walk, but no pacing sleeps (as fast as the machine allows).
install-modules-fast:
	@$(MAKE) -f Makefile.modules install-modules PACE=off

# Continue a previous run, retrying only what was skipped / not yet done.
install-modules-resume:
	@$(MAKE) -f Makefile.modules install-modules RESUME=on

# Show the module order and whether each has its own `install` target.
list-modules:
	@echo "SLeeLa module install order ($(words $(MODULES)) modules):"
	@i=0; for m in $(MODULES); do \
	  i=$$((i+1)); \
	  if [ ! -f "$$m/Makefile" ]; then tag="(no Makefile)"; \
	  elif grep -qE '^install:' "$$m/Makefile"; then tag="-> make install"; \
	  else tag="-> make all"; fi; \
	  printf "  %2d. %-22s %s\n" "$$i" "$$m" "$$tag"; \
	done

# Report per-module state from the last run.
modules-status:
	@if [ -f build/module-install.state ]; then \
	  echo "module install state (build/module-install.state):"; \
	  sed 's/^/  /' build/module-install.state; \
	else echo "no run yet (run 'make -f Makefile.modules install-modules')"; fi

# Clean every module in the list (best-effort; a missing clean target is fine).
clean-modules:
	@for m in $(MODULES); do \
	  [ -f "$$m/Makefile" ] || continue; \
	  echo "==> clean $$m"; $(MAKE) -C "$$m" clean >/dev/null 2>&1 || true; \
	done
	@rm -f build/module-install.state build/module-install.log
	@echo "modules cleaned; install state reset."

help:
	@echo "SLeeLa iterative module installer (Makefile.modules)"
	@echo "  make -f Makefile.modules install-modules         Paced install/build of all modules (~10-20 min)"
	@echo "  make -f Makefile.modules install-modules-fast    Same, without pacing sleeps"
	@echo "  make -f Makefile.modules install-modules-resume  Continue a prior run (retry skipped/undone)"
	@echo "  make -f Makefile.modules list-modules            Show the module order + each module's target"
	@echo "  make -f Makefile.modules modules-status          Show per-module state from the last run"
	@echo "  make -f Makefile.modules clean-modules           Clean every module and reset install state"
	@echo ""
	@echo "Knobs: TARGET_SECONDS (600..1200, default 900) PACE=on|off RESUME=on|off PREFIX=... DESTDIR=... MODULES=\"...\""
