#sleela 2.1
/*
 * CharacterCombatStats.sleela
 * SLeeLa CharacterStats component: combat and action economy.
 *
 * This focused value class separates one coherent group of CharacterStats
 * fields for reuse by games, simulations, and interactive fiction. Values and
 * scales are defined by the consuming game's ruleset; no universal caps are
 * assumed unless explicitly enforced by a method.
 */
class CharacterCombatStats {
    int attackPower;
    int spellPower;
    int rangedPower;
    int defense;
    int armorClass;
    int magicDefense;
    int initiative;
    int accuracy;
    int criticalChance;
    int criticalMultiplier;
    int evasion;
    int blockChance;
    int parryChance;
    int dodgeChance;
    int attackSpeed;
    int castSpeed;
    int movementSpeed;
    int actionPoints;
    int maxActionPoints;
    int reactionPoints;
    int maxReactionPoints;

    int canAct() { return actionPoints > 0; }
    int canReact() { return reactionPoints > 0; }
}
