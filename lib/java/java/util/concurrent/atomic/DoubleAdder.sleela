  < ---- java.util.concurrent.atomic.DoubleAdder members (procedural implementation in SLeeLa) ---- >
  << A sum maintained atomically under VM lock 31. Java spreads the sum
     over cells to reduce contention; a single locked cell has the same
     observable results. >>
  double total;
  DoubleAdder() { this.total = 0.0; }
  void add(double x) { lock(31); this.total = this.total + x; unlock(31); }
  double sum() { return this.total; }
  void reset() { lock(31); this.total = 0.0; unlock(31); }
  double sumThenReset() {
    lock(31);
    double s = this.total;
    this.total = 0.0;
    unlock(31);
    return s;
  }
  String toString() { Double d = new Double(sum()); return d.toString(); }
  long longValue() { return (long) sum(); }
  int intValue() { Double d = new Double(sum()); return d.intValue(); }
  double doubleValue() { double d = sum(); return d; }
  double floatValue() { Float f = new Float(doubleValue()); return f.doubleValue(); }
