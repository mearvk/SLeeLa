< ---- source: lib/advantage/math/SLTradeMath.sleela ---- >
<< lib/advantage/math/SLTradeMath.sleela
   SLeeLa Standard Library Definition.
   Definition: Shared real-valued math helpers for the advantage trade
   subject -- exponential, natural log, and general power. >>
< Self-contained double-precision helpers so the advantage/math subject needs >
< no cross-package imports. These back the fractional exponents of the Nash >
< bargaining objective and any root/ratio arithmetic. Accuracy is ample for >
< bargaining weights and critical ratios (series are range-reduced). >
class SLTradeMath {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10521;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-08";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-08";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 8;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < int -> double coercion that works regardless of implicit promotion. >
  double intToD(int n) {
    double d = 0.0;
    int i = 0;
    if (n >= 0) {
      while (i < n) { d = d + 1.0; i = i + 1; }
      return d;
    }
    int m = 0 - n;
    while (i < m) { d = d + 1.0; i = i + 1; }
    return 0.0 - d;
  }

  < Natural exponential via a truncated Taylor series with range reduction by >
  < halving: e^x = (e^(x/2^k))^(2^k). >
  double expD(double x) {
    boolean neg = false;
    double ax = x;
    if (ax < 0.0) { neg = true; ax = 0.0 - ax; }
    int k = 0;
    while (ax > 0.5) { ax = ax / 2.0; k = k + 1; }
    double term = 1.0;
    double sum = 1.0;
    int n = 1;
    while (n <= 18) {
      term = term * ax / intToD(n);
      sum = sum + term;
      n = n + 1;
    }
    int i = 0;
    while (i < k) { sum = sum * sum; i = i + 1; }
    if (neg) { return 1.0 / sum; }
    return sum;
  }

  < Natural logarithm via atanh series: ln(y) = 2*atanh((y-1)/(y+1)), with >
  < range reduction pulling y into (0.5, 2) by factoring out e. >
  double lnD(double y) {
    if (y <= 0.0) { return 0.0; }
    double e = 2.718281828459045;
    double adjust = 0.0;
    double v = y;
    while (v > 1.5) { v = v / e; adjust = adjust + 1.0; }
    while (v < 0.5) { v = v * e; adjust = adjust - 1.0; }
    double t = (v - 1.0) / (v + 1.0);
    double t2 = t * t;
    double termn = t;
    double sum = 0.0;
    int n = 1;
    while (n <= 39) {
      sum = sum + termn / intToD(n);
      termn = termn * t2;
      n = n + 2;
    }
    return 2.0 * sum + adjust;
  }

  < General power a^b for a > 0 via exp(b * ln a). a <= 0 returns 0. >
  double powAB(double a, double b) {
    if (a <= 0.0) { return 0.0; }
    return expD(b * lnD(a));
  }

  < Convenience square root (powAB with exponent 0.5). >
  double sqrtD(double a) {
    if (a <= 0.0) { return 0.0; }
    return powAB(a, 0.5);
  }

  < Absolute value for doubles. >
  double absD(double a) {
    if (a < 0.0) { return 0.0 - a; }
    return a;
  }
}

< ---- source: lib/advantage/math/SLJointProfitMax.sleela ---- >
<< lib/advantage/math/SLJointProfitMax.sleela
   SLeeLa Standard Library Definition.
   Definition: Joint Profit Maximization -- the integrated surplus formula for
   a coordinated buyer+seller system. >>
< Model 1 of the advantage trade subject. Treat buyer and seller as one >
< coordinated system and maximize the total economic surplus BEFORE dividing >
< it: Pi_total(Q) = R_B(Q) - C_S(Q). >
<  >
< Curve convention (quadratic, so Q* and the marginals are exact): >
<   R_B(Q) = rbA*Q - rbB*Q^2     buyer revenue / utility (concave) >
<   C_S(Q) = csA*Q + csB*Q^2     seller cost (convex) >
< Marginal revenue  dR_B/dQ = rbA - 2*rbB*Q. >
< Marginal cost     dC_S/dQ = csA + 2*csB*Q. >
< Decision rule MR = MC gives Q* = (rbA - csA) / (2*(rbB + csB)). >
class SLJointProfitMax {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10522;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-08";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-08";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 8;
  << metaNationalSchedule: the profit-maximizing rule MR = MC is classical
     marginalism (Cournot, 1838); an academic result, not a statute. >>
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < ---- Curve coefficients ---- >
  < linear term of buyer revenue R_B(Q) >
  double rbA;
  < quadratic (diminishing) term of buyer revenue >
  double rbB;
  < linear term of seller cost C_S(Q) >
  double csA;
  < quadratic (convex) term of seller cost >
  double csB;

  void configureCurves(double rbA0, double rbB0, double csA0, double csB0) {
    rbA = rbA0;
    rbB = rbB0;
    csA = csA0;
    csB = csB0;
  }

  double getRbA() { return rbA; }
  double getRbB() { return rbB; }
  double getCsA() { return csA; }
  double getCsB() { return csB; }

  < Buyer revenue / utility from Q units. >
  double buyerRevenue(double q) { return rbA * q - rbB * q * q; }

  < Seller total cost for Q units. >
  double sellerCost(double q) { return csA * q + csB * q * q; }

  < Total available pool of profit: Pi_total(Q) = R_B(Q) - C_S(Q). >
  double jointProfit(double q) { return buyerRevenue(q) - sellerCost(q); }

  < Marginal revenue dR_B/dQ. >
  double marginalRevenue(double q) { return rbA - 2.0 * rbB * q; }

  < Marginal supply cost dC_S/dQ. >
  double marginalCost(double q) { return csA + 2.0 * csB * q; }

  < Optimal quantity Q* where MR = MC. 0 if no interior optimum exists. >
  double optimalQuantity() {
    double denom = 2.0 * (rbB + csB);
    if (denom <= 0.0) { return 0.0; }
    double q = (rbA - csA) / denom;
    if (q < 0.0) { return 0.0; }
    return q;
  }

  < The maximum joint surplus, evaluated at Q*. >
  double maxJointProfit() { return jointProfit(optimalQuantity()); }

  String describe() {
    double q = optimalQuantity();
    return "JointProfitMax: Q*=" + q + " Pi_total(Q*)=" + jointProfit(q)
         + " (MR=" + marginalRevenue(q) + " MC=" + marginalCost(q) + ")";
  }
}

< ---- source: lib/advantage/math/SLNashBargaining.sleela ---- >
<< lib/advantage/math/SLNashBargaining.sleela
   SLeeLa Standard Library Definition.
   Definition: Bilateral monopoly & Nash bargaining -- split a known joint
   surplus by a bargaining-power index over reservation profits. >>
< Model 2 of the advantage trade subject. Once the joint surplus is fixed at >
< Q*, the SPLIT depends on the wholesale price P. Individual profit curves: >
<   Seller: Pi_S(P,Q) = P*Q - C_S(Q) >
<   Buyer:  Pi_B(P,Q) = R_B(Q) - P*Q >
< The Nash Bargaining Solution (Nash 1950) picks the price that maximizes the >
< geometric product of each party's surplus over its disagreement point: >
<   max_P [Pi_S - Pi_S0]^alpha * [Pi_B - Pi_B0]^(1-alpha). >
< alpha in [0,1] is the bargaining-power index; alpha=0.5 splits the surplus >
< evenly. Depends on a SLJointProfitMax for the curves and SLTradeMath for the >
< fractional-exponent power (both sibling-linked within advantage/math). >
class SLNashBargaining {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10523;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-08";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-08";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 8;
  << metaNationalSchedule: the Nash Bargaining Solution is J. F. Nash,
     "The Bargaining Problem", Econometrica 18(2):155-162 (1950); an academic
     result, not a statute. >>
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < ---- Dependencies (sibling-linked within advantage/math) ---- >
  SLJointProfitMax curves;
  SLTradeMath mathlib;

  void configure(SLJointProfitMax c) {
    curves = c;
    mathlib = new SLTradeMath();
  }

  < Seller profit at wholesale price P and quantity Q: (P*Q) - C_S(Q). >
  double sellerProfit(double price, double q) {
    return price * q - curves.sellerCost(q);
  }

  < Buyer profit at wholesale price P and quantity Q: R_B(Q) - (P*Q). >
  double buyerProfit(double price, double q) {
    return curves.buyerRevenue(q) - price * q;
  }

  < The Nash objective at a candidate price. Both surpluses must be positive >
  < to be inside the bargaining range; outside it the objective is 0. >
  double nashObjective(double price, double q, double s0, double b0, double alpha) {
    double ss = sellerProfit(price, q) - s0;
    double bs = buyerProfit(price, q) - b0;
    if (ss <= 0.0) { return 0.0; }
    if (bs <= 0.0) { return 0.0; }
    return mathlib.powAB(ss, alpha) * mathlib.powAB(bs, 1.0 - alpha);
  }

  << Closed-form Nash price at the optimal quantity. Total profit is fixed at
     Q*, so moving P only transfers value (d Pi_S/dP = +Q*). The generalized
     Nash solution awards the seller a fraction alpha of the bargainable
     surplus S = Pi_total(Q*) - Pi_S0 - Pi_B0:
        Pi_S(P*) - Pi_S0 = alpha * S,  Pi_S(P*) = P*Q* - C_S(Q*)
     =>  P* = ( Pi_S0 + alpha*S + C_S(Q*) ) / Q*. >>
  double nashPrice(double s0, double b0, double alpha) {
    double q = curves.optimalQuantity();
    if (q <= 0.0) { return 0.0; }
    double total = curves.jointProfit(q);
    double surplus = total - s0 - b0;
    double sellerShare = s0 + alpha * surplus;
    return (sellerShare + curves.sellerCost(q)) / q;
  }

  < The joint surplus available for bargaining beyond both reservation points. >
  double bargainableSurplus(double s0, double b0) {
    return curves.maxJointProfit() - s0 - b0;
  }

  String describe(double s0, double b0, double alpha) {
    double q = curves.optimalQuantity();
    double p = nashPrice(s0, b0, alpha);
    return "NashBargaining: alpha=" + alpha + " P*=" + p
         + " sellerProfit=" + sellerProfit(p, q)
         + " buyerProfit=" + buyerProfit(p, q);
  }
}

< ---- source: lib/advantage/math/SLBilateralNewsvendor.sleela ---- >
<< lib/advantage/math/SLBilateralNewsvendor.sleela
   SLeeLa Standard Library Definition.
   Definition: Bilateral newsvendor -- overage/underage costs on both ends and
   the centralized critical ratio that avoids double marginalization. >>
< Model 3 of the advantage trade subject. When the inventory faces uncertain >
< end-market demand but both parties' holding and shortage costs are >
< transparent, the profit curves are governed by overage and underage costs on >
< each side: >
<   Seller overage  c_o,S = cs - vs   (production cost minus seller salvage) >
<   Seller underage c_u,S = P  - cs   (wholesale price minus production cost) >
<   Buyer  overage  c_o,B = P  - vb   (wholesale price minus buyer salvage) >
<   Buyer  underage c_u,B = r  - P    (retail price minus wholesale price) >
< The CENTRALIZED critical ratio sets the system-wide service level F(Q*): >
<   F(Q*) = c_u,system / (c_u,system + c_o,system) >
<         = (r - cs) / ((r - cs) + (cs - vb)). >
< This is the Arrow-Harris-Marschak newsvendor result applied to the whole >
< channel, preventing "double marginalization" (both parties hedging separately >
< and restricting inventory too much). >
class SLBilateralNewsvendor {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10524;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-08";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  String metaBirthDate = "2026-11-08";
  int metaScienceRating = 8;
  << metaNationalSchedule: the newsvendor critical-ratio optimum is the
     Arrow-Harris-Marschak result (Econometrica 1951); an academic result,
     not a statute. >>
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < ---- Per-side overage and underage costs ---- >
  double overageSeller(double cs, double vs)      { return cs - vs; }
  double underageSeller(double price, double cs)  { return price - cs; }
  double overageBuyer(double price, double vb)    { return price - vb; }
  double underageBuyer(double r, double price)    { return r - price; }

  << Centralized critical ratio -- the system-wide service level F(Q*):
       F(Q*) = (r - cs) / ((r - cs) + (cs - vb)).
     System underage r - cs is the full channel margin lost on a stockout;
     system overage cs - vb is the production cost unrecovered beyond buyer
     salvage. Clamped to [0,1]; 0 if the denominator is non-positive. >>
  double criticalRatio(double r, double cs, double vb) {
    double cu = r - cs;
    double co = cs - vb;
    double denom = cu + co;
    if (denom <= 0.0) { return 0.0; }
    double f = cu / denom;
    if (f < 0.0) { return 0.0; }
    if (f > 1.0) { return 1.0; }
    return f;
  }

  << A standalone buyer, facing only its OWN costs, targets
       F_B = (r - P) / ((r - P) + (P - vb)),
     which sits below the centralized F(Q*) -- that shortfall IS double
     marginalization. A buyback or revenue-sharing contract lifts F_B up to
     F(Q*). Returns the gap (>= 0 means the buyer under-orders and a
     coordinating contract is warranted). >>
  double coordinationGap(double r, double cs, double price, double vb) {
    double system = criticalRatio(r, cs, vb);
    double cuB = r - price;
    double coB = price - vb;
    double denomB = cuB + coB;
    double fb = 0.0;
    if (denomB > 0.0) { fb = cuB / denomB; }
    double gap = system - fb;
    if (gap < 0.0) { return 0.0; }
    return gap;
  }

  String describe(double r, double cs, double vb) {
    return "BilateralNewsvendor: F(Q*)=" + criticalRatio(r, cs, vb)
         + " (system underage=" + (r - cs) + " overage=" + (cs - vb) + ")";
  }
}

< ---- source: lib/advantage/physics/SLPhysicsMath.sleela ---- >
<< lib/advantage/physics/SLPhysicsMath.sleela
   SLeeLa Standard Library Definition.
   Definition: Self-contained real-valued helpers for the advantage/physics
   subject (sqrt, exp, ln), named distinctly from the math/ helper to avoid
   cross-directory class-name ambiguity. >>
< The physics subject needs sqrt (geodesic arc length, CIR diffusion) and a >
< general power. A dedicated helper keeps advantage/physics runnable on its own >
< siblings with no cross-package or cross-subfolder imports, and its unique >
< class name avoids colliding with math/SLTradeMath. >
class SLPhysicsMath {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10534;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-08";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-08";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 8;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  double intToD(int n) {
    double d = 0.0;
    int i = 0;
    if (n >= 0) {
      while (i < n) { d = d + 1.0; i = i + 1; }
      return d;
    }
    int mm = 0 - n;
    while (i < mm) { d = d + 1.0; i = i + 1; }
    return 0.0 - d;
  }

  double expD(double x) {
    boolean neg = false;
    double ax = x;
    if (ax < 0.0) { neg = true; ax = 0.0 - ax; }
    int k = 0;
    while (ax > 0.5) { ax = ax / 2.0; k = k + 1; }
    double term = 1.0;
    double sum = 1.0;
    int n = 1;
    while (n <= 18) {
      term = term * ax / intToD(n);
      sum = sum + term;
      n = n + 1;
    }
    int i = 0;
    while (i < k) { sum = sum * sum; i = i + 1; }
    if (neg) { return 1.0 / sum; }
    return sum;
  }

  double lnD(double y) {
    if (y <= 0.0) { return 0.0; }
    double e = 2.718281828459045;
    double adjust = 0.0;
    double v = y;
    while (v > 1.5) { v = v / e; adjust = adjust + 1.0; }
    while (v < 0.5) { v = v * e; adjust = adjust - 1.0; }
    double t = (v - 1.0) / (v + 1.0);
    double t2 = t * t;
    double termn = t;
    double sum = 0.0;
    int n = 1;
    while (n <= 39) {
      sum = sum + termn / intToD(n);
      termn = termn * t2;
      n = n + 2;
    }
    return 2.0 * sum + adjust;
  }

  double powAB(double a, double b) {
    if (a <= 0.0) { return 0.0; }
    return expD(b * lnD(a));
  }

  double sqrtD(double a) {
    if (a <= 0.0) { return 0.0; }
    return powAB(a, 0.5);
  }

  double absD(double a) {
    if (a < 0.0) { return 0.0 - a; }
    return a;
  }
}
