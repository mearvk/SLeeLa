/*
 * lib/gui/SLGuiIntegration.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLGuiIntegration — the recommended combined architecture
 *   from gui/INTEGRATION.md. The three complementary paths are not mutually
 *   exclusive: SLeeLa owns business logic, state transitions, and the meaning
 *   of events; Java owns Swing/JavaFX presentation and desktop lifecycle; the
 *   native bridge provides a stable low-level boundary to the C/C++ core.
 */
#sleela 1.3
// SLeeLa gui front-end contract — the three-path integration posture.
// Family: gui. Intentionally asymmetric: Java is a native desktop host for
// SLeeLa, not a second business-logic implementation.
class SLGuiIntegration {
  int PATH_JAVA_HOST = 1;      // Path 1: Java host -> SLeeLa business logic
  int PATH_SLEELA_INTENT = 2;  // Path 2: SLeeLa intent -> Java GUI
  int PATH_NATIVE_ABI = 3;     // Path 3: shared native ABI bridge
  int path1;                   // enabled flags for the three paths
  int path2;
  int path3;
  void configure() { path1 = 0; path2 = 0; path3 = 0; }
  void enableJavaHost() { path1 = 1; }
  void enableSleelaIntent() { path2 = 1; }
  void enableNativeAbi() { path3 = 1; }
  boolean javaHost() { return path1 == 1; }
  boolean sleelaIntent() { return path2 == 1; }
  boolean nativeAbi() { return path3 == 1; }
  // The preferred long-term architecture uses all three layers.
  boolean recommended() { return path1 == 1 && path2 == 1 && path3 == 1; }
  int enabledPaths() { return path1 + path2 + path3; }
  // Who owns business logic in this posture (always SLeeLa, by contract).
  String businessLogicOwner() { return "sleela"; }
  // Who owns presentation / desktop lifecycle.
  String presentationOwner() { return "java"; }
  // Who owns the low-level boundary to the execution core.
  String nativeBoundaryOwner() { return "native-bridge"; }
}
