/*
 * lib/core/SLListener.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLListener used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Listener.
// Role: runtime. Responsibility: event/network listener contract.
class SLListener {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
