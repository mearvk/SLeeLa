## SLeeLa syntax highlighting for nano (SLeeLa East Asian palette).
## Requires nano >= 5.0 for 24-bit "color #RRGGBB" values.
syntax sleela "\.sleela$"
comment "//"

## keywords, types, literals
color #d97878 "\<(let|var|const|if|else|while|for|in|return|break|continue|class|interface|extends|implements|new|this|super|import|package|public|private|protected|static|final|true|false|null|nil|and|or|not|try|catch|throw|synchronized|finally|switch|case|default|do|assert|yield|instanceof)\>"
color #72c7a5 "\<(String|SLString|Integer|Int|Long|Double|Float|Boolean|Character|Byte|Short|Void|Object|List|Map|Set|Array|int64|int128|long|double|boolean)\>"
## function-call heads
color #9fcb9a "[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\("
## numbers
color #bda6de "\<[0-9]+\>"
## strings (double- and single-quoted; inner double-quote escaped as \")
color #d8b76a "\"(\\.|[^\"\\])*\""
color #d8b76a "'(\\.|[^'\\])*'"
## annotations and the document pragmas
color #d97878 "@[A-Za-z_][A-Za-z0-9_]*"
color #d97878 "^[[:space:]]*#(sleela|schema)\>.*$"
## document markers (only when alone on a line, optional ;)
color #d97878 "^[[:space:]]*(author|authorial|material|memory|determine)[[:space:]]*;?[[:space:]]*$"
## comments: // line and /* */ block, plus << >> and < > angle forms
color #969f9b "//.*$"
color #969f9b start="/\*" end="\*/"
color #969f9b start="^[[:space:]]*<<" end=">>"
color #969f9b "^[[:space:]]*<[^<].*>?$"
## TODO/FIXME/NOTE/XXX inside comments
color #d8b76a "\<(TODO|FIXME|NOTE|XXX)\>"
