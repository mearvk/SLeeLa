/*
 * sleela-virtual-machine/002/SLVmPremiumVersion002.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLVmPremiumVersion002 -- the loadable SLeeLa manifest for
 *   premium VM generation slvm-2 ("cryptographic and VM-link evolution"), the OOD selector record the native
 *   VM can enumerate and select via `sleela vm select premium 2` (or p2).
 *   It names this generation's C/C++ project directory and admission validator,
 *   composes the cumulative premium capability set through generation 2, and
 *   carries the default configuration profile. build() returns the configured
 *   SLVmRuntime a selection resolves to; nativeBinary() names the binary the
 *   master build produces (vm-build/slvm-2).
 *
 * Faithful to impl/frontend/driver.cpp (kPremium) and virtual-machine/USER-GUIDE.md
 * (per-grade validator list). It extends SLVmPremiumVersion
 * (lib/vm/src/sleela/SLVmPremiumVersion.sleela).
 *
 * Family: vm. Composes SLVmPremiumVersion, SLVmConfig, SLVmRuntime.
 */
#sleela 2.4
class SLVmPremiumVersion002 extends SLVmPremiumVersion {
  void configure() {
    base(2, "slvm-2", "cryptographic and VM-link evolution", "sleela-virtual-machine/002", "crypto provider");
    composeThrough(2);
    // default profile tuning for this generation (user-editable in setup/conference)
    profile.setVerbosity(SLVmConfig.VERBOSITY_NORMAL);
  }
}
