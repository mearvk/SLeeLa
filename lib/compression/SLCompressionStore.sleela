<< lib/compression/SLCompressionStore.sleela
   SLeeLa Standard Library Definition.
   Definition: Store (raw) algorithm class — the SLeeLa-facing handle to algorithm id 0. >>
#sleela 2.5
material;
< Family: compression. Individual algorithm class for Store (raw), mirroring >
< compression/compressors/store/ and the registry entry in >
< sleela_compression_manager.h. SLeeLa never calls an algorithm directly; the >
< SLCompressionLoader loads this plugin by id and dispatches >
< compress/decompress. This class is the metadata + capability contract for >
< that plugin. >
<  >
< Handler state codes: 0 native, 1 backend, 2 recognized, 3 container. >
class SLCompressionStore {
  < Registry identity (mirrors sleela_compressor_handler). >
  int id() { return 0; }
  String name() { return "Store (raw)"; }
  String mime() { return "application/octet-stream"; }
  String extensions() { return ".bin"; }

  < Capability state: 0 == native. >
  int state() { return 0; }
  String stateName() { return "native"; }

  < Direction support advertised by the plugin vtable. >
  boolean canCompress() { return true; }
  boolean canDecompress() { return true; }

  < Native algorithms implement compress/decompress in-package (no external backend). >
  boolean isNative() { return true; }
  < A backend adapter must be registered before a backend algorithm can run. >
  boolean needsBackend() { return false; }

  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  < Eleven catalogued attributes with getter/setter pairs, so a GUI, loader, or >
  < catalog can read and (where appropriate) override each algorithm's record. >
  < Values are faithful to the algorithm's real origin where publicly known. >
  String metaVersion = "1.0.0";
  int metaId = 11514;
  String metaAuthor = "SLeeLa";
  String metaDate = "2026-10-23";
  String metaCopyright = "Public domain";
  String metaTrademark = "none";
  String metaCorporation = "SLeeLa Project";
  String metaOrigin = "United States";
  String metaBirthDate = "1991";
  < maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  String metaNationalSchedule = "Identity / stored (no compression)";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
}
