  << True for negative zero: 1/-0.0 is negative infinity. >>
  boolean isNegativeZero(double d) { return d == 0.0 && 1.0 / d < 0.0; }
  double pow2(int e) {
    double r = 1.0;
    int k = e;
    while (k > 0) { r = r * 2.0; k = k - 1; }
    while (k < 0) { r = r * 0.5; k = k + 1; }
    return r;
  }
  << Unbiased binary exponent of a finite non-zero |d| (normal or subnormal),
     so that 2^e <= |d| < 2^(e+1). >>
  int binaryExponent(double d) {
    double a = d;
    if (a < 0.0) { a = 0.0 - a; }
    int e = 0;
    while (a >= 2.0) { a = a * 0.5; e = e + 1; }
    while (a < 1.0) { a = a * 2.0; e = e - 1; }
    return e;
  }
  double pow10(int e) {
    double r = 1.0;
    int k = e;
    if (k > 0) { while (k > 0) { r = r * 10.0; k = k - 1; } return r; }
    while (k < 0) { r = r * 10.0; k = k + 1; }
    return 1.0 / r;
  }
  << Round half-even to the nearest integer-valued double. >>
  double rintD(double a) {
    if (a != a || isInfinite(a)) { return a; }
    if (a >= 4503599627370496.0 || a <= -4503599627370496.0) { return a; }
    long n = (long) a;
    double f = n;
    if (f > a) { f = f - 1.0; }
    double diff = a - f;
    if (diff < 0.5) { return f; }
    if (diff > 0.5) { return f + 1.0; }
    double half = f / 2.0;
    long hn = (long) half;
    double hf = hn;
    if (hf == half) { return f; }
    return f + 1.0;
  }

  < IEEE 754 bit views, computed arithmetically (exact) >
  long doubleToRawLongBits(double value) {
