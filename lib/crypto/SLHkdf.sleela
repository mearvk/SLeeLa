/*
 * lib/crypto/SLHkdf.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLHkdf used within the crypto library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. HKDF extract-and-expand KDF (RFC 5869) over HMAC-SHA-256. Native impl crosses the VM/OS bridge to /crypto.
class SLHkdf {
  String algorithm; int outBytes; int state;
  void configure(String a){algorithm=a;} void outputSize(int n){outBytes=n;} void enable(){state=1;} void disable(){state=0;} boolean active(){return state==1;}
}
