  << Nano-of-second suffix in the Java style: 3, 6 or 9 digits, as needed. >>
  String nanoText(long nano) {
    if (nano % 1000000 == 0) { return "." + pad(nano / 1000000, 3); }
    if (nano % 1000 == 0) { return "." + pad(nano / 1000, 6); }
    return "." + pad(nano, 9);
  }
