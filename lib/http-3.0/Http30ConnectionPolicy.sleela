#sleela 2.1
/* HTTP 1.x carrier connection lifecycle defaults. */
class Http30ConnectionPolicy {
  boolean closeAfterResponse = true;
  boolean rejectIncompleteBody = true;
  boolean rejectUnsupportedTransferEncoding = true;
  boolean rejectDuplicateContentLength = true;
  boolean honorHeadWithoutSendingBody = true;
  boolean suppressBodyFor204 = true;
  boolean suppressBodyFor304 = true;
  int requestTimeoutMillis = 10000;
  int bodyTimeoutMillis = 10000;
  int idleTimeoutMillis = 10000;
  boolean safeDefaults() { return closeAfterResponse && rejectIncompleteBody && rejectUnsupportedTransferEncoding && rejectDuplicateContentLength && requestTimeoutMillis > 0 && bodyTimeoutMillis > 0; }
}
