#sleela 1.3
// Library facade for module package: telephony-skya
// Original module sources remain authoritative in the package source tree.
class AudioDeviceManager {
  String source;
  void configure(String path){source=path;}
  String path(){return source;}
  boolean available(){return source!=null;}
}
