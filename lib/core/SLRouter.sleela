/*
 * lib/core/SLRouter.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLRouter used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Router.
// Role: service. Responsibility: route selection.
class SLRouter {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
