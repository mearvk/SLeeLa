  << A monomial term coefficient * x^exponent. >>
  double coefficient;
  int exponent;
  void set(double c, int e) { coefficient = c; exponent = e; }
  double evaluate(double x) {
    double p = 1.0;
    int i = 0;
    while (i < exponent) { p = p * x; i = i + 1; }
    return coefficient * p;
  }
  double derivativeCoefficient() { return coefficient * exponent; }
}

