#sleela 2.1
/* HTTP 5.0 application frame model. Not an IETF HTTP/3 frame. */
class Http50Frame {
  int version = 5;
  int type = 0;
  int flags = 0;
  long streamId = 0;
  long requestId = 0;
  long sequence = 0;
  long payloadLength = 0;
  String payload = "";
  int FLAG_FIN = 1;
  int FLAG_ACK = 2;
  int FLAG_URGENT = 4;
  int FLAG_INCREMENTAL = 8;
  int FLAG_RESUMABLE = 16;
  int FLAG_OPTIONAL = 32;
  int DEFINED_FLAGS = 63;
  int TYPE_OPEN = 1;
  int TYPE_DATA = 2;
  int TYPE_END = 3;
  int TYPE_RESET = 4;
  int TYPE_WINDOW = 5;
  int TYPE_PING = 6;
  int TYPE_PONG = 7;
  int TYPE_RESUME = 8;
  int TYPE_CAPSULE = 9;
  int TYPE_FRIENDS_PACK = 10;
  int TYPE_BONUS_OFFER = 11;
  int TYPE_FP_UPDATE = 12;
  int TYPE_AUDIT = 13;
  boolean hasKnownType() { return type >= TYPE_OPEN && type <= TYPE_AUDIT; }
  boolean hasOnlyDefinedFlags() { return flags >= 0 && (flags & 65472) == 0; }
  boolean isValid() {
    return version == 5 && hasKnownType() && hasOnlyDefinedFlags() &&
      streamId >= 0 && requestId >= 0 && sequence >= 0 &&
      payloadLength >= 0 && payloadLength <= 16777216 &&
      payload != null;
  }
  boolean requiresNativeCodecValidation() { return true; }
}
