/*
 * lib/crypto/SLSha256.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLSha256 used within the crypto library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. SHA-256 (FIPS 180-4). Native impl crosses the VM/OS bridge to /crypto.
class SLSha256 {
  String algorithm; int state; void configure(String a){algorithm=a;} void enable(){state=1;} void disable(){state=0;} boolean active(){return state==1;}
}
