/*
 * lib/filesystem/SLPathResolver.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLPathResolver used within the filesystem library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: filesystem. Native implementation crosses an explicit VM/OS bridge.
class SLPathResolver {
  String path; int state; void configure(String p){path=p;} void open(){state=1;} void close(){state=0;} boolean active(){return state==1;}
}
