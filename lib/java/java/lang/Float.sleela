    if (sign == 1) { bits = bits - 2147483648; }
    return (int) bits;
  }
  int floatToIntBits(double value) {
    if (value != value) { return 2143289344; }
    return floatToRawIntBits(value);
  }
  double intBitsToFloat(int bits) {
    long b = bits;
    boolean neg = b < 0;
    if (neg) { b = b + 2147483648; }
    long be = b / 8388608;
    long mant = b % 8388608;
    double r = 0.0;
    if (be == 255) {
      if (mant == 0) { r = posInf(); } else { return nan(); }
    } else {
      double m = mant;
