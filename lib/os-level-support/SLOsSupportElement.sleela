<< SLeeLa Standard Library Definition.
  Definition: A typed-by-convention catalogue element connecting a SLeeLa source
  term, capability group, VM-facing operation, native ABI symbol, platform
  backend and effect classification. This is declarative metadata; it does not
  itself perform native calls or grant operating-system authority. >>
#sleela 2.5
material;

class SLOsSupportElement {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override each record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 0;
  String metaAuthor = "mearvk";
  String metaDate = "2026-11-05";
  String metaCopyright = "Copyright mearvk LLC";
  String metaTrademark = "none";
  String metaCorporation = "mearvk LLC";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-05";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 8;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String value) { metaVersion = value; }
  int getMetaId() { return metaId; }
  void setMetaId(int value) { metaId = value; }
  String getMetaAuthor() { return metaAuthor; }
  void setMetaAuthor(String value) { metaAuthor = value; }
  String getMetaDate() { return metaDate; }
  void setMetaDate(String value) { metaDate = value; }
  String getMetaCopyright() { return metaCopyright; }
  void setMetaCopyright(String value) { metaCopyright = value; }
  String getMetaTrademark() { return metaTrademark; }
  void setMetaTrademark(String value) { metaTrademark = value; }
  String getMetaCorporation() { return metaCorporation; }
  void setMetaCorporation(String value) { metaCorporation = value; }
  String getMetaOrigin() { return metaOrigin; }
  void setMetaOrigin(String value) { metaOrigin = value; }
  String getMetaBirthDate() { return metaBirthDate; }
  void setMetaBirthDate(String value) { metaBirthDate = value; }
  int getMetaScienceRating() { return metaScienceRating; }
  void setMetaScienceRating(int value) { metaScienceRating = value; }
  String getMetaNationalSchedule() { return metaNationalSchedule; }
  void setMetaNationalSchedule(String value) { metaNationalSchedule = value; }
  String elementName = "";
  String groupTerm = "";
  String vmElementTerm = "";
  String vmOpcodeTerm = "";
  String portableSymbol = "";
  String nativeSymbol = "";
  String platformTerm = "CommonBackend";
  String effectTerm = "ReadOnlyQuery";
  String implementationStatus = "Planned";
  String resultTerm = "StatusAndValue";
  int argumentCount = 0;
  int capabilityRequired = 0;

  void configure(String name, String group, String vmTerm,
                 String opcode, String portable, String nativeSym,
                 String platform, String effect, String status,
                 int arity, int capability) {
    elementName = name;
    groupTerm = group;
    vmElementTerm = vmTerm;
    vmOpcodeTerm = opcode;
    portableSymbol = portable;
    nativeSymbol = nativeSym;
    platformTerm = platform;
    effectTerm = effect;
    implementationStatus = status;
    argumentCount = arity;
    capabilityRequired = capability;
  }

  String getElementName() { return elementName; }
  String getGroupTerm() { return groupTerm; }
  String getVMElementTerm() { return vmElementTerm; }
  String getVMOpcodeTerm() { return vmOpcodeTerm; }
  String getPortableSymbol() { return portableSymbol; }
  String getNativeSymbol() { return nativeSymbol; }
  String getPlatformTerm() { return platformTerm; }
  String getEffectTerm() { return effectTerm; }
  String getImplementationStatus() { return implementationStatus; }
  String getResultTerm() { return resultTerm; }
  int getArgumentCount() { return argumentCount; }
  int getCapabilityRequired() { return capabilityRequired; }

  void setResultTerm(String value) { resultTerm = value; }

  boolean isReadOnly() {
    return effectTerm == "ReadOnlyQuery" ||
           effectTerm == "ReadOnlyEnumeration";
  }

  boolean isStateChanging() {
    return effectTerm == "StateChangingOperation";
  }

  boolean isPlatformSpecific() {
    return platformTerm != "CommonBackend";
  }

  boolean isImplemented() {
    return implementationStatus == "Implemented";
  }
}
