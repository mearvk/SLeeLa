/*
 * lib/cpu/SLInterruptController.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLInterruptController — the unit that fields hardware and
 *   software interrupts (timer, I/O completion, faults, syscalls) and tells the
 *   core where to jump to service them. It holds an interrupt vector base,
 *   masks, and a pending set. This is how the OS regains control from a running
 *   program (preemption via the timer interrupt).
 *
 * Models up to 16 interrupt lines (IRQ0..IRQ15).
 *
 * Family: cpu. Pure Sleela controller.
 */
#sleela 1.3
class SLInterruptController {
  static final int LINES = 16;
  static final int IRQ_TIMER = 0;
  static final int IRQ_KEYBOARD = 1;
  static final int IRQ_DISK = 2;
  static final int IRQ_NETWORK = 3;

  int vectorBase;    // base address of the interrupt vector table
  int pendingMask;   // bitset of raised-but-unserviced lines
  int enableMask;    // bitset of enabled lines
  int serviced;

  void configure(int base) { vectorBase = base; pendingMask = 0; enableMask = 0; serviced = 0; }

  int pow2(int n) { int p = 1; int i = 0; while (i < n) { p = p * 2; i = i + 1; } return p; }
  boolean bitSet(int mask, int line) { return (mask / pow2(line)) % 2 == 1; }

  void enable(int line) { if (!bitSet(enableMask, line)) { enableMask = enableMask + pow2(line); } }
  void raise(int line) { if (bitSet(enableMask, line) && !bitSet(pendingMask, line)) { pendingMask = pendingMask + pow2(line); } }

  boolean hasPending() { return pendingMask != 0; }

  // Return the lowest-numbered pending line (highest priority), or -1 if none.
  int highestPriorityPending() {
    int line = 0;
    while (line < LINES) { if (bitSet(pendingMask, line)) { return line; } line = line + 1; }
    return -1;
  }

  // Acknowledge a line: clear it and return its handler address.
  int acknowledge(int line) {
    if (bitSet(pendingMask, line)) { pendingMask = pendingMask - pow2(line); serviced = serviced + 1; }
    return vectorBase + line;
  }

  int servicedCount() { return serviced; }
}
