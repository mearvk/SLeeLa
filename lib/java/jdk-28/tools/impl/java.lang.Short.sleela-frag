  << java.lang.Short in SLeeLa, written from the JDK 28 API specification
     (Java Source above). Java names, static modifiers and return types are
     kept. The VM has no short primitive: a Short value is an int held inside the
     Java range -32768..32767, and slNarrow wraps any int back into it with the
     two's-complement rule Java applies on overflow. parseShort, valueOf and decode
     go through Integer and then range-check, throwing NumberFormatException
     with the JDK messages. >>
  short value;

  public Short(short value) { this.value = value; }
  @throwable("java.lang.NumberFormatException")
  public Short(java.lang.String s) { this.value = parseShort(s, 10); }

  static int slNarrow(long v) {
    long m = v % 65536;
    if (m < 0) { m = m + 65536; }
    if (m > 32767) { m = m - 65536; }
    return m;
  }
  static int slRange(int i, java.lang.String s, int radix) {
    if (i < -32768 || i > 32767) {
      throw new NumberFormatException("Value out of range. Value:\"" + s + "\" Radix:" + radix);
    }
    return i;
  }

  < instance members >
  public byte byteValue() { long m = value % 256; if (m < 0) { m = m + 256; } if (m > 127) { m = m - 256; } return m; }
  public short shortValue() { return slNarrowShort(value); }
  public int intValue() { return value; }
  public long longValue() { return value; }
  public float floatValue() { double d = value; return d; }
  public double doubleValue() { double d = value; return d; }
  public java.lang.String toString() { return Integer.toString(value); }
  public int hashCode() { return value; }
  public boolean equals(java.lang.Object obj) {
    if (obj instanceof Short) { Short o = (Short) obj; return o.value == value; }
    return false;
  }
  public int compareTo(java.lang.Short anotherShort) { Short o = (Short) anotherShort; return compare(value, o.value); }

  < static members >
  public static java.lang.String toString(short x) { return Integer.toString(x); }
  public static int hashCode(short value) { return value; }
  public static int compare(short x, short y) { return x - y; }
  public static int compareUnsigned(short x, short y) { return toUnsignedInt(x) - toUnsignedInt(y); }
  public static int toUnsignedInt(short x) { return x & 65535; }
  public static long toUnsignedLong(short x) { return x & 65535; }
  public static short reverseBytes(short i) {
    int lo = i & 255;
    int hi = (i >> 8) & 255;
    return slNarrowShort(lo * 256 + hi);
  }
  static int slNarrowShort(long v) {
    long m = v % 65536;
    if (m < 0) { m = m + 65536; }
    if (m > 32767) { m = m - 65536; }
    return m;
  }
  @throwable("java.lang.NumberFormatException")
  public static short parseShort(java.lang.String s, int radix) {
    int i = Integer.parseInt(s, radix);
    return slRange(i, s, radix);
  }
  @throwable("java.lang.NumberFormatException")
  public static short parseShort(java.lang.String s) { return parseShort(s, 10); }
  @throwable("java.lang.NumberFormatException")
  public static java.lang.Short valueOf(java.lang.String s, int radix) { return new Short(parseShort(s, radix)); }
  @throwable("java.lang.NumberFormatException")
  public static java.lang.Short valueOf(java.lang.String s) { return new Short(parseShort(s, 10)); }
  public static java.lang.Short valueOf(short x) { return new Short(x); }
  @throwable("java.lang.NumberFormatException")
  public static java.lang.Short decode(java.lang.String nm) {
    Integer boxed = (Integer) Integer.decode(nm);
    int i = boxed.intValue();
    if (i < -32768 || i > 32767) {
      throw new NumberFormatException("Value " + i + " out of range from input " + nm);
    }
    return new Short(i);
  }
