/*
 * lib/video/VideoFormat.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type VideoFormat used within the video library family.
 */
#sleela 1.3
class VideoFormat {
  int width;
  int height;
  int frameRateNumerator;
  int frameRateDenominator;
  VideoPixelFormat pixelFormat;
  boolean valid(){return width>0 && height>0 && frameRateNumerator>0 && frameRateDenominator>0 && pixelFormat!=null;}
}