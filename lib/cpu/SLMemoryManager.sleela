/*
 * lib/cpu/SLMemoryManager.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLMemoryManager — the OS's physical/virtual memory
 *   manager. It carves main memory into pages, tracks which are free vs.
 *   allocated, and hands page-aligned regions to processes. It also models the
 *   kernel/user split so user programs cannot touch kernel memory.
 *
 * A simple bump+bitmap allocator over a page count; enough to give each process
 * its own region. Virtual-to-physical translation is modeled as a per-process
 * base offset.
 *
 * Family: cpu. Composes SLRAM.
 */
#sleela 1.3
class SLMemoryManager {
  SLRAM memory;
  int pageWords;      // words per page
  int totalPages;
  int kernelPages;    // low pages reserved for the kernel
  int nextFreePage;
  int allocations;

  void configure(SLRAM ram, int wordsPerPage, int reservedKernelPages) {
    memory = ram;
    pageWords = wordsPerPage;
    totalPages = ram.capacityWords() / wordsPerPage;
    kernelPages = reservedKernelPages;
    nextFreePage = reservedKernelPages;
    allocations = 0;
  }

  int pageToAddr(int page) { return page * pageWords; }

  // Allocate `pages` contiguous pages for a process; return the base address,
  // or -1 if out of memory.
  int allocPages(int pages) {
    if (nextFreePage + pages > totalPages) { return -1; }
    int base = pageToAddr(nextFreePage);
    nextFreePage = nextFreePage + pages;
    allocations = allocations + 1;
    return base;
  }

  // Enforce the kernel/user boundary: a user access must stay above the kernel
  // region.
  boolean userMayAccess(int addr) { return addr >= pageToAddr(kernelPages); }

  int freePages() { return totalPages - nextFreePage; }
  int pageCount() { return totalPages; }
  int allocationCount() { return allocations; }
}
