  double sqrt(double x) {
    if (x <= 0.0) { return 0.0; }
    double g = x;
    int i = 0;
    while (i < 60) { g = (g + x / g) / 2.0; i = i + 1; }
    return g;
  }
  double re;
  double im;
  void set(double r, double i) { re = r; im = i; }
  void add(SLComplex o, SLComplex out) { out.re = re + o.re; out.im = im + o.im; }
  void multiply(SLComplex o, SLComplex out) {
    out.re = re * o.re - im * o.im;
    out.im = re * o.im + im * o.re;
  }
  double modulus() { return sqrt(re * re + im * im); }
  void conjugate(SLComplex out) { out.re = re; out.im = 0.0 - im; }
