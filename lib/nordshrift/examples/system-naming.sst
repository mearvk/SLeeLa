#sst 2.0
sheet NordshriftNamedGroups {
  system "Payments" {
    group "finance.payments";
    name "PaymentGateway";
  }
  system "Settlement" {
    group "finance.settlement";
    name "SettlementLedger";
  }
  system "Network" {
    group "network.edge";
    name "PaymentRouter";
  }
  target sleela;
}
