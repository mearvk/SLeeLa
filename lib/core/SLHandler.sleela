/*
 * lib/core/SLHandler.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLHandler used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Handler.
// Role: runtime. Responsibility: callback/event handler contract.
class SLHandler {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
