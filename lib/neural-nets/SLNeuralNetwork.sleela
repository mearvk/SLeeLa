<< SLeeLa lifecycle contract for the opaque slnn_network handle.
   This front-end class never fabricates native ownership. Prediction and
   training return STATUS_NATIVE_ADAPTER_REQUIRED until a host adapter is
   registered by the embedding runtime. >>
#sleela 3.0
material;
class SLNeuralNetwork {
  static final int STATUS_OK = 0;
  static final int STATUS_INVALID_ARGUMENT = 1;
  static final int STATUS_OUT_OF_MEMORY = 2;
  static final int STATUS_INVALID_STATE = 3;
  static final int STATUS_SIZE_MISMATCH = 4;
  static final int STATUS_NUMERIC = 5;
  static final int STATUS_NATIVE_ADAPTER_REQUIRED = 6;

  boolean configured = false;
  int inputCount = 0;
  int outputCount = 0;

  int configure(SLNeuralNetworkConfig config) {
    if (config == null || !config.valid()) { return STATUS_INVALID_ARGUMENT; }
    int[] sizes = config.getLayerSizes();
    inputCount = sizes[0];
    outputCount = sizes[sizes.length - 1];
    configured = true;
    return STATUS_OK;
  }

  boolean isConfigured() { return configured; }
  boolean isNativeReady() { return false; }
  int getInputCount() { return inputCount; }
  int getOutputCount() { return outputCount; }

  int predict(double[] input, double[] output) {
    if (!configured || input == null || output == null) { return STATUS_INVALID_ARGUMENT; }
    if (input.length != inputCount || output.length != outputCount) { return STATUS_SIZE_MISMATCH; }
    return STATUS_NATIVE_ADAPTER_REQUIRED;
  }

  int trainSample(double[] input, double[] target, double learningRate) {
    if (!configured || input == null || target == null || learningRate <= 0.0) { return STATUS_INVALID_ARGUMENT; }
    if (input.length != inputCount || target.length != outputCount) { return STATUS_SIZE_MISMATCH; }
    return STATUS_NATIVE_ADAPTER_REQUIRED;
  }

  void close() {
    configured = false;
    inputCount = 0;
    outputCount = 0;
  }
}
