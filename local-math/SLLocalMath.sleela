  void shape(int r, int c) { rows = r; cols = c; }
  double at(double[] m, int r, int c) { return m[r * cols + c]; }
  void put(double[] m, int r, int c, double v) { m[r * cols + c] = v; }
  int getRows() { return rows; }
  int getCols() { return cols; }
  < Identity matrix of order n written into `m`. >
  void identity(double[] m, int n) {
    int i = 0;
    while (i < n * n) { m[i] = 0.0; i = i + 1; }
    int d = 0;
    while (d < n) { m[d * n + d] = 1.0; d = d + 1; }
  }
}

