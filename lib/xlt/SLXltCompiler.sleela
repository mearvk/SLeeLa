/*
 * lib/xlt/SLXltCompiler.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLXltCompiler — the compiler for the XLT (.xlt) CPU-model
 *   format. It gives XLT the "comprehensive, ordered, orthogonal, system
 *   interpretation" the format requires: it reads an SLXltSource's declared
 *   parts IN DOCUMENT ORDER, resolves each against the real parts bin
 *   (SLComponentCatalog) and CPU SKU roster, checks that each part both EXISTS
 *   (resolves) and is AGREEABLE to the rest of the design (orthogonal, mutually
 *   consistent), and — when everything is congruent — assembles a real
 *   SLExecutorBuild. No new keyword and no setters are involved: document
 *   orthogonality alone carries the integrity.
 *
 *   Compilation returns an SLXltBuildResult that is exactly one of:
 *     - SUCCESS + a list of what was built, or
 *     - a CONGRUENCE report of why it could not be built (a missing part, or a
 *       part not agreeable to design).
 *
 *   Resolution model: recognition is driven by an explicit SLXltProducerRegistry
 *   (a new part becomes recognizable by registering it, not by editing the
 *   compiler); the registry also supplies the channel attributes the agreement
 *   check needs. Since the surface language cannot `new` a class from a runtime
 *   string, once a ref is recognized the compiler maps it to the concrete
 *   SLComponentCatalog call. An unregistered ref is a "missing part" congruence;
 *   a registered ref that conflicts with another part is a "not agreeable" one.
 *
 * Family: xlt. Consumes SLXltSource; composes SLComponentCatalog +
 *   SLExecutorBuild; produces SLXltBuildResult. Parallels Nordshrift for SST.
 */
#sleela 2.1
class SLXltCompiler {
  SLComponentCatalog parts;
  SLXltProducerRegistry registry;   // what refs are recognized, per slot
  SLExecutorBuild build;      // the real assembly produced on success
  int memChannelsWanted;      // channels the declared memory needs (for agreement)
  int boardChannels;          // channels the declared board routes (0 = no board)

  void configure() {
    parts = new SLComponentCatalog();
    registry = new SLXltProducerRegistry(); registry.configure();
    memChannelsWanted = 1; boardChannels = 0;
  }

  // Allow callers to register additional producers before compiling, so a new
  // part becomes recognizable without editing the compiler.
  void registerProducer(int slot, String ref, int attr) { registry.register(slot, ref, attr); }

  // Compile an .xlt source to a build result. Ordered, orthogonal, congruent.
  SLXltBuildResult compile(SLXltSource src) {
    SLXltBuildResult res = new SLXltBuildResult();
    res.configure(src.name());
    build = new SLExecutorBuild();
    build.configure(src.name());
    memChannelsWanted = 1; boardChannels = 0;

    // ---- 1. CPU (required) ----
    if (src.cpu() == "") {
      res.recordReason(res.REASON_MISSING, "no cpu declared: a model requires a CPU");
    } else if (registry.known(registry.SLOT_CPU, src.cpu()) == false) {
      res.recordReason(res.REASON_MISSING, "cpu '" + src.cpu() + "' is not a registered SKU");
    } else {
      res.recordBuilt("cpu: " + src.cpu());
    }

    // ---- 2. board (optional) ----
    if (src.hasBoard()) {
      if (registry.known(registry.SLOT_BOARD, src.board()) == false) {
        res.recordReason(res.REASON_MISSING, "board '" + src.board() + "' is not a registered motherboard");
      } else {
        boardChannels = registry.attrOf(registry.SLOT_BOARD, src.board());
        build.installBoard(boardFor(src.board()));
        res.recordBuilt("board: " + src.board() + " (" + boardChannels + "-channel)");
      }
    }

    // ---- 3. memory (required) ----
    if (src.memory() == "") {
      res.recordReason(res.REASON_MISSING, "no memory declared: a model requires main memory");
    } else if (registry.known(registry.SLOT_MEMORY, src.memory()) == false) {
      res.recordReason(res.REASON_MISSING, "memory '" + src.memory() + "' is not a registered module");
    } else {
      memChannelsWanted = registry.attrOf(registry.SLOT_MEMORY, src.memory());
      SLMemoryModule mod = memoryFor(src.memory(), src.memoryCapacity());
      // Agreement check: memory channels must fit the board's routed channels.
      if (boardChannels > 0 && memChannelsWanted > boardChannels) {
        res.recordReason(res.REASON_DISAGREES,
          "memory '" + src.memory() + "' needs " + memChannelsWanted +
          " channels but board '" + src.board() + "' routes only " + boardChannels);
      } else {
        build.installMemory(mod);
        res.recordBuilt("memory: " + src.memory() + " x" + src.memoryCapacity() + " MiB");
        // ---- 3b. cadence overlay (optional, rides the memory) ----
        if (src.hasCadence()) {
          if (registry.known(registry.SLOT_CADENCE, src.cadence()) == false) {
            res.recordReason(res.REASON_MISSING, "cadence '" + src.cadence() + "' is not a registered generation");
          } else {
            int tech = registry.attrOf(registry.SLOT_CADENCE, src.cadence());
            SLMemoryInterface iface = parts.memInterface(src.cadence() + "-cadence", mod, tech);
            build.installMemoryInterface(iface);
            res.recordBuilt("cadence: refreshes as " + src.cadence());
          }
        }
      }
    }

    // ---- 4. storage (optional) ----
    if (src.hasStorage()) {
      if (registry.known(registry.SLOT_STORAGE, src.storage()) == false) {
        res.recordReason(res.REASON_MISSING, "storage '" + src.storage() + "' is not a registered device");
      } else {
        build.installStorage(storageFor(src.storage()));
        res.recordBuilt("storage: " + src.storage());
      }
    }

    // ---- 5. bus (optional) ----
    if (src.hasBus()) {
      if (registry.known(registry.SLOT_BUS, src.bus()) == false) {
        res.recordReason(res.REASON_MISSING, "bus '" + src.bus() + "' is not a registered system bus");
      } else {
        build.installBus(busFor(src.bus()));
        res.recordBuilt("bus: " + src.bus());
      }
    }

    res.seal();
    return res;
  }

  SLExecutorBuild assembled() { return build; }

  // ---------------- ref -> real catalog producer mappings ------------------
  // Recognition and channel attributes come from SLXltProducerRegistry; these
  // methods only map an already-recognized ref to the concrete catalog call
  // (the surface language cannot `new` a type from a runtime string).
  SLMemoryModule memoryFor(String ref, int capMiB) {
    if (ref == "ddr_400")    { return parts.ddr_400(capMiB); }
    if (ref == "ddr2_800")   { return parts.ddr2_800(capMiB); }
    if (ref == "ddr3_1600")  { return parts.ddr3_1600(capMiB); }
    if (ref == "ddr4_3200")  { return parts.ddr4_3200(capMiB); }
    if (ref == "ddr5_6000")  { return parts.ddr5_6000(capMiB); }
    if (ref == "ddr5_6400")  { return parts.ddr5_6400(capMiB); }
    if (ref == "ddr5_6400_quadChannel") { return parts.ddr5_6400_quadChannel(capMiB); }
    if (ref == "ddr5_6400_octaChannel") { return parts.ddr5_6400_octaChannel(capMiB); }
    if (ref == "sdram_pc100") { return parts.sdram_pc100(capMiB); }
    if (ref == "dram_fpm")    { return parts.dram_fpm(capMiB); }
    return parts.sram_fast(capMiB);
  }

  SLMotherboard boardFor(String ref) {
    if (ref == "wrx90") { return parts.wrx90(); }
    return parts.trx50();
  }

  SLStorageDevice storageFor(String ref) {
    if (ref == "nvmeGen3") { return parts.nvmeGen3(); }
    if (ref == "sataSsd")  { return parts.sataSsd(); }
    if (ref == "sataHdd")  { return parts.sataHdd(); }
    return parts.nvmeGen4();
  }

  SLSystemBus busFor(String ref) {
    if (ref == "pcieGen4x16") { return parts.pcieGen4x16(); }
    if (ref == "pcieGen3x16") { return parts.pcieGen3x16(); }
    if (ref == "pci33")       { return parts.pci33(); }
    if (ref == "isa")         { return parts.isa(); }
    if (ref == "agp8x")       { return parts.agp8x(); }
    return parts.pcieGen5x16();
  }
}
