/*
 * lib/codecs/SLCodecPcmWav.sleela
 * SLeeLa Standard Library Definition.
 * Definition: PCM/WAV codec class — the SLeeLa-facing handle to codec id 0.
 */
#sleela 1.3
// Family: codecs. Individual codec class for PCM/WAV (uncompressed PCM in a
// RIFF/WAVE container), mirroring codecs/codecs/pcm_wav/ and the registry entry
// in sleela_codec_manager.h. SLeeLa never calls a codec directly; the
// SLCodecLoader loads this plugin by id and dispatches decode/encode. This
// class is the metadata + capability contract for that plugin.
//
// Handler state codes: 0 native, 1 backend, 2 recognized, 3 container, 4 event.
class SLCodecPcmWav {
  // Registry identity (mirrors sleela_codec_handler).
  int id() { return 0; }
  String name() { return "PCM/WAV"; }
  String mime() { return "audio/wav"; }
  String extensions() { return ".wav"; }

  // Capability state: 0 == native (encode/decode live in-package).
  int state() { return 0; }
  String stateName() { return "native"; }

  // Direction support advertised by the plugin vtable.
  boolean canDecode() { return true; }
  boolean canEncode() { return true; }

  // Native codecs implement encode/decode in-package (no external backend).
  boolean isNative() { return true; }
  // A backend adapter must be registered before this codec can decode/encode.
  boolean needsBackend() { return false; }

  // ---- Descriptive metadata (version 1.11 nested-friendly accessors) ----
  // Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
  // or catalog can read and (where appropriate) override each codec's record.
  // Values are faithful to the codec's real origin where publicly known.
  String metaVersion = "1.0.0";
  int metaId = 0;
  String metaAuthor = "IBM/Microsoft";
  String metaDate = "2026-09-28";
  String metaCopyright = "Public domain (format)";
  String metaTrademark = "none";
  String metaCorporation = "Microsoft Corporation";
  String metaOrigin = "United States";
  String metaBirthDate = "1991";
  int metaScienceRating = 10;        // maturity/robustness on a 1..10 scale
  String metaNationalSchedule = "ITU-T G.711-adjacent / RIFF WAVE";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
}
