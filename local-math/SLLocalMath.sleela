  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  << A graph adjacency matrix stored row-major (n x n). 1 (or a weight) marks an
     edge. Supports degree and neighbour queries. >>
  int n;
  void configure(int size) { n = size; }
  void addEdge(double[] m, int u, int v) { m[u * n + v] = 1.0; m[v * n + u] = 1.0; }
  boolean adjacent(double[] m, int u, int v) { return m[u * n + v] != 0.0; }
  int degree(double[] m, int u) {
    int d = 0;
    int v = 0;
    while (v < n) { if (m[u * n + v] != 0.0) { d = d + 1; } v = v + 1; }
    return d;
  }
}

