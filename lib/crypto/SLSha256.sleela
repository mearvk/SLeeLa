<< lib/crypto/SLSha256.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines the SLeeLa standard-library type SLSha256 used within the crypto library family. >>
#sleela 2.5
material;
< Unified SLeeLa SDK front-end object. >
< Family: crypto. SHA-256 (FIPS 180-4). Native impl crosses the VM/OS bridge to /crypto. >
<  >
< SECURITY NOTE: the native /crypto backend is a correct, specification-faithful >
< REFERENCE implementation. It is NOT guaranteed constant-time and is NOT >
< side-channel resistant. For data that must be protected use an audited library >
< (BoringSSL, OpenSSL, libsodium, liboqs). See crypto/README.md. >
class SLSha256 {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10279;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-10-16";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-06";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  < Status codes mirror slcrypto_status in crypto/include/slcrypto.h. >
  static final int OK = 0;
  static final int ERR_PARAM = -1;
  static final int ERR_AUTH = -2;
  static final int ERR_UNIMPL = -3;

  < Native digest length for SHA-256. >
  static final int DIGEST_LEN = 32;

  String algorithm;
  < 1 = enabled, 0 = disabled >
  int state;
  < 1 once a supported algorithm name has been accepted >
  int configured;
  < 1 when the native /crypto backend is linked and ready >
  int backend;

  < Accept only the algorithm name this facade bridges to. >
  int configure(String a) {
    if (a == null) { configured = 0; return ERR_PARAM; }
    if (a == "SHA-256") { algorithm = a; configured = 1; return OK; }
    configured = 0;
    return ERR_PARAM;
  }

  < Declare native backend availability (set by the VM/OS bridge binding). >
  void bindBackend(int ready) { if (ready == 1) { backend = 1; } else { backend = 0; } }
  boolean backendReady() { return backend == 1; }

  void enable() { state = 1; }
  void disable() { state = 0; }

  < active() is only true when enabled, configured, AND the native backend is ready, >
  < so it cannot report usable while the computation path is unavailable. >
  boolean active() { return state == 1 && configured == 1 && backend == 1; }

  int digestLength() { return DIGEST_LEN; }

  < One-shot hash over data. Models slc_sha256(); returns a status code. >
  int digest(String data) {
    if (active() == false) { return ERR_UNIMPL; }
    if (data == null) { return ERR_PARAM; }
    return OK;
  }

  String securityNote() {
    return "Reference-grade: not constant-time, not side-channel resistant; use an audited library in production.";
  }
}
