/*
 * lib/cpu/components/SLSystemBus.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLSystemBus — a selectable system/expansion bus for a
 *   Sleela executor build: ISA, PCI, AGP, PCIe (by generation and lane count),
 *   or a front-side bus. It carries the real spec that bounds how fast the CPU,
 *   memory, and devices talk to each other: bus clock, data width, and the
 *   resulting peak bandwidth. The bus can cap an otherwise-fast RAM/storage
 *   choice, so it belongs in the build.
 *
 * Family: cpu.components. Selected via SLComponentCatalog.
 */
#sleela 1.3
class SLSystemBus {
  static final int BUS_ISA  = 0;
  static final int BUS_PCI  = 1;
  static final int BUS_AGP  = 2;
  static final int BUS_PCIE = 3;
  static final int BUS_FSB  = 4;

  String partName;
  int busType;
  int clockMHz;
  int widthBits;       // data path width
  int lanes;           // for PCIe (1 otherwise)
  int perLaneMBs;      // per-lane rate for serial buses (PCIe), 0 for parallel

  void configure(String name, int type, int clock, int width, int laneCount, int laneMBs) {
    partName = name; busType = type; clockMHz = clock; widthBits = width;
    lanes = (laneCount < 1) ? 1 : laneCount; perLaneMBs = laneMBs;
  }

  // Peak bandwidth in MB/s. Serial buses (PCIe) use per-lane × lanes; parallel
  // buses use clock × bus bytes.
  int peakBandwidthMBs() {
    if (perLaneMBs > 0) { return perLaneMBs * lanes; }
    return clockMHz * (widthBits / 8);
  }

  String name()      { return partName; }
  int clock()        { return clockMHz; }
  int width()        { return widthBits; }
  int laneCount()    { return lanes; }

  String busName() {
    if (busType == BUS_ISA)  { return "ISA"; }
    if (busType == BUS_PCI)  { return "PCI"; }
    if (busType == BUS_AGP)  { return "AGP"; }
    if (busType == BUS_PCIE) { return "PCIe"; }
    if (busType == BUS_FSB)  { return "FSB"; }
    return "bus";
  }
}
