# ============================================================================
# conversion.model -- the Java -> SLeeLa conversion subject (declarative model)
#
# Like math and physics, conversion is a SUBJECT: one folder, one model, one
# set of laws. Math owns arithmetic; physics owns mechanics; conversion owns the
# laws under which Java source becomes functionally equivalent SLeeLa source.
#
# The model is DATA. The sleelactl converter (sleelactl/convert) holds no Java
# semantic knowledge of its own: every typing rule, operator lowering and cast
# below is read from this file, and the converter FAILS CLOSED when a construct
# is not covered here (it never guesses, it never emits a near-miss).
#
# Normative sources: The Java Language Specification (JLS) chapters 4 (types),
# 5 (conversions and promotion), 14 (statements), 15 (expressions).
# The executable halves of the laws live in lib/java/JavaOperands.sleela and
# are checked line for line against a real JDK by examples/java/differential.
#
# Record grammar: one record per line, fields separated by whitespace, the last
# field of a record takes the rest of the line (so templates may contain spaces).
# '#' starts a comment line.
#   model <name> <revision>
#   type <java> <sleela> <kind> <rank>
#         kind: integral | floating | boolean | text | reference | void
#         rank: numeric promotion order (higher wins), '-' when not numeric
#   box <boxed class> <primitive>
#   promote <primitive> <promoted to>            (JLS 5.6 unary promotion)
#   binop <operand class> <java operator> <template>
#   unop <operand class> <java operator> <template>
#   cast <from> <to> <template>                  ('=' template = plain assignment)
#   widen <from> <to>                            (implicit, value preserving)
#   compound <operand class> <java operator>     (x op= y is x = (T)(x op y))
#   tostr <primitive> <template>                 (string conversion, JLS 5.1.11)
#   incr <operand class> <template for +1> ;; <template for -1>
#   ret <owner> <method> <return type or @arg0>
#   field <owner> <name> <type>
#   call <java owner.method> <sleela call template>   ($args)
#   unsupported <construct> <reason>             (diagnostic text, fail closed)
#
# Template variables: $a $b operands, $t target type, $recv receiver, $args
# comma-joined argument list, $0 $1 ... individual arguments.
# ============================================================================
model java-to-sleela 1.0.0

# ---- 1. Types (JLS 4). SLeeLa int is a 64-bit slot, so the int-width types are
#         kept as their own names and wrapped by the templates below.
type boolean boolean boolean -
type byte byte integral 1
type short short integral 2
type char char integral 2
type int int integral 3
type long long integral 4
type float float floating 5
type double double floating 6
type void void void -
type String String text -

# ---- 2. Boxing (JLS 5.1.7/5.1.8): arithmetic sees the primitive.
box Byte byte
box Short short
box Character char
box Integer int
box Long long
box Double double
box Boolean boolean

# ---- 3. Unary promotion (JLS 5.6.1): byte/short/char compute as int.
promote byte int
promote short int
promote char int
promote int int
promote long long
promote double double

# ---- 4. Implicit widening (JLS 5.1.2): value preserving, plain assignment.
widen byte short
widen byte int
widen byte long
widen byte double
widen short int
widen short long
widen short double
widen char int
widen char long
widen char double
widen int long
widen int double

# ---- 5. Binary operators on promoted operand classes (JLS 15.17-15.24).
#         int: 32-bit wrap; long: 64-bit native; double: IEEE binary64.
binop int + JavaOperands.addInt($a, $b)
binop int - JavaOperands.subInt($a, $b)
binop int * JavaOperands.mulInt($a, $b)
binop int / JavaOperands.divInt($a, $b)
binop int % JavaOperands.remInt($a, $b)
binop int << JavaOperands.shlInt($a, $b)
binop int >> JavaOperands.shrInt($a, $b)
binop int >>> JavaOperands.ushrInt($a, $b)
binop int & ($a & $b)
binop int | ($a | $b)
binop int ^ ($a ^ $b)
binop int < ($a < $b)
binop int <= ($a <= $b)
binop int > ($a > $b)
binop int >= ($a >= $b)
binop int == ($a == $b)
binop int != ($a != $b)
binop long + ($a + $b)
binop long - ($a - $b)
binop long * ($a * $b)
binop long / JavaOperands.divLong($a, $b)
binop long % JavaOperands.remLong($a, $b)
binop long << JavaOperands.shlLong($a, $b)
binop long >> JavaOperands.shrLong($a, $b)
binop long >>> JavaOperands.ushrLong($a, $b)
binop long & ($a & $b)
binop long | ($a | $b)
binop long ^ ($a ^ $b)
binop long < ($a < $b)
binop long <= ($a <= $b)
binop long > ($a > $b)
binop long >= ($a >= $b)
binop long == ($a == $b)
binop long != ($a != $b)
binop double + ($a + $b)
binop double - ($a - $b)
binop double * ($a * $b)
binop double / ($a / $b)
binop double < ($a < $b)
binop double <= ($a <= $b)
binop double > ($a > $b)
binop double >= ($a >= $b)
binop double == ($a == $b)
binop double != ($a != $b)
binop boolean && ($a && $b)
binop boolean || ($a || $b)
binop boolean == ($a == $b)
binop boolean != ($a != $b)
binop boolean & ($a & $b)
binop boolean | ($a | $b)
binop boolean ^ ($a != $b)
binop text + ($a + $b)
binop text == ($a == $b)
binop text != ($a != $b)
binop reference == ($a == $b)
binop reference != ($a != $b)

# ---- 6. Unary operators.
unop int - JavaOperands.negInt($a)
unop int + $a
unop int ~ (~$a)
unop long - (0 - $a)
unop long + $a
unop long ~ (~$a)
unop double - (0.0 - $a)
unop double + $a
unop boolean ! (!$a)

# ---- 7. Casts (JLS 5.1.3 narrowing, 5.1.2 widening). '=' means plain.
cast int byte JavaOperands.toByte($a)
cast int short JavaOperands.toShort($a)
cast int char JavaOperands.toChar($a)
cast int int =
cast int long =
cast int double (double) $a
cast long int JavaOperands.toInt($a)
cast long byte JavaOperands.toByte($a)
cast long short JavaOperands.toShort($a)
cast long char JavaOperands.toChar($a)
cast long long =
cast long double (double) $a
cast double int JavaOperands.d2i($a)
cast double long JavaOperands.d2l($a)
cast double byte JavaOperands.d2b($a)
cast double short JavaOperands.d2s($a)
cast double char JavaOperands.d2c($a)
cast double double =

# ---- 8. Compound assignment: x op= y  ==  x = (T)(x op y)  (JLS 15.26.2).
compound int +
compound int -
compound int *
compound int /
compound int %
compound int <<
compound int >>
compound int >>>
compound int &
compound int |
compound int ^
compound long +
compound long -
compound long *
compound long /
compound long %
compound long <<
compound long >>
compound long >>>
compound long &
compound long |
compound long ^
compound double +
compound double -
compound double *
compound double /
compound text +
compound boolean &
compound boolean |
compound boolean ^

# ---- 9. Increment / decrement as statements (value of the expression unused).
incr int JavaOperands.addInt($a, 1) ;; JavaOperands.subInt($a, 1)
incr long ($a + 1) ;; ($a - 1)
incr double ($a + 1.0) ;; ($a - 1.0)

# ---- 9b. String conversion (JLS 5.1.11) for concatenation and println. SLeeLa
#          renders a double as 3 where Java prints 3.0, so the Java layout is
#          taken from the lib/java tier (Double.toString, shortest round-trip).
tostr double Double.toString($a)
tostr char JavaText.plainIfRepresentable(JavaText.codePointU($a))

# ---- 10. Result types of well-known library members. This is TYPING only; the
#          behaviour of the member comes from the lib/java tier at run time.
ret String length int
ret String charAt char
ret String isEmpty boolean
ret String indexOf int
ret String lastIndexOf int
ret String equals boolean
ret String equalsIgnoreCase boolean
ret String compareTo int
ret String startsWith boolean
ret String endsWith boolean
ret String contains boolean
ret String substring String
ret String trim String
ret String toUpperCase String
ret String toLowerCase String
ret String replace String
ret String concat String
ret String valueOf String
ret String hashCode int
ret StringBuilder append StringBuilder
ret StringBuilder toString String
ret StringBuilder length int
ret StringBuilder charAt char
ret Math abs @arg0
ret Math max @arg0
ret Math min @arg0
ret Math sqrt double
ret Math pow double
ret Math floor double
ret Math ceil double
ret Integer parseInt int
ret Integer valueOf int
ret Integer toString String
ret Long parseLong long
ret Double parseDouble double
ret Object toString String
ret Object hashCode int
ret Object equals boolean
ret List size int
ret ArrayList size int
ret Map size int
ret HashMap size int
field Integer MAX_VALUE int
field Integer MIN_VALUE int
field Long MAX_VALUE long
field Long MIN_VALUE long

# ---- 11. Statement-level call rewrites (Java name -> SLeeLa call).
call System.out.println print($args)
call array.length arrayLength($recv)

# ---- 12. Constructs the converter refuses, with the reason it states.
unsupported float float arithmetic rounds to IEEE binary32 at every step; SLeeLa has no binary32 operator set, so equivalence cannot be guaranteed
unsupported lambda lambdas need the linear lowering of lib/java/jdk-28/LOWERING.md (design draft, not implemented in the converter)
unsupported methodref method references need the linear lowering of lib/java/jdk-28/LOWERING.md
unsupported synchronized synchronized blocks have no SLeeLa form
unsupported enum enum declarations are listed in SLEELA.syntax 43.5 as not supported
unsupported incr-expr ++/-- used as a value (not a statement) would reorder evaluation
unsupported assign-expr assignment used as a value would reorder evaluation
unsupported switch-expr switch expressions and arrow cases are not converted
unsupported string-static String is a keyword type in SLeeLa, so String.valueOf / String.format / String.join cannot be called as static members yet
unsupported nested nested/inner/anonymous types are not converted yet
unsupported untyped operand type cannot be determined, so the Java operator semantics cannot be selected
