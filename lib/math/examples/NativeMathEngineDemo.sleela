<< Runnable regression tour of SLNativeMathEngine and the native VM bridge. >>
#sleela 3.0
material;
class NativeMathEngineDemo {
    String metaVersion = "1.0.0";
    int metaId = 9502;
    String metaAuthor = "SLeeLa project";
    String metaDate = "2026-11-09";
    String metaCopyright = "SLeeLa project";
    String metaTrademark = "none";
    String metaCorporation = "none";
    String metaOrigin = "International";
    String metaBirthDate = "2026-11-09";
    int metaScienceRating = 7;
    String metaNationalSchedule = "none";

    String getMetaVersion() { return metaVersion; }
    void setMetaVersion(String v) { metaVersion = v; }
    int getMetaId() { return metaId; }
    void setMetaId(int v) { metaId = v; }
    String getAuthor() { return metaAuthor; }
    void setAuthor(String v) { metaAuthor = v; }
    String getDate() { return metaDate; }
    void setDate(String v) { metaDate = v; }
    String getCopyright() { return metaCopyright; }
    void setCopyright(String v) { metaCopyright = v; }
    String getTrademark() { return metaTrademark; }
    void setTrademark(String v) { metaTrademark = v; }
    String getCorporation() { return metaCorporation; }
    void setCorporation(String v) { metaCorporation = v; }
    String getOrigin() { return metaOrigin; }
    void setOrigin(String v) { metaOrigin = v; }
    String getBirthDate() { return metaBirthDate; }
    void setBirthDate(String v) { metaBirthDate = v; }
    int getScienceRating() { return metaScienceRating; }
    void setScienceRating(int v) { metaScienceRating = v; }
    String getNationalSchedule() { return metaNationalSchedule; }
    void setNationalSchedule(String v) { metaNationalSchedule = v; }


    static void main() {
        SLNativeMathEngine nativeMath = new SLNativeMathEngine();
        let a = arrayNew(3);
        let b = arrayNew(3);
        let sum = arrayNew(5);
        arraySet(sum, 4, 99.0);
        let vectorLength = 3;
        arraySet(a, 0, 1.0); arraySet(a, 1, 2.0); arraySet(a, 2, 3.0);
        arraySet(b, 0, 4.0); arraySet(b, 1, 5.0); arraySet(b, 2, 6.0);
        nativeMath.vectorAdd(a, b, sum, vectorLength);
        print("MATH_VECTOR_ADD");
        print(arrayGet(sum, 0)); print(arrayGet(sum, 1)); print(arrayGet(sum, 2));
        if (arrayGet(sum, 0) != 5.0 || arrayGet(sum, 1) != 7.0 || arrayGet(sum, 2) != 9.0) { throw "vector add mismatch"; }
        print("MATH_OUTPUT_EXTRA_CAPACITY"); print(arrayGet(sum, 4));
        if (arrayGet(sum, 4) != 99.0) { throw "native math overwrote extra output capacity"; }
        double dot = nativeMath.vectorDot(a, b, vectorLength);
        print("MATH_VECTOR_DOT"); print(dot);
        if (dot != 32.0) { throw "vector dot mismatch"; }
        double vectorNorm = nativeMath.vectorNorm(a, vectorLength);
        print("MATH_VECTOR_NORM"); print(vectorNorm);
        if (vectorNorm < 3.7 || vectorNorm > 3.8) { throw "vector norm mismatch"; }
        let scaled = arrayNew(3);
        nativeMath.vectorScale(a, 2.0, scaled, vectorLength);
        print("MATH_VECTOR_SCALE"); print(arrayGet(scaled, 2));
        if (arrayGet(scaled, 2) != 6.0) { throw "vector scale mismatch"; }

        let ma = arrayNew(4);
        let mb = arrayNew(4);
        let mc = arrayNew(4);
        arraySet(ma, 0, 1.0); arraySet(ma, 1, 2.0);
        arraySet(ma, 2, 3.0); arraySet(ma, 3, 4.0);
        arraySet(mb, 0, 5.0); arraySet(mb, 1, 6.0);
        arraySet(mb, 2, 7.0); arraySet(mb, 3, 8.0);
        let matrixOrder = 2;
        nativeMath.matrixMultiply(ma, mb, mc, matrixOrder, matrixOrder, matrixOrder, matrixOrder);
        print("MATH_MATRIX_MULTIPLY");
        print(arrayGet(mc, 0)); print(arrayGet(mc, 1));
        print(arrayGet(mc, 2)); print(arrayGet(mc, 3));
        if (arrayGet(mc, 0) != 19.0 || arrayGet(mc, 1) != 22.0 ||
            arrayGet(mc, 2) != 43.0 || arrayGet(mc, 3) != 50.0) { throw "matrix multiply mismatch"; }
        let mt = arrayNew(4);
        nativeMath.matrixTranspose(ma, mt, matrixOrder, matrixOrder);
        print("MATH_MATRIX_TRANSPOSE");
        print(arrayGet(mt, 0)); print(arrayGet(mt, 1));
        print(arrayGet(mt, 2)); print(arrayGet(mt, 3));
        if (arrayGet(mt, 0) != 1.0 || arrayGet(mt, 1) != 3.0 ||
            arrayGet(mt, 2) != 2.0 || arrayGet(mt, 3) != 4.0) { throw "matrix transpose mismatch"; }
        let diff = arrayNew(3);
        nativeMath.vectorSubtract(b, a, diff, vectorLength);
        print("MATH_VECTOR_SUBTRACT"); print(arrayGet(diff, 2));
        if (arrayGet(diff, 0) != 3.0 || arrayGet(diff, 1) != 3.0 || arrayGet(diff, 2) != 3.0) { throw "vector subtract mismatch"; }
        let unit = arrayNew(3);
        nativeMath.vectorNormalize(a, unit, vectorLength);
        print("MATH_VECTOR_NORMALIZE"); print(arrayGet(unit, 0));
        if (arrayGet(unit, 0) < 0.26 || arrayGet(unit, 0) > 0.28) { throw "vector normalize mismatch"; }
        let cross = arrayNew(3);
        nativeMath.vectorCross3(a, b, cross);
        print("MATH_VECTOR_CROSS3"); print(arrayGet(cross, 2));
        if (arrayGet(cross, 0) != -3.0 || arrayGet(cross, 1) != 6.0 || arrayGet(cross, 2) != -3.0) { throw "vector cross mismatch"; }

        let inv = arrayNew(4);
        nativeMath.matrixInverse(ma, inv, matrixOrder);
        print("MATH_MATRIX_INVERSE"); print(arrayGet(inv, 0));
        if (arrayGet(inv, 0) < -2.001 || arrayGet(inv, 0) > -1.999) { throw "matrix inverse mismatch"; }
        double determinant = nativeMath.matrixDeterminant(ma, matrixOrder);
        print("MATH_MATRIX_DETERMINANT"); print(determinant);
        if (determinant != -2.0) { throw "matrix determinant mismatch"; }
        let qrQ = arrayNew(6);
        let qrR = arrayNew(4);
        let tall = arrayNew(6);
        arraySet(tall, 0, 1.0); arraySet(tall, 1, 0.0);
        arraySet(tall, 2, 1.0); arraySet(tall, 3, 1.0);
        arraySet(tall, 4, 1.0); arraySet(tall, 5, 2.0);
        let qrRows = 3; let qrCols = 2;
        nativeMath.matrixQR(tall, qrQ, qrR, qrRows, qrCols);
        print("MATH_MATRIX_QR"); print(arrayGet(qrR, 0));
        if (arrayGet(qrR, 0) <= 0.0) { throw "QR factorization mismatch"; }
        let eigenValues = arrayNew(2);
        let eigenVectors = arrayNew(4);
        let symmetric = arrayNew(4);
        arraySet(symmetric, 0, 2.0); arraySet(symmetric, 1, 1.0);
        arraySet(symmetric, 2, 1.0); arraySet(symmetric, 3, 2.0);
        let eigenOrder = 2; let eigenSweeps = 32;
        nativeMath.symmetricEigen(symmetric, eigenValues, eigenVectors, eigenOrder, eigenSweeps);
        print("MATH_SYMMETRIC_EIGEN"); print(arrayGet(eigenValues, 0));
        double eigenSum = arrayGet(eigenValues, 0) + arrayGet(eigenValues, 1);
        double eigenProduct = arrayGet(eigenValues, 0) * arrayGet(eigenValues, 1);
        if (eigenSum < 3.999 || eigenSum > 4.001 ||
            eigenProduct < 2.999 || eigenProduct > 3.001) { throw "symmetric eigen mismatch"; }
        let fftIn = arrayNew(8);
        let fftOut = arrayNew(8);
        arraySet(fftIn, 0, 1.0);
        let fftLength = 8; let fftInverse = 0; nativeMath.fft(fftIn, fftOut, fftLength, fftInverse);
        print("MATH_FFT"); print(arrayGet(fftOut, 0));
        if (arrayGet(fftOut, 0) != 1.0 || arrayGet(fftOut, 2) != 1.0 ||
            arrayGet(fftOut, 4) != 1.0 || arrayGet(fftOut, 6) != 1.0) { throw "FFT impulse mismatch"; }

        let ca = arrayNew(2);
        let cb = arrayNew(2);
        let cz = arrayNew(2);
        arraySet(ca, 0, 3.0); arraySet(ca, 1, 2.0);
        arraySet(cb, 0, 1.0); arraySet(cb, 1, -1.0);
        nativeMath.complexAdd(ca, cb, cz);
        print("MATH_COMPLEX_ADD"); print(arrayGet(cz, 0));
        if (arrayGet(cz, 0) != 4.0 || arrayGet(cz, 1) != 1.0) { throw "complex add mismatch"; }
        nativeMath.complexSubtract(ca, cb, cz);
        print("MATH_COMPLEX_SUBTRACT"); print(arrayGet(cz, 1));
        if (arrayGet(cz, 0) != 2.0 || arrayGet(cz, 1) != 3.0) { throw "complex subtract mismatch"; }
        nativeMath.complexMultiply(ca, cb, cz);
        print("MATH_COMPLEX_MULTIPLY"); print(arrayGet(cz, 0));
        if (arrayGet(cz, 0) != 5.0 || arrayGet(cz, 1) != -1.0) { throw "complex multiply mismatch"; }
        nativeMath.complexDivide(ca, cb, cz);
        print("MATH_COMPLEX_DIVIDE"); print(arrayGet(cz, 1));
        if (arrayGet(cz, 0) < 0.499 || arrayGet(cz, 0) > 0.501 ||
            arrayGet(cz, 1) < 2.499 || arrayGet(cz, 1) > 2.501) { throw "complex divide mismatch"; }
        double cscalar = nativeMath.complexAbs(ca);
        print("MATH_COMPLEX_ABS"); print(cscalar);
        if (cscalar < 3.60 || cscalar > 3.61) { throw "complex magnitude mismatch"; }
        double cphase = nativeMath.complexPhase(ca);
        print("MATH_COMPLEX_PHASE"); print(cphase);
        if (cphase < 0.58 || cphase > 0.60) { throw "complex phase mismatch"; }
        nativeMath.complexConjugate(ca, cz);
        print("MATH_COMPLEX_CONJUGATE"); print(arrayGet(cz, 1));
        if (arrayGet(cz, 0) != 3.0 || arrayGet(cz, 1) != -2.0) { throw "complex conjugate mismatch"; }

        print("NATIVE_MATH_VM_SOURCE=PASS");
    }
}
