/*
 * lib/core/SLClock.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLClock used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Clock.
// Role: runtime. Responsibility: monotonic/wall clock access.
class SLClock {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
