/*
 * lib/crypto/SLPlainText.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLPlainText, a single
 *   initial plaintext field supplied to the cryptography pipeline.
 *
 * Rationale: The reference AES2 module begins from a PLAIN_TEXT field (and an
 *   initial_pad derived from it). A pipeline may carry one or more such fields;
 *   SLPlainText is one field, SLPlainTextField groups the ordered set.
 *
 * Order and Orientation: SLPlainText is a stage-zero input. It is read by the
 *   initial pad step and by the intermix stages; it is never reordered.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLPlainText {
  String label;    // human name of this field, e.g. "primary"
  String content;  // the plaintext content
  int ordinal;     // 1-based position among the initial fields
  int state;

  void configure(String fieldLabel, String fieldContent, int position) {
    label = fieldLabel;
    content = fieldContent;
    ordinal = position;
    state = 1;
  }

  void enable() { state = 1; }
  void disable() { state = 0; }
  boolean active() { return state == 1; }

  String value() { return content; }
  int length() { return content == null ? 0 : content.length(); }
  int position() { return ordinal; }
}
