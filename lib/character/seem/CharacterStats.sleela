#sleela 2.5
material;
<< lib/character/seem/CharacterStats.sleela
   Canonical character attribute and derived-stat model for SLeeLa games,
   simulations, and interactive fiction.

   Design notes:
   - STR, DEX, CON, INT, WIS, and CHA are the six classic primary abilities.
   - Scores are raw numeric values; the owning game defines its scale and caps.
   - Derived values are kept separate from primary abilities and should be
     recalculated by the game rules when equipment, level, effects, or stats change.
   - Resistances, skills, and status effects are represented as extensible
     named collections when the consuming runtime supports collections.

   This is the monolithic companion to the split lib/character/Character*Stats
   component classes; it gathers the whole stat surface into one value class for
   callers that prefer a single object. Moved here under lib/character/seem/ as a
   settled Source; marked material (section 19 of SLEELA.syntax). >>
class CharacterStats {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "2.5.0";
  int metaId = 11601;
  String metaAuthor = "Max Rupplin vs. Dr. Mrs. Elisabeth Harkins";
  String metaDate = "2026-10-28";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-11";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

    < Identity and progression >
    string characterId;
    string characterName;
    string characterClass;
    string characterRace;
    string characterArchetype;
    int level;
    int experience;
    int experienceToNextLevel;
    int proficiencyBonus;
    int alignment;

    < Six primary abilities >
    < STR Strength: force, lifting, melee power >
    int STR;
    < DEX Dexterity: agility, precision, reflexes >
    int DEX;
    < CON Constitution: endurance and resilience >
    int CON;
    < INT Intelligence: reasoning, memory, learned knowledge >
    int INT;
    < WIS Wisdom: awareness, intuition, judgment >
    int WIS;
    < CHA Charisma: presence, persuasion, leadership >
    int CHA;

    < Optional expanded abilities >
    < LCK Luck >
    int LCK;
    < PER Perception / sensory awareness >
    int PER;
    < WILL Willpower and mental resistance >
    int WILL;
    < SPI Spirit / spiritual affinity >
    int SPI;
    < TEC Technical aptitude >
    int TEC;
    < CRAFT Crafting aptitude >
    int CRAFT;

    < Core survival pools >
    int health;
    int maxHealth;
    int healthRegen;
    int mana;
    int maxMana;
    int manaRegen;
    int stamina;
    int maxStamina;
    int staminaRegen;
    int shield;
    int maxShield;
    int barrier;
    int maxBarrier;

    < Combat and action economy >
    int attackPower;
    int spellPower;
    int rangedPower;
    int defense;
    int armorClass;
    int magicDefense;
    int initiative;
    int accuracy;
    int criticalChance;
    int criticalMultiplier;
    int evasion;
    int blockChance;
    int parryChance;
    int dodgeChance;
    int attackSpeed;
    int castSpeed;
    int movementSpeed;
    int actionPoints;
    int maxActionPoints;
    int reactionPoints;
    int maxReactionPoints;

    < Saving throws and resistance scores >
    int saveStrength;
    int saveDexterity;
    int saveConstitution;
    int saveIntelligence;
    int saveWisdom;
    int saveCharisma;
    int physicalResistance;
    int magicalResistance;
    int poisonResistance;
    int diseaseResistance;
    int fireResistance;
    int coldResistance;
    int lightningResistance;
    int acidResistance;
    int necroticResistance;
    int radiantResistance;
    int psychicResistance;
    int forceResistance;
    int bleedResistance;
    int stunResistance;
    int fearResistance;
    int charmResistance;
    int curseResistance;

    < Exploration and interaction >
    int perception;
    int insight;
    int investigation;
    int stealth;
    int survival;
    int tracking;
    int lockpicking;
    int disarmTraps;
    int persuasion;
    int deception;
    int intimidation;
    int performance;
    int animalHandling;
    int medicine;
    int navigation;
    int luckCheck;

    < Skills: systems may use these as ranks, bonuses, or proficiency values >
    int athletics;
    int acrobatics;
    int sleightOfHand;
    int arcana;
    int history;
    int nature;
    int religion;
    int crafting;
    int alchemy;
    int engineering;
    int computing;
    int diplomacy;
    int bargaining;
    int leadership;
    int cooking;
    int fishing;
    int hunting;
    int mining;
    int farming;
    int riding;
    int swimming;
    int climbing;

    < Carrying capacity, economy, and equipment >
    int carryCapacity;
    int carriedWeight;
    int inventoryCapacity;
    int equipmentSlots;
    int gold;
    int silver;
    int copper;
    int reputation;
    int notoriety;
    int factionStanding;

    < Body and movement >
    int height;
    int weight;
    int reach;
    int jumpHeight;
    int fallResistance;
    int swimSpeed;
    int climbSpeed;
    int flightSpeed;
    int encumbrance;

    < Needs and long-duration condition (game-defined scales) >
    int hunger;
    int thirst;
    int fatigue;
    int stress;
    int morale;
    int temperature;
    int cleanliness;
    int sleepDebt;
    int sanity;
    int corruption;
    int infection;
    int intoxication;

    < Social, knowledge, and reputation >
    int socialStanding;
    int fame;
    int infamy;
    int knowledge;
    int languagesKnown;
    int companionsLimit;
    int commandLimit;
    int relationshipScore;

    < Lifetime and current state >
    int age;
    int lifespan;
    int alive;
    int conscious;
    int incapacitated;
    int hostile;
    int playerControlled;
    int summoned;
    int undead;
    int construct;
    int boss;
    int elite;

    < Versioned rules metadata >
    int schemaVersion;
    int rulesetId;

    CharacterStats() {
        characterId = "";
        characterName = "";
        characterClass = "";
        characterRace = "";
        characterArchetype = "";
        level = 1;
        experience = 0;
        experienceToNextLevel = 0;
        proficiencyBonus = 0;
        alignment = 0;

        STR = 10;
        DEX = 10;
        CON = 10;
        INT = 10;
        WIS = 10;
        CHA = 10;
        LCK = 10;
        PER = 10;
        WILL = 10;
        SPI = 10;
        TEC = 10;
        CRAFT = 10;

        health = 100;
        maxHealth = 100;
        healthRegen = 0;
        mana = 100;
        maxMana = 100;
        manaRegen = 0;
        stamina = 100;
        maxStamina = 100;
        staminaRegen = 0;
        shield = 0;
        maxShield = 0;
        barrier = 0;
        maxBarrier = 0;

        attackPower = 0;
        spellPower = 0;
        rangedPower = 0;
        defense = 0;
        armorClass = 10;
        magicDefense = 0;
        initiative = 0;
        accuracy = 0;
        criticalChance = 0;
        criticalMultiplier = 2;
        evasion = 0;
        blockChance = 0;
        parryChance = 0;
        dodgeChance = 0;
        attackSpeed = 100;
        castSpeed = 100;
        movementSpeed = 100;
        actionPoints = 1;
        maxActionPoints = 1;
        reactionPoints = 1;
        maxReactionPoints = 1;

        saveStrength = 0;
        saveDexterity = 0;
        saveConstitution = 0;
        saveIntelligence = 0;
        saveWisdom = 0;
        saveCharisma = 0;
        physicalResistance = 0;
        magicalResistance = 0;
        poisonResistance = 0;
        diseaseResistance = 0;
        fireResistance = 0;
        coldResistance = 0;
        lightningResistance = 0;
        acidResistance = 0;
        necroticResistance = 0;
        radiantResistance = 0;
        psychicResistance = 0;
        forceResistance = 0;
        bleedResistance = 0;
        stunResistance = 0;
        fearResistance = 0;
        charmResistance = 0;
        curseResistance = 0;

        perception = 0;
        insight = 0;
        investigation = 0;
        stealth = 0;
        survival = 0;
        tracking = 0;
        lockpicking = 0;
        disarmTraps = 0;
        persuasion = 0;
        deception = 0;
        intimidation = 0;
        performance = 0;
        animalHandling = 0;
        medicine = 0;
        navigation = 0;
        luckCheck = 0;

        athletics = 0;
        acrobatics = 0;
        sleightOfHand = 0;
        arcana = 0;
        history = 0;
        nature = 0;
        religion = 0;
        crafting = 0;
        alchemy = 0;
        engineering = 0;
        computing = 0;
        diplomacy = 0;
        bargaining = 0;
        leadership = 0;
        cooking = 0;
        fishing = 0;
        hunting = 0;
        mining = 0;
        farming = 0;
        riding = 0;
        swimming = 0;
        climbing = 0;

        carryCapacity = 0;
        carriedWeight = 0;
        inventoryCapacity = 0;
        equipmentSlots = 0;
        gold = 0;
        silver = 0;
        copper = 0;
        reputation = 0;
        notoriety = 0;
        factionStanding = 0;

        height = 0;
        weight = 0;
        reach = 1;
        jumpHeight = 0;
        fallResistance = 0;
        swimSpeed = 0;
        climbSpeed = 0;
        flightSpeed = 0;
        encumbrance = 0;

        hunger = 0;
        thirst = 0;
        fatigue = 0;
        stress = 0;
        morale = 100;
        temperature = 0;
        cleanliness = 100;
        sleepDebt = 0;
        sanity = 100;
        corruption = 0;
        infection = 0;
        intoxication = 0;

        socialStanding = 0;
        fame = 0;
        infamy = 0;
        knowledge = 0;
        languagesKnown = 1;
        companionsLimit = 0;
        commandLimit = 0;
        relationshipScore = 0;

        age = 0;
        lifespan = 0;
        alive = 1;
        conscious = 1;
        incapacitated = 0;
        hostile = 0;
        playerControlled = 0;
        summoned = 0;
        undead = 0;
        construct = 0;
        boss = 0;
        elite = 0;

        schemaVersion = 1;
