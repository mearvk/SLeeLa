#sleela 2.5
material;
class SleelaVMFeatureBits {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 81;
  String metaAuthor = "Max Rupplin vs. Dr. Mrs. Elisabeth Harkins";
  String metaDate = "2026-10-09";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-01";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
 Integer FILES = 1; Integer NETWORK = 2; Integer DNS = 4; Integer IPC = 8;
 Integer THREADS = 16; Integer ASYNC = 32; Integer GUI = 64; Integer AUDIO = 128;
 Integer VIDEO = 256; Integer DEVICES = 512; Integer CRYPTO = 1024; Integer TLS = 2048;
 Integer JIT = 4096; Integer AOT = 8192; Integer SIMD = 16384; Integer ATOMICS = 32768;
 Integer GC = 65536; Integer CHECKPOINT = 131072; Integer MIGRATION = 262144; Integer ATTESTATION = 524288;
 Integer OBSERVABILITY = 1048576; Integer DEBUG = 2097152; Integer PROFILING = 4194304; Integer DETERMINISTIC = 8388608;
 Integer RESOLVER = 16777216; Integer BROKER = 33554432; Integer CERTIFICATES = 67108864; Integer SANDBOX = 134217728;
 Integer LINK_OBSERVATION = 268435456; Integer LINK_TRANSACTIONS = 536870912; Integer LINK_MEMORY = 1073741824; Integer LINK_ATTESTATION = 2147483648;
 Integer CHALLENGE_EVENTS = 4294967296; Integer CHALLENGE_REMOTE = 8589934592; Integer REPORTS_INPUT = 17179869184; Integer REPORTS_OUTPUT = 34359738368; Integer REPORTS_MESSAGES = 68719476736; Integer REPORTS_IQ = 137438953472;
 < Operating-system system-call capability (syntax 1.5). PROCESS covers process >
 < execution (osRun/osSpawn/osWait/osKill); OS_SYSCALLS covers the full host >
 < System API surface (environment, identity, cwd, filesystem metadata) exposed >
 < via the os* built-ins and OP_OS_* opcodes. Backed by impl/core/sleela_os.c >
 < on Windows/Linux/macOS; a spawned process is a VM-local bounded handle. >
 Integer PROCESS = 274877906944; Integer OS_SYSCALLS = 549755813888;
 < Direct hardware acceleration (syntax 1.6). DMA grants a direct memory-access >
 < engine (bulk transfers without the CPU copying word by word); GPU grants >
 < native GPU access (offload parallel/compute kernels to a host GPU over the >
 < bridge, or a modelled SIMT engine when none is present). Both are opt-in and >
 < flow from the VM through a hosted CPU to the running program. >
 Integer DMA = 1099511627776; Integer GPU = 2199023255552;
 < Native-RAM residency (syntax 1.6). When set, the Secondary VM's linear memory >
 < runs on REAL host RAM (SLNativeMemory) instead of the simulated SLRAM store — >
 < for running outside simulation for procedural layment. Backed by the native >
 < host allocator (sleela_native_ram_*). Opt-in via the VM Creator. >
 Integer NATIVE_RAM = 4398046511104;
 function contains(mask, bit); function add(mask, bit); function remove(mask, bit); function validate(mask);
}