/*
 * lib/regex/RegexScanner.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexScanner used within the regex library family.
 */
#sleela 2.1
class RegexScanner {
  int position;
  void reset(){position=0;}
  void advance(){position=position+1;}
  int current(){return position;}
}
