/*
 * lib/regex/RegexEngine.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexEngine used within the regex library family.
 */
#sleela 1.3
class RegexEngine {
  string name;
  int capability;
  void setName(string value){name=value;}
  string getName(){return name;}
  void setCapability(int value){capability=value;}
  int getCapability(){return capability;}
}
