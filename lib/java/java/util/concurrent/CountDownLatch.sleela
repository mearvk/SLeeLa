  < ---- java.util.concurrent.CountDownLatch members (procedural implementation in SLeeLa) ---- >
  << A count guarded by VM lock 30 (reserved for java.util.concurrent
     synchronizers), so countDown from spawned threads never loses a step.
     await waits by polling the count once a millisecond; the timed form
     returns false when the time runs out. toString keeps its stub, because
     Java prints an identity hash that SLeeLa has no equivalent for. >>
  long cdlCount = 0;

  public CountDownLatch(int count) {
    if (count < 0) { throw new IllegalArgumentException("count < 0"); }
    this.cdlCount = count;
  }
  public long getCount() { return this.cdlCount; }
  public void countDown() {
    lock(30);
    if (this.cdlCount > 0) { this.cdlCount = this.cdlCount - 1; }
    unlock(30);
  }
  public void await() {
    while (this.cdlCount > 0) { sleep(1); }
  }
  public boolean await(long timeout, TimeUnit unit) {
    long deadline = timeMonotonicNanos() + unit.toNanos(timeout);
    while (this.cdlCount > 0) {
      if (timeMonotonicNanos() >= deadline) { return false; }
      sleep(1);
    }
    return true;
  }
