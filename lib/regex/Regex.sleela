/*
 * lib/regex/Regex.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type Regex used within the regex library family.
 */
#sleela 1.3
class Regex {
  int state;
  int captures;
  void reset(){state=0;captures=0;}
  void compile(){state=1;}
  boolean valid(){return state==1;}
  int captureCount(){return captures;}
}
