/*
 * lib/crypto/SLRadix.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLRadix, a general
 *   mixed-radix converter supporting bases 1 through 2055.
 *
 * Rationale: The reference AES2 obfuscation module (Java.Web.Server.Telnet
 *   .Front.Java.21, source/encryption/module/aes/two) depends on a family of
 *   per-base converters (Radix6, Radix11, Radix12, Radix13, Radix17, Radix18,
 *   ...). Rather than one class per base, SLeeLa carries a single configurable
 *   converter whose base is selected at runtime. Bases 1..2055 are supported:
 *   base 1 is the unary (tally) encoding; bases 2..2055 are positional with a
 *   generated extended digit alphabet.
 *
 * Order and Orientation: SLRadix is a leaf utility. It performs no intermix and
 *   holds no pipeline order. It is called by the ordered CryptoBlock stages and
 *   by the intermix stages. Native positional conversion crosses the explicit
 *   VM/OS bridge (sleela_crypto_radix_*).
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLRadix {
  // Minimum and maximum supported bases. Base 1 is unary; 2055 is the ceiling.
  static final int MIN_BASE = 1;
  static final int MAX_BASE = 2055;

  int base;        // the configured radix, MIN_BASE..MAX_BASE
  int state;       // 0 = disabled, 1 = enabled
  String lastError;

  // Configure the converter to a specific base. Fail-closed: an out-of-range
  // base leaves the converter disabled and records the reason.
  boolean configure(int b) {
    if (b < MIN_BASE || b > MAX_BASE) {
      lastError = "radix out of range 1..2055";
      state = 0;
      return false;
    }
    base = b;
    lastError = "";
    return true;
  }

  void enable() { state = 1; }
  void disable() { state = 0; }
  boolean active() { return state == 1 && base >= MIN_BASE && base <= MAX_BASE; }
  int radix() { return base; }

  // Encode a non-negative integer value into the configured base and return the
  // digit string. Base 1 yields a unary tally. Positional bases 2..2055 use the
  // native extended-alphabet encoder across the VM/OS bridge.
  String toBase(long value) {
    if (!active()) { return ""; }
    return native sleela_crypto_radix_to_base(base, value);
  }

  // Decode a digit string in the configured base back to its integer value.
  long fromBase(String digits) {
    if (!active()) { return 0; }
    return native sleela_crypto_radix_from_base(base, digits);
  }

  // Convenience: re-express a value from this base's digit string into another
  // base's digit string in a single ordered call.
  String rebase(String digits, int targetBase) {
    long v = fromBase(digits);
    SLRadix target = new SLRadix();
    if (!target.configure(targetBase)) { return ""; }
    target.enable();
    return target.toBase(v);
  }
}
