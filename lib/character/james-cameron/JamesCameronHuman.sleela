/*
 * lib/character/james-cameron/JamesCameronHuman.sleela
 * Public professional profile and optional capability-simulation fields.
 * Hypothetical stats are kept separate from verified biography.
 */
#sleela 2.1

class JamesCameronHuman {
  String fullName;
  String profession;
  String publicProfileNote;
  String sourceUrl;
  boolean verified;
  String capabilityModelStatus;
  String capabilityModelNote;

  void load() {
    fullName = "James Cameron";
    profession = "Filmmaker, screenwriter, producer and explorer";
    publicProfileNote = "Public professional profile; cite sources for all factual claims.";
    sourceUrl = "";
    verified = false;
    capabilityModelStatus = "hypothetical-scenario";
    capabilityModelNote = "Capability scores are illustrative simulation inputs, not measured intelligence or private-life data.";
  }

  void setSource(String url) {
    if (url != null) { sourceUrl = url; }
  }

  void setVerification(boolean value) { verified = value; }
  String name() { return fullName; }
  String occupation() { return profession; }
  boolean hasSource() { return sourceUrl != null && sourceUrl.length() > 0; }
  boolean isVerified() { return verified && hasSource(); }
}
