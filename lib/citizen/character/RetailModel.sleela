/*
 * lib/citizen/character/RetailModel.sleela
 * SLeeLa Standard Library Definition.
 * Definition: RetailModel — buy a thing, mark it up, sell it to a person who
 *   wants it today. Revenue is units x retail price; cost is units x what you
 *   paid, plus the rent on the shop with the nice window.
 *
 * A concrete BusinessModel. Family: character.
 */
#sleela 1.3
class RetailModel extends BusinessModel {

  int unitsSold;          // items sold this month
  int retailPriceCents;   // price on the shelf
  int unitCostCents;      // what the item cost to acquire
  int overheadCents;      // monthly rent/staff/lights

  void setUp(int sold, int retailPrice, int unitCost, int overhead) {
    load();
    configure("Retail", KIND_RETAIL);
    if (sold < 0) { sold = 0; }
    if (retailPrice < 0) { retailPrice = 0; }
    if (unitCost < 0) { unitCost = 0; }
    if (overhead < 0) { overhead = 0; }
    unitsSold = sold;
    retailPriceCents = retailPrice;
    unitCostCents = unitCost;
    overheadCents = overhead;
    setUnits(sold);
  }

  // Margin per unit, in case anyone asks how thin it really is.
  int unitMargin() { return retailPriceCents - unitCostCents; }

  int monthlyRevenue() { return unitsSold * retailPriceCents; }
  int monthlyCost() { return unitsSold * unitCostCents + overheadCents; }
}
