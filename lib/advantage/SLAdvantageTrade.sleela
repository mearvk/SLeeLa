<< lib/advantage/SLAdvantageTrade.sleela
   SLeeLa Standard Library Definition.
   Definition: Bilateral trade economics for the advantage model -- joint
   profit maximization, Nash bargaining split, and the bilateral newsvendor
   critical ratio. >>
#sleela 2.5
material;
< Math functionality for advantaging a dividend across a BUYER and a SELLER as >
< one coordinated system, then dividing the surplus. Three models: >
<   1. Joint Profit Maximization -- the integrated surplus Pi_total(Q) and the >
<      optimal quantity Q* where marginal revenue meets marginal supply cost. >
<   2. Nash Bargaining -- split the joint surplus by a bargaining-power index >
<      alpha over each party's reservation (disagreement) profit. >
<   3. Bilateral Newsvendor -- overage/underage costs on both ends and the >
<      centralized critical ratio that avoids double marginalization. >
<  >
< Curve convention (so Q* and marginals are exact and checkable): >
<   R_B(Q) = rbA * Q  -  rbB * Q*Q      (concave buyer revenue/utility) >
<   C_S(Q) = csA * Q  +  csB * Q*Q      (convex seller cost) >
< Then marginal revenue = rbA - 2*rbB*Q, marginal cost = csA + 2*csB*Q, and >
< setting them equal gives Q* = (rbA - csA) / (2*(rbB + csB)). >
class SLAdvantageTrade {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10516;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-08";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-08";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 8;
  << metaNationalSchedule: a real, citable instrument or "none".
     The Nash Bargaining Solution is Nash (1950), Econometrica 18(2):155-162;
     the newsvendor critical ratio is the classic Arrow-Harris-Marschak result.
     These are academic results, not a statute, so the schedule is "none". >>
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < ---- Curve coefficients (buyer revenue, seller cost) ---- >
  < linear term of buyer revenue R_B(Q) >
  double rbA;
  < quadratic (diminishing) term of buyer revenue >
  double rbB;
  < linear term of seller cost C_S(Q) >
  double csA;
  < quadratic (convex) term of seller cost >
  double csB;

  void configureCurves(double rbA0, double rbB0, double csA0, double csB0) {
    rbA = rbA0;
    rbB = rbB0;
    csA = csA0;
    csB = csB0;
  }

  < ---- 1. Joint Profit Maximization (integrated surplus) ---- >

  < Buyer revenue / utility from Q units: R_B(Q) = rbA*Q - rbB*Q^2. >
  double buyerRevenue(double q) { return rbA * q - rbB * q * q; }

  < Seller total cost for Q units: C_S(Q) = csA*Q + csB*Q^2. >
  double sellerCost(double q) { return csA * q + csB * q * q; }

  < Total available pool of profit: Pi_total(Q) = R_B(Q) - C_S(Q). >
  double jointProfit(double q) { return buyerRevenue(q) - sellerCost(q); }

  < Marginal revenue dR_B/dQ = rbA - 2*rbB*Q. >
  double marginalRevenue(double q) { return rbA - 2.0 * rbB * q; }

  < Marginal supply cost dC_S/dQ = csA + 2*csB*Q. >
  double marginalCost(double q) { return csA + 2.0 * csB * q; }

  < Decision rule: the optimal quantity Q* where MR = MC. For the quadratic >
  < curves this is Q* = (rbA - csA) / (2*(rbB + csB)). Returns 0 if the >
  < denominator is non-positive (no interior optimum). >
  double optimalQuantity() {
    double denom = 2.0 * (rbB + csB);
    if (denom <= 0.0) { return 0.0; }
    double q = (rbA - csA) / denom;
    if (q < 0.0) { return 0.0; }
    return q;
  }

  < The maximum joint surplus, evaluated at Q*. >
  double maxJointProfit() { return jointProfit(optimalQuantity()); }

  < ---- 2. Bilateral monopoly: individual profit curves + Nash split ---- >

  < Seller profit at wholesale price P and quantity Q: (P*Q) - C_S(Q). >
  double sellerProfit(double price, double q) {
    return price * q - sellerCost(q);
  }

  < Buyer profit at wholesale price P and quantity Q: R_B(Q) - (P*Q). >
  double buyerProfit(double price, double q) {
    return buyerRevenue(q) - price * q;
  }

  < The Nash objective at a candidate price: >
  <   [Pi_S - Pi_S0]^alpha * [Pi_B - Pi_B0]^(1-alpha). >
  < Both surpluses must be positive to be in the bargaining range; outside it >
  < the objective is 0 (no agreement value). >
  double nashObjective(double price, double q, double s0, double b0, double alpha) {
    double ss = sellerProfit(price, q) - s0;
    double bs = buyerProfit(price, q) - b0;
    if (ss <= 0.0) { return 0.0; }
    if (bs <= 0.0) { return 0.0; }
    return powAB(ss, alpha) * powAB(bs, 1.0 - alpha);
  }

  << Closed-form Nash price at the optimal quantity.
     The joint surplus S = Pi_total(Q*) - Pi_S0 - Pi_B0 is split so the seller
     gets a fraction alpha and the buyer gets (1-alpha). Since total profit is
     fixed at Q*, moving P only transfers value: d Pi_S/dP = +Q*, d Pi_B/dP =
     -Q*. The generalized Nash solution gives
        Pi_S(P*) - Pi_S0 = alpha * S,
     and Pi_S(P*) = P* * Q* - C_S(Q*), so
        P* = ( Pi_S0 + alpha*S + C_S(Q*) ) / Q*.
     With alpha = 0.5 and symmetric reservations this splits S down the middle. >>
  double nashPrice(double s0, double b0, double alpha) {
    double q = optimalQuantity();
    if (q <= 0.0) { return 0.0; }
    double total = jointProfit(q);
    double surplus = total - s0 - b0;
    double sellerShare = s0 + alpha * surplus;
    return (sellerShare + sellerCost(q)) / q;
  }

  < The joint surplus available for bargaining beyond both reservation points. >
  double bargainableSurplus(double s0, double b0) {
    return maxJointProfit() - s0 - b0;
  }

  < ---- 3. Bilateral Newsvendor (perishable / stochastic demand) ---- >
  < Overage (cost of one unit too many) and underage (cost of one unit too >
  < few), per side. r = retail price, cs = unit production cost, P = wholesale >
  < price, vs = seller salvage, vb = buyer salvage. >

  double overageSeller(double cs, double vs)  { return cs - vs; }
  double underageSeller(double price, double cs) { return price - cs; }
  double overageBuyer(double price, double vb) { return price - vb; }
  double underageBuyer(double r, double price) { return r - price; }

  << Centralized critical ratio -- the system-wide service level F(Q*) that
     avoids double marginalization:
        F(Q*) = c_u,system / (c_u,system + c_o,system)
              = (r - cs) / ((r - cs) + (cs - vb)).
     System underage = r - cs (full channel margin lost on a stockout);
     system overage  = cs - vb (production cost not recovered beyond buyer
     salvage). Returned in [0,1]; 0 if the denominator is non-positive. >>
  double criticalRatio(double r, double cs, double vb) {
    double cu = r - cs;
    double co = cs - vb;
    double denom = cu + co;
    if (denom <= 0.0) { return 0.0; }
    double f = cu / denom;
    if (f < 0.0) { return 0.0; }
    if (f > 1.0) { return 1.0; }
    return f;
  }

  << Buyback / revenue-share coordination check. Double marginalization occurs
     when the buyer, facing only its OWN critical ratio, orders less than the
     system optimum. The buyer's standalone ratio is
        F_B = (r - P) / ((r - P) + (P - vb)).
     A coordinating contract lifts F_B up to the centralized F(Q*). This
     returns how far the buyer's ratio falls short of the system ratio (>= 0
     means the buyer under-orders and a contract is needed). >>
  double coordinationGap(double r, double cs, double price, double vb) {
    double system = criticalRatio(r, cs, vb);
    double cuB = r - price;
    double coB = price - vb;
    double denomB = cuB + coB;
    double fb = 0.0;
    if (denomB > 0.0) { fb = cuB / denomB; }
    double gap = system - fb;
    if (gap < 0.0) { return 0.0; }
    return gap;
  }

  < ---- Small math helpers (self-contained; no cross-package imports) ---- >

  < Natural exponential via a truncated Taylor series with range reduction by >
  < halving, accurate enough for the bargaining exponents used here. >
  double expD(double x) {
    boolean neg = false;
    double ax = x;
    if (ax < 0.0) { neg = true; ax = 0.0 - ax; }
    < range-reduce: e^ax = (e^(ax/2^k))^(2^k) >
    int k = 0;
    while (ax > 0.5) { ax = ax / 2.0; k = k + 1; }
    double term = 1.0;
    double sum = 1.0;
    int n = 1;
    while (n <= 18) {
      term = term * ax / intToD(n);
      sum = sum + term;
      n = n + 1;
    }
    int i = 0;
    while (i < k) { sum = sum * sum; i = i + 1; }
    if (neg) { return 1.0 / sum; }
    return sum;
  }

  < Natural logarithm via atanh series: ln(y) = 2*atanh((y-1)/(y+1)), with >
  < range reduction pulling y into (0.5, 2) by factoring out e. >
  double lnD(double y) {
    if (y <= 0.0) { return 0.0; }
    double e = 2.718281828459045;
    double adjust = 0.0;
    double v = y;
    while (v > 1.5) { v = v / e; adjust = adjust + 1.0; }
    while (v < 0.5) { v = v * e; adjust = adjust - 1.0; }
    double t = (v - 1.0) / (v + 1.0);
    double t2 = t * t;
    double termn = t;
    double sum = 0.0;
    int n = 1;
    while (n <= 39) {
      sum = sum + termn / intToD(n);
      termn = termn * t2;
      n = n + 2;
    }
    return 2.0 * sum + adjust;
  }

  < General power a^b for a > 0 via exp(b * ln a). Used for the Nash exponents >
  < (alpha and 1-alpha are fractional). a <= 0 returns 0. >
  double powAB(double a, double b) {
    if (a <= 0.0) { return 0.0; }
    return expD(b * lnD(a));
  }

  < int -> double coercion that works regardless of implicit promotion. >
  double intToD(int n) {
    double d = 0.0;
    int i = 0;
    if (n >= 0) {
      while (i < n) { d = d + 1.0; i = i + 1; }
      return d;
    }
    int m = 0 - n;
    while (i < m) { d = d + 1.0; i = i + 1; }
    return 0.0 - d;
  }
}
