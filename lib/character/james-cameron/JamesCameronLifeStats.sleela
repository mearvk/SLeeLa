/*
 * User-configurable simulation inputs for a public-career case study.
 * Scores are scenario knobs, not measured attributes of the named person.
 * A value of zero for sustainability means unknown.
 */
#sleela 2.1
class JamesCameronLifeStats {
  String subjectName;
  String scaleDefinition;
  String profileStatus;
  String evidenceNote;
  String sourceUrl;
  int scenarioIntelligence;
  int scenarioCreativity;
  int scenarioSystemsThinking;
  int scenarioTechnicalInnovation;
  int scenarioExecution;
  int scenarioExploration;
  int scenarioCollaboration;
  int scenarioResilience;
  int sustainability;
  int publicCareerYears;
  int majorProfessionalDomains;
  int academyAwardsPersonallyWon;
  int billionDollarFilms;
  int dataConfidence;

  void load() {
    subjectName = "James Cameron";
    scaleDefinition = "1..30 simulation scale; 0 means unknown";
    profileStatus = "user-specified-hypothetical-scenario";
    evidenceNote = "Capability values are scenario inputs only. Career counts use public sources.";
    sourceUrl = "https://explorers.nationalgeographic.org/directory/james-cameron";
    scenarioIntelligence = 19;
    scenarioCreativity = 20;
    scenarioSystemsThinking = 19;
    scenarioTechnicalInnovation = 19;
    scenarioExecution = 18;
    scenarioExploration = 18;
    scenarioCollaboration = 16;
    scenarioResilience = 18;
    sustainability = 0;
    publicCareerYears = 48;
    majorProfessionalDomains = 5;
    academyAwardsPersonallyWon = 3;
    billionDollarFilms = 4;
    dataConfidence = 90;
  }

  boolean setPublicCareerMetrics(int years, int domains, int awards, int billionFilms,
                                 int confidence, String source) {
    if (years < 0 || domains < 0 || awards < 0 || billionFilms < 0
        || confidence < 0 || confidence > 100) { return false; }
    publicCareerYears = years;
    majorProfessionalDomains = domains;
    academyAwardsPersonallyWon = awards;
    billionDollarFilms = billionFilms;
    dataConfidence = confidence;
    if (source != null) { sourceUrl = source; }
    return true;
  }
  int intelligenceModifier() {
    if (scenarioIntelligence == 0) { return 0; }
    return floorHalf(scenarioIntelligence - 10);
  }
  int intelligencePlanningIndex() {
    if (scenarioIntelligence == 0) { return 0; }
    return 100 + (scenarioIntelligence - 10) * 5;
  }
  int creativeSystemsIndex() {
    if (scenarioCreativity == 0 || scenarioSystemsThinking == 0
        || scenarioTechnicalInnovation == 0) { return 0; }
    return (scenarioCreativity + scenarioSystemsThinking + scenarioTechnicalInnovation) * 100 / 90;
  }
  int floorHalf(int value) {
    if (value >= 0) { return value / 2; }
    return (value - 1) / 2;
  }
  boolean hasVerifiedCareerMetrics() {
    return dataConfidence >= 80 && sourceUrl != null && sourceUrl.length() > 0;
  }
  String report() {
    return subjectName + " life-capability scenario"
      + " status=" + profileStatus
      + " scenario_INT=" + scenarioIntelligence
      + " INT_modifier=" + intelligenceModifier()
      + " INT_planning_index=" + intelligencePlanningIndex()
      + " creative_systems_index=" + creativeSystemsIndex()
      + " career_years=" + publicCareerYears
      + " domains=" + majorProfessionalDomains
      + " awards=" + academyAwardsPersonallyWon
      + " billion_dollar_films=" + billionDollarFilms
      + " confidence=" + dataConfidence;
  }
}
