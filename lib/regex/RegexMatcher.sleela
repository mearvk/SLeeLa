/*
 * lib/regex/RegexMatcher.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexMatcher used within the regex library family.
 */
#sleela 1.3
class RegexMatcher {
  boolean matched;
  int start;
  int end;
  void clear(){matched=false;start=0;end=0;}
  void set(int a,int b){matched=true;start=a;end=b;}
  boolean found(){return matched;}
}
