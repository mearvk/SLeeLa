/*
 * lib/crypto/SLCryptoSeries.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLCryptoSeries, the
 *   ordered 1..255 series of SLCryptoBlock steps that make up the main general
 *   intermix of the cryptography process.
 *
 * Rationale: The user requires "some number of final procedural increments ...
 *   call the functions ... in order 1,2,3,x,y,z. Assume 1-255." The reference
 *   AES2 runner dispatches passes one()..twentyone() strictly in order. This
 *   type holds the blocks indexed by Order, honours Respect on ties, and drives
 *   advance() across the whole series in a single run().
 *
 * Order and Orientation: SLCryptoSeries is the ordered driver of the main
 *   general intermix. It sits between the two secondary intermix stages and the
 *   result/compare/register tail of the pipeline.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLCryptoSeries {
  static final int MIN_STEPS = 1;
  static final int MAX_STEPS = 255;

  SLCryptoBlock[] blocks;
  int count;
  int state;
  String lastError;

  void init() {
    blocks = new SLCryptoBlock[MAX_STEPS];
    count = 0;
    state = 0;
    lastError = "";
  }

  // Register a block. Fail-closed on bound. Order is validated by the block.
  boolean register(SLCryptoBlock block) {
    if (block == null || !block.active()) { lastError = "inactive block"; return false; }
    if (count >= MAX_STEPS) { lastError = "series full (max 255 steps)"; return false; }
    blocks[count] = block;
    count = count + 1;
    return true;
  }

  // Guard: a series must have at least one step.
  boolean valid() {
    if (count < MIN_STEPS) { lastError = "series requires at least one step"; return false; }
    return true;
  }

  void enable() { if (valid()) { state = 1; } }
  void disable() { state = 0; }
  boolean active() { return state == 1 && valid(); }

  int size() { return count; }

  // Sort the registered blocks into strict ascending Order, breaking ties by
  // descending Respect, so the main series advances 1,2,3,...,x,y,z with higher
  // respect never falling beneath lower respect at the same order.
  void arrange() {
    for (int i = 0; i < count; i = i + 1) {
      for (int j = i + 1; j < count; j = j + 1) {
        boolean swap = false;
        if (blocks[j].orderIndex() < blocks[i].orderIndex()) {
          swap = true;
        } else if (blocks[j].orderIndex() == blocks[i].orderIndex()
                   && blocks[j].respectRank() > blocks[i].respectRank()) {
          swap = true;
        }
        if (swap) {
          SLCryptoBlock tmp = blocks[i];
          blocks[i] = blocks[j];
          blocks[j] = tmp;
        }
      }
    }
  }

  // Run the whole ordered series over the running cipher text.
  String run(String running, SLRadixTable radices) {
    if (!active()) { return running; }
    arrange();
    String acc = running;
    for (int i = 0; i < count; i = i + 1) {
      acc = blocks[i].advance(acc, radices);
    }
    return acc;
  }
}
