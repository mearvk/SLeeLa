    int avail = this.count - this.pos;
    int k = len;
    if (k > avail) { k = avail; }
    if (k <= 0) { return 0; }
    int i = 0;
    while (i < k) { cbuf[off + i] = this.buf[this.pos + i]; i = i + 1; }
    this.pos = this.pos + k;
    return k;
