<< lib/guidoc/SLGuiDocApp.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLGuiDocApp — the controller of the document GUI, in
     white. It builds the widget tree from the spec (SLGuiDocSpec, mirrored by
     gui-document.xml), keeps up to 14 tabs (each a standing document with its
     own observer and white GUI listener), runs the menu commands, handles
     keyboard accelerators, the open and save-as dialogs and the
     discard-changes confirmations, and repaints the view whenever a command or
     an external change to a document calls for it. Load and save go through
     SLGuiDocFile. >>
#sleela 3.0
material;
artifact;
pure;
gasoline;
import observer;
import ui;
< Family: guidoc. Dialog modes: 0 none, 1 open, 2 save as, 3 confirm close, >
< 4 confirm quit. While a dialog is open every other command is refused. >
class SLGuiDocApp {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 39247;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-11";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-11";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  SLGuiDocSpec spec;
  SLGuiDocWhite white;
  SLGuiDocFile file;
  SLGuiDocView view;
  SLGuiDocTab[] tabs;
  int tabCount;
  int active;
  int untitled;
  int dialog;
  int pendingTab;
  int quitFlag;
  String status;
  int statusError;
  String openMenu;
  int executed;
  int refusedCommands;

  < Build everything from the spec. False if the spec or the white theme is >
  < inconsistent (nothing is half-built). >
  boolean configure() {
    spec = new SLGuiDocSpec();
    spec.configure();
    if (spec.standard() != 0) { return false; }
    white = new SLGuiDocWhite();
    white.configure();
    if (!white.isWhite()) { return false; }
    file = new SLGuiDocFile();
    file.configure(spec.getSidecarSuffix(), spec.getMaxBytes());
    view = new SLGuiDocView();
    view.configure();
    tabs = new SLGuiDocTab[14];
    tabCount = 0; active = -1; untitled = 0; dialog = 0; pendingTab = -1; quitFlag = 0;
    status = "ready"; statusError = 0; openMenu = ""; executed = 0; refusedCommands = 0;
    buildView();
    paint();
    return true;
  }

  SLGuiDocSpec specification() { return spec; }
  SLGuiDocWhite look() { return white; }
  SLGuiDocView widgets() { return view; }
  SLGuiDocFile files() { return file; }
  int tabTotal() { return tabCount; }
  int activeIndex() { return active; }
  SLGuiDocTab tabAt(int i) {
    if (i < 0 || i >= tabCount) { return null; }
    return tabs[i];
  }
  SLGuiDocTab activeTab() { return tabAt(active); }
  boolean quitRequested() { return quitFlag == 1; }
  String statusText() { return status; }
  boolean statusIsError() { return statusError == 1; }
  int dialogMode() { return dialog; }
  String menuOpen() { return openMenu; }
  int executedCount() { return executed; }
  int refusedCount() { return refusedCommands; }

  < ---- building the widget tree ----------------------------------------- >

  void buildView() {
    view.add("", "window", "win", spec.getTitle(), white.style("window"));
    view.add("win", "menubar", "menubar", "", white.style("menubar"));
    int m = 0;
    while (m < spec.menuTotal()) {
      String mid = "menu-" + spec.menuIdAt(m);
      view.add("menubar", "menu", mid, spec.menuLabelAt(m), white.style("menu"));
      view.bind(mid, "menu.toggle", m);
      m = m + 1;
    }
    int i = 0;
    while (i < spec.itemTotal()) {
      String nid = "mi-" + spec.itemIdAt(i);
      String label = spec.itemLabelAt(i);
      if (spec.itemAccelAt(i) != "") { label = label + "   " + spec.itemAccelAt(i); }
      view.add("menu-" + spec.itemMenuAt(i), "menuitem", nid, label, white.style("menu-item"));
      view.bind(nid, spec.itemCommandAt(i), i);
      view.setVisible(nid, false);
      i = i + 1;
    }
    view.add("win", "tabbar", "tabbar", "", white.style("tabbar"));
    int t = 0;
    while (t < spec.getMaxTabs()) {
      view.add("tabbar", "tab", "tab-" + t, "", white.style("tab"));
      view.bind("tab-" + t, "view.gotoTab", t);
      view.setVisible("tab-" + t, false);
      t = t + 1;
    }
    view.add("tabbar", "button", "tab-new", "+", white.style("button"));
    view.bind("tab-new", "file.new", 0);
    view.add("win", "editor", "editor", "", white.style("editor"));
    int r = 0;
    while (r < spec.getEditorRows()) {
      view.add("editor", "gutter", "gut-" + r, "", white.style("gutter"));
      view.add("editor", "row", "row-" + r, "", white.style("row"));
      view.bind("row-" + r, "editor.select", r);
      r = r + 1;
    }
    view.add("win", "entry", "entry", "", white.style("entry"));
    view.add("win", "label", "status-left", "", white.style("status"));
    view.add("win", "label", "status-mid", "", white.style("status"));
    view.add("win", "label", "status-right", "", white.style("status"));
    view.add("win", "dialog", "dlg", "", white.style("dialog"));
    view.add("dlg", "label", "dlg-title", "", white.style("dialog"));
    view.add("dlg", "entry", "dlg-path", "", white.style("entry"));
    view.add("dlg", "button", "dlg-ok", "OK", white.style("button-primary"));
    view.bind("dlg-ok", "dialog.ok", 0);
    view.add("dlg", "button", "dlg-cancel", "Cancel", white.style("button"));
    view.bind("dlg-cancel", "dialog.cancel", 0);
  }

  < ---- state the menus depend on ----------------------------------------- >

  boolean whenHolds(String when) {
    SLGuiDocTab t = activeTab();
    if (when == "always") { return true; }
    if (when == "hasTab") { return t != null; }
    if (when == "dirty") { return t != null && t.isDirty() && !t.isReadOnly(); }
    if (when == "editable") { return t != null && !t.isReadOnly(); }
    if (when == "selectionEditable") { return t != null && !t.isReadOnly() && t.hasSelection(); }
    if (when == "multipleTabs") { return tabCount > 1; }
    return false;
  }

  void say(String text) { status = text; statusError = 0; }
  void complain(String text) { status = text; statusError = 1; }

  < ---- painting ------------------------------------------------------------ >

  String tabLabel(SLGuiDocTab t) {
    String s = t.getTitle();
    if (t.isDirty()) { s = s + spec.getDirtyMarker(); }
    if (t.isReadOnly()) { s = s + " [read-only]"; }
    return s;
  }

  void paint() {
    SLGuiDocTab cur = activeTab();
    String head = spec.getTitle();
    if (cur != null) { head = head + " - " + tabLabel(cur); }
    view.setText("win", head);
    boolean modal = dialog != 0;
    int m = 0;
    while (m < spec.menuTotal()) {
      String mid = "menu-" + spec.menuIdAt(m);
      view.setStyle(mid, (spec.menuIdAt(m) == openMenu) ? white.style("menu-open") : white.style("menu"));
      view.setEnabled(mid, !modal);
      m = m + 1;
    }
    int i = 0;
    while (i < spec.itemTotal()) {
      String nid = "mi-" + spec.itemIdAt(i);
      boolean ok = whenHolds(spec.itemWhenAt(i)) && !modal;
      view.setVisible(nid, spec.itemMenuAt(i) == openMenu);
      view.setEnabled(nid, ok);
      view.setStyle(nid, ok ? white.style("menu-item") : white.style("menu-item-disabled"));
      i = i + 1;
    }
    int t = 0;
    while (t < spec.getMaxTabs()) {
      String nid = "tab-" + t;
      if (t < tabCount) {
        SLGuiDocTab tb = tabs[t];
        view.setVisible(nid, true);
        view.setText(nid, tabLabel(tb));
        String role = "tab";
        if (t == active) { role = tb.isDirty() ? "tab-active-dirty" : "tab-active"; }
        else if (tb.isDirty()) { role = "tab-dirty"; }
        view.setStyle(nid, white.style(role));
      } else {
        view.setVisible(nid, false);
        view.setText(nid, "");
      }
      view.setEnabled(nid, !modal);
      t = t + 1;
    }
    view.setEnabled("tab-new", !modal);
    paintEditor(cur);
    view.setEnabled("entry", !modal && cur != null && !cur.isReadOnly());
    paintStatus(cur);
    paintDialog(cur);
  }

  void paintEditor(SLGuiDocTab cur) {
    int rows = spec.getEditorRows();
    int r = 0;
    if (cur == null) {
      while (r < rows) {
        view.setText("gut-" + r, "");
        view.setText("row-" + r, (r == 0) ? "No document open. Use File, New or File, Open." : "");
        view.setStyle("row-" + r, white.style("row-empty"));
        view.setEnabled("row-" + r, false);
        r = r + 1;
      }
      return;
    }
    cur.clampSelection();
    cur.ensureVisible(rows);
    SLObserverDocument d = cur.body();
    while (r < rows) {
      int line = cur.topLine() + r;
      boolean real = line < d.lineCount();
      view.setText("gut-" + r, (real && spec.showsLineNumbers()) ? ("" + (line + 1)) : "");
      view.setText("row-" + r, real ? d.lineAt(line) : "");
      view.setEnabled("row-" + r, real && dialog == 0);
      if (real && line == cur.selectedLine()) { view.setStyle("row-" + r, white.style("row-selected")); }
      else { view.setStyle("row-" + r, white.style("row")); }
      r = r + 1;
    }
  }

  void paintStatus(SLGuiDocTab cur) {
    view.setText("status-left", status);
    view.setStyle("status-left", (statusError == 1) ? white.style("status-error") : white.style("status"));
    if (cur == null) {
      view.setText("status-mid", "");
      view.setText("status-right", white.name());
      view.setStyle("status-right", white.style("status"));
      return;
    }
    SLObserverDocument d = cur.body();
    String where = (cur.selectedLine() >= 0) ? ("Ln " + (cur.selectedLine() + 1) + " of ") : "Lines: ";
    view.setText("status-mid", where + d.lineCount() + "  rev " + d.revisionNow());
    SLGuiDocListener.Responder lis = cur.guiListener();
    view.setText("status-right", white.name() + " | " + lis.statusText());
    view.setStyle("status-right", lis.statusStyle());
  }

  void paintDialog(SLGuiDocTab cur) {
    boolean on = dialog != 0;
    view.setVisible("dlg", on);
    view.setVisible("dlg-title", on);
    view.setVisible("dlg-ok", on);
    view.setVisible("dlg-cancel", on);
    view.setVisible("dlg-path", dialog == 1 || dialog == 2);
    if (dialog == 1) { view.setText("dlg-title", "Open file: type a path"); view.setText("dlg-ok", "Open"); }
    if (dialog == 2) { view.setText("dlg-title", "Save as: type a path"); view.setText("dlg-ok", "Save"); }
    if (dialog == 3) {
      SLGuiDocTab p = tabAt(pendingTab);
      view.setText("dlg-title", "Discard unsaved changes in " + ((p == null) ? "this tab" : p.getTitle()) + "?");
      view.setText("dlg-ok", "Discard");
    }
    if (dialog == 4) { view.setText("dlg-title", "Quit and discard unsaved changes?"); view.setText("dlg-ok", "Discard"); }
  }

  < Called by the host loop after anything outside the GUI may have changed >
  < a document: repaint if any tab listener latched a repaint. >
  boolean refresh() {
    boolean any = false;
    int i = 0;
    while (i < tabCount) {
      SLGuiDocTab t = tabs[i];
      SLGuiDocListener.Responder lis = t.guiListener();
      if (lis.takeRepaint()) { any = true; }
      i = i + 1;
    }
    if (any) { paint(); }
    return any;
  }

  < ---- input ---------------------------------------------------------------- >

  void type(String id, String text) { view.type(id, text); }

  < Report a node activation and service it. Returns commands executed. >
  int click(String id) {
    if (!view.press(id)) { return 0; }
    return pump();
  }

  int pump() {
    int n = 0;
    int i = view.takePress();
    while (i >= 0) {
      n = n + 1;
      handle(view.commandAt(i), view.argAt(i));
      i = view.takePress();
    }
    return n;
  }

  void handle(String command, int arg) {
    if (command == "menu.toggle") {
      String mid = spec.menuIdAt(arg);
      openMenu = (mid == openMenu) ? "" : mid;
      paint();
      return;
    }
    openMenu = "";
    if (command == "view.gotoTab") { gotoTab(arg); return; }
    if (command == "editor.select") { selectRow(arg); return; }
    if (command == "dialog.ok") { dialogOk(); return; }
    if (command == "dialog.cancel") { dialogCancel(); return; }
    execute(command);
  }

  < A keyboard accelerator such as Ctrl+S. >
  boolean accelerate(String accel) {
    String command = spec.commandForAccel(accel);
    if (command == "") { return false; }
    openMenu = "";
    return execute(command);
  }

  < ---- commands ------------------------------------------------------------- >

  boolean execute(String command) {
    if (spec.commandIndex(command) < 0) { refusedCommands = refusedCommands + 1; return false; }
    if (dialog != 0) {
      refusedCommands = refusedCommands + 1;
      complain("finish or cancel the open dialog first");
      paint();
      return false;
    }
    if (!whenHolds(spec.whenForCommand(command))) {
      refusedCommands = refusedCommands + 1;
      complain("not available now: " + command);
      paint();
      return false;
    }
    boolean ok = false;
    if (command == "file.new") { ok = cmdNew(); }
    else if (command == "file.open") { ok = cmdOpen(); }
    else if (command == "file.save") { ok = cmdSave(); }
    else if (command == "file.saveAs") { ok = cmdSaveAs(); }
    else if (command == "file.closeTab") { ok = cmdCloseTab(); }
    else if (command == "app.quit") { ok = cmdQuit(); }
    else if (command == "edit.insertLine") { ok = cmdInsertLine(); }
    else if (command == "edit.replaceLine") { ok = cmdReplaceLine(); }
    else if (command == "edit.deleteLine") { ok = cmdDeleteLine(); }
    else if (command == "view.nextTab") { ok = cmdNextTab(); }
    else if (command == "view.prevTab") { ok = cmdPrevTab(); }
    else if (command == "help.about") { ok = cmdAbout(); }
    if (ok) { executed = executed + 1; } else { refusedCommands = refusedCommands + 1; }
    paint();
    return ok;
  }

  boolean addTab(SLGuiDocTab t) {
    if (tabCount >= spec.getMaxTabs()) { complain("tab limit reached (" + spec.getMaxTabs() + ")"); return false; }
    tabs[tabCount] = t;
    active = tabCount;
    tabCount = tabCount + 1;
    return true;
  }

  boolean cmdNew() {
    untitled = untitled + 1;
    SLGuiDocTab t = new SLGuiDocTab();
    t.configure(spec.getNewTabTitle() + "-" + untitled, white, spec.getListenerPort());
    if (!addTab(t)) { return false; }
    say("new document " + t.getTitle());
    return true;
  }
  boolean cmdOpen() {
    dialog = 1;
    view.setText("dlg-path", "");
    return true;
  }
  boolean cmdSaveAs() {
    SLGuiDocTab t = activeTab();
    if (t.isReadOnly()) { complain("a read-only (unsplit) document cannot be saved"); return false; }
    dialog = 2;
    view.setText("dlg-path", "");
    return true;
  }
  boolean cmdSave() {
    SLGuiDocTab t = activeTab();
    if (t.getPath() == "") { return cmdSaveAs(); }
    return saveActiveTo(t.getPath());
  }
  boolean cmdCloseTab() {
    SLGuiDocTab t = activeTab();
    if (t.isDirty()) { dialog = 3; pendingTab = active; return true; }
    return closeTab(active);
  }
  boolean cmdQuit() {
    int i = 0;
    while (i < tabCount) {
      SLGuiDocTab t = tabs[i];
      if (t.isDirty()) { dialog = 4; return true; }
      i = i + 1;
    }
    quitFlag = 1;
    say("goodbye");
    return true;
  }
  boolean cmdInsertLine() {
    SLGuiDocTab t = activeTab();
    int pos = t.hasSelection() ? (t.selectedLine() + 1) : t.body().lineCount();
    int r = t.edit(0, pos, view.textOf("entry"), "gui");
    if (r < 0) { complain("the document refused the insert"); return false; }
    t.guiListener().acknowledgeExternal();
    t.select(pos);
    view.setText("entry", "");
    say("inserted line " + (pos + 1));
    return true;
  }
  boolean cmdReplaceLine() {
    SLGuiDocTab t = activeTab();
    int at = t.selectedLine();
    int r = t.edit(1, at, view.textOf("entry"), "gui");
    if (r < 0) { complain("the document refused the replace"); return false; }
    t.guiListener().acknowledgeExternal();
    view.setText("entry", "");
    say("replaced line " + (at + 1));
    return true;
  }
  boolean cmdDeleteLine() {
    SLGuiDocTab t = activeTab();
    int at = t.selectedLine();
    int r = t.edit(2, at, "", "gui");
    if (r < 0) { complain("the document refused the delete"); return false; }
    t.guiListener().acknowledgeExternal();
    t.clampSelection();
    say("deleted line " + (at + 1));
    return true;
  }
  boolean cmdNextTab() { gotoTab((active + 1) % tabCount); return true; }
  boolean cmdPrevTab() { gotoTab((active + tabCount - 1) % tabCount); return true; }
  boolean cmdAbout() { say(spec.getTitle() + " 1.0 (" + white.name() + ")"); return true; }

  < ---- tab, file and dialog operations ------------------------------------ >

  void gotoTab(int i) {
    if (dialog != 0 || i < 0 || i >= tabCount) { return; }
    active = i;
    SLGuiDocTab shown = tabs[i];
    say("tab " + shown.getTitle());
    paint();
  }
  void selectRow(int row) {
    SLGuiDocTab t = activeTab();
    if (dialog != 0 || t == null) { return; }
    int line = t.topLine() + row;
    if (line >= t.body().lineCount()) { return; }
    t.select(line);
    t.guiListener().acknowledgeExternal();
    paint();
  }

  boolean saveActiveTo(String path) {
    SLGuiDocTab t = activeTab();
    int code = t.saveTo(file, path);
    if (code == 0) { say("saved " + path); return true; }
    complain("save failed (code " + code + ")");
    return false;
  }

  < Open a path in a new tab (or switch to the tab that already has it). >
  boolean openPath(String path) {
    if (path == "") { complain("no path given"); return false; }
    int i = 0;
    while (i < tabCount) {
      SLGuiDocTab seen = tabs[i];
      if (seen.getPath() == path) { active = i; say("already open: " + path); return true; }
      i = i + 1;
    }
    if (tabCount >= spec.getMaxTabs()) { complain("tab limit reached (" + spec.getMaxTabs() + ")"); return false; }
    SLGuiDocTab t = new SLGuiDocTab();
    t.configure(path, white, spec.getListenerPort());
    int code = t.loadFrom(file, path, spec.lockUnsplit());
    if (code != 0 && code != 10) { complain("open failed (code " + code + ")"); return false; }
    addTab(t);
    if (code == 10) { say("opened unsplit and read-only: " + path); }
    else { say("opened " + path + " (" + t.body().lineCount() + " lines)"); }
    return true;
  }

  boolean closeTab(int idx) {
    if (idx < 0 || idx >= tabCount) { return false; }
    SLGuiDocTab gone = tabs[idx];
    gone.observer().retire(gone.guiListener().portOf().getName());
    int i = idx;
    while (i + 1 < tabCount) {
      SLGuiDocTab nx = tabs[i + 1];
      tabs[i] = nx;
      i = i + 1;
    }
    tabCount = tabCount - 1;
    if (active >= tabCount) { active = tabCount - 1; }
    if (tabCount == 0) { active = -1; }
    say("closed " + gone.getTitle());
    return true;
  }

  void dialogOk() {
    int mode = dialog;
    if (mode == 0) { return; }
    String path = view.textOf("dlg-path");
    dialog = 0;
    if (mode == 1) { openPath(path); }
    else if (mode == 2) {
      if (path == "") { complain("no path given"); dialog = 2; }
      else { saveActiveTo(path); }
    }
    else if (mode == 3) { closeTab(pendingTab); pendingTab = -1; }
    else if (mode == 4) { quitFlag = 1; say("goodbye"); }
    paint();
  }
  void dialogCancel() {
    if (dialog == 0) { return; }
    dialog = 0; pendingTab = -1;
    say("cancelled");
    paint();
  }
}
