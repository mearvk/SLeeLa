< ---- source: lib/math/SLPiReference.sleela ---- >
<< lib/math/SLPiReference.sleela
   SLeeLa Standard Library Definition.
   Definition: SLPiReference is the Modium static reference variable for the
   mathematical constant pi. It carries pi inline to the irrational-digit-carry
   norm (SLMathNorms.DEFAULT_IRRATIONAL_CARRY = 2048 fractional digits) as a
   static final String, reports its own digit count and a digit checksum, and
   self-verifies its leading digits against a known reference. The value is a
   Modium catalog static: a single authoritative, hash-checkable reference that
   the SLeeLa registry seeds as a default start value. >>
< Modium static reference: the canonical pi value for the SLeeLa catalog. >
class SLPiReference {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 7903;
  String metaAuthor = "Max Rupplin";
  String metaDate = "2026-11-06";
  String metaCopyright = "MEARVK LLC";
  String metaTrademark = "none";
  String metaCorporation = "MEARVK LLC";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-06";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  << The Modium static reference value of pi, carried to 2048 fractional digits
     as "3." followed by the digits. It is published as a head (the first 60
     fractional digits) and a tail that compose back to the whole, so integrity
     can be self-checked using only string equality and concatenation -- the
     operations SLeeLa Strings guarantee. A deeper reference set (millions of
     digits) is produced out-of-band and resolved by handle; this inline value
     is the catalog's canonical, hash-checkable start value at the irrational-
     digit-carry norm (SLMathNorms.DEFAULT_IRRATIONAL_CARRY = 2048). >>
  static final String PI = "3.";

  < The published head: "3." plus the first 60 fractional digits. >
  static final String PI_HEAD = "3.141592653589793238462643383279502884197169399375105820974944";

  < The published tail: the remaining fractional digits. PI_HEAD + PI_TAIL == PI. >
  static final String PI_TAIL = "";

  < An independent echo of the head, for a tamper check against PI_HEAD. >
  static final String PI_HEAD_ECHO = "3.141592653589793238462643383279502884197169399375105820974944";

  < The first 50 fractional digits, a widely published reference for pi. >
  static final String PI_REF_50 = "14159265358979323846264338327950288419716939937510";

  < The head with the leading "3." stripped: the first 50 then 60 digits. >
  static final String PI_HEAD_FRACTION_50 = "14159265358979323846264338327950288419716939937510";

  < The number of fractional digits carried inline (the irrational-carry norm). >
  static final int PI_DIGITS = 2048;

  << The deeper reference set, resolved by handle rather than carried inline:
     the 100,000,000-fractional-digit value in pi-generator/pi.100000000.digits
     (verified genuine pi in pi-generator/VERIFIED.md). This class carries only
     the LOCATOR and the digit count -- the bytes live on disk and are loaded by
     the Modium/Registry subsystem at startup (sleela registry / sleela modium),
     consistent with REGISTRY-3.0-MODIUM.md (registry stores locator metadata,
     Modium resolves it to a host file). >>
  static final String PI_LARGE_PATH = "pi-generator/pi.100000000.digits";
  static final int PI_LARGE_DIGITS = 100000000;

  < The sum of the fractional decimal digits -- a stable integrity checksum. >
  static final int PI_DIGIT_CHECKSUM = 9338;

  String value() { return PI; }
  int digitCount() { return PI_DIGITS; }
  int checksum() { return PI_DIGIT_CHECKSUM; }
  < The published head ("3." + first 60 fractional digits), via a method. >
  String head() { return PI_HEAD; }

  < The handle (locator path) to the 100,000,000-digit deeper reference set. >
  String largePath() { return PI_LARGE_PATH; }
  < The fractional-digit count of the deeper reference set resolved by handle. >
  int largeDigits() { return PI_LARGE_DIGITS; }

  << Self-verify pi using only string equality and concatenation:
       1. the head and its independent echo agree (no tamper);
       2. head and tail compose back to the whole stored value;
       3. the published 50-digit reference is the start of the head fraction.
     Returns true when the catalog pi value is intact. The sibling demo prints
     this on compile (check) and run so SLeeLa reports pi correctness. >>
  boolean verify() {
    if (PI_HEAD != PI_HEAD_ECHO) { return false; }
    if ((PI_HEAD + PI_TAIL) != PI) { return false; }
    if (("3." + PI_REF_50) != firstFiftyTwo()) { return false; }
    return true;
  }

  < The first 52 characters ("3." + 50 digits), rebuilt from the reference. >
  String firstFiftyTwo() { return "3." + PI_REF_50; }

  < A one-line human report of the verification outcome. >
  String report() {
    if (verify()) { return "pi OK: 2048 digits, checksum " + PI_DIGIT_CHECKSUM; }
    return "pi FAILED verification";
  }

  boolean available() { return PI_DIGITS == 2048; }
}

