<< lib/advantage/learner-vs-professional/series/04-agreement/DiAgreement.sleela
   SLeeLa courseware lesson.
   Definition: Device Instructor agreement test: the student and the Purchase Master observe the same field independently and the instructor points at exactly what differs. >>
#sleela 3.0
material;
artifact;
pure;
gasoline;
< Lesson 4. Two independent registries are compared entry by entry. Agreement >
< is the acceptance test. A disagreement names the entry to look at again, >
< and the cycle repeats until the two registries match. >
class DiAgreement {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs. A worker-class
     lesson carries the baseline identity record. >>
  String metaVersion = "1.0.0";
  int metaId = 39104;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-11";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-11";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 5;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  String[] sNouns = new String[8];
  String[] sCarriers = new String[8];
  int sCount = 0;
  String[] mNouns = new String[8];
  String[] mCarriers = new String[8];
  int mCount = 0;

  void studentAdd(String noun, String carrier) {
    sNouns[sCount] = noun; sCarriers[sCount] = carrier; sCount = sCount + 1;
  }

  void masterAdd(String noun, String carrier) {
    mNouns[mCount] = noun; mCarriers[mCount] = carrier; mCount = mCount + 1;
  }

  void studentSet(String noun, String carrier) {
    int i = 0;
    while (i < sCount) {
      if (sNouns[i] == noun) { sCarriers[i] = carrier; }
      i = i + 1;
    }
  }

  int masterIndex(String noun) {
    int i = 0;
    while (i < mCount) {
      if (mNouns[i] == noun) { return i; }
      i = i + 1;
    }
    return -1;
  }

  int studentIndex(String noun) {
    int i = 0;
    while (i < sCount) {
      if (sNouns[i] == noun) { return i; }
      i = i + 1;
    }
    return -1;
  }

  < Prints each difference and returns the number of differences. >
  int compare() {
    int diffs = 0;
    int i = 0;
    while (i < sCount) {
      int j = masterIndex(sNouns[i]);
      if (j < 0) {
        print("  " + sNouns[i] + ": student only, master did not observe it");
        diffs = diffs + 1;
      } else if (mCarriers[j] != sCarriers[i]) {
        print("  " + sNouns[i] + ": student says " + sCarriers[i] + ", master says " + mCarriers[j] + " -> re-observe");
        diffs = diffs + 1;
      }
      i = i + 1;
    }
    int k = 0;
    while (k < mCount) {
      if (studentIndex(mNouns[k]) < 0) {
        print("  " + mNouns[k] + ": master only, student did not observe it");
        diffs = diffs + 1;
      }
      k = k + 1;
    }
    return diffs;
  }

  void verdict(int diffs) {
    if (diffs == 0) { print("  verdict: AGREE, work accepted"); }
    else { print("  verdict: " + diffs + " difference(s), not yet accepted"); }
  }

  void main() {
    print("== Lesson 4: agreement ==");
    masterAdd("ball", "red box");
    masterAdd("book", "blue box");
    masterAdd("block", "shelf");

    studentAdd("ball", "blue box");
    studentAdd("book", "blue box");

    print("-- first comparison --");
    verdict(compare());

    print("-- student re-observes ball and adds block --");
    studentSet("ball", "red box");
    studentAdd("block", "shelf");
    print("-- second comparison --");
    verdict(compare());
  }
}
