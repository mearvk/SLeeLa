<?xml version="1.0" encoding="UTF-8"?>
<bodi-ui id="skya-ui" title="Skya — SLeeLa Telephony" protocol="Guia™">
  <window id="main-window" width="1100" height="760" min-width="980" min-height="700"/>
  <header id="skya-header" logo="/images/skya-logo-blue.jpeg" style-ref="skya-header-surface"/>
  <connection id="connection-bar">
    <control id="host" type="text"/>
    <control id="port" type="text"/>
    <control id="room" type="select"/>
    <command id="connect" action="CLIENT.CONNECT"/>
    <command id="disconnect" action="SESSION.CLOSE"/>
  </connection>
  <styles id="skya-visual-styles">
    <style id="skya-header-surface">
      <gradient id="skya-header-gradient" type="linear" direction="vertical" start="#ffffff" end="#e6e6e6"/>
      <bevel id="skya-header-bevel" orientation="horizontal" style="raised" size="3" light="#ffffff" shadow="#a6a6a6"/>
    </style>
    <style id="skya-content-surface">
      <gradient id="skya-content-gradient" type="linear" direction="vertical" start="#ffffff" end="#f0f0f0"/>
    </style>
    <style id="skya-footer-surface">
      <gradient id="skya-footer-gradient" type="linear" direction="vertical" start="#f7f7f7" end="#dedede"/>
    </style>
  </styles>
  <content id="tabs" style-ref="skya-content-surface">
    <view id="chat" type="chat">
      <command id="chat-send" action="CHAT.SEND"/>
    </view>
    <view id="video" type="video">
      <command id="video-start" action="VIDEO.START"/>
      <command id="video-stop" action="VIDEO.STOP"/>
    </view>
    <view id="audio" type="audio">
      <command id="audio-start" action="AUDIO.START"/>
      <command id="audio-stop" action="AUDIO.STOP"/>
    </view>
    <view id="file-transfer" type="file">
      <command id="file-send" action="FILE.SEND"/>
    </view>
  </content>
  <footer id="protocol-footer" title="Protocol Message Scroller" callback="Guia™" position="bottom" style-ref="skya-footer-surface">
    <divider id="protocol-divider" orientation="horizontal" style="2d-bevel"/>
    <message-bar id="guia-message-bar" mode="scroll" messages="1-16" position="lowest"/>
  </footer>
  <!-- Bindings map a Guia command/event to the footer message-scroller step.
       The command/action and event names here match the live Guia vocabulary
       served by sleela/SkyaClient.sleela (see docs/GUIA-PROTOCOL.md). -->
  <bindings>
    <binding event="GUI.CREATE" target="guia-message-bar" message="1"/>
    <binding event="CLIENT.CONNECT" target="guia-message-bar" message="4"/>
    <binding event="SESSION.CLOSE" target="guia-message-bar" message="6"/>
    <binding event="CHAT.SEND" target="guia-message-bar" message="11"/>
    <binding event="LISTENER.RECEIVE" target="guia-message-bar" message="13"/>
    <binding event="AUDIO.START" target="guia-message-bar" message="10"/>
    <binding event="AUDIO.STOP" target="guia-message-bar" message="10"/>
    <binding event="VIDEO.START" target="guia-message-bar" message="10"/>
    <binding event="VIDEO.STOP" target="guia-message-bar" message="10"/>
    <binding event="FILE.SEND" target="guia-message-bar" message="14"/>
    <binding event="CIRCUIT.START" target="guia-message-bar" message="9"/>
    <binding event="CIRCUIT.PAUSE" target="guia-message-bar" message="9"/>
    <binding event="CIRCUIT.STOP" target="guia-message-bar" message="15"/>
    <binding event="MONITOR.STATUS" target="guia-message-bar" message="15"/>
    <binding event="CONTROL.UPDATE" target="guia-message-bar" message="16"/>
  </bindings>
</bodi-ui>
