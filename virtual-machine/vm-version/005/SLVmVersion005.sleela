/*
 * virtual-machine/vm-version/005/SLVmVersion005.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLVmVersion005 — the loadable manifest for VM version 005
 *   ("gc quality"), the OOD selector record the native VM loads on system
 *   start or a user conference. It names this version's native directory and
 *   the C/C++ main the loader builds and boots, declares the hardening units it
 *   composes (cumulative through v005 of the think-tank arc), and carries the
 *   default configuration profile a user starts from. build() returns the
 *   configured SLVmRuntime a selection resolves to.
 *
 * Mirrors the C/C++ in this folder (the 71-file core + the additive vm_* units
 * through v005). It extends SLVmVersion (lib/vm/src/sleela/SLVmVersion.sleela).
 *
 * Family: vm. Composes SLVmVersion, SLVmConfig, SLVmRuntime.
 */
#sleela 1.3
class SLVmVersion005 extends SLVmVersion {
  void configure() {
    base(5, "idea-vm-005", "gc quality", "virtual-machine/vm-version/005", "vm_gc_test");
    composeThrough(5);
    // default profile tuning for this version (user-editable in setup/conference)
    profile.setVerbosity(SLVmConfig.VERBOSITY_NORMAL);
  }
}
