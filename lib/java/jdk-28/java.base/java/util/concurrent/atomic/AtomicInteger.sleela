  int incrementAndGet() { return addAndGet(1); }
  int decrementAndGet() { return addAndGet(-1); }
  int addAndGet(int delta) {
    lock(31);
    this.value = wrap32(this.value + delta);
    int now = this.value;
    unlock(31);
    return now;
  }
