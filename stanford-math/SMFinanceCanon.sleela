<< stanford-math/SMFinanceCanon.sleela
   SLeeLa Standard Library Definition.
   Definition: The canon of foundational finance and economics equations behind
   money, capitalism, and credit -- the equation of exchange, the time value of
   money, asset pricing, and corporate finance. Each entry records a real name,
   symbolic form, discoverer, and year faithful to the public record; where
   attribution is genuinely diffuse it is marked honestly. >>
#sleela 2.1
< Executive+ class: a standards/products artifact, full metadata record. >
class SMFinanceCanon {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 9250;
  String metaAuthor = "the economics and finance public record";
  String metaDate = "2026-11-02";
  String metaCopyright = "results in the peer-reviewed public record";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-02";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 8;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < ---- Scientific record (purpose / method / gains / bedrock) ---- >
  << Spec-sanctioned extension (SLEELA.syntax §15: ordinary fields + accessors):
     what the canon is for, the method it follows, what its editors gain, and
     the bedrock it rests on. See SMProvenance for the literature callouts. >>
  String metaPurpose = "A curated index of foundational finance and economics equations behind money, capitalism, and credit.";
  String metaScientificMethod = "Tertiary cataloguing: record published results traceable to their primary papers; originate nothing.";
  String metaAuthorialGains = "Editorial credit for the catalogue only; each result belongs to its cited authors/publishers.";
  String metaBedrock = "The peer-reviewed economics and finance record (see SMProvenance).";
  String metaIntegrityGoal = "Record each foundational result under the name history gives it -- credit the economist, claim nothing, and mark diffuse attributions honestly.";
  String getPurpose() { return metaPurpose; }
  void setPurpose(String v) { metaPurpose = v; }
  String getScientificMethod() { return metaScientificMethod; }
  void setScientificMethod(String v) { metaScientificMethod = v; }
  String getAuthorialGains() { return metaAuthorialGains; }
  void setAuthorialGains(String v) { metaAuthorialGains = v; }
  String getBedrock() { return metaBedrock; }
  void setBedrock(String v) { metaBedrock = v; }
  String getIntegrityGoal() { return metaIntegrityGoal; }
  void setIntegrityGoal(String v) { metaIntegrityGoal = v; }

  < ---- The finance / economics canon (public record) ---- >
  SMEquation[] eqs;
  int filled;

  void build() {
    eqs = new SMEquation[52];
    filled = 0;

    add("Equation of exchange (quantity theory of money)", "M V = P T", "monetary economics", "Irving Fisher", "1911");
    add("Compound interest", "A = P (1 + r/n)^(n t)", "finance", "classical; mercantile practice", "unknown");
    add("Continuous compounding", "A = P e^(r t)", "finance", "classical (Euler's e)", "unknown");
    add("Present value (discounting)", "PV = sum_{t} CF_t / (1 + r)^t", "finance", "classical; Fisher (formalized)", "1930");
    add("Future value of an annuity", "FV = C ((1 + r)^n - 1) / r", "finance", "classical actuarial practice", "unknown");
    add("Perpetuity value", "PV = C / r", "finance", "classical", "unknown");
    add("Gordon growth (dividend discount)", "P = D1 / (r - g)", "corporate finance", "Myron J. Gordon", "1959");
    add("Fisher equation (nominal vs real rate)", "1 + i = (1 + r)(1 + pi) ~ i = r + pi", "monetary economics", "Irving Fisher", "1930");
    add("Money multiplier", "m = 1 / rr  (reserve ratio rr)", "monetary economics", "classical; Phillips (formalized)", "1920");
    add("Capital Asset Pricing Model (CAPM)", "E[R_i] = R_f + beta_i (E[R_m] - R_f)", "asset pricing", "William Sharpe; Lintner; Mossin", "1964");
    add("Beta (systematic risk)", "beta_i = Cov(R_i, R_m) / Var(R_m)", "asset pricing", "William Sharpe", "1964");
    add("Modigliani-Miller (irrelevance, no tax)", "V_levered = V_unlevered", "corporate finance", "Modigliani & Miller", "1958");
    add("Weighted average cost of capital", "WACC = (E/V) r_E + (D/V) r_D (1 - Tc)", "corporate finance", "standard corporate finance", "unknown");
    add("Bond price (discounted cash flows)", "P = sum_{t} C / (1 + y)^t + F / (1 + y)^n", "fixed income", "classical valuation", "unknown");
    add("Macaulay duration", "D = (1/P) sum_{t} t * CF_t / (1 + y)^t", "fixed income", "Frederick Macaulay", "1938");
    add("Sharpe ratio", "S = (R_p - R_f) / sigma_p", "portfolio theory", "William Sharpe", "1966");
    add("Markowitz portfolio variance", "sigma_p^2 = sum_i sum_j w_i w_j Cov(R_i, R_j)", "portfolio theory", "Harry Markowitz", "1952");
    add("Put-call parity", "C - P = S - K e^(-r T)", "mathematical finance", "classical; Stoll (formalized)", "1969");
    add("Okun's law", "dU ~ -c (g_Y - g_bar)", "macroeconomics", "Arthur Okun", "1962");
    add("Phillips curve", "pi = pi_e - a (u - u_n)", "macroeconomics", "A. W. Phillips", "1958");
    add("Taylor rule", "i = r* + pi + a_pi (pi - pi*) + a_y (y - y*)", "monetary policy", "John B. Taylor", "1993");
    add("Cobb-Douglas production function", "Y = A K^alpha L^(1 - alpha)", "economic growth", "Cobb & Douglas", "1928");
    add("Solow growth (steady state)", "s f(k) = (n + delta) k", "economic growth", "Robert Solow", "1956");
    add("Marginal cost = marginal revenue", "MC = MR  (profit-maximizing output)", "microeconomics", "classical marginalism (Cournot)", "1838");
    add("Little's Law (throughput-inventory)", "L = lambda W  (avg inventory = throughput * avg flow-time)", "operations economics", "John D. C. Little", "1961");
    add("Black-Scholes delta", "delta_call = N(d1)", "option Greeks", "Black; Scholes; Merton", "1973");
    add("Black-Scholes gamma", "gamma = N'(d1) / (S sigma sqrt(T))", "option Greeks", "Black; Scholes; Merton", "1973");
    add("Black-Scholes vega", "vega = S N'(d1) sqrt(T)", "option Greeks", "Black; Scholes; Merton", "1973");
    add("Black-Scholes theta", "theta = -(S N'(d1) sigma)/(2 sqrt(T)) - r K e^(-r T) N(d2)", "option Greeks", "Black; Scholes; Merton", "1973");
    add("Binomial option pricing (CRR)", "C = e^(-r dt)[p Cu + (1-p) Cd]", "derivatives pricing", "Cox; Ross; Rubinstein", "1979");
    add("Black-76 (futures option)", "C = e^(-r T)[F N(d1) - K N(d2)]", "derivatives pricing", "Fischer Black", "1976");
    add("Forward price (cost of carry)", "F = S e^((r - q) T)", "derivatives pricing", "classical (no-arbitrage)", "unknown");
    add("Covered interest rate parity", "F/S = (1 + r_d)/(1 + r_f)", "international finance", "John Maynard Keynes", "1923");
    add("Vasicek short-rate model", "dr = a(b - r) dt + sigma dW", "fixed income", "Oldrich Vasicek", "1977");
    add("Cox-Ingersoll-Ross model", "dr = a(b - r) dt + sigma sqrt(r) dW", "fixed income", "Cox; Ingersoll; Ross", "1985");
    add("Merton structural credit model", "equity = call option on firm assets", "credit risk", "Robert C. Merton", "1974");
    add("Modified duration", "ModDur = MacaulayDur / (1 + y/k)", "fixed income", "Frederick Macaulay (basis)", "1938");
    add("Bond convexity", "C = (1/P) d2P/dy2", "fixed income", "classical", "unknown");
    add("Yield to maturity (IRR of bond)", "P = sum CF_t / (1 + y)^t", "fixed income", "classical", "unknown");
    add("Fama-French three-factor model", "R - Rf = a + b(Rm-Rf) + s SMB + h HML", "asset pricing", "Fama; French", "1993");
    add("Arbitrage pricing theory (APT)", "E[R] = Rf + sum beta_k lambda_k", "asset pricing", "Stephen Ross", "1976");
    add("Jensen's alpha", "alpha = R_p - [Rf + beta(Rm - Rf)]", "performance measurement", "Michael Jensen", "1968");
    add("Treynor ratio", "T = (R_p - Rf) / beta_p", "performance measurement", "Jack Treynor", "1965");
    add("Sortino ratio", "S = (R_p - R_target) / downside deviation", "performance measurement", "Frank Sortino", "1980");
    add("Value at Risk (parametric)", "VaR = mu - z_alpha sigma", "risk management", "J.P. Morgan (RiskMetrics)", "1994");
    add("GARCH(1,1) variance", "sigma_t^2 = omega + alpha e_{t-1}^2 + beta sigma_{t-1}^2", "financial econometrics", "Tim Bollerslev", "1986");
    add("Rule of 72 (doubling time)", "t_double = 72 / r%", "personal finance", "Luca Pacioli (attrib.)", "1494");
    add("Dividend payout / retention", "g = ROE * retention ratio", "corporate finance", "classical", "unknown");
    add("Economic order quantity (EOQ)", "Q* = sqrt(2 D S / H)", "operations economics", "Ford W. Harris", "1913");
    add("Herfindahl-Hirschman index", "HHI = sum s_i^2", "industrial organization", "Herfindahl; Hirschman", "1945");
  }

  void add(String name, String form, String field, String who, String year) {
    SMEquation e = new SMEquation();
    e.define(name, form, field, who, year);
    eqs[filled] = e;
    filled = filled + 1;
  }

  int count() { return filled; }

  String lineAt(int i) {
    SMEquation e = eqs[i];
    return e.line();
  }
}
