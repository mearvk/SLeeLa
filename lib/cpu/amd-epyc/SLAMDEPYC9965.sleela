/*
 * lib/cpu/amd-epyc/SLAMDEPYC9965.sleela
 * SLeeLa Standard Library Definition.
 * Definition: AMD EPYC 9965 (Zen 5c "Turin Dense", 9005 series flagship).
 *   192 cores / 384 threads, 2.25 GHz base / 3.7 GHz max boost, 384 MB L3,
 *   12-channel DDR5, SP5, up to 500 W. A thin SKU subclass of SLAMDEPYCCPU:
 *   it shares the Zen x86-64 programmer model and decode(), overriding only
 *   configure() with this SKU's rated clock/label. Full figures in
 *   SPECIFICATION.md.
 * Family: cpu. Extends SLAMDEPYCCPU.
 */
#sleela 1.3
class SLAMDEPYC9965 extends SLAMDEPYCCPU {
  void configure() { bringUpModel("AMD EPYC 9965 (Zen 5c Turin, 192C/384T)", 3700); }
}
