  << Draw n uniform samples on [a,b] from a seeded stream into out; returns the
     stream so a caller can continue it. Deterministic for a given seed. >>
  long state;
  void seed(long s) { state = s; }
  double nextUniform(double a, double b) {
    state = state * 6364136223846793005 + 1442695040888963407;
    long v = state;
    if (v < 0) { v = 0 - v; }
    double u = v / 9223372036854775807.0;
    return a + u * (b - a);
  }
  void sample(double a, double b, int n, double[] out) {
    int i = 0;
    while (i < n) { out[i] = nextUniform(a, b); i = i + 1; }
  }
}

