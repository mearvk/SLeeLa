#sleela 2.5
material;
< State model only; native server must enforce it atomically per stream. >
class Http50StreamState {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 11507;
  String metaAuthor = "Max Rupplin vs. Dr. Mrs. Elisabeth Harkins";
  String metaDate = "2026-10-21";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-21";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  String sessionId = "";
  long streamId = 0;
  long nextReceiveSequence = 0;
  long nextSendSequence = 0;
  long receivedBytes = 0;
  long sentBytes = 0;
  long receiveWindow = 0;
  long sendWindow = 0;
  boolean opened = false;
  boolean receiveClosed = false;
  boolean sendClosed = false;
  boolean reset = false;
  void open(String session, long id, long receiveLimit, long sendLimit) {
    sessionId = session; streamId = id;
    receiveWindow = receiveLimit; sendWindow = sendLimit;
    opened = session != "" && id >= 0 && receiveLimit >= 0 && sendLimit >= 0;
  }
  boolean acceptReceiveSequence(long value) {
    if (!opened || reset || receiveClosed || value != nextReceiveSequence ||
        nextReceiveSequence == 9223372036854775807) return false;
    nextReceiveSequence = nextReceiveSequence + 1; return true;
  }
  boolean acceptSendSequence(long value) {
    if (!opened || reset || sendClosed || value != nextSendSequence ||
        nextSendSequence == 9223372036854775807) return false;
    nextSendSequence = nextSendSequence + 1; return true;
  }
  boolean addReceivedBytes(long count) {
    if (!opened || reset || receiveClosed || count < 0 || count > receiveWindow ||
        count > 9223372036854775807 - receivedBytes) return false;
    receivedBytes = receivedBytes + count; receiveWindow = receiveWindow - count; return true;
  }
  boolean addSentBytes(long count) {
    if (!opened || reset || sendClosed || count < 0 || count > sendWindow ||
        count > 9223372036854775807 - sentBytes) return false;
    sentBytes = sentBytes + count; sendWindow = sendWindow - count; return true;
  }
  boolean updateReceiveWindow(long amount) {
    if (!opened || reset || amount <= 0 || amount > 268435456 - receiveWindow) return false;
    receiveWindow = receiveWindow + amount; return true;
  }
  boolean updateSendWindow(long amount) {
    if (!opened || reset || amount <= 0 || amount > 268435456 - sendWindow) return false;
    sendWindow = sendWindow + amount; return true;
  }
  void closeReceive() { receiveClosed = true; }
  void closeSend() { sendClosed = true; }
  void resetStream() { reset = true; receiveClosed = true; sendClosed = true; }
  boolean isClosed() { return reset || (receiveClosed && sendClosed); }
}
