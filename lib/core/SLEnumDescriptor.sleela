#sleela 1.3
// Native foundational bridge contract for EnumDescriptor.
// Role: language. Responsibility: runtime enum metadata.
class SLEnumDescriptor {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
