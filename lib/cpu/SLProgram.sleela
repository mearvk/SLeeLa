/*
 * lib/cpu/SLProgram.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLProgram — an executable image: a sequence of encoded
 *   instructions plus an entry point and a name. A program is produced by the
 *   assembler (SLAssembler), stored by the filesystem, loaded into memory by
 *   SLProgramLoader, and run as a process on the Sleela CPU under the Sleela OS.
 *
 * Instructions are staged into a backing SLRAM region at build time so the
 * loader can copy them to their final load address.
 *
 * A program may also carry an SLTimingManifest — the stated timing/voltage/
 * expertise operating point the image was compiled for. When present, a
 * compiler or VM operates those DECLARED timings instead of assuming the
 * quality of the hardware ("rather than inherently to expect the quality of
 * these operating as confidences of how CPUs operate").
 *
 * A program may likewise carry an SLAccessManifest — the stated meaning of its
 * public / private / protected members as system roles (exposed hop / local /
 * integrity-guarded), so the VM stands up a clean System backdrop from the
 * declared semantics instead of inferring a file-network topology.
 *
 * Family: cpu. Composes SLInstruction, SLRAM, SLTimingManifest, SLAccessManifest.
 */
#sleela 2.1
class SLProgram {
  String name;
  int entryPoint;
  int length;        // instruction count
  SLRAM image;       // staging buffer holding the encoded words
  SLTimingManifest timing;   // stated operating point (null until attached)
  SLAccessManifest access;   // stated access semantics (null until attached)

  void configure(String programName, int capacityWords) {
    name = programName; entryPoint = 0; length = 0;
    image = new SLRAM(); image.configure(capacityWords, 32); image.allocate();
    timing = null; access = null;
  }

  void setEntryPoint(int addr) { entryPoint = addr; }

  // Attach the stated timing/voltage/expertise manifest this image was compiled
  // for. The loader and VM read it instead of inferring an operating point.
  void attachTiming(SLTimingManifest manifest) { timing = manifest; }
  SLTimingManifest timingManifest() { return timing; }
  boolean hasTiming() { return timing != null; }
  // True only when the image declares an operating point AND that point was
  // sealed honored at compile time — the consumer may trust it as stated.
  boolean timingHonored() { return timing != null && timing.honored(); }

  // Attach the stated access-semantics manifest (public/private/protected as
  // system roles). The VM reads it to stand up the System backdrop instead of
  // guessing a file-network topology.
  void attachAccess(SLAccessManifest manifest) { access = manifest; }
  SLAccessManifest accessManifest() { return access; }
  boolean hasAccess() { return access != null; }
  // True only when the image declares access semantics AND they were sealed as
  // a competent backdrop the consumer may realize as stated.
  boolean accessCompetent() { return access != null && access.competent(); }

  // Append one encoded instruction word to the image.
  int append(int encodedWord) {
    image.writeWord(length, encodedWord);
    int at = length;
    length = length + 1;
    return at;
  }

  int wordAt(int index) { return image.readWord(index); }
  int size() { return length; }
  int entry() { return entryPoint; }
  String programName() { return name; }
}
