/*
 * lib/regex/RegexFlags.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexFlags used within the regex library family.
 */
#sleela 1.3
class RegexFlags {
  int value;
  void clear(){value=0;}
  void ignoreCase(){value=value+1;}
  void newline(){value=value+2;}
  void noSubexpressions(){value=value+4;}
  int get(){return value;}
}
