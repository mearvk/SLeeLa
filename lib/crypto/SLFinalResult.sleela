/*
 * lib/crypto/SLFinalResult.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLFinalResult, the final
 *   standard result of the whole cryptography process.
 *
 * Order and Orientation: The terminal stage. Produced after the national-register
 *   call, it closes the pipeline with the standard result of all of it.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLFinalResult {
  String cipherText;   // the final standard cipher text
  boolean registered;  // whether the national register accepted the result
  boolean verified;    // whether the comparator matched
  int state;

  void finalise(SLCryptoResult result, boolean didVerify, boolean didRegister) {
    cipherText = result == null ? "" : result.value();
    verified = didVerify;
    registered = didRegister;
    state = 1;
  }

  void enable() { state = 1; }
  void disable() { state = 0; }
  boolean active() { return state == 1; }

  String value() { return cipherText; }
  boolean ok() { return state == 1 && verified && registered; }
}
