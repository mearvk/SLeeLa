<< SLeeLa Standard Library Definition.
  Definition: Linux-specific OS backend grouping terms and native symbol catalogue.
  Names cover POSIX/libc and Linux interfaces; prefer libc wrappers over raw syscalls.
  Procfs/sysfs and service-manager interfaces are optional and permission-dependent. >>
#sleela 2.5
material;

class SLOsSupportLinux {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override each record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 0;
  String metaAuthor = "mearvk";
  String metaDate = "2026-11-05";
  String metaCopyright = "Copyright mearvk LLC";
  String metaTrademark = "none";
  String metaCorporation = "mearvk LLC";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-05";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 8;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String value) { metaVersion = value; }
  int getMetaId() { return metaId; }
  void setMetaId(int value) { metaId = value; }
  String getMetaAuthor() { return metaAuthor; }
  void setMetaAuthor(String value) { metaAuthor = value; }
  String getMetaDate() { return metaDate; }
  void setMetaDate(String value) { metaDate = value; }
  String getMetaCopyright() { return metaCopyright; }
  void setMetaCopyright(String value) { metaCopyright = value; }
  String getMetaTrademark() { return metaTrademark; }
  void setMetaTrademark(String value) { metaTrademark = value; }
  String getMetaCorporation() { return metaCorporation; }
  void setMetaCorporation(String value) { metaCorporation = value; }
  String getMetaOrigin() { return metaOrigin; }
  void setMetaOrigin(String value) { metaOrigin = value; }
  String getMetaBirthDate() { return metaBirthDate; }
  void setMetaBirthDate(String value) { metaBirthDate = value; }
  int getMetaScienceRating() { return metaScienceRating; }
  void setMetaScienceRating(int value) { metaScienceRating = value; }
  String getMetaNationalSchedule() { return metaNationalSchedule; }
  void setMetaNationalSchedule(String value) { metaNationalSchedule = value; }
  String platformName = "Linux";
  String backendTerm = "LinuxBackend";

  String getPlatformName() { return platformName; }
  String getBackendTerm() { return backendTerm; }

  SLList getGroupTerms() {
    SLList out = new SLList();
    out.add("LinuxKernelAndDistribution");
    out.add("LinuxProcessMetadata");
    out.add("LinuxResourceLimits");
    out.add("LinuxMemoryAndLoad");
    out.add("LinuxCPUTopology");
    out.add("LinuxFileSystemAndMounts");
    out.add("LinuxDeviceMetadata");
    out.add("LinuxNetwork");
    out.add("LinuxEventNotification");
    out.add("LinuxResourceControls");
    out.add("LinuxServicesAndSessions");
    out.add("LinuxClockAndPower");
    return out;
  }

  < POSIX/libc and Linux function names, alphabetically. >
  SLList getLinuxFunctions() {
    SLList out = new SLList();
    out.add("accept");
    out.add("access");
    out.add("bind");
    out.add("clock_getres");
    out.add("clock_gettime");
    out.add("close");
    out.add("closedir");
    out.add("connect");
    out.add("dup");
    out.add("epoll_create1");
    out.add("epoll_ctl");
    out.add("epoll_wait");
    out.add("execve");
    out.add("fstat");
    out.add("fstatvfs");
    out.add("ftruncate");
    out.add("getaddrinfo");
    out.add("getcwd");
    out.add("getegid");
    out.add("geteuid");
    out.add("getgid");
    out.add("gethostname");
    out.add("getifaddrs");
    out.add("getnameinfo");
    out.add("getpid");
    out.add("getppid");
    out.add("getpriority");
    out.add("getrlimit");
    out.add("getsockname");
    out.add("getsockopt");
    out.add("gettimeofday");
    out.add("getuid");
    out.add("inotify_add_watch");
    out.add("inotify_init1");
    out.add("inotify_rm_watch");
    out.add("ioctl");
    out.add("listen");
    out.add("lseek");
    out.add("lstat");
    out.add("mmap");
    out.add("munmap");
    out.add("nanosleep");
    out.add("open");
    out.add("opendir");
    out.add("poll");
    out.add("pread");
    out.add("pwrite");
    out.add("read");
    out.add("readlink");
    out.add("recv");
    out.add("recvfrom");
    out.add("rename");
    out.add("select");
    out.add("send");
    out.add("sendto");
    out.add("setenv");
    out.add("setrlimit");
    out.add("setsockopt");
    out.add("shutdown");
    out.add("socket");
    out.add("stat");
    out.add("statvfs");
    out.add("sysconf");
    out.add("sysinfo");
    out.add("uname");
    out.add("unsetenv");
    out.add("write");
    return out;
  }

  SLList getAdditionalInterfaces() {
    SLList out = new SLList();
    out.add("cgroup-v1");
    out.add("cgroup-v2");
    out.add("netlink-NETLINK_ROUTE");
    out.add("procfs");
    out.add("sysfs");
    out.add("systemd-DBus");
    return out;
  }

  SLList getPlatformTerms() {
    SLList out = new SLList();
    out.add("cgroup");
    out.add("epoll");
    out.add("inotify");
    out.add("libc");
    out.add("LinuxBackend");
    out.add("netlink");
    out.add("POSIX");
    out.add("procfs");
    out.add("sysfs");
    out.add("systemd");
    return out;
  }
}
