/*
 * lib/core/SLValidator.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLValidator used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Validator.
// Role: language. Responsibility: contract validation.
class SLValidator {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
