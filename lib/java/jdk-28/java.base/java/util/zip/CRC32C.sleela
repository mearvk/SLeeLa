  << The CRC-32C (Castagnoli) of RFC 3720. Table driven (reflected polynomial 2197175160), exactly the checksum
     java.util.zip.CRC32C computes. Bytes are ints (only the low 8 bits are
     used). update(byte[], off, len) is updateBytes; update(byte[]) is
     updateAll. >>
  long crc;
  long[] table;
  CRC32C() {
    initNibbles();
    this.table = new long[256];
    int n = 0;
    while (n < 256) {
      long c = n;
      int k = 0;
      while (k < 8) {
        if (c % 2 == 1) { c = xor32(2197175160, c / 2); } else { c = c / 2; }
        k = k + 1;
      }
      this.table[n] = c;
      n = n + 1;
    }
    this.crc = 4294967295;
  }
  void update(int b) {
    long byteVal = b % 256;
    if (byteVal < 0) { byteVal = byteVal + 256; }
    long idx = xor32(this.crc % 256, byteVal);
    this.crc = xor32(this.table[(int) idx], this.crc / 256);
  }
  void updateBytes(int[] b, int off, int len) {
    if (off < 0 || len < 0 || off > arrayLength(b) - len) { throw new ArrayIndexOutOfBoundsException(null); }
    int i = off;
    while (i < off + len) { update(b[i]); i = i + 1; }
  }
  void updateAll(int[] b) { updateBytes(b, 0, arrayLength(b)); }
  long getValue() { return xor32(this.crc, 4294967295); }
  void reset() { this.crc = 4294967295; }
  << Bitwise operations on unsigned 32-bit values through a 4-bit table
     (the VM has no bitwise operators). >>
  int[] nib;
  void initNibbles() {
    this.nib = new int[256];
    int a = 0;
    while (a < 16) {
      int b = 0;
      while (b < 16) {
        int r = 0;
        int bit = 1;
        int x = a;
        int y = b;
        int k = 0;
        while (k < 4) {
          if ((x % 2) != (y % 2)) { r = r + bit; }
          x = x / 2; y = y / 2; bit = bit * 2; k = k + 1;
        }
        this.nib[a * 16 + b] = r;
        b = b + 1;
      }
      a = a + 1;
    }
  }
  long xor32(long a, long b) {
    long r = 0;
    long mul = 1;
    long x = a;
    long y = b;
    int k = 0;
    while (k < 8) {
      r = r + this.nib[(int) ((x % 16) * 16 + (y % 16))] * mul;
      x = x / 16; y = y / 16; mul = mul * 16; k = k + 1;
    }
    return r;
  }
