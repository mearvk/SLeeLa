<< lib/cpu/SLInterruptController.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLInterruptController — the unit that fields hardware and
     software interrupts (timer, I/O completion, faults, syscalls) and tells the
     core where to jump to service them. It holds an interrupt vector base,
     masks, and a pending set. This is how the OS regains control from a running
     program (preemption via the timer interrupt).
   
   Models up to 16 interrupt lines (IRQ0..IRQ15).
   
   Family: cpu. Pure Sleela controller. >>
#sleela 2.5
material;
class SLInterruptController {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10255;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-10-16";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-06";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  static final int LINES = 16;
  static final int IRQ_TIMER = 0;
  static final int IRQ_KEYBOARD = 1;
  static final int IRQ_DISK = 2;
  static final int IRQ_NETWORK = 3;

  < base address of the interrupt vector table >
  int vectorBase;
  < bitset of raised-but-unserviced lines >
  int pendingMask;
  < bitset of enabled lines >
  int enableMask;
  int serviced;

  void configure(int base) { vectorBase = base; pendingMask = 0; enableMask = 0; serviced = 0; }

  int pow2(int n) { int p = 1; int i = 0; while (i < n) { p = p * 2; i = i + 1; } return p; }
  boolean bitSet(int mask, int line) { return (mask / pow2(line)) % 2 == 1; }

  void enable(int line) { if (!bitSet(enableMask, line)) { enableMask = enableMask + pow2(line); } }
  void raise(int line) { if (bitSet(enableMask, line) && !bitSet(pendingMask, line)) { pendingMask = pendingMask + pow2(line); } }

  boolean hasPending() { return pendingMask != 0; }

  < Return the lowest-numbered pending line (highest priority), or -1 if none. >
  int highestPriorityPending() {
    int line = 0;
    while (line < LINES) { if (bitSet(pendingMask, line)) { return line; } line = line + 1; }
    return -1;
  }

  < Acknowledge a line: clear it and return its handler address. >
  int acknowledge(int line) {
    if (bitSet(pendingMask, line)) { pendingMask = pendingMask - pow2(line); serviced = serviced + 1; }
    return vectorBase + line;
  }

  int servicedCount() { return serviced; }
}
