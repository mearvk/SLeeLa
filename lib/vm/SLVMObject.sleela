/*
 * lib/vm/SLVMObject.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLVMObject — a typed handle to a heap-allocated instance
 *   in the secondary Sleela VM. The object's state lives in SLVMHeap (header +
 *   field slots); SLVMObject is the convenient surface a Sleela-sourced VM uses
 *   to read and write that state by field index without touching raw SLRAM.
 *
 * It binds a heap handle to the heap that owns it, so getField/setField route
 * through the GC-aware store and the object participates in marking.
 *
 * Family: vm. Composes SLVMHeap, SLVMValue.
 */
#sleela 1.3
class SLVMObject {
  SLVMHeap heap;
  int handle;      // -1 == null object

  void bind(SLVMHeap h, int objectHandle) { heap = h; handle = objectHandle; }

  // Allocate a fresh instance of classId with fieldCount fields on the heap.
  void create(SLVMHeap h, int classId, int fieldCount) {
    heap = h;
    handle = h.allocate(classId, fieldCount);
  }

  boolean isNull()  { return handle < 0; }
  int reference()   { return handle; }
  int classId()     { return (handle < 0) ? -1 : heap.classOf(handle); }
  int fieldCount()  { return (handle < 0) ? 0 : heap.fieldCount(handle); }

  void getField(int index, SLVMValue out) {
    if (handle < 0) { out.setNull(); return; }
    heap.getField(handle, index, out);
  }
  void setField(int index, SLVMValue v) {
    if (handle < 0) { return; }
    heap.setField(handle, index, v);
  }

  // Convenience scalar accessors for the common integer-field case.
  int getInt(int index) {
    SLVMValue tmp = new SLVMValue();
    getField(index, tmp);
    return tmp.asInt();
  }
  void setInt(int index, int value) {
    SLVMValue tmp = new SLVMValue();
    tmp.setInt(value);
    setField(index, tmp);
  }

  void mark() { if (handle >= 0) { heap.mark(handle); } }
}
