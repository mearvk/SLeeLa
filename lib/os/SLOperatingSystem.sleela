/*
 * lib/os/SLOperatingSystem.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLOperatingSystem used within the os library family.
 */
#sleela 1.3
// Unified SLeeLa standard-library front-end object.
// Family: os. Native VM/OS work crosses an explicit bridge.
class SLOperatingSystem {
  String name; int state; void configure(String n){name=n;} void open(){state=1;} void close(){state=0;} boolean active(){return state==1;}
}
