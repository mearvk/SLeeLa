  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  << A fixed-point number as a scaled long with a fixed number of fractional
     bits. Conversions and basic arithmetic preserve the scale. >>
  int fracBits;
  long raw;
  void configure(int bits) { fracBits = bits; }
  void fromDouble(double x) {
    long scale = 1;
    int i = 0;
    while (i < fracBits) { scale = scale * 2; i = i + 1; }
    raw = (long) (x * scale);
  }
  double toDouble() {
    long scale = 1;
    int i = 0;
    while (i < fracBits) { scale = scale * 2; i = i + 1; }
    return (double) raw / scale;
  }
  long getRaw() { return raw; }
}

