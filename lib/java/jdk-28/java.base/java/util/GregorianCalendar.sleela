  public void set(int field, int value) {
    long days = gfdiv(this.gcTime, 86400000);
    long ms = gfmod(this.gcTime, 86400000);
    int y = gYear(days);
    int mo = gMonth(days) - 1;
    int d = gDay(days);
    int h = (int) (ms / 3600000);
    int mi = (int) ((ms / 60000) % 60);
