;;; sleela-american-theme.el --- SLeeLa American Professional theme -*- lexical-binding: t; -*-
(deftheme sleela-american "Deep navy with American blue, teal, amber and slate syntax colors.")
(custom-theme-set-faces
 'sleela-american
 '(default ((t (:foreground "#F4F7FA" :background "#101820"))))
 '(cursor ((t (:background "#7FB3FF"))))
 '(region ((t (:background "#233D55" :extend t))))
 '(highlight ((t (:background "#172632"))))
 '(fringe ((t (:foreground "#8A96A3" :background "#101820"))))
 '(line-number ((t (:foreground "#8A96A3" :background "#101820"))))
 '(line-number-current-line ((t (:foreground "#7FB3FF" :weight bold))))
 '(mode-line ((t (:foreground "#F4F7FA" :background "#233D55" :box nil :weight bold))))
 '(mode-line-inactive ((t (:foreground "#8A96A3" :background "#172632" :box nil))))
 '(minibuffer-prompt ((t (:foreground "#7FB3FF" :weight bold))))
 '(font-lock-builtin-face ((t (:foreground "#73DACA"))))
 '(font-lock-comment-face ((t (:foreground "#8A96A3" :slant italic))))
 '(font-lock-constant-face ((t (:foreground "#FF8F8F"))))
 '(font-lock-function-name-face ((t (:foreground "#82C91E" :weight bold))))
 '(font-lock-keyword-face ((t (:foreground "#7FB3FF" :weight bold))))
 '(font-lock-string-face ((t (:foreground "#F2C078"))))
 '(font-lock-type-face ((t (:foreground "#73DACA" :weight bold))))
 '(font-lock-variable-name-face ((t (:foreground "#F4F7FA"))))
 '(font-lock-warning-face ((t (:foreground "#FF6B6B" :weight bold :underline t))))
 '(error ((t (:foreground "#FF6B6B" :weight bold))))
 '(warning ((t (:foreground "#F2C078" :weight bold))))
 '(success ((t (:foreground "#82C91E" :weight bold))))
 '(show-paren-match ((t (:foreground "#F4F7FA" :background "#31536C" :weight bold))))
 '(isearch ((t (:foreground "#101820" :background "#F2C078" :weight bold))))
 '(lazy-highlight ((t (:foreground "#F4F7FA" :background "#233D55")))))
(provide-theme 'sleela-american)
;;; sleela-american-theme.el ends here
