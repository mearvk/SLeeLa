/*
 * lib/image/SLImageCodecLoader.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLImageCodecLoader used within the image library family.
 */
#sleela 2.1
// Unified SLeeLa standard-library front-end object.
// Family: image. The SLeeLa-facing handle to the Image Codec Loader /
// Unloader / Management Controller, parallel to the audio lib/codecs Loader
// and the lib/video video-codec surface. SLeeLa calls the Loader -- never an
// individual image codec. The Loader keeps a registry of every image codec and
// a per-codec loaded flag; a program loads a codec by id, decodes/encodes
// through the Loader, then unloads it.
//
// Image codec ids (0-based, in registry order):
//   0 PPM/PNM  1 BMP  2 TGA  3 PNG  4 JPEG  5 GIF  6 TIFF  7 WEBP
//   8 HEIF  9 AVIF  10 JPEG_XL  11 JPEG_2000  12 ICO  13 SVG  14 DDS
//   15 OPENEXR  16 RADIANCE_HDR  17 PCX  18 XPM  19 ICNS
//
// Handler states: 0 native, 1 backend, 2 recognized, 3 container, 4 event.
// Native image codecs decode/encode uncompressed or simple-RLE raster formats
// in-package; the compressed/container formats advertise a backend state and
// fail cleanly until an approved backend adapter is registered.
class SLImageCodecLoader {
  // Per-codec loaded flag (1 loaded, 0 not), indexed by codec id. Backed by the
  // first-class array type; call init() before use.
  int[] loaded;

  // The number of image codecs the registry knows.
  int codecCount() { return 20; }

  // Allocate the loaded-flag table with every codec unloaded.
  void init() { loaded = new int[20]; }

  // load(id): mark a codec loaded.
  void load(int id) { loaded[id] = 1; }

  // unload(id): mark a codec unloaded.
  void unload(int id) { loaded[id] = 0; }

  boolean isLoaded(int id) { return loaded[id] == 1; }

  // unloadAll(): release every loaded codec.
  void unloadAll() {
    int i = 0;
    while (i < 20) { loaded[i] = 0; i = i + 1; }
  }

  // Human-readable codec name by id, matching the registry.
  String nameOf(int id) {
    if (id == 0) { return "PPM/PNM (Netpbm)"; }
    if (id == 1) { return "BMP"; }
    if (id == 2) { return "Truevision TGA"; }
    if (id == 3) { return "PNG"; }
    if (id == 4) { return "JPEG"; }
    if (id == 5) { return "GIF"; }
    if (id == 6) { return "TIFF"; }
    if (id == 7) { return "WebP"; }
    if (id == 8) { return "HEIF/HEIC"; }
    if (id == 9) { return "AVIF"; }
    if (id == 10) { return "JPEG XL"; }
    if (id == 11) { return "JPEG 2000"; }
    if (id == 12) { return "ICO/CUR"; }
    if (id == 13) { return "SVG"; }
    if (id == 14) { return "DirectDraw Surface (DDS)"; }
    if (id == 15) { return "OpenEXR"; }
    if (id == 16) { return "Radiance HDR"; }
    if (id == 17) { return "PCX"; }
    if (id == 18) { return "X PixMap (XPM)"; }
    return "Apple Icon Image (ICNS)";
  }

  // Native image codecs decode/encode raster in-package (no external backend):
  // PPM/PNM (0), BMP (1), TGA (2), Radiance HDR (16), PCX (17). The rest are
  // backend/recognized/container handlers until an approved adapter is wired.
  boolean isNative(int id) {
    return id == 0 || id == 1 || id == 2 || id == 16 || id == 17;
  }
}
