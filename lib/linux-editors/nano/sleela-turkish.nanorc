## SLeeLa syntax highlighting for nano (SLeeLa Turkish palette).
## Requires nano >= 5.0 for 24-bit "color #RRGGBB" values.
syntax sleela "\.sleela$"
comment "//"

## keywords, types, literals
color #f23d48 "\<(let|var|const|if|else|while|for|in|return|break|continue|class|interface|extends|implements|new|this|super|import|package|public|private|protected|static|final|true|false|null|nil|and|or|not|try|catch|throw|synchronized|finally|switch|case|default|do|assert|yield|instanceof)\>"
color #f0a9ae "\<(String|SLString|Integer|Int|Long|Double|Float|Boolean|Character|Byte|Short|Void|Object|List|Map|Set|Array|int64|int128|long|double|boolean)\>"
## function-call heads
color #ffffff "[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\("
## numbers
color #f3d5c7 "\<[0-9]+\>"
## strings (double- and single-quoted; inner double-quote escaped as \")
color #f0c9a9 "\"(\\.|[^\"\\])*\""
color #f0c9a9 "'(\\.|[^'\\])*'"
## annotations and the document pragmas
color #f0a9ae "@[A-Za-z_][A-Za-z0-9_]*"
color #f0a9ae "^[[:space:]]*#(sleela|schema)\>.*$"
## document markers (only when alone on a line, optional ;)
color #f0a9ae "^[[:space:]]*(author|authorial|material|memory|determine)[[:space:]]*;?[[:space:]]*$"
## comments: // line and /* */ block, plus << >> and < > angle forms
color #a8767a "//.*$"
color #a8767a start="/\*" end="\*/"
color #a8767a start="^[[:space:]]*<<" end=">>"
color #a8767a "^[[:space:]]*<[^<].*>?$"
## TODO/FIXME/NOTE/XXX inside comments
color #ffffff "\<(TODO|FIXME|NOTE|XXX)\>"
