/*
 * lib/cpu/SLHardDrive.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLHardDrive — persistent block storage (an HDD or SSD).
 *   It is the slowest, largest tier of the storage hierarchy and the device the
 *   OS boots from and loads programs out of. It presents a block interface
 *   (read/write by block number) and crosses the explicit VM/OS bridge to the
 *   native file-backed store.
 *
 * Models capacity in blocks, block size, media kind (spinning vs. solid-state),
 * and I/O counters.
 *
 * Family: cpu. Native file-backed store via bridge.
 */
#sleela 1.3
class SLHardDrive {
  static final int MEDIA_HDD = 0; // rotational
  static final int MEDIA_SSD = 1; // solid-state

  String name;
  int blockCount;
  int blockBytes;
  int media;
  int handle;
  int reads;
  int writes;

  void configure(String driveName, int blocks, int bsize, int mediaKind) {
    name = driveName; blockCount = blocks; blockBytes = bsize; media = mediaKind;
    handle = 0; reads = 0; writes = 0;
  }

  // Mount the native file-backed store, creating it if absent.
  int mount(String path) {
    handle = native sleela_blockdev_open(path, blockCount, blockBytes);
    return handle;
  }

  boolean inRange(int block) { return block >= 0 && block < blockCount; }

  int readBlock(int block) {
    if (!inRange(block) || handle == 0) { return -1; }
    reads = reads + 1;
    return native sleela_blockdev_read(handle, block);
  }

  int writeBlock(int block, int payloadHandle) {
    if (!inRange(block) || handle == 0) { return -1; }
    writes = writes + 1;
    return native sleela_blockdev_write(handle, block, payloadHandle);
  }

  void unmount() { if (handle != 0) { native sleela_blockdev_close(handle); handle = 0; } }

  int capacityBlocks() { return blockCount; }
  int capacityBytes() { return blockCount * blockBytes; }
  boolean solidState() { return media == MEDIA_SSD; }
  String driveName() { return name; }
}
