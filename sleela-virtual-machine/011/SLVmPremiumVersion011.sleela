/*
 * sleela-virtual-machine/011/SLVmPremiumVersion011.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLVmPremiumVersion011 -- the loadable SLeeLa manifest for
 *   premium VM generation slvm-11 (codename "Sovereign"; "filesystem-module hosting, schema-driven extension"), the OOD selector
 *   record the native VM can enumerate and select via `sleela vm select premium
 *   11` (or p11). It names this generation's C/C++ project directory, codename,
 *   and admission validator, composes the cumulative premium capability set
 *   through generation 11, and carries the default configuration profile.
 *   build() returns the configured SLVmRuntime a selection resolves to;
 *   nativeBinary() names the binary the master build produces (vm-build/slvm-11).
 *
 * Faithful to impl/frontend/driver.cpp (kPremium), each VM's SLVM_CODENAME
 * (src/slvm11_vm.c), and virtual-machine/USER-GUIDE.md (per-grade validator).
 * It extends SLVmPremiumVersion (lib/vm/src/sleela/SLVmPremiumVersion.sleela).
 *
 * Family: vm. Composes SLVmPremiumVersion, SLVmConfig, SLVmRuntime.
 */
#sleela 2.4
class SLVmPremiumVersion011 extends SLVmPremiumVersion {
  void configure() {
    base(11, "slvm-11", "Sovereign", "filesystem-module hosting, schema-driven extension", "sleela-virtual-machine/011", "TAC3 filesystem module");
    composeThrough(11);
    // default profile tuning for this generation (user-editable in setup/conference)
    profile.setVerbosity(SLVmConfig.VERBOSITY_NORMAL);
  }
}
