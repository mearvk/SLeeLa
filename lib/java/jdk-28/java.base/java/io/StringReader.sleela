  public StringReader(java.lang.String s) {
    if (s == null) { throw new NullPointerException(); }
    if (s instanceof string) { this.srText = javaStringFromUtf8(s); }
    else { this.srText = s; }
    this.srLength = javaStringLength(this.srText);
