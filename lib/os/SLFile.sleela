/*
 * lib/os/SLFile.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLFile — a single named file on the host filesystem. It
 *   pairs the path with metadata queries (exists/size) and namespace operations
 *   (delete/rename) that cross to the real OS through the VM's `os*` built-ins.
 *   Byte-level content I/O is left to the file I/O built-ins (openFile/read/
 *   write/close); SLFile is the path-oriented handle a developer passes around.
 *
 * Family: os. Native VM/OS work crosses the explicit `os*` SLVM bridge.
 */
#sleela 1.5
class SLFile {
  String path;
  void configure(String p) { path = p; }

  String name() { return path; }
  boolean exists() { return osExists(path) == 1; }
  boolean isRegular() { return osExists(path) == 1 && osIsDir(path) == 0; }
  int size() { return osFileSize(path); }

  // Remove this file; returns true on success.
  boolean delete() { return osRemove(path) == 0; }

  // Rename/move this file; on success the handle tracks the new path.
  boolean renameTo(String newPath) {
    if (osRename(path, newPath) == 0) { path = newPath; return true; }
    return false;
  }
}
