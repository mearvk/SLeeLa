/*
 * lib/regex/RegexLiteral.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexLiteral used within the regex library family.
 */
#sleela 1.3
class RegexLiteral {
  string value;
  void set(string text){value=text;}
  string escaped(){return value;}
}
