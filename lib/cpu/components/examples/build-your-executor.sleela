/*
 * lib/cpu/components/examples/build-your-executor.sleela
 * SLeeLa example: build a custom Sleela executor from catalog parts, overclock
 * the CPU, upgrade the RAM/storage, and run a program on it under the SLVM.
 */
#sleela 1.3
class BuildYourExecutorExample {
  int result;

  void main() {
    SLComponentCatalog parts = new SLComponentCatalog();

    // Pick a CPU and run it ABOVE spec (6502 rated at 1 MHz, pushed to 14 MHz).
    SL6502CPU cpu = new SL6502CPU();
    cpu.configure();
    print("6502 spec clock: " + cpu.specClockMHz() + " MHz");

    // Assemble a build: overclocked CPU + DDR4 + NVMe + Blu-ray on PCIe 4.0.
    SLExecutorBuild build = new SLExecutorBuild();
    build.configure("retro-overclock");
    build.installCpu(cpu);
    build.installMemory(parts.ddr4_3200(16384));   // 16 GiB DDR4-3200
    build.installStorage(parts.nvmeGen4());         // 7 GB/s NVMe
    build.installOptical(parts.bluRay());           // 16x Blu-ray
    build.installBus(parts.pcieGen4x16());          // PCIe 4.0 x16

    boolean stable = build.setClock(14);            // overclock the 6502 to 14 MHz
    build.assemble();
    print("effective clock: " + build.cpuEffectiveMHz() + " MHz, overclocked=" +
          build.cpuOverclocked() + ", stable=" + stable);
    print("RAM: " + build.ram().technologyName() + " @ " + build.ram().peakBandwidthMBs() +
          " MB/s, CL" + build.ram().cl());
    print("storage: " + build.disk().className() + " " + build.disk().transferRate() + " MB/s");
    print("effective mem bandwidth (RAM vs bus): " + build.effectiveMemoryBandwidthMBs() + " MB/s");

    // Run a C program on the assembled executor via the Creator -> SLVM stack.
    SLCPUResource grant = new SLCPUResource();
    grant.configure(4096, 100000, grant.PRIORITY_NORMAL);
    SLWorkload job = new SLWorkload();
    job.configure("hello", "examples/hello.c", job.LANG_C, grant);

    SleelaVMCreator creator = new SleelaVMCreator();
    creator.configure();
    result = creator.run(5, build.processor(), job, 1000000);
    print("program result on the built executor -> " + result);
  }
}
