/*
 * lib/http-6.0/SLPackage.sleela
 * SLeeLa Standard Library Definition for HTTP 6.0.
 */
#sleela 2.1
// Capability flags describe source models and tested contracts, not production guarantees.
class SLPackage {
  String packageName;
  void configure(String name){packageName=name;}
  String name(){return packageName;}
  String generation(){return "6.0";}
  boolean consolidatedFriendsBetModelAvailable(){return true;}
  boolean teamsterDebateModelAvailable(){return true;}
  boolean strictFrameFlagValidationAvailable(){return true;}
  boolean strictHttpFramingValidationAvailable(){return true;}
  boolean strictDownloadMetadataParserAvailable(){return true;}
  boolean completeFramePayloadSchemasAvailable(){return false;}
  boolean integratedStreamStateMachineAvailable(){return false;}
  boolean enforcedFlowControlAvailable(){return false;}
  boolean authenticatedCarrierAvailable(){return false;}
  boolean nativeHttp3QuicAvailable(){return false;}
  boolean durableResumeAvailable(){return false;}
  boolean productionReady(){return false;}
  boolean requiresProtectedTransport(){return true;}
  boolean available(){return packageName!=null;}
}
