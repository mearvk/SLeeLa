/*
 * lib/cpu/SLControlUnit.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLControlUnit — the conductor of a CPU core. It drives
 *   the fetch-decode-execute cycle: read the instruction at the program
 *   counter, decode it, route operands through the register file and ALU,
 *   write results back, update the program counter (sequential or branch), and
 *   set the status flags. It is where the ISA semantics become control signals.
 *
 * This models a classic single-cycle control unit. Pipelining and out-of-order
 * execution are described in CPU.md; the observable semantics are the same.
 *
 * Family: cpu. Composes decoder, register file, ALU, PC, status, and RAM.
 */
#sleela 1.3
class SLControlUnit {
  SLInstructionSet isa;
  SLInstructionDecoder decoder;
  SLRegisterFile regs;
  SLALU alu;
  SLProgramCounter pc;
  SLStatusRegister status;
  SLRAM memory;
  int halted;
  int executed;
  int syscallVector;   // address the OS installed for SYSCALL
  int lastSyscall;     // last syscall number requested (for the kernel to read)

  void configure(SLInstructionSet instructionSet, SLInstructionDecoder dec,
                 SLRegisterFile registers, SLALU unit, SLProgramCounter counter,
                 SLStatusRegister stat, SLRAM ram) {
    isa = instructionSet; decoder = dec; regs = registers; alu = unit;
    pc = counter; status = stat; memory = ram;
    halted = 0; executed = 0; syscallVector = 0; lastSyscall = -1;
  }

  void installSyscallVector(int addr) { syscallVector = addr; }
  boolean isHalted() { return halted == 1; }
  int instructionsRetired() { return executed; }
  int pendingSyscall() { return lastSyscall; }
  void clearSyscall() { lastSyscall = -1; }

  // Execute exactly one instruction at the current PC. Returns the opcode run,
  // or -1 if the core is halted.
  int step() {
    if (halted == 1) { return -1; }
    int word = memory.readWord(pc.value());
    SLInstruction instr = decoder.decode(word);
    int op = instr.op();
    executed = executed + 1;

    if (op == isa.HALT) { halted = 1; return op; }
    if (op == isa.NOP)  { pc.increment(); return op; }

    if (op == isa.LOAD)  { regs.write(instr.dest(), memory.readWord(instr.immediate())); pc.increment(); return op; }
    if (op == isa.STORE) { memory.writeWord(instr.immediate(), regs.read(instr.src())); pc.increment(); return op; }
    if (op == isa.MOV)   { regs.write(instr.dest(), instr.immediate()); pc.increment(); return op; }

    if (isa.isArithmetic(op)) {
      int a = regs.read(instr.dest());
      int b = regs.read(instr.src());
      int aluOp = toAluOp(op);
      int r = alu.execute(a, b, aluOp);
      status.setFromALU(alu);
      if (op != isa.CMP) { regs.write(instr.dest(), r); }
      pc.increment();
      return op;
    }

    if (op == isa.JMP) { pc.branchTo(instr.immediate()); return op; }
    if (op == isa.JZ)  { if (status.zeroFlag() == 1) { pc.branchTo(instr.immediate()); } else { pc.increment(); } return op; }
    if (op == isa.JNZ) { if (status.zeroFlag() == 0) { pc.branchTo(instr.immediate()); } else { pc.increment(); } return op; }

    if (op == isa.SYSCALL) {
      lastSyscall = instr.immediate();
      status.enterSupervisorMode();
      if (syscallVector != 0) { pc.branchTo(syscallVector); } else { pc.increment(); }
      return op;
    }

    // IN/OUT/PUSH/POP/CALL/RET are routed by the core's I/O and stack units;
    // advance by default so the cycle makes progress.
    pc.increment();
    return op;
  }

  // Map ISA arithmetic opcodes onto SLALU operation selectors.
  int toAluOp(int op) {
    if (op == isa.ADD) { return alu.OP_ADD; }
    if (op == isa.SUB) { return alu.OP_SUB; }
    if (op == isa.AND) { return alu.OP_AND; }
    if (op == isa.OR)  { return alu.OP_OR; }
    if (op == isa.XOR) { return alu.OP_XOR; }
    if (op == isa.SHL) { return alu.OP_SHL; }
    if (op == isa.SHR) { return alu.OP_SHR; }
    if (op == isa.CMP) { return alu.OP_SUB; }
    return alu.OP_PASS;
  }

  // Run until HALT or until the instruction budget is exhausted (safety bound).
  int run(int budget) {
    int ran = 0;
    while (halted == 0 && ran < budget) { step(); ran = ran + 1; }
    return ran;
  }
}
