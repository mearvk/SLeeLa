  public static double nextAfter(double start, double direction) {
    if (start != start || direction != direction) { return slNaN(); }
    if (start < direction) { return nextUp(start); }
    if (start > direction) { return nextDown(start); }
    return direction;
  }
  public static double IEEEremainder(double f1, double f2) {
    if (f1 != f1 || f2 != f2 || slIsInf(f1) || f2 == 0.0) { return slNaN(); }
    if (slIsInf(f2)) { return f1; }
    return f1 - f2 * rint(f1 / f2);
  }

  < random: a pseudorandom double in [0.0, 1.0) >
  public static double random() {
    if (slSeed == 0) { slSeed = timeUtcNanos() % 281474976710656; }
    int128 s = slSeed;
    s = (s * 25214903917 + 11) % 281474976710656;
    slSeed = (long) s;
    return slSeed / 281474976710656.0;
  }
  < exact power and unsigned arithmetic >
  << Two-word arithmetic through int128. powExact and unsignedPowExact use
     square-free repeated multiplication, checking the range after every step. >>
  @throwable("java.lang.ArithmeticException")
  public static long powExact(long x, int n) {
    if (n < 0) { throw new ArithmeticException("negative exponent"); }
    int128 lo = -9223372036854775807;
    lo = lo - 1;
    int128 hi = 9223372036854775807;
    int128 r = 1;
    int128 b = x;
    int i = 0;
    while (i < n) {
      r = r * b;
      if (r < lo || r > hi) { throw new ArithmeticException("long overflow"); }
      i = i + 1;
    }
    return (long) r;
  }
  @throwable("java.lang.ArithmeticException")
  public static int powExact(int x, int n) {
    if (n < 0) { throw new ArithmeticException("negative exponent"); }
    long r = 1;
    int i = 0;
    while (i < n) {
      r = r * x;
      if (r < -2147483648 || r > 2147483647) { throw new ArithmeticException("integer overflow"); }
      i = i + 1;
    }
    return (int) r;
  }
  static int128 slTwo64() { int128 t = 4294967296; return t * 4294967296; }
  static int128 slUnsigned(long v) { int128 u = v; if (v < 0) { u = u + slTwo64(); } return u; }
  static long slFromUnsigned(int128 u) { int128 t = u; if (t >= slTwo64() / 2) { t = t - slTwo64(); } return (long) t; }
  public static long unsignedMultiplyHigh(long x, long y) {
    int128 h = multiplyHigh(x, y);
    if (x < 0) { h = h + y; }
    if (y < 0) { h = h + x; }
