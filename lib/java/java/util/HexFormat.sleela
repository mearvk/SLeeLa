  public java.lang.String toHexDigits(long value, int digits) {
    if (digits < 0 || digits > 16) { throw new IllegalArgumentException("number of digits: " + digits); }
    String out = "";
    int i = digits - 1;
    while (i >= 0) {
      long p = 1;
      int k = 0;
      while (k < i) { p = p * 16; k = k + 1; }
      long nib = hfmod(hfdiv(value, p), 16);
      out = out + hexDigit((int) nib);
      i = i - 1;
    }
    return out;
  }
  public char toHighHexDigit(int value) { return hexCode(hfmod(value, 256) / 16); }
  public char toLowHexDigit(int value) { return hexCode(hfmod(value, 256) % 16); }

  public static boolean isHexDigit(int ch) {
    return (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 70) || (ch >= 97 && ch <= 102);
  }
  public static int fromHexDigit(int ch) {
    if (ch >= 48 && ch <= 57) { return ch - 48; }
    if (ch >= 65 && ch <= 70) { return ch - 55; }
    if (ch >= 97 && ch <= 102) { return ch - 87; }
    throw new NumberFormatException("not a hexadecimal digit: code " + ch);
  }

