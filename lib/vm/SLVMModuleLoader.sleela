#sleela 1.3
// Unified SLeeLa standard-library module loader front-end.
// The native compiler and Nordshrift share the same recursive /lib discovery
// contract; this object models the loader-facing package lifecycle.
class SLVMModuleLoader {
  String root;
  String packageName;
  int state;
  int count;

  void configure(String libraryRoot){root=libraryRoot;}
  void select(String name){packageName=name;}
  void register(){count=count+1;}
  void load(){state=1;}
  void unload(){state=0;}
  boolean active(){return state==1;}
  boolean selected(){return packageName!=null;}
  String library(){return root;}
  String package(){return packageName;}
}
