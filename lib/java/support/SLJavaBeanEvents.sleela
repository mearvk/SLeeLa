<< lib/java/support/SLJavaBeanEvents.sleela
   Delivers java.beans property-change and vetoable-change events to a
   listener lowered to SLJavaLambda, or to a listener proxy that wraps one.
   Kept apart from SLJavaLambda so a program that only sorts with a lambda
   does not load the bean classes. >>
#sleela 3.0
material;

class SLJavaBeanEvents {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs. Shared support
     class of the /lib/java Java container; written for SLeeLa, not copied
     from the JDK. It delivers the events of the JavaBeans 1.01 specification
     (Sun Microsystems, 1997) bound and constrained properties. >>
  String metaVersion = "1.0.0";
  int metaId = 39406;
  String metaAuthor = "Max Rupplin";
  String metaDate = "2026-11-12";
  String metaCopyright = "MEARVK LLC";
  String metaTrademark = "none";
  String metaCorporation = "MEARVK LLC";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-12";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 6;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "JavaBeans API Specification 1.01 (Sun Microsystems, 1997), section 7.4 Bound and Constrained Properties";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  << Delivery used by the JDK 28 bean classes (PropertyChangeSupport,
     VetoableChangeSupport and the listener proxies). A listener is an
     SLJavaLambda or a listener proxy that wraps one; a listener of any other
     class cannot be reached through the interface type without virtual
     dispatch, so it fails closed and names the lowering rule. >>
  static void notifyPropertyChange(Any listener, Any evt) {
    if (listener instanceof SLJavaLambda) { SLJavaLambda f = (SLJavaLambda) listener; f.propertyChange(evt); return; }
    if (listener instanceof PropertyChangeListenerProxy) { PropertyChangeListenerProxy p = (PropertyChangeListenerProxy) listener; p.propertyChange(evt); return; }
    throw new UnsupportedOperationException("java.beans.PropertyChangeListener: lower the listener to an SLJavaLambda (lib/java/jdk-28/LOWERING.md section 2)");
  }
  static void notifyVetoableChange(Any listener, Any evt) {
    if (listener instanceof SLJavaLambda) { SLJavaLambda f = (SLJavaLambda) listener; f.vetoableChange(evt); return; }
    if (listener instanceof VetoableChangeListenerProxy) { VetoableChangeListenerProxy p = (VetoableChangeListenerProxy) listener; p.vetoableChange(evt); return; }
    throw new UnsupportedOperationException("java.beans.VetoableChangeListener: lower the listener to an SLJavaLambda (lib/java/jdk-28/LOWERING.md section 2)");
  }
}
