/*
 * lib/telephony-skya/Communication.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines Communication, the Skya message-exchange Master Class —
 *   client-side reach / send / receive with an honest coherence tally.
 *
 * Communication is an emblematic Skya module and a NATURAL / LOADABLE MODULE
 * sharing the common module contract (load / loaded / moduleName / describe).
 * Where Servers stands ready and Network describes reach, Communication
 * performs the client-side exchange and keeps a simple, honest tally of what
 * was sent and received so a program can tell whether a conversation actually
 * completed. It uses the same portable VM socket primitives as SkyaClient
 * (connect / sockwrite / sockread / sockclose) across the explicit SLeeLa
 * VM/OS bridge. The runnable orchestration example lives in
 * telephony-skya/sleela/Communication.sleela.
 *
 * Family: telephony-skya. Native VM/OS work crosses an explicit bridge.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class Communication {

  static final String MODULE = "Communication";

  int loadedFlag;
  int sent;
  int received;
  int failures;

  void load() { loadedFlag = 1; sent = 0; received = 0; failures = 0; }
  boolean loaded() { return loadedFlag == 1; }
  String moduleName() { return MODULE; }

  String exchange(String host, int port, String message) {
    int sock = connect(host, port);
    if (sock < 0) { failures = failures + 1; return ""; }
    sockwrite(sock, message);
    sent = sent + 1;
    String response = sockread(sock);
    sockclose(sock);
    if (response != null && response.length() > 0) {
      received = received + 1;
      return response;
    }
    return "";
  }

  boolean ping(String host, int port) {
    String r = exchange(host, port, "PING SKYA/1");
    return r.length() > 0;
  }

  boolean coherent() { return failures == 0 && sent == received; }

  int sentCount() { return sent; }
  int receivedCount() { return received; }
  int failureCount() { return failures; }

  String describe() {
    return MODULE + " sent=" + sent + " received=" + received
         + " failures=" + failures + " coherent=" + coherent();
  }
}
