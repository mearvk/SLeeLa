    SLOsSupportElement e = new SLOsSupportElement();
    e.configure("getFileInfo", "FileSystem", "OSFileSystem", "OP_OSLS_CALL:155/5",
      "osls_get_file_info", "osls_get_file_info", "CommonBackend",
      "ReadOnlyQuery", "Implemented", 2, 0);
    e.setResultTerm("StatusAndFileRecord");
    return e;
  }

  SLOsSupportElement getNetworkInterfaces() {
    SLOsSupportElement e = new SLOsSupportElement();
    e.configure("getNetworkInterfaces", "NetworkInterfaces", "OSNetwork", "OP_OSLS_CALL:155/9",
      "osls_get_network_interfaces", "osls_get_network_interfaces", "CommonBackend",
      "ReadOnlyEnumeration", "Partial", 3, 0);
    e.setResultTerm("StatusAndInterfaceRecords");
    return e;
  }

  SLOsSupportElement getProcessInfo() {
    SLOsSupportElement e = new SLOsSupportElement();
