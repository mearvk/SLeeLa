/*
 * lib/core/SLByte.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLByte used within the core library family.
 */
#sleela 1.3
// Unified SLeeLa standard-library front-end object.
// Family: core. Native VM/OS work crosses an explicit bridge.
class SLByte {
  String name; int value; void configure(String n,int v){name=n;value=v;} String type(){return name;} int get(){return value;}
}
