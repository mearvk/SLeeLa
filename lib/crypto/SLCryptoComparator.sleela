/*
 * lib/crypto/SLCryptoComparator.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLCryptoComparator, the
 *   compare stage of the pipeline that checks the intermediate result against an
 *   expectation before the national-register call.
 *
 * Order and Orientation: Runs after SLCryptoResult and before SLNationalRegister.
 *   Orientation is a verification gate; it never alters the running text.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLCryptoComparator {
  String expected;  // optional expectation; empty means "accept any"
  int state;
  boolean lastMatch;

  void configure(String expectation) { expected = expectation; state = 1; }
  void enable() { state = 1; }
  void disable() { state = 0; }
  boolean active() { return state == 1; }

  // Constant-time-oriented comparison of the result against the expectation.
  // An empty expectation is treated as an unconditional accept.
  boolean compare(SLCryptoResult result) {
    if (!active() || result == null) { lastMatch = false; return false; }
    if (expected == null || expected.length() == 0) { lastMatch = true; return true; }
    lastMatch = native sleela_crypto_compare(expected, result.value());
    return lastMatch;
  }

  boolean matched() { return lastMatch; }
}
