#sleela 1.3
// SLeeLa Regex API — Level 2: Shape
// Regex API 1.0.0 draft.
// Teaching rule: name the kind of text, then say how much of it is wanted.

class RegexLevel2Shape {
    void main() {
        // Named character shapes.
        print(match("12345", "exact digit+"));
        print(match("hello", "exact word+"));
        print(match("   ", "exact space+"));
        print(match("anything", "exact any*"));

        // Exact repetition.
        print(match("2026", "exact digit{4}"));

        // Bounded repetition.
        print(match("42", "exact digit{2,4}"));
        print(match("1234", "exact digit{2,4}"));

        // Level 2 is deliberately small:
        // Find first, then Shape, then Repeat.
    }
}
