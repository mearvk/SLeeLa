< VM-selection service opcode (code 148): the seam the Sleela VM selector >
< (virtual-machine/vm-version/SLVmRegistry + SLVmVersion manifests) binds to, >
< so choosing a non-native VM parks a VM-exit that the native loader services >
< by building and booting the chosen version's C/C++ main. Append-only. >
< OP_VM_SELECT 148 >
class SLISAVmSelect { String name; int code; }
< OP_MODIUM_SCAN 149 >
class SLISAModiumScan { String name; int code; }

< OP_UI_CALL 150 >
class SLISAUiCall { String name; int code; }

< OP_SSEND 151 -- the ::: structural-offload send (String source -> receiver reach) >
class SLISASSend { String name; int code; }

< OP_CHECKCAST 152 >
class SLISACheckCast { String name; int code; }

< OP_INSTANCEOF 153 >
class SLISAInstanceOf { String name; int code; }

< OP_DUP2 154 >
class SLISADup2 { String name; int code; }

< OP_OSLS_CALL 155 -- typed call into the registered osls_* ABI table >
class SLISAOslsCall { String name; int code; }

< OP_BIGMUL 156 -- native big-integer multiply over base-1e9 limb arrays (the SLBigInteger VM bridge) >
class SLISABigMul { String name; int code; }

< OP_SLEEP 157 -- block the thread for a popped millisecond count (sleep() builtin and the loop-timing annotations) >
class SLISASleep { String name; int code; }

< OP_BIGADD 158 -- native big-integer add over base-1e9 limb arrays (pops a, b, result int[]; companion to OP_BIGMUL) >
class SLISABigAdd { String name; int code; }

< OP_BIGDIVMOD 159 -- native big-integer divide/remainder of a limb array by a small integer divisor (pushes the remainder; backs base conversion and Chudnovsky scaling) >
class SLISABigDivMod { String name; int code; }

< OP_BIGSUB 160 -- native big-integer subtract over base-1e9 limb arrays (pops a, b, result int[]; requires a >= b; companion to OP_BIGADD) >
class SLISABigSub { String name; int code; }

< OP_BIGDIV 161 -- native big-integer divide of big by big (pops num, den, quoOut, remOut int[]; pushes the quotient-limb count; the single large Chudnovsky final division) >
class SLISABigDiv { String name; int code; }

< OP_BIGISQRT 162 -- native big-integer floor square root over base-1e9 limb arrays (pops a, result int[]; backs sqrt(10005) in the Chudnovsky constant) >
class SLISABigISqrt { String name; int code; }

< OP_NATIVE_CALL 163 -- typed native method dispatch through the versioned scalar ABI; missing/unhandled methods and VM-only arguments may fall back to same-name SLeeLa bytecode >
class SLISANativeCall { String name; int code; }

< OP_NATIVE_OPEN 164 -- host-authorized shared-module open; pops path String and pushes opaque VM-owned generation-checked handle >
class SLISANativeOpen { String name; int code; }

< OP_NATIVE_CLOSE 165 -- closes and invalidates an opaque native-module handle; pushes null >
class SLISANativeClose { String name; int code; }

< OP_JSTR_LENGTH 166 -- return the UTF-16 code-unit length of a VM-owned Java String >
class SLISAJavaStringLength { String name; int code; }

< OP_JSTR_CHAR_AT 167 -- read one UTF-16 code unit by index >
class SLISAJavaStringCharAt { String name; int code; }

< OP_JSTR_CODE_POINT_AT 168 -- read the Unicode code point at a UTF-16 index >
class SLISAJavaStringCodePointAt { String name; int code; }

< OP_JSTR_CODE_POINT_COUNT 169 -- count Unicode code points in a UTF-16 range >
class SLISAJavaStringCodePointCount { String name; int code; }

< OP_JSTR_OFFSET_BY_CODE_POINTS 170 -- translate a code-point offset to a UTF-16 index >
class SLISAJavaStringOffsetByCodePoints { String name; int code; }

< OP_JSTR_SUBSTRING 171 -- create a Java String substring using UTF-16 indices >
class SLISAJavaStringSubstring { String name; int code; }

< OP_JSTR_CONCAT 172 -- concatenate two VM-owned Java UTF-16 Strings >
class SLISAJavaStringConcat { String name; int code; }

< OP_JSTR_HASH_CODE 173 -- compute Java String.hashCode over UTF-16 code units >
class SLISAJavaStringHashCode { String name; int code; }

< OP_JSTR_COMPARE_TO 174 -- compare Java UTF-16 Strings using String.compareTo ordering >
class SLISAJavaStringCompareTo { String name; int code; }

< OP_JSTR_FROM_UTF8 175 -- convert a validated legacy UTF-8 String into a VM-owned Java UTF-16 String >
class SLISAJavaStringFromUtf8 { String name; int code; }

< OP_TRY_PUSH 176 -- register a catch-all handler at instruction address a; captures stack height and frame depth >
class SLISATryPush { String name; int code; }

< OP_TRY_POP 177 -- remove the current frame's most recently registered exception handler >
class SLISATryPop { String name; int code; }

< OP_THROW 178 -- pop an arbitrary SLValue and dispatch it to the newest active handler; uncaught values terminate with SLR_ERROR >
class SLISAThrow { String name; int code; }

< OP_IPC_OPEN 179 -- open a host-authorized worker capability name; pushes an opaque VM-local worker handle (reserved; runtime supervisor integration pending) >
class SLISAIPcOpen { String name; int code; }

< OP_IPC_CALL 180 -- operand a is argc; stack is worker handle, method String, then arguments; pushes scalar/UTF-8 result (reserved; runtime supervisor integration pending) >
class SLISAIPcCall { String name; int code; }

< OP_IPC_CLOSE 181 -- close and invalidate a VM-local worker handle; pushes null (reserved; runtime supervisor integration pending) >
class SLISAIPcClose { String name; int code; }

< OP_REF 182 -- object reference: operand a packs a selector (low 4 bits) and, for DEREF, a class type index above them. OF pops an object or null and pushes a weak generation-checked ref (an int, 0 is null); DEREF pops a ref and pushes the object if valid and an instance of the class, else null; VALID/OLD push bool; ID/GEN/TYPE/FIELDS/BYTES/AGE push int, -1 when invalid; LIVE/LIMIT push VM-wide object counts. Never a machine address >
class SLISARef { String name; int code; }

< OP_JSTR_TO_UTF8 183 -- convert a VM-owned Java UTF-16 String to an equivalent legacy UTF-8 String; fails closed on an unpaired surrogate, an embedded NUL or text longer than SL_MAX_STRTEXT bytes >
class SLISAJavaStringToUtf8 { String name; int code; }

< OP_JSTR_FROM_CODE_UNIT 184 -- pop an integer UTF-16 code unit 0..65535 and push a one-unit VM-owned Java UTF-16 String >
class SLISAJavaStringFromCodeUnit { String name; int code; }
< OP_BAND 185 -- bitwise AND of two integers (64-bit two's complement); two bools give the non-short-circuit logical AND >
class SLISBitAnd { String name; int code; }

< OP_BOR 186 -- bitwise OR of two integers; two bools give the non-short-circuit logical OR >
class SLISBitOr { String name; int code; }

< OP_BXOR 187 -- bitwise XOR of two integers; two bools give the logical XOR >
class SLISBitXor { String name; int code; }

< OP_BSHL 188 -- shift an integer left; the count is masked to 0..63 >
class SLISBitShiftLeft { String name; int code; }

< OP_BSHR 189 -- arithmetic (sign extending) shift right; the count is masked to 0..63 >
class SLISBitShiftRight { String name; int code; }

< OP_BUSHR 190 -- logical (zero filling) shift right; the count is masked to 0..63 >
class SLISBitUnsignedShiftRight { String name; int code; }

< OP_BNOT 191 -- bitwise complement of one integer >
class SLISBitNot { String name; int code; }

< OP_CHARSTR 192 -- syntax 3.2 (SLEELA.syntax 45): pop a char (UTF-16 code unit) and push it as a one-character plain String; an unpaired surrogate or NUL is a runtime error >
class SLISCharToString { String name; int code; }

< OP_ADDCHAR 193 -- syntax 3.2 (SLEELA.syntax 45): operand a bit 0 = left operand is a char, bit 1 = right operand is a char; exactly OP_ADD, except that when either operand is a String each flagged char operand is first converted to a one-unit String of the same kind >
class SLISAddChar { String name; int code; }

< OP_NEWARRAYND 194 -- syntax 3.2 (SLEELA.syntax 46): operand a = sized dimensions n (2..8) | innermost fill kind << 8; pop n sizes (last on top) and push a rectangular array of arrays, outermost first >
class SLISNewArrayND { String name; int code; }
