/*
 * lib/cpu/SLIOBus.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLIOBus — the I/O interconnect (modeling PCIe / the
 *   peripheral bus). It owns a set of I/O ports and routes CPU IN/OUT accesses
 *   to the right port by number. Devices register their ports here; drivers
 *   reach their device through the bus.
 *
 * Up to 16 ports are wired as fields (SLeeLa surface has no arrays); this is
 * ample for a modeled machine (console, disk, keyboard, timer, NIC, ...).
 *
 * Family: cpu. Composes SLIOPort.
 */
#sleela 1.3
class SLIOBus {
  static final int MAX_PORTS = 16;
  SLIOPort p0; SLIOPort p1; SLIOPort p2; SLIOPort p3;
  SLIOPort p4; SLIOPort p5; SLIOPort p6; SLIOPort p7;
  SLIOPort p8; SLIOPort p9; SLIOPort p10; SLIOPort p11;
  SLIOPort p12; SLIOPort p13; SLIOPort p14; SLIOPort p15;
  int registered;

  void configure() { registered = 0; }

  void registerPort(int number, SLIOPort port) {
    if (number == 0) { p0 = port; } if (number == 1) { p1 = port; }
    if (number == 2) { p2 = port; } if (number == 3) { p3 = port; }
    if (number == 4) { p4 = port; } if (number == 5) { p5 = port; }
    if (number == 6) { p6 = port; } if (number == 7) { p7 = port; }
    if (number == 8) { p8 = port; } if (number == 9) { p9 = port; }
    if (number == 10) { p10 = port; } if (number == 11) { p11 = port; }
    if (number == 12) { p12 = port; } if (number == 13) { p13 = port; }
    if (number == 14) { p14 = port; } if (number == 15) { p15 = port; }
    registered = registered + 1;
  }

  SLIOPort port(int number) {
    if (number == 0) { return p0; } if (number == 1) { return p1; }
    if (number == 2) { return p2; } if (number == 3) { return p3; }
    if (number == 4) { return p4; } if (number == 5) { return p5; }
    if (number == 6) { return p6; } if (number == 7) { return p7; }
    if (number == 8) { return p8; } if (number == 9) { return p9; }
    if (number == 10) { return p10; } if (number == 11) { return p11; }
    if (number == 12) { return p12; } if (number == 13) { return p13; }
    if (number == 14) { return p14; } if (number == 15) { return p15; }
    return p0;
  }

  // CPU-side IN/OUT routed through the bus.
  int in(int number) { SLIOPort p = port(number); if (p != null) { return p.in(); } return -1; }
  void out(int number, int value) { SLIOPort p = port(number); if (p != null) { p.out(value); } }

  int portsRegistered() { return registered; }
}
