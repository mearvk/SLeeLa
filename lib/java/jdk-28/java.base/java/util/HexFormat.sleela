  static int[] unitsOf(Any text) {
    if (text == null) { throw new NullPointerException(); }
    String u = javaStringFromUtf8("" + text);
    int n = javaStringLength(u);
    int[] out = new int[n];
    int i = 0;
    while (i < n) { out[i] = javaStringCharAt(u, i); i = i + 1; }
    return out;
  }
  static void checkFromTo(int fromIndex, int toIndex, int n) {
    if (fromIndex < 0 || fromIndex > toIndex || toIndex > n) {
      throw new IndexOutOfBoundsException("Range [" + fromIndex + ", " + toIndex + ") out of bounds for length " + n);
    }
  }
  static int fromHexDigitsRange(int[] u, int from, int to) {
    int len = to - from;
    if (len > 8) { throw new IllegalArgumentException("string length greater than 8: " + len); }
    long v = 0;
    int i = from;
    while (i < to) { v = v * 16 + fromHexDigit(u[i]); i = i + 1; }
    if (v >= 2147483648) { v = v - 4294967296; }
    return (int) v;
  }
  static long fromHexDigitsToLongRange(int[] u, int from, int to) {
    int len = to - from;
    if (len > 16) { throw new IllegalArgumentException("string length greater than 16: " + len); }
    long v = 0;
    int i = from;
    while (i < to) {
      int d = fromHexDigit(u[i]);
      if (v >= 576460752303423488) { v = v - 1152921504606846976; }
      v = v * 16 + d;
      i = i + 1;
    }
    return v;
  }
  static int pairByte(int[] u, int at) {
    int v = fromHexDigit(u[at]) * 16 + fromHexDigit(u[at + 1]);
    if (v > 127) { v = v - 256; }
    return v;
  }
  int[] literalUnits(String s) {
    String u = javaStringFromUtf8(s);
    int n = javaStringLength(u);
    int[] out = new int[n];
    int i = 0;
    while (i < n) { out[i] = javaStringCharAt(u, i); i = i + 1; }
    return out;
  }
  void checkLiteral(int[] u, int base, int index, int[] lit, String litText) {
    int n = arrayLength(lit);
    int i = 0;
    while (i < n) {
      if (u[base + index + i] != lit[i]) {
        String foundU = javaStringFromCodeUnits();
        int k = 0;
        while (k < n) { foundU = javaStringConcat(foundU, javaStringFromCodeUnit(u[base + index + k])); k = k + 1; }
        String found = JavaText.plainIfRepresentable(foundU);
        if (JavaText.plainBlocker(foundU) != "") { found = "(text with NUL or an unpaired surrogate)"; }
        throw new IllegalArgumentException("found: \"" + found + "\", expected: \"" + litText + "\", index: " + index + " ch: " + u[base + index + i]);
      }
      i = i + 1;
    }
  }
  byte[] parseUnits(int[] u, int from, int to) {
    int len = to - from;
    if (len == 0) { return new byte[0]; }
    if (this.delim == "" && this.pfx == "" && this.sfx == "") {
      if (len % 2 != 0) { throw new IllegalArgumentException("string length not even: " + len); }
      byte[] out = new byte[len / 2];
      int i = 0;
      while (i < len / 2) { out[i] = pairByte(u, from + 2 * i); i = i + 1; }
      return out;
    }
    int[] p = literalUnits(this.pfx);
    int[] s = literalUnits(this.sfx);
    int[] dl = literalUnits(this.delim);
    int valueChars = arrayLength(p) + 2 + arrayLength(s);
    int stride = valueChars + arrayLength(dl);
    if (len < valueChars || (len - valueChars) % stride != 0) {
      throw new IllegalArgumentException("extra or missing delimiters or values consisting of prefix, two hexadecimal digits, and suffix");
    }
    checkLiteral(u, from, 0, p, this.pfx);
    checkLiteral(u, from, len - arrayLength(s), s, this.sfx);
    String betweenText = this.sfx + this.delim + this.pfx;
    int[] between = literalUnits(betweenText);
    int count = (len - valueChars) / stride + 1;
    byte[] out = new byte[count];
    int i = 0;
    int offset = arrayLength(p);
    while (i < count - 1) {
      out[i] = pairByte(u, from + offset);
      checkLiteral(u, from, offset + 2, between, betweenText);
      i = i + 1;
      offset = offset + 2 + arrayLength(between);
    }
    out[i] = pairByte(u, from + offset);
    return out;
  }

  < ---- helpers ---- >
  String byteDigits(int b) {
    long v = hfmod(b, 256);
    return hexDigit((int) (v / 16)) + hexDigit((int) (v % 16));
  }
  String hexDigit(int v) {
    if (v < 10) { return "" + v; }
    String s = "a";
    if (v == 10) { s = "a"; }
    if (v == 11) { s = "b"; }
    if (v == 12) { s = "c"; }
    if (v == 13) { s = "d"; }
    if (v == 14) { s = "e"; }
    if (v == 15) { s = "f"; }
    if (this.upper) {
      if (v == 10) { s = "A"; }
      if (v == 11) { s = "B"; }
      if (v == 12) { s = "C"; }
      if (v == 13) { s = "D"; }
      if (v == 14) { s = "E"; }
      if (v == 15) { s = "F"; }
    }
    return s;
  }
  int hexCode(long v) {
    if (v < 10) { return (int) v + 48; }
    if (this.upper) { return (int) v + 55; }
    return (int) v + 87;
  }
  static long hfdiv(long a, long b) {
    long q = a / b;
    if ((a % b != 0) && ((a < 0) != (b < 0))) { q = q - 1; }
    return q;
  }
  static long hfmod(long a, long b) { return a - hfdiv(a, b) * b; }
