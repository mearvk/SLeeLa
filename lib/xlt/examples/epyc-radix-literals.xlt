#xlt 1.0
// lib/xlt/examples/epyc-radix-literals.xlt
// Demonstrates radix-prefixed integer literals in the .xlt format, in parity
// with the SLeeLa frontend (SLEELA.syntax 1.4). Integer values -- the memory
// capacity and the grant words/budget -- may be written in hexadecimal (0x),
// binary (0b), or octal (0o), with optional '_' digit separators for
// readability. These are the natural way to express power-of-two memory sizes
// and cycle budgets.
//
//   make -C impl/xlt
//   ./impl/xlt/build/xltc lib/xlt/examples/epyc-radix-literals.xlt
model EpycRadixLiterals {
  cpu      "SLAMDEPYC9575F";
  memory   "ddr5_6400" 0x10000;        // 0x10000 = 65536 MiB (64 GiB)
  storage  "nvmeGen4";
  bus      "pcieGen5x16";

  program  "examples/hello.sleela" sleela;
  grant    0b1_0000_0000_0000_0000 0xF4240;  // 65536 words, 1_000_000 cycles

  target   sleela;
}
