/*
 * lib/video/VideoCodec.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type VideoCodec used within the video library family.
 */
#sleela 1.3
class VideoCodec {
  string name;
  string profile;
  boolean decoder;
  boolean encoder;
  void identify(string codec,string codecProfile){name=codec;profile=codecProfile;}
  void capabilities(boolean decode,boolean encode){decoder=decode;encoder=encode;}
  boolean supported(){return name!="" && (decoder || encoder);}
}