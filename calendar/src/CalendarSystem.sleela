<< calendar/src/CalendarSystem.sleela
   SLeeLa Calendar System — self-contained runnable unit.
   Definition: the whole calendar family in one compilation unit, because the
   toolchain resolves inter-class references within a single file. The classes
   mirror the per-class source files in this directory (SLCalendarJulian,
   SLCalendarGregorian, SLCalendarConverter, SLCalendarIntegrationUS,
   SLUnifiedCalendar) and the documents in calendar/*.md. The CalendarSystemDemo
   class at the end carries main() and exercises the family.
   Run with: sleela run calendar/src/CalendarSystem.sleela >>
#sleela 2.5
material;

<< ============================================================= >>
<< SLCalendarJulian — the Julian baseline (doc 01).                >>
<< ============================================================= >>
class SLCalendarJulian {

  << The Julian leap rule: leap exactly when divisible by four. >>
  boolean isLeapYear(int year) {
    return (year % 4) == 0;
  }

  int daysInMonth(int year, int month) {
    if (month == 2) {
      if (isLeapYear(year)) { return 29; }
      return 28;
    }
    if (month == 4) { return 30; }
    if (month == 6) { return 30; }
    if (month == 9) { return 30; }
    if (month == 11) { return 30; }
    return 31;
  }

  int daysInYear(int year) {
    if (isLeapYear(year)) { return 366; }
    return 365;
  }

  << Serial day number on the proleptic Julian calendar, shared epoch. >>
  int toSerial(int year, int month, int day) {
    int y = year;
    int m = month;
    if (m <= 2) {
      y = y - 1;
      m = m + 12;
    }
    int monthDays = ((153 * (m - 3)) + 2) / 5;
    int leapDays = y / 4;
    return (y * 365) + leapDays + monthDays + (day - 1);
  }

  << ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >>
  String metaVersion = "1.0.0";
  int metaId = 1;
  String metaAuthor = "Julius Caesar / Sosigenes of Alexandria";
  String metaDate = "2026-11-07";
  String metaCopyright = "Public domain (historical calendar)";
  String metaTrademark = "none";
  String metaCorporation = "mearvk LLC";
  String metaOrigin = "International";
  String metaBirthDate = "0046-BCE";
  int metaScienceRating = 8;
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
