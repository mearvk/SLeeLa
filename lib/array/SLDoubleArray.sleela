<< array/SLDoubleArray.sleela
   SLeeLa double-array library.
   Definition: Helpers over double[] (SLEELA.syntax section 46): copy, fill, sum, minimum,
   maximum, search, equality and reverse. Version neutral (uses arrayLength). >>
#sleela 3.0
material;
class SLDoubleArray {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Full descriptive record for a library-family class: identity, legality
     (metaNationalSchedule), fiduciary (copyright, trademark, corporation) and
     jurisdictional scope (metaOrigin). Values are faithful to the real origin
     of the subject where publicly known; unknown values are stated as none. >>
  String metaVersion = "1.0.0";
  int metaId = 8605;
  String metaAuthor = "Max Rupplin";
  String metaDate = "2026-11-12";
  String metaCopyright = "MEARVK LLC";
  String metaTrademark = "none";
  String metaCorporation = "MEARVK LLC";
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-12";
  int metaScienceRating = 7;
  String metaNationalSchedule = "The Java Language Specification, Java SE 28 Edition (JLS 10, Arrays)";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  static double[] copyOf(double[] a, int n) {
    double[] r = new double[n];
    int m = arrayLength(a);
    if (n < m) { m = n; }
    for (int i = 0; i < m; i++) { r[i] = a[i]; }
    return r;
  }

  static void fill(double[] a, double v) {
    for (int i = 0; i < arrayLength(a); i++) { a[i] = v; }
  }

  static double sumOf(double[] a) {
    double s = 0.0;
    for (int i = 0; i < arrayLength(a); i++) { s = s + a[i]; }
    return s;
  }

  static double minOf(double[] a) {
    if (arrayLength(a) == 0) { throw new RuntimeException("minOf of an empty array"); }
    double m = a[0];
    for (int i = 1; i < arrayLength(a); i++) { if (a[i] < m) { m = a[i]; } }
    return m;
  }

  static double maxOf(double[] a) {
    if (arrayLength(a) == 0) { throw new RuntimeException("maxOf of an empty array"); }
    double m = a[0];
    for (int i = 1; i < arrayLength(a); i++) { if (a[i] > m) { m = a[i]; } }
    return m;
  }

  static int indexOf(double[] a, double v) {
    for (int i = 0; i < arrayLength(a); i++) { if (a[i] == v) { return i; } }
    return -1;
  }

  static boolean isEqual(double[] a, double[] b) {
    if (a == null || b == null) { return a == null && b == null; }
    if (arrayLength(a) != arrayLength(b)) { return false; }
    for (int i = 0; i < arrayLength(a); i++) { if (a[i] != b[i]) { return false; } }
    return true;
  }

  static void reverse(double[] a) {
    int i = 0;
    int j = arrayLength(a) - 1;
    while (i < j) { double t = a[i]; a[i] = a[j]; a[j] = t; i++; j--; }
  }
}
