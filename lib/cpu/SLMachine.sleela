/*
 * lib/cpu/SLMachine.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLMachine — the complete computer: it composes the entire
 *   /lib/cpu stack into one bootable system and demonstrates the full chain the
 *   library exists to express:
 *
 *     gates -> adders/ALU -> registers/RAM/cache -> cores -> SLCPU            (hardware)
 *       -> SLBootloader loads the kernel                                      (boot)
 *         -> SLOperatingSystem / SLKernel comes up with drivers + scheduler   (OS)
 *           -> SLAssembler builds a Sleela program                            (program)
 *             -> SLProgramLoader loads it as a process                        (load)
 *               -> SLKernel schedules and runs it on the Sleela CPU           (run)
 *
 * This is the Sleela CPU built from Sleela source, booting a Sleela
 * Class-Driven OS, which then loads and runs Sleela programs on top of it.
 *
 * Family: cpu. Top-level composition of the whole package.
 */
#sleela 1.3
class SLMachine {
  SLRAM memory;
  SLHardDrive drive;
  SLCPU cpu;
  SLBootloader bootloader;
  SLOperatingSystem os;
  SLProgramLoader loader;
  SLInstructionSet isa;
  int kernelEntry;
  int syscallHandler;

  // Build the hardware: main memory, boot disk, and a multi-core CPU.
  void buildHardware(String vendor, String model, int cores, int bits, int mhz) {
    memory = new SLRAM(); memory.configure(1048576, bits); memory.allocate(); // 1M words
    drive = new SLHardDrive(); drive.configure("boot0", 65536, 4096, SLHardDrive.MEDIA_SSD);
    drive.mount("boot0.img");
    cpu = new SLCPU(); cpu.configure(vendor, model, cores, bits, mhz);
    cpu.power(memory);
    isa = new SLInstructionSet(); isa.configure();
  }

  // Boot: firmware loads the kernel image, then the OS installs and comes up.
  void boot() {
    kernelEntry = 4096;      // kernel loads high above the vector table
    syscallHandler = 4096;   // kernel's syscall handler entry (modeled)

    bootloader = new SLBootloader();
    bootloader.configure(cpu, buildBootDiskDriver(), memory);
    bootloader.loadKernel(0, 32, kernelEntry);

    os = new SLOperatingSystem();
    os.configure("SleelaOS", cpu, memory);
    os.install(drive, syscallHandler);

    loader = new SLProgramLoader();
    loader.configure(os, memory);
    loader.attachCompiler(isa);   // enable multi-language source loading
  }

  // Compile and load a source program in any supported language, returning the
  // spawned process. Language ids: 0 Sleela, 1 C, 2 C++, 3 Java.
  SLProcess loadLanguageProgram(String path, int langId, String procName, int loadAddr) {
    return loader.loadSource(path, langId, procName, loadAddr);
  }

  // Reduce a program in any supported language to the canonical SLeeLa opcode
  // substrate and execute it there, returning its printed result. This runs the
  // program as a stream of the Turing-complete base-98 opcodes — the common
  // ground C/C++/Java/Sleela all share.
  int runOnSubstrate(int langId, String path, String name) {
    SLTuringBridge bridge = new SLTuringBridge(); bridge.configure();
    return bridge.runLanguage(langId, path, name);
  }

  // Prove the four languages are 1:1 in Turing effect: identical observable
  // result after each is reduced to the Sleela opcode substrate.
  boolean proveLanguageEquivalence(String c, String cpp, String java, String sleela) {
    SLTuringBridge bridge = new SLTuringBridge(); bridge.configure();
    return bridge.proveEquivalence(c, cpp, java, sleela);
  }

  // Boot a Linux-style guest OS on top of this Sleela CPU via the hypervisor,
  // and run it for a bounded number of guest instructions. Returns the guest
  // instruction count executed. (Architectural model — see SLGuestLinux.)
  int runLinuxGuest(int guestEntry, int budget) {
    SLHypervisor hv = new SLHypervisor();
    hv.configure(cpu, memory);
    hv.attachBootDisk(drive);
    SLGuestVM vm = hv.createGuest("linux-guest", 262144, 65536, guestEntry);
    SLGuestLinux linux = new SLGuestLinux();
    linux.configure("sleela-linux", vm);
    vm.attachKernel(linux);                 // timer IRQs drive the guest scheduler
    linux.boot(guestEntry, guestEntry + 256);
    linux.startScheduling(8);               // program the guest timer heartbeat
    return hv.runGuest(0, budget);
  }

  // Boot a Linux-style guest whose kernel is GENUINELY COMPILED from source in
  // any supported language (C/C++/Java/Sleela) via the real toolchain (step 4),
  // then run it. Returns the guest instruction count executed.
  int runLinuxGuestFromSource(String kernelSourcePath, int langId, int guestEntry, int budget) {
    SLHypervisor hv = new SLHypervisor();
    hv.configure(cpu, memory);
    hv.attachBootDisk(drive);
    SLGuestVM vm = hv.createGuest("linux-guest", 262144, 65536, guestEntry);
    SLGuestLinux linux = new SLGuestLinux();
    linux.configure("sleela-linux", vm);
    vm.attachKernel(linux);                         // timer IRQs drive the scheduler
    linux.buildKernel(kernelSourcePath, langId);    // compile the guest kernel
    linux.boot(guestEntry, guestEntry + 256);
    linux.startScheduling(8);
    return hv.runGuest(0, budget);
  }

  // Boot a guest, then have its init process (PID 1) load and spawn two user
  // programs compiled from source (any supported language). The timer-driven
  // scheduler then multitasks them. Returns the guest instruction count.
  int runLinuxGuestWithPrograms(String kernelSrc, int kernelLang,
                                String progA, String progASrc, int progALang,
                                String progB, String progBSrc, int progBLang,
                                int guestEntry, int budget) {
    SLHypervisor hv = new SLHypervisor();
    hv.configure(cpu, memory);
    hv.attachBootDisk(drive);
    SLGuestVM vm = hv.createGuest("linux-guest", 262144, 65536, guestEntry);
    SLGuestLinux linux = new SLGuestLinux();
    linux.configure("sleela-linux", vm);
    vm.attachKernel(linux);
    linux.buildKernel(kernelSrc, kernelLang);
    linux.boot(guestEntry, guestEntry + 256);
    SLGuestInit init = linux.startInit();
    init.exec(progA, progASrc, progALang);          // spawn user program A
    init.exec(progB, progBSrc, progBLang);          // spawn user program B
    linux.startScheduling(8);
    return hv.runGuest(0, budget);
  }

  // Boot a guest, then compile a program, install it to the guest filesystem as
  // an on-disk executable, load it back FROM DISK, and run it. Demonstrates the
  // full compile -> install -> load-from-disk -> execute cycle. Returns the
  // guest instruction count executed.
  int runLinuxGuestDiskProgram(String kernelSrc, int kernelLang,
                               String progName, String progSrc, int progLang,
                               int fileId, int guestEntry, int budget) {
    SLHypervisor hv = new SLHypervisor();
    hv.configure(cpu, memory);
    hv.attachBootDisk(drive);
    SLGuestVM vm = hv.createGuest("linux-guest", 262144, 65536, guestEntry);
    SLGuestLinux linux = new SLGuestLinux();
    linux.configure("sleela-linux", vm);
    vm.attachKernel(linux);
    linux.buildKernel(kernelSrc, kernelLang);
    linux.boot(guestEntry, guestEntry + 256);
    SLGuestInit init = linux.startInit();
    init.installAndExec(progName, progSrc, progLang, fileId);  // compile->disk->load->run
    linux.startScheduling(8);
    return hv.runGuest(0, budget);
  }

  // Boot a guest, launch its shell as init's first child, and run a short
  // command script (each entry is a leading-char + arg pair). Returns the
  // number of shell commands executed. Demonstrates boot -> init -> shell.
  int runLinuxGuestShell(String kernelSrc, int kernelLang, int guestEntry) {
    SLHypervisor hv = new SLHypervisor();
    hv.configure(cpu, memory);
    hv.attachBootDisk(drive);
    SLGuestVM vm = hv.createGuest("linux-guest", 262144, 65536, guestEntry);
    SLGuestLinux linux = new SLGuestLinux();
    linux.configure("sleela-linux", vm);
    vm.attachKernel(linux);
    linux.buildKernel(kernelSrc, kernelLang);
    linux.boot(guestEntry, guestEntry + 256);
    SLGuestInit init = linux.startInit();
    SLGuestShell sh = init.launchShell();
    linux.startScheduling(8);
    // A tiny boot script: help, ps, echo 'A', exit.
    sh.run(104, 0);     // help
    sh.run(112, 0);     // ps
    sh.run(101, 65);    // echo 'A'
    sh.run(120, 0);     // exit
    return sh.commandCount();
  }

  // The bootloader needs a disk driver before the OS driver manager exists;
  // build a minimal one bound to the boot drive.
  SLDiskDriver buildBootDiskDriver() {
    SLIOBus bus = new SLIOBus(); bus.configure();
    SLIOPort port = new SLIOPort(); port.configure(1, SLIOPort.DIR_INOUT); bus.registerPort(1, port);
    SLDMAController dmaEngine = new SLDMAController(); dmaEngine.configure(memory);
    SLDiskDriver d = new SLDiskDriver(); d.init(bus, 1, drive, dmaEngine);
    return d;
  }

  // Author, assemble, load, and run a demonstration Sleela program:
  // compute 2 + 3 into r1, print a character via SYS_WRITE, then exit.
  SLProcess loadDemoProgram(int loadAddr) {
    SLProgram prog = new SLProgram(); prog.configure("demo", 64);
    SLAssembler asm = new SLAssembler(); asm.configure(isa, prog);

    asm.mov(1, 2);                                   // r1 = 2
    asm.mov(2, 3);                                   // r2 = 3
    asm.add(1, 2);                                   // r1 = r1 + r2 = 5
    asm.mov(2, 65);                                  // r2 = 'A'
    asm.syscall(0);                                  // SYS_WRITE: print r2
    asm.syscall(4);                                  // SYS_EXIT
    asm.halt();

    return loader.load(prog, loadAddr);
  }

  // Run the whole chain end to end: build -> boot -> load program -> run.
  int powerOnAndRun(int cores, int bits, int mhz, int rounds) {
    buildHardware("SleelaWorks", "SL-Core-X", cores, bits, mhz);
    boot();
    loadDemoProgram(8192);
    return os.run(rounds);
  }

  SLCPU processor() { return cpu; }
  SLOperatingSystem operatingSystem() { return os; }
  SLProgramLoader programLoader() { return loader; }
  SLRAM mainMemory() { return memory; }
}
