#sleela 1.7
// A deterministic debugging checklist; it does not attach to a live process.
class ClassicDebuggingChecklist {
    void main() {
        print("1. reproduce the smallest failing input");
        print("2. capture the exact command and diagnostic");
        print("3. inspect the first failing source location");
        print("4. change one cause at a time");
        print("5. rerun the focused test and regression suite");
    }
}
