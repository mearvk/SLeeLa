#sleela 1.3
// SLeeLa Regex API — Level 1: Find
// Regex API 1.0.0 draft.
// Teaching rule: ask one clear question about literal text.

class RegexLevel1Find {
    void main() {
        // Does the text contain this literal?
        print(match("hello, SLeeLa", "contains hello"));

        // Does the text begin with this literal?
        print(match("SLeeLa Regex", "starts SLeeLa"));

        // Does the text finish with this literal?
        print(match("report.txt", "ends .txt"));

        // Is the entire text exactly this literal?
        print(match("ready", "exact ready"));

        // A Level 1 pattern should be readable without knowing regex punctuation.
        print(match("alice@example.com", "contains @"));
    }
}
