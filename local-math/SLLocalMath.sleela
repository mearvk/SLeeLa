  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  << A threshold predicate on a double: kind 0 = (x > t), 1 = (x >= t),
     2 = (x < t), 3 = (x <= t), 4 = (x == t). >>
  int kind;
  double threshold;
  void set(int k, double t) { kind = k; threshold = t; }
  boolean test(double x) {
    if (kind == 0) { return x > threshold; }
    if (kind == 1) { return x >= threshold; }
    if (kind == 2) { return x < threshold; }
    if (kind == 3) { return x <= threshold; }
    if (kind == 4) { return x == threshold; }
    return false;
  }
}

