<< lib/advantage/learner-vs-professional/courseware/long-term-potencies/05-short-side-mirror/TaPotency05ShortSideMirror.sleela
   SLeeLa courseware lesson.
   Definition: Entry 5: the short-side overloads of term potency and age potency, mirroring entry 1's exact lot structure and ages, confirming the formulas give identical readings on either book shape. >>
#sleela 3.0
material;
artifact;
pure;
gasoline;
< Entry 5 of 6, long-term-potencies. The short-side overloads added to >
< SLTermPotency (termPotencyBp(SLShortBook,...), agePotencyBp(SLShortBook,...), >
< atLeastHalfLongTerm(SLShortBook,...)) are exercised with the same lot sizes, >
< days and thresholds as entry 1's long-side example, and the readings are >
< checked to match exactly -- the formulas do not care which side of the >
< book they are reading, only the age/term data the book exposes. >
class TaPotency05ShortSideMirror {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs. A worker-class
     lesson carries the baseline identity record. >>
  String metaVersion = "1.0.0";
  int metaId = 39355;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-11";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-11";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 5;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }


  int passed = 0;
  int failed = 0;
  void expect(String label, int got, int want) {
    if (got == want) { print("  ok   " + label + " = " + got); passed = passed + 1; }
    else { print("  FAIL " + label + " got " + got + " want " + want); failed = failed + 1; }
  }
  void expectTrue(String label, boolean got) {
    if (got) { print("  ok   " + label); passed = passed + 1; }
    else { print("  FAIL " + label); failed = failed + 1; }
  }
  void summary() { print("  checks passed=" + passed + " failed=" + failed); }
  void act(SLShortBook b, String text, int code) { print("  " + text + " : " + b.reason(code)); }

  void main() {
    SLShortBook book = new SLShortBook();
    SLTermPotency p = new SLTermPotency();
    print("== Entry 5: short-side term and age potency, mirroring entry 1 ==");
    act(book, "short 40 @ 5000 on day 0", book.shortSell(0, 40, 5000, 0));
    print("-- day 365, before the second short: the one lot is exactly 365 days old --");
    expect("term potency, threshold 365", p.termPotencyBp(book, 365, 365), 0);
    expect("age potency (one lot)", p.agePotencyBp(book, 365), 10000);
    expectTrue("not yet long term at exactly 365 days", !p.atLeastHalfLongTerm(book, 365, 365));
    print("-- day 400: add a second, younger short --");
    act(book, "short 60 @ 5100 on day 400", book.shortSell(400, 60, 5100, 0));
        print("-- day 500 (the day-0 short, 40 units, has crossed 365 days; the day-400 short has not) --");
    expect("term potency, threshold 365", p.termPotencyBp(book, 500, 365), 4000);
    expect("age potency", p.agePotencyBp(book, 500), 5200);
    expectTrue("still not half (40 of 100 units)", !p.atLeastHalfLongTerm(book, 500, 365));
    print("-- day 900 (both shorts have crossed 365 days: full term potency) --");
    expect("term potency, threshold 365", p.termPotencyBp(book, 900, 365), 10000);
    expect("age potency", p.agePotencyBp(book, 900), 7333);
    expectTrue("now fully long term", p.atLeastHalfLongTerm(book, 900, 365));
    expectTrue("invariants hold", book.invariantsHold());
    print("-- both readings exactly match entry 1's long-side readings at the same ages --");
    expectTrue("term potency matches the long-side value at day 500", p.termPotencyBp(book, 500, 365) == 4000);
    expectTrue("age potency matches the long-side value at day 500", p.agePotencyBp(book, 500) == 5200);
    summary();
  }
}
