;;; sleela-eurasia-theme.el --- SLeeLa Pan-Eurasian theme -*- lexical-binding: t; -*-
(deftheme sleela-eurasia "Sapphire, jade, silk gold and burgundy inspired Pan-Eurasian palette.")
(custom-theme-set-faces
 'sleela-eurasia
 '(default ((t (:foreground "#F0F2F5" :background "#111827"))))
 '(cursor ((t (:background "#7AA7E8"))))
 '(region ((t (:background "#30435A" :extend t))))
 '(highlight ((t (:background "#1B293A"))))
 '(fringe ((t (:foreground "#8995A5" :background "#111827"))))
 '(line-number ((t (:foreground "#8995A5" :background "#111827"))))
 '(line-number-current-line ((t (:foreground "#7AA7E8" :weight bold))))
 '(mode-line ((t (:foreground "#F0F2F5" :background "#30435A" :weight bold))))
 '(mode-line-inactive ((t (:foreground "#8995A5" :background "#1B293A"))))
 '(minibuffer-prompt ((t (:foreground "#7AA7E8" :weight bold))))
 '(font-lock-builtin-face ((t (:foreground "#69C9B3"))))
 '(font-lock-comment-face ((t (:foreground "#8995A5" :slant italic))))
 '(font-lock-constant-face ((t (:foreground "#D98A9A"))))
 '(font-lock-function-name-face ((t (:foreground "#8FCB8A" :weight bold))))
 '(font-lock-keyword-face ((t (:foreground "#7AA7E8" :weight bold))))
 '(font-lock-string-face ((t (:foreground "#D7B56D"))))
 '(font-lock-type-face ((t (:foreground "#69C9B3" :weight bold))))
 '(font-lock-variable-name-face ((t (:foreground "#F0F2F5"))))
 '(font-lock-warning-face ((t (:foreground "#FF7777" :weight bold :underline t))))
 '(error ((t (:foreground "#FF7777" :weight bold))))
 '(warning ((t (:foreground "#D7B56D" :weight bold))))
 '(success ((t (:foreground "#8FCB8A" :weight bold))))
 '(show-paren-match ((t (:foreground "#F0F2F5" :background "#31536C" :weight bold))))
 '(isearch ((t (:foreground "#111827" :background "#D7B56D" :weight bold)))))
(provide-theme 'sleela-eurasia)
;;; sleela-eurasia-theme.el ends here
