/*
 * lib/core/SLParameter.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLParameter used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Parameter.
// Role: language. Responsibility: callable/type parameter metadata.
class SLParameter {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
