  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  << A linear inequality a x + b (op) 0, with op encoded: 0 = <, 1 = <=,
     2 = >, 3 = >=. satisfies tests a candidate x. >>
  double a;
  double b;
  int op;
  void set(double pa, double pb, int o) { a = pa; b = pb; op = o; }
  boolean satisfies(double x) {
    double v = a * x + b;
    if (op == 0) { return v < 0.0; }
    if (op == 1) { return v <= 0.0; }
    if (op == 2) { return v > 0.0; }
    if (op == 3) { return v >= 0.0; }
    return false;
  }
}

