/*
 * lib/deliberation/SLNegotiation.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLNegotiation used within the deliberation library family.
 */
#sleela 1.3
// SLeeLa deliberation front-end contract.
// Explicit reasoning/evidence/decision state; native facilities cross a VM/OS bridge.
class SLNegotiation {
  int state;
  int count;
  void reset(){state=0;count=0;}
  void activate(){state=1;count=count+1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
