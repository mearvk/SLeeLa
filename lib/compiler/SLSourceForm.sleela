/*
 * lib/compiler/SLSourceForm.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLSourceForm, the set of SLeeLa source forms the compiler
 *   can be asked to compile, so that .sldocument is a first-class compile choice
 *   alongside ordinary .sleela.
 *
 * The SLeeLa Compiler accepts more than one source form. This type names each
 * form, its canonical extension, and whether it is ordered top-down. The
 * compiler's selection model (language -> family -> version -> producer ->
 * source form -> IR/object -> target) consults this to pick the right front end.
 *
 * Forms:
 *   SLEELA     — the general program/source unit (.sleela), class/method shaped.
 *   SLDOCUMENT — the ordered, top-down document (.sldocument); annotated method
 *                steps run in order, each usually returning one binary value.
 *   SLSCRIPT   — the dynamic scripting form (.sleela-script).
 *
 * Family: compiler. Native VM/OS work crosses an explicit bridge.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class SLSourceForm {
  static final int SLEELA     = 1;
  static final int SLDOCUMENT = 2;
  static final int SLSCRIPT   = 3;

  int form;
  String extension; // canonical extension, including the dot
  boolean ordered;  // true when the form runs strictly top-down

  void configure(int whichForm) {
    form = whichForm;
    if (whichForm == SLEELA) { extension = ".sleela"; ordered = false; }
    else if (whichForm == SLDOCUMENT) { extension = ".sldocument"; ordered = true; }
    else if (whichForm == SLSCRIPT) { extension = ".sleela-script"; ordered = true; }
    else { extension = ""; ordered = false; }
  }

  // Infer the source form from a file name's extension. Returns 0 (unknown) when
  // the extension is not a recognised SLeeLa source form.
  int fromExtension(String fileName) {
    if (endsWith(fileName, ".sldocument")) { configure(SLDOCUMENT); return SLDOCUMENT; }
    if (endsWith(fileName, ".sleela-script")) { configure(SLSCRIPT); return SLSCRIPT; }
    if (endsWith(fileName, ".sleela")) { configure(SLEELA); return SLEELA; }
    form = 0; extension = ""; ordered = false;
    return 0;
  }

  int value() { return form; }
  String ext() { return extension; }
  boolean isOrdered() { return ordered; }
  boolean isDocument() { return form == SLDOCUMENT; }
  boolean isProgram() { return form == SLEELA; }

  // Small helper: does `s` end with `suffix`? (The .sldocument check runs before
  // the .sleela check so the longer extension is matched first.)
  boolean endsWith(String s, String suffix) {
    if (s == null || suffix == null) { return false; }
    int sl = s.length();
    int fl = suffix.length();
    if (fl > sl) { return false; }
    return s.substring(sl - fl, sl) == suffix;
  }
}
