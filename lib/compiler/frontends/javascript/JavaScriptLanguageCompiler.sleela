/*
 * lib/compiler/frontends/javascript/JavaScriptLanguageCompiler.sleela
 * SLeeLa Standard Library Definition.
 * Definition: A modular front end that compiles the JavaScript programming
 *   language into SLeeLa IR and onward to a VM-ready artifact.
 *
 * JavaScript accepts several module/source extensions (.js, .mjs, .cjs). This
 * front end lists each so the registry resolves any of them. It is another
 * scripting-family example alongside Python.
 *
 * Family: compiler (front end). Native VM/OS work crosses an explicit bridge.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class JavaScriptLanguageCompiler extends SLLanguageCompiler {

  void configure() {
    declare("JavaScript", "scripting", "ECMAScript 2023", ".js,.mjs,.cjs", TARGET_SLVM);
    provide(PHASE_SOURCE);
    provide(PHASE_LEX);
    provide(PHASE_PARSE);
    provide(PHASE_RESOLVE);
    provide(PHASE_SEMANTIC);
    provide(PHASE_IR);
    provide(PHASE_LOWER);
    provide(PHASE_CODEGEN);
  }

  boolean runParse(SLCompileRequest request) {
    // JavaScript parsing: scripts vs modules, hoisting-aware declarations,
    // functions/arrow functions, classes, and expressions.
    return provides(PHASE_PARSE);
  }
}
