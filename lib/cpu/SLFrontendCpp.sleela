/*
 * lib/cpu/SLFrontendCpp.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLFrontendCpp — the C++ frontend. It extends the C
 *   frontend's lowering with the C++-specific constructs that still reduce to
 *   the same common SLIR: an object's method call lowers to a function call
 *   whose first IR_PARAM is the `this` pointer; a constructor lowers to an
 *   allocation plus an initializer call; virtual dispatch lowers to a vtable
 *   load (IR_LOAD) followed by an indirect IR_CALL.
 *
 * SCOPE NOTE: templates, overload resolution, exceptions, and the STL are a
 * full C++ front-end's job and are out of scope for one class; this models the
 * canonical C++-to-IR lowerings (this-pointer, construction, virtual dispatch)
 * and demonstrates one complete lowering. The IR and backend are unchanged —
 * exactly how clang++ shares LLVM with clang.
 *
 * Family: cpu. Extends SLFrontendC (C++ is a superset lowering).
 */
#sleela 1.3
class SLFrontendCpp extends SLFrontendC {

  void initCpp(String path) { configure("cpp", LANG_CPP, path); }

  // Model lowering of the CANONICAL equivalence program expressed with a C++
  // object (so the C++-specific lowering is exercised), computing the same
  // value as every other frontend:
  //   struct Box { int a, b; int sum(){ return a + b; } };
  //   int main(){ Box box{2, 3}; write(1, box.sum()); return 0; }
  // Construction stores the fields; box.sum() is a call with `this` as the
  // first param; the returned value is x = 2 + 3 = 5 — identical to the C,
  // Java, and Sleela frontends, which is what makes the four 1:1 in Turing
  // effect once reduced to the Sleela opcode substrate (SLTuringBridge).
  SLIR lower() {
    SLIR m = intermediate();
    SLIRInstruction k = new SLIRInstruction();

    int thisPtr = m.allocTemp();
    int two     = m.allocTemp();
    int three   = m.allocTemp();
    int one     = m.allocTemp();
    int ret     = m.allocTemp();
    int sumLbl  = m.allocLabel();

    // Box box{2, 3}: fields a and b at this+0 and this+1.
    m.emit(k.IR_CONST, thisPtr, -1, -1, 2048);     // &box
    m.emit(k.IR_CONST, two, -1, -1, 2);
    m.emit(k.IR_STORE, -1, thisPtr, two, 0);       // box.a = 2
    m.emit(k.IR_CONST, one, -1, -1, 1);
    m.emit(k.IR_ADD, one, thisPtr, one, 0);        // &box.b = this + 1
    m.emit(k.IR_CONST, three, -1, -1, 3);
    m.emit(k.IR_STORE, -1, one, three, 0);         // box.b = 3

    // box.sum(): pass `this`, call the method, receive a + b.
    m.emit(k.IR_PARAM, -1, thisPtr, -1, 0);        // push this
    m.emit(k.IR_CALL, ret, -1, -1, sumLbl);        // ret = Box::sum(this) = 2 + 3

    m.emit(k.IR_SYSCALL, -1, ret, -1, 0);          // write(ret)
    m.emit(k.IR_SYSCALL, -1, -1, -1, 4);           // return 0
    m.emit(k.IR_HALT, -1, -1, -1, 0);

    // Box::sum(this){ return this->a + this->b; }
    m.emit(k.IR_LABEL, -1, -1, -1, sumLbl);
    int self = m.allocTemp();
    int fa = m.allocTemp();
    int fb = m.allocTemp();
    int selfb = m.allocTemp();
    int s = m.allocTemp();
    int one2 = m.allocTemp();
    m.emit(k.IR_CONST, self, -1, -1, 2048);        // this
    m.emit(k.IR_LOAD, fa, self, -1, 0);            // a = this->a
    m.emit(k.IR_CONST, one2, -1, -1, 1);
    m.emit(k.IR_ADD, selfb, self, one2, 0);        // &this->b
    m.emit(k.IR_LOAD, fb, selfb, -1, 0);           // b = this->b
    m.emit(k.IR_ADD, s, fa, fb, 0);                // a + b
    m.emit(k.IR_RET, -1, s, -1, 0);
    return m;
  }
}
