#sleela 1.10
/*
 * CitizenPhysicalHealthAndDailyWellbeingStats.sleela
 * Individual category class extracted from citizen/sleela/CitizenStats.sleela.
 * Source category: Physical health and daily wellbeing (game-defined scales).
 * Monetary values use integer minor units where the field name says Cents.
 */
class CitizenPhysicalHealthAndDailyWellbeingStats {
    int healthScore;
    int maxHealthScore;
    int fitness;
    int mobility;
    int vision;
    int hearing;
    int speech;
    int nutrition;
    int hydration;
    int sleepQuality;
    int stressLevel;
    int mentalWellbeing;
    int physicalWellbeing;
    int chronicConditionCount;
    int acuteConditionSeverity;
    int injurySeverity;
    int infectionRisk;
    int vaccinationStatus;
    int healthcareAccess;
    int healthInsuranceCoverage;
    int medicationAdherence;
    int substanceRisk;
    int disabilitySupportLevel;

    CitizenPhysicalHealthAndDailyWellbeingStats() {
        healthScore = 100;
        maxHealthScore = 100;
        fitness = 50;
        mobility = 100;
        vision = 100;
        hearing = 100;
        speech = 100;
        nutrition = 100;
        hydration = 100;
        sleepQuality = 100;
        stressLevel = 0;
        mentalWellbeing = 100;
        physicalWellbeing = 100;
        chronicConditionCount = 0;
        acuteConditionSeverity = 0;
        injurySeverity = 0;
        infectionRisk = 0;
        vaccinationStatus = 0;
        healthcareAccess = 0;
        healthInsuranceCoverage = 0;
        medicationAdherence = 100;
        substanceRisk = 0;
        disabilitySupportLevel = 0;
    }
}
