#sleela 1.3
// Unified SLeeLa VM module loader front-end.
class SLVMModuleLoader {
  String name; String libraryRoot; int state; int count;
  void configure(String n){name=n;libraryRoot="/lib";}
  void configureLibrary(String root){libraryRoot=root;}
  void discover(int symbols){count=symbols;state=1;}
  void start(){state=1;} void stop(){state=0;}
  void register(){count=count+1;} boolean active(){return state==1;}
  String root(){return libraryRoot;} int symbolCount(){return count;}
}
