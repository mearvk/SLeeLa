  double sum(double a, double b) { return a + b; }
  double max(double a, double b) {
    if (a != a) { return a; }
    if (a == 0.0 && b == 0.0) { if (isNegativeZero(a)) { return b; } return a; }
    if (a >= b) { return a; }
    return b;
  }
  double min(double a, double b) {
    if (a != a) { return a; }
    if (a == 0.0 && b == 0.0) { if (isNegativeZero(a)) { return a; } return b; }
    if (a <= b) { return a; }
