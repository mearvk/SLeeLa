#sleela 1.3
class PermissibleConnector { String referenceName; String importPath; String domain; String seraphState; String memoryState; String balanceState; String status; function initialize(){status="imported";} function sight(){domain="sight";return domain;} function name(){domain="name";return domain;} function travel(){domain="travel";return domain;} function process(){domain="process";return domain;} function memory(){domain="memory";return domain;} function system(){domain="system";return domain;} function linearGraph(){domain="linear-graph";return domain;} function preserveBalance(){balanceState="bounded";return balanceState;} }
