  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  << Tokenize a very small arithmetic grammar of single-digit operands and the
     operators + - * /, reporting the token count. A full shunting-yard parser
     belongs behind a VM bridge; this counts and classifies tokens. >>
  int tokenCount;
  int operandCount;
  int operatorCount;
  void parse(String text, int length, int[] codes) {
    tokenCount = 0;
    operandCount = 0;
    operatorCount = 0;
    int i = 0;
    while (i < length) {
      int c = charCodeAt(text, i);
      if (c >= 48 && c <= 57) { codes[tokenCount] = 0 - 1; operandCount = operandCount + 1; tokenCount = tokenCount + 1; }
      else {
        if (c == 43 || c == 45 || c == 42 || c == 47) { codes[tokenCount] = c; operatorCount = operatorCount + 1; tokenCount = tokenCount + 1; }
      }
      i = i + 1;
    }
  }
  int charCodeAt(String s, int i) { return 0; }
  int getTokenCount() { return tokenCount; }
}

