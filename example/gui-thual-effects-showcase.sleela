/*
 * example/gui-thual-effects-showcase.sleela
 * The THUAL (3.0) "effects showcase" scene as a REAL, on-screen window --
 * driven by SleelaUI, SLeeLa's own native C/C++ toolkit, through the ui* SLVM
 * bridge (OP_UI_CALL -> user-interface/ C ABI -> X11/Cocoa/Win32). Previously
 * this file only print()ed a walkthrough; now the visual-effects layer (glow /
 * shine / shadow / metal / rotation / fade + branding + audio cues, with a
 * scheduled rotation that advances a memo key epoch) is painted as actual
 * widgets, including a live throbber that drives the SleelaUI event loop.
 *
 * The three-layer stack is live here:
 *   SLeeLa decoration (this program + the bright "studio" theme below)
 *     -> model (ui* built-ins: uiWindowCreate, uiThrobber, uiProgressBar, ...)
 *       -> C/C++ (SleelaUI software rasterizer + native window backend)
 *
 * Run (needs a display: X on Linux, native on macOS/Windows):
 *   SLEELA_SHEET=./SHEET.sheet \
 *   SLEELA_SHA256_MANIFEST=./security/sha256-manifest.json \
 *   ./impl/build/sleela run example/gui-thual-effects-showcase.sleela
 *
 * With no display (headless/CI) it reports that and exits 0 without a window.
 */
#sleela 2.1
// THUAL (3.0): a clamped visual-effects layer. Every knob clamps to a safe
// window; here those clamped values drive real level/progress controls and a
// live, hue-tinted throbber (the "rotation" made visible).
class GuiThualEffectsShowcase {

  // SLUITheme preset ordinals (mirror SLUIThemeId in the toolkit C ABI).
  int THEME_CUSTOM = 2;

  int rgba(int r, int g, int b, int a) {
    return r * 16777216 + g * 65536 + b * 256 + a;
  }
  int rgb(int r, int g, int b) { return rgba(r, g, b, 255); }

  // Every effect knob clamps to a safe window (the THUAL discipline).
  int clamp(int v, int lo, int hi) {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
  }
  String intToStr(int v) { return "" + v; }

  // A bright, dimensional "studio" theme for the effects line.
  int studioTheme() {
    int t = uiThemePreset(THEME_CUSTOM);
    uiThemeSetBg(t, rgb(27, 36, 48));          // deep studio backdrop
    uiThemeSetSurface(t, rgb(39, 50, 66));     // panel surface
    uiThemeSetSurfaceHi(t, rgb(54, 68, 88));   // shine / hover
    uiThemeSetChrome(t, rgb(46, 60, 80));
    uiThemeSetBorder(t, rgba(120, 170, 255, 60));
    uiThemeSetFg(t, rgb(234, 240, 248));
    uiThemeSetFgDim(t, rgb(158, 176, 198));
    uiThemeSetAccent(t, rgb(79, 142, 247));    // #4F8EF7 studio accent
    uiThemeSetAccentFg(t, rgb(12, 20, 34));
    uiThemeSetRadius(t, 12);
    uiThemeSetControlHeight(t, 34);
    return t;
  }

  void main() {
    print("SLeeLa THUAL Effects Showcase (native SleelaUI) — backend "
        + uiBackendName(uiBackend()) + ", toolkit " + uiVersion());

    int app = uiAppCreate("com.mearvk.SleelaUI.ThualEffectsShowcase");
    if (app < 0) {
      print("No display available (headless): the ui* bridge is wired, but the");
      print("toolkit could not open a window. Run on a desktop (X/Cocoa/Win32).");
      return;
    }

    int theme = studioTheme();
    int win = uiWindowCreate(app, "SLeeLa Studio — THUAL 3.0 Effects", 1000, 640, theme);
    int root = uiWindowRoot(win);

    // --- Chrome: branding painted into the header ---
    int header = uiHeaderBar(root);
    int logo = uiLabel(header, "\u2756");                 // the studio mark
    uiWidgetMargin(logo, 0, 10, 0, 14);
    int brand = uiBox(header, 1, 0);
    uiLabel(brand, "SLeeLa Studio");
    uiLabel(brand, "bright \u00B7 dimensional \u00B7 alive");
    uiSpacer(header);
    uiBadge(header, "effects honored");

    int content = uiBox(root, 1, 14);
    uiWidgetMargin(content, 18, 18, 18, 18);
    uiWidgetExpand(content, 1, 1);

    int cols = uiBox(content, 0, 16);
    uiWidgetExpand(cols, 1, 0);
    int colL = uiBox(cols, 1, 14);
    uiWidgetExpand(colL, 1, 0);
    int colR = uiBox(cols, 1, 14);
    uiWidgetExpand(colR, 1, 0);

    // Effects bundle card: each clamped knob shown on a level/progress bar.
    int fx = uiCard(colL);
    int fxBox = uiBox(fx, 1, 8);
    uiWidgetMargin(fxBox, 14, 14, 14, 14);
    uiLabel(fxBox, "EFFECTS BUNDLE  (every knob clamps)");
    int glow = clamp(140, 0, 100);             // 140% -> 100%
    uiLabel(fxBox, "glow: 140% -> " + intToStr(glow) + "% @24px, #4F8EF7");
    uiLevelBar(fxBox, glow / 100.0);
    int shine = clamp(70, 0, 100);
    uiLabel(fxBox, "3D shine: " + intToStr(shine) + "% @35deg");
    uiLevelBar(fxBox, shine / 100.0);
    int sheen = clamp(85, 0, 100);
    uiLabel(fxBox, "metal sheen: " + intToStr(sheen) + "%");
    uiLevelBar(fxBox, sheen / 100.0);
    int fadeMs = clamp(50, 60, 2000);          // 50 -> 60ms
    uiLabel(fxBox, "fade-in: 50ms -> " + intToStr(fadeMs) + "ms (window 60..2000)");

    // The primary button carrying the effect bundle, plus its audio cues.
    int demo = uiCard(colR);
    int demoBox = uiBox(demo, 1, 10);
    uiWidgetMargin(demoBox, 14, 14, 14, 14);
    uiLabel(demoBox, "PRIMARY ACTION  (bundle + audio cue)");
    int glowBtn = uiButton(demoBox, "\u2756 Confirm");
    uiWidgetSuggested(glowBtn, 1);
    int cues = uiBox(demoBox, 0, 8);
    uiChip(cues, "cue: tap");
    uiChip(cues, "cue: confirm");
    uiSpacer(cues);
    uiLabel(demoBox, "master audio: enabled \u00B7 gain 80%");

    // Scheduled-rotation card (full width): the 'schene' == memo key epoch,
    // made visible by a live, accent-hued throbber.
    int rot = uiCard(content);
    uiWidgetExpand(rot, 1, 0);
    int rotBox = uiBox(rot, 1, 8);
    uiWidgetMargin(rotBox, 14, 14, 14, 14);
    uiLabel(rotBox, "ROTATION SCHEDULE  (visible tick == memo key epoch)");
    int rrow = uiBox(rotBox, 0, 12);
    int spin = uiThrobber(rrow, 1);            // 1 = active/spinning
    uiThrobberSetHue(spin, 215.0);             // blue accent hue
    uiThrobberSetIntensity(spin, 0.9);
    uiThrobberSetWidth(spin, 4);
    int epochBox = uiBox(rrow, 1, 2);
    uiLabel(epochBox, "cadence 90deg / tick");
    uiLabel(epochBox, "each visible tick advances the memo key epoch");
    uiSpacer(rrow);
    uiBadge(rrow, "schene running");

    int status = uiStatusBar(root);
    int sl = uiLabel(status, "THUAL 3.0 \u00B7 clamped glow/shine/shadow/metal/rotation/fade + branding + audio cues");
    uiWidgetMargin(sl, 0, 12, 0, 12);

    uiWindowShow(win);
    print("Window shown (throbber animating). Close it to exit; running the event loop.");
    int code = uiAppRun(app);
    uiThemeDestroy(theme);
    uiAppDestroy(app);
    print("event loop exited with code " + code);
  }
}
