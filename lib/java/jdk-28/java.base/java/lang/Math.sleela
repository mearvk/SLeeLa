  @throwable("java.lang.ArithmeticException")
  public static int unsignedMultiplyExact(int x, int y) {
    long ux = x; if (ux < 0) { ux = ux + 4294967296; }
    long uy = y; if (uy < 0) { uy = uy + 4294967296; }
    long p = ux * uy;
