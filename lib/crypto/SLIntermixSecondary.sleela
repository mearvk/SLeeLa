/*
 * lib/crypto/SLIntermixSecondary.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLIntermixSecondary, the
 *   second secondary intermix stage woven internally over the running text,
 *   again, after SLIntermixPrimary.
 *
 * Rationale: Mirrors Intermix02 of the reference AES2 module — the second cipher
 *   intermix loop that substitutes at positions 2, 3, and 17 using base-11 and
 *   base-17 conversions ORed with per-position constants.
 *
 * Order and Orientation:
 *   - Orientation: ORIENT_INTERMIX, internal (secondary) weave, second pass.
 *   - This stage runs AFTER SLIntermixPrimary and the ordering is respected.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLIntermixSecondary {
  static final int SPAN = 19;               // loop 1..18 as in the reference
  static final int POS17 = 17; static final int BASE17 = 17; static final int MASK17 = 0x771321a;
  static final int POS2  = 2;  static final int BASE2  = 11; static final int MASK2  = 0x7722321;
  static final int POS3  = 3;  static final int BASE3  = 17; static final int MASK3  = 0x77321a;

  int state;

  void prepare() { state = 1; }
  void enable() { state = 1; }
  void disable() { state = 0; }
  boolean active() { return state == 1; }

  String apply(String running, SLRadixTable radices) {
    if (!active()) { return running; }
    return native sleela_crypto_intermix_secondary(
        running, SPAN,
        POS17, BASE17, MASK17,
        POS2,  BASE2,  MASK2,
        POS3,  BASE3,  MASK3);
  }
}
