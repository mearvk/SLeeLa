/*
 * lib/cpu/components/SLMemoryModule.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLMemoryModule — a selectable main-memory part a user
 *   plugs into a Sleela executor build. It carries the real-world specification
 *   of a RAM module: technology (DRAM/SDRAM/DDRn/SRAM), capacity, data-bus
 *   width, clock, CAS latency, and the resulting first-word latency and peak
 *   transfer bandwidth. The timings are what make one RAM choice faster than
 *   another; SLComponentCatalog offers presets (DDR3-1600, DDR5-6000, ...).
 *
 * The module backs an SLRAM at the chosen capacity; the spec fields drive the
 * performance model (effective bandwidth, access latency) so overclocked CPUs
 * and faster RAM visibly change an executor's characterization.
 *
 * Family: cpu.components. Composes SLRAM; selected via SLComponentCatalog.
 */
#sleela 1.3
class SLMemoryModule {
  // Memory technology ids.
  static final int TECH_SRAM   = 0;
  static final int TECH_DRAM   = 1;
  static final int TECH_SDRAM  = 2;
  static final int TECH_DDR    = 3;
  static final int TECH_DDR2   = 4;
  static final int TECH_DDR3   = 5;
  static final int TECH_DDR4   = 6;
  static final int TECH_DDR5   = 7;

  String partName;      // e.g. "DDR4-3200 16GB"
  int technology;
  int capacityMiB;      // module capacity in MiB
  int busWidthBits;     // data bus width (e.g. 64 for a DIMM)
  int clockMHz;         // I/O bus clock (MT/s = clockMHz × ddrFactor)
  int casLatency;       // CL in clock cycles
  int ddrFactor;        // 1 for SDR/SRAM, 2 for DDR double-pumping

  SLRAM backing;        // the actual word store the executor addresses

  void configure(String name, int tech, int capMiB, int busBits,
                 int ioClockMHz, int cl, int ddr) {
    partName = name; technology = tech; capacityMiB = capMiB;
    busWidthBits = busBits; clockMHz = ioClockMHz; casLatency = cl;
    ddrFactor = (ddr < 1) ? 1 : ddr;
  }

  // Allocate the backing store for this module as `width`-bit words.
  SLRAM mount(int wordWidth) {
    int words = (capacityMiB * 1048576 * 8) / wordWidth;
    backing = new SLRAM(); backing.configure(words, wordWidth); backing.allocate();
    return backing;
  }

  // Effective data rate in mega-transfers/second (DDR double-pumps).
  int transfersPerSecMT() { return clockMHz * ddrFactor; }

  // Peak bandwidth in MB/s: MT/s × bus bytes.
  int peakBandwidthMBs() { return transfersPerSecMT() * (busWidthBits / 8); }

  // First-word access latency in nanoseconds: CL / clock. (×1000 for ns.)
  int firstWordLatencyNs() { if (clockMHz <= 0) { return 0; } return (casLatency * 1000) / clockMHz; }

  String name()        { return partName; }
  int tech()           { return technology; }
  int capacity()       { return capacityMiB; }
  int busWidth()       { return busWidthBits; }
  int clock()          { return clockMHz; }
  int cl()             { return casLatency; }
  SLRAM memory()       { return backing; }

  String technologyName() {
    if (technology == TECH_SRAM)  { return "SRAM"; }
    if (technology == TECH_DRAM)  { return "DRAM"; }
    if (technology == TECH_SDRAM) { return "SDRAM"; }
    if (technology == TECH_DDR)   { return "DDR"; }
    if (technology == TECH_DDR2)  { return "DDR2"; }
    if (technology == TECH_DDR3)  { return "DDR3"; }
    if (technology == TECH_DDR4)  { return "DDR4"; }
    if (technology == TECH_DDR5)  { return "DDR5"; }
    return "RAM";
  }
}
