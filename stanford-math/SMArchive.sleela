<< stanford-math/SMArchive.sleela
   SLeeLa Standard Library Definition.
   Definition: Runnable entry point for the Stanford Math brand archive. Links
   the sibling records (brand, people, formulas, symbols, thermodynamics) and
   broadcasts the whole honest catalog. >>
#sleela 2.1
< Worker-class demo carrier with full identity metadata. >
class SMArchive {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 9150;
  String metaAuthor = "Stanford University Department of Mathematics";
  String metaDate = "2026-10-25";
  String metaCopyright = "SLeeLa project; subject facts in the public record";
  String metaTrademark = "none";
  String metaCorporation = "The Leland Stanford Junior University";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-25";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  void main() {
    print("==== Stanford Math brand -- present-utopia archive ====");

    SMBrand brand = new SMBrand();
    print(brand.describe());
    print("motto: " + brand.getMotto() + "  <" + brand.getHomepage() + ">");

    print("");
    print("-- Named mathematicians (public record) --");
    SMPersonRegistry people = new SMPersonRegistry();
    people.build();
    int pn = people.count();
    int i = 0;
    while (i < pn) {
      print("  " + people.summaryAt(i));
      i = i + 1;
    }

    print("");
    print("-- Named formulas / theorems --");
    SMFormulaCatalog formulas = new SMFormulaCatalog();
    formulas.build();
    int fn = formulas.count();
    i = 0;
    while (i < fn) {
      print("  " + formulas.entryAt(i));
      i = i + 1;
    }

    print("");
    print("-- Symbols --");
    SMSymbolTable symbols = new SMSymbolTable();
    symbols.build();
    int sn = symbols.count();
    i = 0;
    while (i < sn) {
      print("  " + symbols.entryAt(i));
      i = i + 1;
    }

    print("");
    print("-- How far does their thermodynamics go? --");
    SMThermodynamics thermo = new SMThermodynamics();
    thermo.build();
    int tn = thermo.count();
    i = 0;
    while (i < tn) {
      print("  " + thermo.rungAt(i));
      i = i + 1;
    }
    print("");
    print("Answer: " + thermo.reachStatement());

    print("");
    print("==== Equation canon (math, physics, thermodynamics, crossovers) ====");

    print("");
    print("-- Mathematics canon --");
    SMMathCanon mathCanon = new SMMathCanon();
    mathCanon.build();
    int mn = mathCanon.count();
    i = 0;
    while (i < mn) {
      print("  " + mathCanon.lineAt(i));
      i = i + 1;
    }

    print("");
    print("-- Physics canon --");
    SMPhysicsCanon physCanon = new SMPhysicsCanon();
    physCanon.build();
    int phn = physCanon.count();
    i = 0;
    while (i < phn) {
      print("  " + physCanon.lineAt(i));
      i = i + 1;
    }

    print("");
    print("-- Thermodynamics & statistical mechanics canon --");
    SMThermoEquations thermoEq = new SMThermoEquations();
    thermoEq.build();
    int ten = thermoEq.count();
    i = 0;
    while (i < ten) {
      print("  " + thermoEq.lineAt(i));
      i = i + 1;
    }

    print("");
    print("-- Crossover canon (finance, chemistry, cosmology, information) --");
    SMCrossoverCanon crossCanon = new SMCrossoverCanon();
    crossCanon.build();
    int cn = crossCanon.count();
    i = 0;
    while (i < cn) {
      print("  " + crossCanon.lineAt(i));
      i = i + 1;
    }

    int total = mn + phn + ten + cn;
    print("");
    print("Equation canon total: " + total + " entries recorded, each faithful to its real origin.");
    print("==== end of archive ====");
  }
}
