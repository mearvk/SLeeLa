/*
 * lib/regex/RegexCompiler.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexCompiler used within the regex library family.
 */
#sleela 2.1
class RegexCompiler {
  int state;
  void reset(){state=0;}
  void compile(){state=1;}
  boolean compiled(){return state==1;}
}
