// for-loops, locals, and integer arithmetic.
class Fibonacci {

    int fib(int n) {
        int a = 0;
        int b = 1;
        int i = 0;
        while (i < n) {
            int t = a + b;
            a = b;
            b = t;
            i = i + 1;
        }
        return a;
    }

    void main() {
        for (int n = 0; n < 15; n = n + 1) {
            print("fib(" + n + ") = " + fib(n));
        }
    }
}
