/*
 * lib/core/SLResult.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLResult used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Result.
// Role: language. Responsibility: success/failure result.
class SLResult {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
