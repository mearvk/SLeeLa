/*
 * lib/crypto/SLAesGcm.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLAesGcm used within the crypto library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. AES-GCM authenticated encryption (NIST SP 800-38D). Native impl crosses the VM/OS bridge to /crypto.
class SLAesGcm {
  String algorithm; int keyBits; int tagBytes; int state;
  void configure(String a){algorithm=a;} void keySize(int b){keyBits=b;} void tagSize(int t){tagBytes=t;} void enable(){state=1;} void disable(){state=0;} boolean active(){return state==1;}
}
