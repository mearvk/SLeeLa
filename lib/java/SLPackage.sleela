/*
 * lib/java/SLPackage.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa Java library package facade used to expose Java interoperability
 * and Java-oriented library services to the SLeeLa Compiler, Loader, and Nordshrift.
 */
#sleela 2.1

class SLPackage {
  String packageName = "java";

  String name() {
    return packageName;
  }

  boolean available() {
    return packageName != null;
  }
}
