  < ---- java.math.BigInteger members (procedural implementation in SLeeLa) ---- >
  << Immutable arbitrary-precision integers. The value is signum plus a
     magnitude of little-endian base-1e9 limbs (trimmed; zero is signum 0
     with one zero limb), so add/subtract/multiply/divide/sqrt run on the
     native VM big-integer opcodes. Bitwise operations, shifts, hashCode,
     toByteArray and doubleValue use the two-complement 32-bit word view of
     the Java specification. The constructor is BigInteger(String) (decimal);
     the other Java constructors are newRadix(String, int),
     newFromBytes(byte[]), newSignMagnitude(int, byte[]) and
     newRandomBits(int, Random). Static factories are instance methods. >>
  int signum;
  int[] mag;
  BigInteger(String val) {
    this.signum = 0;
    this.mag = limbs(1);
    this.nib = null;
    this.quoOut = null;
    this.remOut = null;
    parseInto(val, 10);
  }

  < limb utilities >
  int[] limbs(int n) {
    int[] a = new int[n];
    int i = 0;
    while (i < n) { a[i] = 0; i = i + 1; }
    return a;
  }
  int[] trimmed(int[] a, int n) {
    int k = n;
    if (k > arrayLength(a)) { k = arrayLength(a); }
    while (k > 1 && a[k - 1] == 0) { k = k - 1; }
    if (k < 1) { k = 1; }
    if (k == arrayLength(a)) { return a; }
    int[] r = limbs(k);
    int i = 0;
    while (i < k) { r[i] = a[i]; i = i + 1; }
    return r;
  }
  boolean magZero(int[] a) { return arrayLength(a) == 1 && a[0] == 0; }
  int cmpMag(int[] a, int[] b) {
    int la = arrayLength(a);
    int lb = arrayLength(b);
    if (la != lb) { if (la < lb) { return -1; } return 1; }
    int i = la - 1;
    while (i >= 0) {
      if (a[i] != b[i]) { if (a[i] < b[i]) { return -1; } return 1; }
      i = i - 1;
    }
    return 0;
  }
  int[] addMag(int[] a, int[] b) {
    int n = arrayLength(a);
    if (arrayLength(b) > n) { n = arrayLength(b); }
    int[] r = limbs(n + 1);
    int k = bigadd(a, b, r);
    return trimmed(r, k);
  }
  << a - b for |a| >= |b|. >>
  int[] subMag(int[] a, int[] b) {
    int[] r = limbs(arrayLength(a));
    int k = bigsub(a, b, r);
    return trimmed(r, k);
  }
  int[] mulMag(int[] a, int[] b) {
    if (magZero(a) || magZero(b)) { return limbs(1); }
    int[] r = limbs(arrayLength(a) + arrayLength(b));
    int k = bigmul(a, b, r);
    return trimmed(r, k);
  }
  int[] quoOut;
  int[] remOut;
  void divMag(int[] a, int[] b) {
    if (cmpMag(a, b) < 0) { this.quoOut = limbs(1); this.remOut = a; return; }
    int[] q = limbs(arrayLength(a));
    int[] r = limbs(arrayLength(b));
    bigdiv(a, b, q, r);
    this.quoOut = trimmed(q, arrayLength(q));
    this.remOut = trimmed(r, arrayLength(r));
  }
  << magnitude * small + add (small, add below 2^31), for radix parsing. >>
  int[] mulAddSmall(int[] a, long small, long add) {
    int n = arrayLength(a);
    int[] r = limbs(n + 2);
    long carry = add;
    int i = 0;
    while (i < n) {
      long v = a[i];
      v = v * small + carry;
      r[i] = (int) (v % 1000000000);
      carry = v / 1000000000;
      i = i + 1;
    }
    while (carry > 0) { r[i] = (int) (carry % 1000000000); carry = carry / 1000000000; i = i + 1; }
    return trimmed(r, n + 2);
  }
  BigInteger make(int sig, int[] m) {
    BigInteger r = new BigInteger("0");
    if (magZero(m)) { r.signum = 0; } else { r.signum = sig; }
    r.mag = m;
    return r;
  }

  < parsing >
  void parseInto(String val, int radix) {
    if (val == null) { throw new NullPointerException(null); }
    if (radix < 2 || radix > 36) { throw new NumberFormatException("Radix out of range"); }
    String u = javaStringFromUtf8(val);
    int n = javaStringLength(u);
    if (n == 0) { throw new NumberFormatException("Zero length BigInteger"); }
    int i = 0;
    int sig = 1;
    int c0 = javaStringCharAt(u, 0);
    if (c0 == 45 || c0 == 43) {
      if (c0 == 45) { sig = -1; }
      i = 1;
      if (n == 1) { throw new NumberFormatException("Zero length BigInteger"); }
    }
    int j = i;
    while (j < n) {
      int cs = javaStringCharAt(u, j);
      if (cs == 45 || cs == 43) { throw new NumberFormatException("Illegal embedded sign character"); }
      j = j + 1;
    }
    while (i < n - 1 && javaStringCharAt(u, i) == 48) { i = i + 1; }
    int z = i;
    int[] m = limbs(1);
    while (i < n) {
      int c = javaStringCharAt(u, i);
      int d = -1;
      if (c >= 48 && c <= 57) { d = c - 48; }
      if (c >= 97 && c <= 122) { d = c - 87; }
      if (c >= 65 && c <= 90) { d = c - 55; }
      if (d < 0 || d >= radix) { throw groupError(u, z, n, i, radix); }
      m = mulAddSmall(m, radix, d);
      i = i + 1;
    }
    this.mag = m;
    if (magZero(m)) { this.signum = 0; } else { this.signum = sig; }
  }

  << Java parses the digits in groups of digitsPerInt(radix) characters with
     Integer.parseInt, so a bad digit reports the group that holds it. >>
  NumberFormatException groupError(String u, int z, int n, int bad, int radix) {
    int dpi = digitsPerInt(radix);
    int first = (n - z) % dpi;
    if (first == 0) { first = dpi; }
    int gs = z;
    int ge = z + first;
    if (bad >= ge) {
      gs = ge + ((bad - ge) / dpi) * dpi;
      ge = gs + dpi;
    }
    Character C = new Character(0);
    String g = "";
    int k = gs;
    while (k < ge && k < n) {
      String one = C.toStringOf(javaStringCharAt(u, k));
      if (one == null) { one = "?"; }
      g = g + one;
      k = k + 1;
    }
    if (radix == 10) { return new NumberFormatException("For input string: \"" + g + "\""); }
    return new NumberFormatException("For input string: \"" + g + "\" under radix " + radix);
  }
  int digitsPerInt(int radix) {
    if (radix == 2) { return 30; }
    if (radix == 3) { return 19; }
    if (radix == 4) { return 15; }
    if (radix == 5) { return 13; }
    if (radix <= 7) { return 11; }
    if (radix == 8) { return 10; }
    if (radix <= 10) { return 9; }
    if (radix <= 14) { return 8; }
    if (radix <= 21) { return 7; }
    if (radix <= 35) { return 6; }
    return 5;
  }

  < static factories and constants (call on any BigInteger) >
  BigInteger ZERO() { return make(0, limbs(1)); }
  BigInteger ONE() { return valueOf(1); }
  BigInteger TWO() { return valueOf(2); }
  BigInteger TEN() { return valueOf(10); }
  BigInteger valueOf(long val) {
    if (val == 0) { return make(0, limbs(1)); }
    int sig = 1;
    if (val < 0) { sig = -1; }
    int[] m = limbs(3);
    if (val == -9223372036854775807 - 1) {
      m[0] = 854775808; m[1] = 223372036; m[2] = 9;
      return make(-1, m);
    }
    long v = val;
    if (v < 0) { v = 0 - v; }
    m[0] = (int) (v % 1000000000);
    m[1] = (int) ((v / 1000000000) % 1000000000);
    m[2] = (int) (v / 1000000000000000000);
    return make(sig, trimmed(m, 3));
  }
  BigInteger newRadix(String val, int radix) {
    BigInteger r = new BigInteger("0");
    r.parseInto(val, radix);
    return r;
  }

  < arithmetic >
  int signum() { return this.signum; }
  BigInteger negate() { return make(0 - this.signum, this.mag); }
  BigInteger abs() { if (this.signum < 0) { return negate(); } return this; }
  BigInteger add(BigInteger val) {
    if (val.signum == 0) { return this; }
    if (this.signum == 0) { return val; }
    if (val.signum == this.signum) { return make(this.signum, addMag(this.mag, val.mag)); }
    int c = cmpMag(this.mag, val.mag);
    if (c == 0) { return make(0, limbs(1)); }
    if (c > 0) { return make(this.signum, subMag(this.mag, val.mag)); }
    return make(val.signum, subMag(val.mag, this.mag));
  }
  BigInteger subtract(BigInteger val) { return add(val.negate()); }
  BigInteger multiply(BigInteger val) {
    if (this.signum == 0 || val.signum == 0) { return make(0, limbs(1)); }
    return make(this.signum * val.signum, mulMag(this.mag, val.mag));
  }
  void checkDivisor(BigInteger val) {
    if (val.signum == 0) { throw new ArithmeticException("BigInteger divide by zero"); }
  }
  BigInteger divide(BigInteger val) {
    checkDivisor(val);
    divMag(this.mag, val.mag);
    return make(this.signum * val.signum, this.quoOut);
  }
  BigInteger remainder(BigInteger val) {
    checkDivisor(val);
    divMag(this.mag, val.mag);
    return make(this.signum, this.remOut);
  }
  BigInteger[] divideAndRemainder(BigInteger val) {
    checkDivisor(val);
    divMag(this.mag, val.mag);
    BigInteger[] r = new BigInteger[2];
    r[0] = make(this.signum * val.signum, this.quoOut);
    r[1] = make(this.signum, this.remOut);
    return r;
  }
  BigInteger mod(BigInteger m) {
    if (m.signum <= 0) { throw new ArithmeticException("BigInteger: modulus not positive"); }
    BigInteger r = remainder(m);
    if (r.signum < 0) { return r.add(m); }
    return r;
  }
  BigInteger pow(int exponent) {
    if (exponent < 0) { throw new ArithmeticException("Negative exponent"); }
    BigInteger result = valueOf(1);
    BigInteger base = this;
    int e = exponent;
    while (e > 0) {
      if (e % 2 == 1) { result = result.multiply(base); }
      e = e / 2;
      if (e > 0) { base = base.multiply(base); }
    }
    return result;
  }
  BigInteger gcd(BigInteger val) {
    int[] a = this.mag;
    int[] b = val.mag;
    while (!magZero(b)) {
      divMag(a, b);
      a = b;
      b = this.remOut;
    }
    return make(1, a);
  }
  BigInteger sqrt() {
    if (this.signum < 0) { throw new ArithmeticException("Negative BigInteger"); }
    if (this.signum == 0) { return this; }
    int[] r = limbs((arrayLength(this.mag) + 1) / 2 + 1);
    int k = bigisqrt(this.mag, r);
    return make(1, trimmed(r, k));
  }
  BigInteger[] sqrtAndRemainder() {
    BigInteger s = sqrt();
    BigInteger[] r = new BigInteger[2];
    r[0] = s;
    r[1] = subtract(s.multiply(s));
    return r;
  }
  BigInteger modPow(BigInteger exponent, BigInteger m) {
    if (m.signum <= 0) { throw new ArithmeticException("BigInteger: modulus not positive"); }
    if (exponent.signum < 0) { return this.modInverse(m).modPow(exponent.negate(), m); }
    if (m.equals(valueOf(1))) { return make(0, limbs(1)); }
    BigInteger result = valueOf(1);
    BigInteger base = mod(m);
    long[] w = words32(exponent.mag);
    int wi = 0;
    while (wi < arrayLength(w)) {
      long word = w[wi];
      long bit = 2147483648;
      while (bit > 0) {
        result = result.multiply(result).mod(m);
        if ((word / bit) % 2 == 1) { result = result.multiply(base).mod(m); }
        bit = bit / 2;
      }
      wi = wi + 1;
    }
    return result;
  }
  BigInteger modInverse(BigInteger m) {
    if (m.signum <= 0) { throw new ArithmeticException("BigInteger: modulus not positive"); }
    if (m.equals(valueOf(1))) { return make(0, limbs(1)); }
    BigInteger a = mod(m);
    BigInteger b = m;
    BigInteger x0 = valueOf(1);
    BigInteger x1 = make(0, limbs(1));
    while (b.signum != 0) {
      BigInteger[] qr = a.divideAndRemainder(b);
      BigInteger q = qr[0];
      BigInteger rr = qr[1];
      a = b;
      b = rr;
      BigInteger t = x0.subtract(q.multiply(x1));
      x0 = x1;
      x1 = t;
    }
    if (!a.equals(valueOf(1))) { throw new ArithmeticException("BigInteger not invertible."); }
    return x0.mod(m);
  }
  << Miller-Rabin with the first thirteen prime bases (deterministic below
     3.3e24; for larger values the error bound is far below Java's
     2^-certainty). >>
  boolean isProbablePrime(int certainty) {
    if (certainty <= 0) { return true; }
    BigInteger w = abs();
    BigInteger two = valueOf(2);
    if (w.compareTo(two) < 0) { return false; }
    int[] small = new int[13];
    small[0] = 2; small[1] = 3; small[2] = 5; small[3] = 7; small[4] = 11; small[5] = 13; small[6] = 17;
    small[7] = 19; small[8] = 23; small[9] = 29; small[10] = 31; small[11] = 37; small[12] = 41;
    int i = 0;
    while (i < 13) {
      BigInteger p = valueOf(small[i]);
      if (w.equals(p)) { return true; }
      if (w.mod(p).signum == 0) { return false; }
      i = i + 1;
    }
    BigInteger wm1 = w.subtract(valueOf(1));
    int s = wm1.getLowestSetBit();
    BigInteger d = wm1.shiftRight(s);
    i = 0;
    while (i < 13) {
      BigInteger x = this.valueOf(small[i]).modPow(d, w);
      boolean ok = x.equals(valueOf(1)) || x.equals(wm1);
      int r = 1;
      while (!ok && r < s) {
        x = x.multiply(x).mod(w);
        if (x.equals(wm1)) { ok = true; }
        r = r + 1;
      }
      if (!ok) { return false; }
      i = i + 1;
    }
    return true;
  }
  BigInteger nextProbablePrime() {
    if (this.signum < 0) { throw new ArithmeticException("start < 0: " + toString()); }
    BigInteger c = add(valueOf(1));
    if (c.compareTo(valueOf(2)) <= 0) { return valueOf(2); }
    if (!c.testBit(0)) { c = c.add(valueOf(1)); }
    while (!c.isProbablePrime(100)) { c = c.add(valueOf(2)); }
    return c;
  }

  < comparison >
  int compareTo(BigInteger val) {
    if (this.signum != val.signum) { if (this.signum < val.signum) { return -1; } return 1; }
    if (this.signum == 0) { return 0; }
    int c = cmpMag(this.mag, val.mag);
    if (this.signum < 0) { return 0 - c; }
    return c;
  }
  boolean equals(Any x) {
    if (x instanceof BigInteger) { BigInteger o = (BigInteger) x; return compareTo(o) == 0; }
    return false;
  }
  BigInteger min(BigInteger val) { if (compareTo(val) < 0) { return this; } return val; }
  BigInteger max(BigInteger val) { if (compareTo(val) > 0) { return this; } return val; }

  < 32-bit word view (big-endian unsigned words of the magnitude) >
  long[] words32(int[] m) {
    int[] cur = m;
    long[] tmp = new long[arrayLength(m) * 2 + 2];
    int n = 0;
    while (!magZero(cur)) {
      int[] q1 = limbs(arrayLength(cur));
      int lo = bigdivmod(cur, 65536, q1);
      int[] q2 = limbs(arrayLength(cur));
      int hi = bigdivmod(trimmed(q1, arrayLength(q1)), 65536, q2);
      long w = hi;
      w = w * 65536 + lo;
      tmp[n] = w;
      n = n + 1;
      cur = trimmed(q2, arrayLength(q2));
    }
    long[] r = new long[n];
    int i = 0;
    while (i < n) { r[i] = tmp[n - 1 - i]; i = i + 1; }
    return r;
  }
  int[] fromWords32(long[] w) {
    int[] m = limbs(1);
    int i = 0;
    while (i < arrayLength(w)) {
      m = mulAddSmall(m, 65536, w[i] / 65536);
      m = mulAddSmall(m, 65536, w[i] % 65536);
      i = i + 1;
    }
    return m;
  }
  << Two-complement little-endian 32-bit words, sign-extended to n words. >>
  long[] twos(int n) {
    long[] r = new long[n];
    int i = 0;
    while (i < n) { r[i] = 0; i = i + 1; }
    long[] w = words32(this.mag);
    int k = 0;
    while (k < arrayLength(w) && k < n) { r[k] = w[arrayLength(w) - 1 - k]; k = k + 1; }
    if (this.signum < 0) {
      long carry = 1;
      i = 0;
      while (i < n) {
        long v = 4294967295 - r[i] + carry;
        r[i] = v % 4294967296;
        carry = v / 4294967296;
        i = i + 1;
      }
    }
    return r;
  }
  BigInteger fromTwos(long[] r) {
    int n = arrayLength(r);
    boolean neg = n > 0 && r[n - 1] >= 2147483648;
    long[] m = new long[n];
    int i = 0;
    while (i < n) { m[i] = r[i]; i = i + 1; }
    if (neg) {
      long carry = 1;
      i = 0;
      while (i < n) {
        long v = 4294967295 - m[i] + carry;
        m[i] = v % 4294967296;
        carry = v / 4294967296;
        i = i + 1;
      }
    }
    long[] be = new long[n];
    i = 0;
    while (i < n) { be[i] = m[n - 1 - i]; i = i + 1; }
    int sig = 1;
    if (neg) { sig = -1; }
    return make(sig, fromWords32(be));
  }
  int wordsFor(BigInteger o) {
    int a = bitLength() / 32 + 2;
    int b = o.bitLength() / 32 + 2;
    if (b > a) { return b; }
    return a;
  }
  int[] nib;
  long bitop(long a, long b, int op) {
    if (this.nib == null) {
      this.nib = new int[768];
      int x = 0;
      while (x < 16) {
        int y = 0;
        while (y < 16) {
          int ra = 0;
          int ro = 0;
          int rx = 0;
          int bit = 1;
          int p = x;
          int q = y;
          int k = 0;
          while (k < 4) {
            int pa = p % 2;
            int qb = q % 2;
            if (pa == 1 && qb == 1) { ra = ra + bit; }
            if (pa == 1 || qb == 1) { ro = ro + bit; }
            if (pa != qb) { rx = rx + bit; }
            p = p / 2; q = q / 2; bit = bit * 2; k = k + 1;
          }
          this.nib[x * 16 + y] = ra;
          this.nib[256 + x * 16 + y] = ro;
          this.nib[512 + x * 16 + y] = rx;
          y = y + 1;
        }
        x = x + 1;
      }
    }
    long r = 0;
    long mul = 1;
    long p = a;
    long q = b;
    int k = 0;
    while (k < 8) {
      r = r + this.nib[op * 256 + (int) ((p % 16) * 16 + (q % 16))] * mul;
      p = p / 16; q = q / 16; mul = mul * 16; k = k + 1;
    }
    return r;
  }
  BigInteger bitwise(BigInteger val, int op) {
    int n = wordsFor(val);
    long[] a = twos(n);
    long[] b = val.twos(n);
    long[] r = new long[n];
    int i = 0;
    while (i < n) { r[i] = bitop(a[i], b[i], op); i = i + 1; }
    return fromTwos(r);
  }
  BigInteger and(BigInteger val) { return bitwise(val, 0); }
  BigInteger or(BigInteger val) { return bitwise(val, 1); }
  BigInteger xor(BigInteger val) { return bitwise(val, 2); }
  BigInteger not() { return this.negate().subtract(valueOf(1)); }
  BigInteger andNot(BigInteger val) { return and(val.not()); }
  BigInteger shiftLeft(int n) {
    if (n < 0) { return shiftRight(0 - n); }
    if (this.signum == 0 || n == 0) { return this; }
    return multiply(this.valueOf(2).pow(n));
  }
  << Arithmetic shift: floor(this / 2^n). >>
  BigInteger shiftRight(int n) {
    if (n < 0) { return shiftLeft(0 - n); }
    if (this.signum == 0 || n == 0) { return this; }
    BigInteger d = this.valueOf(2).pow(n);
    BigInteger[] qr = divideAndRemainder(d);
    BigInteger quo = qr[0];
    BigInteger rem = qr[1];
    if (this.signum < 0 && rem.signum != 0) { return quo.subtract(valueOf(1)); }
    return quo;
  }
