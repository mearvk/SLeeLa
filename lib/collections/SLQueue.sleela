/*
 * lib/collections/SLQueue.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLQueue used within the collections library family.
 */
#sleela 1.3
// Unified SLeeLa standard-library front-end object.
// Family: collections. Native VM/OS work crosses an explicit bridge.
class SLQueue {
  int size; void add(){size=size+1;} void remove(){if(size>0)size=size-1;} int length(){return size;} boolean empty(){return size==0;}
}
