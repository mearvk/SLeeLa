/*
 * lib/regex/RegexError.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexError used within the regex library family.
 */
#sleela 1.3
class RegexError {
  int code;
  int position;
  string message;
  void clear(){code=0;position=0;message="";}
  void set(int c,int p,string m){code=c;position=p;message=m;}
  int getCode(){return code;}
  int getPosition(){return position;}
}
