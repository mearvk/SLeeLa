/*
 * lib/crypto/SLIntermixPrimary.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLIntermixPrimary, the
 *   first secondary intermix stage woven internally over the running text.
 *
 * Rationale: Mirrors Intermix01 of the reference AES2 module — the first cipher
 *   intermix loop that substitutes at positions 1, 2, 6, and 7 using base-11
 *   and base-12 conversions ORed with per-position constants.
 *
 * Order and Orientation:
 *   - Orientation: ORIENT_INTERMIX, internal (secondary) weave.
 *   - This stage runs BEFORE SLIntermixSecondary and the ordering is respected.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLIntermixPrimary {
  // Position / base / mask triples, in the reference order (7,2,6,1).
  static final int SPAN = 16;              // loop 1..15 as in the reference
  static final int POS7 = 7;  static final int BASE7 = 11; static final int MASK7 = 0x7716;
  static final int POS2 = 2;  static final int BASE2 = 11; static final int MASK2 = 0x77223;
  static final int POS6 = 6;  static final int BASE6 = 11; static final int MASK6 = 0x7766;
  static final int POS1 = 1;  static final int BASE1 = 12; static final int MASK1 = 0x771c;

  int state;

  void prepare() { state = 1; }
  void enable() { state = 1; }
  void disable() { state = 0; }
  boolean active() { return state == 1; }

  // Weave the four fixed positions into the running text, preserving the order
  // the reference uses. Non-selected positions are passed through unchanged.
  String apply(String running, SLRadixTable radices) {
    if (!active()) { return running; }
    return native sleela_crypto_intermix_primary(
        running, SPAN,
        POS7, BASE7, MASK7,
        POS2, BASE2, MASK2,
        POS6, BASE6, MASK6,
        POS1, BASE1, MASK1);
  }
}
