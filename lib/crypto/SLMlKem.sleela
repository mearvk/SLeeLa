/*
 * lib/crypto/SLMlKem.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLMlKem used within the crypto library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. ML-KEM post-quantum key encapsulation (FIPS 203, CNSA 2.0).
// Native impl crosses the VM/OS bridge to /crypto; see crypto/PQ-INTEGRATION.md.
class SLMlKem {
  String parameterSet; int state;
  void configure(String p){parameterSet=p;} void enable(){state=1;} void disable(){state=0;} boolean active(){return state==1;}
}
