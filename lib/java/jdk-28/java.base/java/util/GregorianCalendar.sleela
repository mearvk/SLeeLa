  < ---- helpers: lenient composition and the Hinnant civil calendar ---- >
  void compose(long year, long month0, long day, long hour, long minute, long second, long milli) {
    long y = year + gfdiv(month0, 12);
    long m = gfmod(month0, 12) + 1;
    long days = gDays(y, m, 1) + (day - 1);
    this.gcTime = days * 86400000 + hour * 3600000 + minute * 60000 + second * 1000 + milli;
  }
  static boolean leap(long y) { return (gfmod(y, 4) == 0) && ((gfmod(y, 100) != 0) || (gfmod(y, 400) == 0)); }
  static int monthLength(int y, int m) {
    if (m == 2) { if (leap(y)) { return 29; } return 28; }
    if (m == 4 || m == 6 || m == 9 || m == 11) { return 30; }
    return 31;
  }
  static long gfdiv(long a, long b) {
    long q = a / b;
    if ((a % b != 0) && ((a < 0) != (b < 0))) { q = q - 1; }
    return q;
  }
  static long gfmod(long a, long b) { return a - gfdiv(a, b) * b; }
  static long gDays(long yIn, long m, long d) {
    long y = yIn;
    if (m <= 2) { y = y - 1; }
    long era = gfdiv(y, 400);
    long yoe = y - era * 400;
    long mp = m - 3;
    if (m <= 2) { mp = m + 9; }
    long doy = (153 * mp + 2) / 5 + d - 1;
    long doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
  }
  static long gDoy(long days) {
    long z = days + 719468;
    long era = gfdiv(z, 146097);
    long doe = z - era * 146097;
    long yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    return doe - (365 * yoe + yoe / 4 - yoe / 100);
  }
  static int gYear(long days) {
    long z = days + 719468;
    long era = gfdiv(z, 146097);
    long doe = z - era * 146097;
    long yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    long y = yoe + era * 400;
    long mp = (5 * gDoy(days) + 2) / 153;
    if (mp >= 10) { y = y + 1; }
    return (int) y;
  }
  static int gMonth(long days) {
    long mp = (5 * gDoy(days) + 2) / 153;
    if (mp < 10) { return (int) (mp + 3); }
    return (int) (mp - 9);
  }
  static int gDay(long days) {
    long doy = gDoy(days);
    long mp = (5 * doy + 2) / 153;
    return (int) (doy - (153 * mp + 2) / 5 + 1);
  }
