<< lib/cpu/SLSignalQuality.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLSignalQuality, a monitor attached to one named net in a
     CPU circuit. It samples the net voltage against the net SLLogicFamily and
     counts what a bench engineer would look for: samples that land in the
     forbidden zone between logic levels, samples that leave the supply window,
     edges that are too slow, and ringing beyond the overshoot allowance.

   A net is healthy when it has produced no forbidden-zone samples, no
   out-of-window samples, no slow edges and no excess overshoot. The monitor
   never invents data. It only judges the voltages and edge times it is handed.

   Family: cpu. Pure Sleela signal-integrity check. >>
#sleela 2.5
material;
class SLSignalQuality {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 39535;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-21";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-21";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 7;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < net name, for example phi2, A0, DB7, RDY >
  String wire;
  SLLogicFamily family;
  < last sampled level in millivolts >
  int levelMv;
  < last classification: 0 LOW, 1 HIGH, 2 forbidden, 3 out of window >
  int state;
  < measured rise and fall times in picoseconds >
  int risePs;
  int fallPs;
  < slowest edge the receiving logic tolerates, in picoseconds >
  int edgeLimitPs;
  < overshoot beyond the rail seen on the net, in millivolts >
  int overshootMv;
  < overshoot the family tolerates, in millivolts >
  int overshootLimitMv;
  int samples;
  int forbidden;
  int outOfWindow;
  int slowEdges;
  int ringing;

  void configure(String netName, SLLogicFamily fam) {
    wire = netName; family = fam;
    levelMv = 0; state = 0; risePs = 0; fallPs = 0;
    edgeLimitPs = fam.edgeTimePs() * 4;
    overshootMv = 0; overshootLimitMv = fam.toleranceMv();
    samples = 0; forbidden = 0; outOfWindow = 0; slowEdges = 0; ringing = 0;
  }

  void setEdgeLimit(int ps) { if (ps > 0) { edgeLimitPs = ps; } }
  void setOvershootLimit(int mv) { if (mv >= 0) { overshootLimitMv = mv; } }

  < Judge one voltage sample and remember the verdict. >
  int sample(int mv) {
    levelMv = mv;
    samples = samples + 1;
    state = family.classify(mv);
    if (state == 2) { forbidden = forbidden + 1; }
    if (state == 3) { outOfWindow = outOfWindow + 1; }
    return state;
  }

  < Judge one measured edge. Returns true when the edge is fast enough. >
  boolean edge(int riseTimePs, int fallTimePs) {
    risePs = riseTimePs; fallPs = fallTimePs;
    boolean ok = true;
    if (riseTimePs > edgeLimitPs) { ok = false; }
    if (fallTimePs > edgeLimitPs) { ok = false; }
    if (!ok) { slowEdges = slowEdges + 1; }
    return ok;
  }

  < Judge overshoot beyond the rail. Returns true when within allowance. >
  boolean overshoot(int mv) {
    overshootMv = mv;
    if (mv > overshootLimitMv) { ringing = ringing + 1; return false; }
    return true;
  }

  int violations() { return forbidden + outOfWindow + slowEdges + ringing; }
  boolean healthy() { return violations() == 0; }
  int sampleCount() { return samples; }
  int lastState() { return state; }
  int lastLevelMv() { return levelMv; }
  String netName() { return wire; }

  String stateName() {
    if (state == 0) { return "LOW"; }
    if (state == 1) { return "HIGH"; }
    if (state == 2) { return "FORBIDDEN"; }
    return "OUT-OF-WINDOW";
  }
}
