<< lib/cpu/SLOpcodeMap.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLOpcodeMap — the translator that maps the register-style
     CPU ISA (SLInstructionSet) and the OS system calls (SLSystemCall) ONTO the
     canonical SLeeLa opcode substrate (SLSleelaOpcode), emitting the result into
     an SLSleelaVM. This is the pivot of the whole design: every CPU instruction
     and every OS service is expressed as a sequence of canonical Sleela opcodes.
   
   Because the Sleela opcodes are Turing complete and already executed by the
   native VM, mapping the CPU ISA + syscalls onto them means the register
   machine's behavior is fully realized by the substrate. Repeating this mapping
   for whatever a frontend emits is exactly what makes C/C++/Java/Sleela 1:1 in
   Turing effect: they all become streams of the same opcodes.
   
   Register model: the register file is mapped to Sleela GLOBAL slots (rN ->
   global N). A register op becomes: load operands from globals, do the stack
   arithmetic, store the result back to a global.
   
   Family: cpu. Composes SLInstructionSet, SLSystemCall, SLSleelaOpcode, SLSleelaVM. >>
#sleela 2.5
material;
class SLOpcodeMap {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10269;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-10-16";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-06";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  < Local mirrors of constants owned by other classes. The checker does not >
  < resolve cross-class statics reached transitively, so the values are repeated >
  < here under the owner class name. Keep them equal to the owner. >
  static final int SLInstructionSet_ADD = 10;
  static final int SLInstructionSet_AND = 16;
  static final int SLInstructionSet_CALL = 28;
  static final int SLInstructionSet_CMP = 22;
  static final int SLInstructionSet_DIV = 13;
  static final int SLInstructionSet_HALT = 1;
  static final int SLInstructionSet_JMP = 23;
  static final int SLInstructionSet_JNZ = 25;
  static final int SLInstructionSet_JZ = 24;
  static final int SLInstructionSet_MOD = 14;
  static final int SLInstructionSet_MOV = 2;
  static final int SLInstructionSet_MOVR = 3;
  static final int SLInstructionSet_MUL = 12;
  static final int SLInstructionSet_NEG = 15;
  static final int SLInstructionSet_NOP = 0;
  static final int SLInstructionSet_OR = 17;
  static final int SLInstructionSet_POP = 31;
  static final int SLInstructionSet_PUSH = 30;
  static final int SLInstructionSet_RET = 29;
  static final int SLInstructionSet_SUB = 11;
  static final int SLInstructionSet_SYSCALL = 34;
  static final int SLInstructionSet_XOR = 18;
  static final int SLSleelaOpcode_OP_ADD = 8;
  static final int SLSleelaOpcode_OP_AND = 20;
  static final int SLSleelaOpcode_OP_CALL = 25;
  static final int SLSleelaOpcode_OP_CONST = 1;
  static final int SLSleelaOpcode_OP_DIV = 11;
  static final int SLSleelaOpcode_OP_FILECLOSE = 46;
  static final int SLSleelaOpcode_OP_FILEOPEN = 43;
  static final int SLSleelaOpcode_OP_FILEREAD = 44;
  static final int SLSleelaOpcode_OP_HALT = 48;
  static final int SLSleelaOpcode_OP_JMP = 23;
  static final int SLSleelaOpcode_OP_JMPF = 24;
  static final int SLSleelaOpcode_OP_LOADG = 4;
  static final int SLSleelaOpcode_OP_MOD = 12;
  static final int SLSleelaOpcode_OP_MUL = 10;
  static final int SLSleelaOpcode_OP_NE = 15;
  static final int SLSleelaOpcode_OP_NEG = 13;
  static final int SLSleelaOpcode_OP_NOP = 0;
  static final int SLSleelaOpcode_OP_NOT = 22;
  static final int SLSleelaOpcode_OP_OR = 21;
  static final int SLSleelaOpcode_OP_PRINT = 27;
  static final int SLSleelaOpcode_OP_RET = 26;
  static final int SLSleelaOpcode_OP_STOREG = 5;
  static final int SLSleelaOpcode_OP_SUB = 9;
  static final int SLSystemCall_SYS_CLOSE = 3;
  static final int SLSystemCall_SYS_EXIT = 4;
  static final int SLSystemCall_SYS_OPEN = 2;
  static final int SLSystemCall_SYS_READ = 1;
  static final int SLSystemCall_SYS_SPAWN = 5;
  static final int SLSystemCall_SYS_WRITE = 0;
  static final int SLSystemCall_SYS_YIELD = 6;
  SLInstructionSet isa;
  SLSystemCall sys;
  SLSleelaOpcode sop;
  SLSleelaVM vm;
  < register-ISA instructions translated >
  int mappedInstr;
  < Sleela opcodes emitted >
  int emittedOps;

  void configure(SLInstructionSet instructionSet, SLSystemCall syscalls, SLSleelaVM target) {
    isa = instructionSet; sys = syscalls; vm = target;
    sop = new SLSleelaOpcode(); sop.configure(0, "OP_NOP");
    mappedInstr = 0; emittedOps = 0;
  }

  void op0(int opcode) { vm.emit(opcode, 0); emittedOps = emittedOps + 1; }
  void op1(int opcode, int arg) { vm.emit(opcode, arg); emittedOps = emittedOps + 1; }

  < Map ONE register-ISA instruction (opcode rd rs imm) to a Sleela opcode >
  < sequence appended to the VM's code store. Registers live in global slots. >
  void mapInstruction(int op, int rd, int rs, int imm) {
    mappedInstr = mappedInstr + 1;

    if (op == SLInstructionSet_NOP)  { op0(SLSleelaOpcode_OP_NOP); return; }
    if (op == SLInstructionSet_HALT) { op0(SLSleelaOpcode_OP_HALT); return; }

    < rd <- imm :  CONST imm ; STOREG rd >
    if (op == SLInstructionSet_MOV)  { op1(SLSleelaOpcode_OP_CONST, imm); op1(SLSleelaOpcode_OP_STOREG, rd); return; }
    < rd <- rs  :  LOADG rs ; STOREG rd >
    if (op == SLInstructionSet_MOVR) { op1(SLSleelaOpcode_OP_LOADG, rs); op1(SLSleelaOpcode_OP_STOREG, rd); return; }

    < Binary arithmetic rd = rd (op) rs :  LOADG rd ; LOADG rs ; <ALU> ; STOREG rd >
    if (op == SLInstructionSet_ADD || op == SLInstructionSet_SUB || op == SLInstructionSet_MUL || op == SLInstructionSet_DIV ||
        op == SLInstructionSet_MOD || op == SLInstructionSet_AND || op == SLInstructionSet_OR  || op == SLInstructionSet_XOR) {
      op1(SLSleelaOpcode_OP_LOADG, rd);
      op1(SLSleelaOpcode_OP_LOADG, rs);
      op0(aluToSleela(op));
      op1(SLSleelaOpcode_OP_STOREG, rd);
      return;
    }
    if (op == SLInstructionSet_NEG) { op1(SLSleelaOpcode_OP_LOADG, rd); op0(SLSleelaOpcode_OP_NEG); op1(SLSleelaOpcode_OP_STOREG, rd); return; }

    < CMP rd, rs : LOADG rd ; LOADG rs ; SUB  (leaves difference; zero <=> equal) >
    if (op == SLInstructionSet_CMP) { op1(SLSleelaOpcode_OP_LOADG, rd); op1(SLSleelaOpcode_OP_LOADG, rs); op0(SLSleelaOpcode_OP_SUB); return; }

    < Branches map onto OP_JMP / OP_JMPF (jump-if-false) against a pushed test. >
    if (op == SLInstructionSet_JMP) { op1(SLSleelaOpcode_OP_JMP, imm); return; }
    < top==0 (false) => take >
    if (op == SLInstructionSet_JZ)  { op1(SLSleelaOpcode_OP_JMPF, imm); return; }
    if (op == SLInstructionSet_JNZ) { op1(SLSleelaOpcode_OP_NOT, 0); op1(SLSleelaOpcode_OP_JMPF, imm); return; }

    < CALL / RET map directly to the substrate's call/return. >
    if (op == SLInstructionSet_CALL) { op1(SLSleelaOpcode_OP_CALL, imm); return; }
    if (op == SLInstructionSet_RET)  { op0(SLSleelaOpcode_OP_RET); return; }

    < PUSH rs / POP rd map onto global<->stack moves. >
    if (op == SLInstructionSet_PUSH) { op1(SLSleelaOpcode_OP_LOADG, rs); return; }
    if (op == SLInstructionSet_POP)  { op1(SLSleelaOpcode_OP_STOREG, rd); return; }

    < SYSCALL imm : the OS service dispatch (see mapSyscall). >
    if (op == SLInstructionSet_SYSCALL) { mapSyscall(imm, rs); return; }

    < Unknown / unmodeled: NOP in the substrate. >
    op0(SLSleelaOpcode_OP_NOP);
  }

  < Map a register-ISA ALU opcode to the Sleela stack-arithmetic opcode. >
  int aluToSleela(int op) {
    if (op == SLInstructionSet_ADD) { return SLSleelaOpcode_OP_ADD; }
    if (op == SLInstructionSet_SUB) { return SLSleelaOpcode_OP_SUB; }
    if (op == SLInstructionSet_MUL) { return SLSleelaOpcode_OP_MUL; }
    if (op == SLInstructionSet_DIV) { return SLSleelaOpcode_OP_DIV; }
    if (op == SLInstructionSet_MOD) { return SLSleelaOpcode_OP_MOD; }
    if (op == SLInstructionSet_AND) { return SLSleelaOpcode_OP_AND; }
    if (op == SLInstructionSet_OR)  { return SLSleelaOpcode_OP_OR; }
    < bitwise XOR modeled as logical NE on the substrate >
    if (op == SLInstructionSet_XOR) { return SLSleelaOpcode_OP_NE; }
    return SLSleelaOpcode_OP_NOP;
  }

  < Map ONE OS system call onto Sleela service opcodes. The syscall argument >
  < convention: argReg holds the register whose value is the primary argument. >
  void mapSyscall(int number, int argReg) {
    < SYS_WRITE -> push the arg and PRINT it. >
    if (number == SLSystemCall_SYS_WRITE) { op1(SLSleelaOpcode_OP_LOADG, argReg); op0(SLSleelaOpcode_OP_PRINT); return; }
    < SYS_READ  -> FILEREAD service opcode (stdin modeled as fd 0). >
    if (number == SLSystemCall_SYS_READ)  { op1(SLSleelaOpcode_OP_CONST, 0); op0(SLSleelaOpcode_OP_FILEREAD); return; }
    if (number == SLSystemCall_SYS_OPEN)  { op0(SLSleelaOpcode_OP_FILEOPEN); return; }
    if (number == SLSystemCall_SYS_CLOSE) { op0(SLSleelaOpcode_OP_FILECLOSE); return; }
    < SYS_EXIT  -> HALT the substrate. >
    if (number == SLSystemCall_SYS_EXIT)  { op0(SLSleelaOpcode_OP_HALT); return; }
    < SYS_SPAWN -> OP_SPAWN ; SYS_YIELD -> NOP (cooperative point). >
    if (number == SLSystemCall_SYS_SPAWN) { op0(SLSleelaOpcode_OP_NOP); return; }
    if (number == SLSystemCall_SYS_YIELD) { op0(SLSleelaOpcode_OP_NOP); return; }
    op0(SLSleelaOpcode_OP_NOP);
  }

  < Translate a whole SLProgram (register-ISA image) into the Sleela substrate. >
  int mapProgram(SLProgram program, SLInstructionDecoder decoder) {
    int i = 0;
    while (i < program.size()) {
      SLInstruction instr = decoder.decode(program.wordAt(i));
      mapInstruction(instr.op(), instr.dest(), instr.src(), instr.immediate());
      i = i + 1;
    }
    return emittedOps;
  }

  int instructionsMapped() { return mappedInstr; }
  int opcodesEmitted() { return emittedOps; }
  SLSleelaVM substrate() { return vm; }
}
