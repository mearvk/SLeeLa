  public ByteArrayInputStream(byte[] buf) {
    this.buf = buf;
    this.pos = 0;
    this.mark = 0;
    this.count = arrayLength(buf);
  }
  public ByteArrayInputStream(byte[] buf, int offset, int length) {
    this.buf = buf;
    this.pos = offset;
    this.mark = offset;
    int n = arrayLength(buf);
    int end = offset + length;
    if (end > n) { end = n; }
    this.count = end;
  }
  public synchronized int read() {
    if (this.pos >= this.count) { return 0 - 1; }
    int b = this.buf[this.pos];
    this.pos = this.pos + 1;
    return unsignedByte(b);
  }
  public synchronized int read(byte[] b, int off, int len) {
    checkFromIndexSize(off, len, arrayLength(b));
    if (this.pos >= this.count) { return 0 - 1; }
    int avail = this.count - this.pos;
    int k = len;
    if (k > avail) { k = avail; }
    if (k <= 0) { return 0; }
    int i = 0;
    while (i < k) { b[off + i] = this.buf[this.pos + i]; i = i + 1; }
    this.pos = this.pos + k;
    return k;
  }
  public int readNBytes(byte[] b, int off, int len) {
    int n = this.read(b, off, len);
    if (n == 0 - 1) { return 0; }
    return n;
  }
  public synchronized byte[] readAllBytes() {
    int n = this.count - this.pos;
    if (n < 0) { n = 0; }
    byte[] out = new byte[n];
    int i = 0;
    while (i < n) { out[i] = this.buf[this.pos + i]; i = i + 1; }
    this.pos = this.count;
    return out;
  }
  public synchronized long skip(long n) {
    long k = this.count - this.pos;
    if (n < k) { k = n; }
    if (k < 0) { k = 0; }
    this.pos = this.pos + (int) k;
    return k;
  }
  public boolean markSupported() { return true; }
  public synchronized void reset() { this.pos = this.mark; }

  int unsignedByte(int b) {
    int v = b % 256;
    if (v < 0) { v = v + 256; }
    return v;
  }
  void checkFromIndexSize(int off, int len, int n) {
