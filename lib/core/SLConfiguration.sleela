/*
 * lib/core/SLConfiguration.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLConfiguration used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Configuration.
// Role: service. Responsibility: configuration state.
class SLConfiguration {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
