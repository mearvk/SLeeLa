/*
 * thermodynamics/curriculum/SLFourierFlux.sleela
 * SLeeLa Thermodynamics Curriculum - Level 1: Fourier's law of conduction.
 * Definition: q = -k * (dT / dx). Heat flux is the (negative) slope of the
 * temperature profile times the conductivity. The novice's first "rate".
 * Max Rupplin - MEARVK LLC - 2026
 */
#sleela 1.3
// Level 1 - a rate is the slope of a line. Still only +,-,*,/ needed.
class SLFourierFlux {
  double conductivity; // k, W/(m*K)
  void configure(double k) { conductivity = k; }

  // q = -k * (dT / dx). Returns 0 if dx is 0 (no gradient defined).
  double flux(double deltaT, double dx) {
    if (dx == 0.0) { return 0.0; }
    return (0.0 - conductivity) * (deltaT / dx);
  }

  boolean valid() { return conductivity > 0.0; }
}
