/*
 * lib/data-structures/DSQueue.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type DSQueue used within the data-structures library family.
 */
#sleela 1.2

// FIFO queue contract.

struct DSQueue {
    int size;
}

class DSQueueOperations {
    boolean empty(DSQueue queue) { return queue.size == 0; }
    int size(DSQueue queue) { return queue.size; }
    boolean canDequeue(DSQueue queue) { return queue.size > 0; }
}
