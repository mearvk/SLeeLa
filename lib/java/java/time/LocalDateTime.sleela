  < shared java.time helpers >
  long floorDiv(long x, long y) {
    long q = x / y;
    if ((x % y != 0) && ((x < 0) != (y < 0))) { q = q - 1; }
    return q;
  }
  long floorMod(long x, long y) { return x - floorDiv(x, y) * y; }
  int wrap32(long v) {
    long m = v % 4294967296;
