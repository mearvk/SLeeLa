    s[62] = 15;
    s[63] = 21;
    int n = arrayLength(data);
    int total = (n + 8) / 64 * 64 + 64;
    int[] buf = new int[total];
    < array elements start out null, which would turn the sums below into doubles >
    int i = 0;
    while (i < total) { buf[i] = 0; i = i + 1; }
    i = 0;
    while (i < n) { buf[i] = SLJavaBits.mod(data[i], 256); i = i + 1; }
    buf[n] = 128;
    long bits = n * 8;
    i = 0;
    while (i < 8) { buf[total - 8 + i] = bits % 256; bits = bits / 256; i = i + 1; }
    long a0 = 1732584193;
    long b0 = 4023233417;
    long c0 = 2562383102;
    long d0 = 271733878;
    int blk = 0;
    while (blk < total) {
      long[] m = new long[16];
      int w = 0;
      while (w < 16) {
        int p = blk + w * 4;
        m[w] = buf[p] + buf[p + 1] * 256 + buf[p + 2] * 65536 + buf[p + 3] * 16777216;
        w = w + 1;
      }
      long a = a0;
      long b = b0;
      long c = c0;
      long d = d0;
      int r = 0;
      while (r < 64) {
        long f = 0;
        int g = 0;
        if (r < 16) { f = SLJavaBits.or32(SLJavaBits.and32(b, c), SLJavaBits.and32(SLJavaBits.not32(b), d)); g = r; }
        else if (r < 32) { f = SLJavaBits.or32(SLJavaBits.and32(d, b), SLJavaBits.and32(SLJavaBits.not32(d), c)); g = (5 * r + 1) % 16; }
        else if (r < 48) { f = SLJavaBits.xor32(SLJavaBits.xor32(b, c), d); g = (3 * r + 5) % 16; }
        else { f = SLJavaBits.xor32(c, SLJavaBits.or32(b, SLJavaBits.not32(d))); g = 7 * r % 16; }
        f = (f + a + k[r] + m[g]) % 4294967296;
        a = d;
        d = c;
        c = b;
        b = (b + SLJavaBits.rotl32(f, s[r])) % 4294967296;
        r = r + 1;
      }
      a0 = (a0 + a) % 4294967296;
      b0 = (b0 + b) % 4294967296;
      c0 = (c0 + c) % 4294967296;
      d0 = (d0 + d) % 4294967296;
      blk = blk + 64;
    }
    int[] out = new int[16];
    long[] words = new long[4];
    words[0] = a0;
    words[1] = b0;
    words[2] = c0;
    words[3] = d0;
    int q = 0;
    while (q < 16) {
      long word = words[q / 4];
      int sh = q % 4;
      while (sh > 0) { word = word / 256; sh = sh - 1; }
      out[q] = word % 256;
      q = q + 1;
    }
    return out;
