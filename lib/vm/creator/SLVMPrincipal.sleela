/*
 * lib/vm/creator/SLVMPrincipal.sleela
 * SLeeLa VM Creator — generation /10 "Principal".
 * Definition: the source-level construction contract for the Principal SLVM
 *   generation. Like the other generation classes it is a build-side contract
 *   (configure/build/verify), descriptive only; selecting it never implicitly
 *   grants OS, filesystem, network, storage, security, or administrative
 *   capability. SleelaVMCreator does the actual instantiation/boot.
 *
 * Family: vm.creator.
 */
package vm.creator;

class SLVMPrincipal {
 String formalName = "Principal"; Integer generation = 10; String vmPath = "/10";
 function configurePrincipalGovernance(); function selectPrincipalModules(); function validatePrincipal();
 function configure(SleelaVMOptions options); function build(SleelaVMSource source); function verify(SleelaVMBuildPlan plan);
}
