;;; sleela-kiro-theme.el --- Kiro theme -*- lexical-binding: t; -*-
(deftheme sleela-kiro "Kiro: near-black with purple, dark blue, yellow and white syntax colors.")
(custom-theme-set-faces
 'sleela-kiro
 '(default ((t (:foreground "#F5F5FA" :background "#0B0B12"))))
 '(cursor ((t (:background "#A98EDA"))))
 '(region ((t (:background "#1E2A55" :extend t))))
 '(highlight ((t (:background "#15131F"))))
 '(fringe ((t (:foreground "#6A6482" :background "#0B0B12"))))
 '(line-number ((t (:foreground "#5A5470" :background "#0B0B12"))))
 '(line-number-current-line ((t (:foreground "#A98EDA" :weight bold))))
 '(mode-line ((t (:foreground "#F5F5FA" :background "#241B3A" :box nil :weight bold))))
 '(mode-line-inactive ((t (:foreground "#6A6482" :background "#15131F" :box nil))))
 '(minibuffer-prompt ((t (:foreground "#A98EDA" :weight bold))))
 '(font-lock-builtin-face ((t (:foreground "#6E8BE0"))))
 '(font-lock-comment-face ((t (:foreground "#6A6482" :slant italic))))
 '(font-lock-constant-face ((t (:foreground "#C0A9F0"))))
 '(font-lock-function-name-face ((t (:foreground "#F2D45C" :weight bold))))
 '(font-lock-keyword-face ((t (:foreground "#A98EDA" :weight bold))))
 '(font-lock-string-face ((t (:foreground "#E8C547"))))
 '(font-lock-type-face ((t (:foreground "#6E8BE0" :weight bold))))
 '(font-lock-variable-name-face ((t (:foreground "#F5F5FA"))))
 '(font-lock-preprocessor-face ((t (:foreground "#B79CE6"))))
 '(font-lock-warning-face ((t (:foreground "#FF6B6B" :weight bold :underline t))))
 '(error ((t (:foreground "#FF6B6B" :weight bold))))
 '(warning ((t (:foreground "#E8C547" :weight bold))))
 '(success ((t (:foreground "#F2D45C" :weight bold))))
 '(show-paren-match ((t (:foreground "#F5F5FA" :background "#1E2A55" :weight bold))))
 '(isearch ((t (:foreground "#0B0B12" :background "#E8C547" :weight bold))))
 '(lazy-highlight ((t (:foreground "#F5F5FA" :background "#241B3A")))))
(provide-theme 'sleela-kiro)
;;; sleela-kiro-theme.el ends here
