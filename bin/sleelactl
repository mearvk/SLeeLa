#!/usr/bin/env sh
# =============================================================================
# sleelactl — the unified SLeeLa control plane.
#
# One command to control every module family: daemons and servers, the HTTP and
# wireless protocols, the codec/compression/video registries, the compiler and
# decompiler tools, and the availability of the data systems.
#
# The families are genuinely DIFFERENT kinds of thing, so the verbs are chosen
# per nature rather than forced into one shape (see lib/core/SERVICE-STANDARD.md).
# The grammar is:
#
#     sleelactl <verb> <module> [args...]
#     sleelactl <verb> all                 # fan the verb across every module of
#                                           # a compatible nature
#
# plus the cross-cutting verbs:
#
#     sleelactl list [nature]              # enumerate modules (optionally by nature)
#     sleelactl status [module|all]        # status of a module or everything
#     sleelactl natures                    # explain the natures and their verbs
#     sleelactl help [verb|module]         # help, or the verbs legal for a module
#
# NATURES and their legal verbs:
#     daemon      start stop restart reload status enable disable
#     registry    load unload enable disable list probe can status
#     datasource  open close status available
#     protocol    negotiate grade simulate validate info
#     tool        run build inspect info
#     subject     run info
#     library     info
#
# A verb that a module's nature does not support is REFUSED with the correct
# verb set for that module — sleelactl never pretends to do something a module
# cannot do (no fake "start" of a protocol spec, no fake "decode" of a daemon).
#
# Underlying mechanisms (honest, delegating to what already exists):
#     daemon      -> systemctl on the module's unit (scope: SLEELACTL_SYSTEMCTL_SCOPE,
#                    system by default; non-root system mutations go through sudo)
#     registry    -> list/probe/status run the lib/<pkg> reference pipeline via
#                    `sleela run`; load/unload/enable/disable/can are refused
#                    (process-local Controller state cannot outlive a CLI call)
#     datasource  -> the lib/<pkg> SLDataSource surface via `sleela run`
#     protocol    -> `make -C <dir>` targets / the module's own sim/validate CLI
#     tool        -> the module's built CLI, or `make -C <dir>`
#     subject     -> the native C/C++ subject (impl/subjects/<name>) exercised by
#                    running its reference demo through `sleela run`
# When a mechanism is absent (no systemctl, binary not built), sleelactl says so
# plainly and exits non-zero rather than faking success.
#
# Global options (before the verb; also accepted right after `all`):
#     --dry-run    print what would be done; change nothing
#     --yes, -y    confirm a mutating daemon verb fanned out with `all`
#
# Exit codes:
#     0   success
#     1   the operation ran and failed, or the module is not present here
#     2   usage error (unknown module/nature/option, bad id, missing --yes)
#     3   mechanism unavailable or not offered from the CLI (no systemctl,
#         runtime not built, process-local registry mutation)
#     64  the verb is not legal for the module's nature
# =============================================================================
set -u

PROG=sleelactl

# --- locate the repo root from this script's location (bin/..) ---------------
SELF=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$SELF/.." && pwd)
REGISTRY="$SELF/sleelactl.d/registry.conf"

# Allow an installed layout: if the registry is not beside the script, try a
# couple of conventional spots before giving up.
if [ ! -f "$REGISTRY" ]; then
  for cand in "$ROOT/bin/sleelactl.d/registry.conf" \
              "$ROOT/lib/sleela/bin/sleelactl.d/registry.conf" \
              "$SELF/../lib/sleela/bin/sleelactl.d/registry.conf" \
              "/usr/local/lib/sleela/bin/sleelactl.d/registry.conf" \
              "$HOME/.local/lib/sleela/bin/sleelactl.d/registry.conf" \
              "$HOME/.local/sleela/lib/sleela/bin/sleelactl.d/registry.conf" \
              "/etc/sleela/sleelactl/registry.conf" \
              "$ROOT/share/sleela/sleelactl/registry.conf"; do
    [ -f "$cand" ] && { REGISTRY="$cand"; break; }
  done
fi
# An explicit override is honoured strictly: if it names a missing file,
# sleelactl fails (exit 2) rather than silently using another registry.
[ -n "${SLEELACTL_REGISTRY:-}" ] && REGISTRY="$SLEELACTL_REGISTRY"

# The SLeeLa runtime used to drive registry/datasource surfaces. Prefer a built
# compiler in-tree; fall back to one on PATH.
SLEELA_BIN="${SLEELA_BIN:-$ROOT/impl/build/sleela}"
if [ ! -x "$SLEELA_BIN" ]; then
  command -v sleela >/dev/null 2>&1 && SLEELA_BIN=sleela
fi

# --- presentation (optional color, degrades to plain) ------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  E=$(printf '\033'); R="${E}[0m"; B="${E}[1m"; G="${E}[38;5;43m"
  Y="${E}[38;5;215m"; RD="${E}[38;5;203m"; GY="${E}[38;5;245m"
else
  R=""; B=""; G=""; Y=""; RD=""; GY=""
fi
say()  { printf '%s\n' "$*"; }
info() { printf '  %s%s%s\n' "$GY" "$*" "$R"; }
okay() { printf '  %s✓%s %s\n' "$G" "$R" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$R" "$*"; }
err()  { printf '  %s✗%s %s\n' "$RD" "$R" "$*" >&2; }
die()  { err "$*"; exit 1; }
usage_die() { err "$*"; exit 2; }

DRY_RUN=0
ASSUME_YES=0

# Resolve helper scripts in both repository/quick-safe layouts (ROOT/tools)
# and conventional installs (PREFIX/lib/sleela/tools).
runtime_file() {
  relative=$1
  for candidate in "$ROOT/$relative" "$ROOT/lib/sleela/$relative" "$SELF/../lib/sleela/$relative"; do
    [ -f "$candidate" ] && { printf '%s\n' "$candidate"; return 0; }
  done
  return 1
}

# Python 3 launcher for POSIX hosts and Windows installations (py -3).
run_python() {
  if command -v python3 >/dev/null 2>&1; then
    python3 "$@"
  elif command -v py >/dev/null 2>&1; then
    py -3 "$@"
  elif command -v python >/dev/null 2>&1; then
    python -c 'import sys; raise SystemExit(0 if sys.version_info.major >= 3 else 1)' >/dev/null 2>&1 \
      || { warn "Python 3 is required for Native Drive"; return 3; }
    python "$@"
  else
    warn "Python 3 is required for Native Drive (python3, py -3, or python not found)"
    return 3
  fi
}

# --- registry access ----------------------------------------------------------
# Each lookup reads the plain-text registry; small enough to re-scan cheaply.
reg_require() { [ -f "$REGISTRY" ] || usage_die "module registry not found: $REGISTRY"; }

# Emit "name nature handle" for a module, or nothing if unknown.
reg_row() {
  reg_require
  awk -v want="$1" '
    /^[[:space:]]*#/ {next} NF==0 {next}
    $1==want { print $1, $2, $3; found=1; exit }
    END { if (!found) exit 1 }
  ' "$REGISTRY"
}
nature_of() { reg_row "$1" | awk '{print $2}'; }
handle_of() { reg_row "$1" | awk '{print $3}'; }

# All module names, optionally filtered by nature.
reg_names() {
  reg_require
  awk -v nat="${1:-}" '
    /^[[:space:]]*#/ {next} NF==0 {next}
    nat=="" || $2==nat { print $1 }
  ' "$REGISTRY"
}

# The summary (col 4..end) for a module.
summary_of() {
  reg_require
  awk -v want="$1" '
    /^[[:space:]]*#/ {next} NF==0 {next}
    $1==want { $1=$2=$3=""; sub(/^[[:space:]]+/,""); print; exit }
  ' "$REGISTRY"
}

# Legal verbs for a nature.
verbs_for_nature() {
  case "$1" in
    daemon)     echo "start stop restart reload status enable disable" ;;
    registry)   echo "load unload enable disable list probe can status" ;;
    datasource) echo "open close status available" ;;
    protocol)   echo "negotiate grade simulate validate info" ;;
    tool)       echo "run build inspect info" ;;
    subject)    echo "run info" ;;
    library)    echo "info" ;;
    *)          echo "" ;;
  esac
}

verb_allowed() { # verb nature
  for v in $(verbs_for_nature "$2"); do [ "$v" = "$1" ] && return 0; done
  return 1
}

ALL_NATURES="daemon registry datasource protocol tool subject library"
is_nature() { for n in $ALL_NATURES; do [ "$n" = "$1" ] && return 0; done; return 1; }
natures_for_verb() { # verb -> space-separated natures that accept it
  out=""
  for n in $ALL_NATURES; do verb_allowed "$1" "$n" && out="$out $n"; done
  printf '%s\n' "${out# }"
}
is_mutating_daemon_verb() {
  case "$1" in start|stop|restart|reload|enable|disable) return 0 ;; *) return 1 ;; esac
}
# Registry mutations act on a process-local Controller; no process outlives a
# CLI call to hold that state, so these are refused honestly (exit 3).
is_process_local_registry_verb() {
  case "$1" in load|unload|enable|disable|can) return 0 ;; *) return 1 ;; esac
}

# Run a SLeeLa program, keeping stderr. The runtime prints verification/
# security preamble on stderr, so on success it is suppressed (set
# SLEELACTL_VERBOSE=1 to see it); on failure the last diagnostic lines are shown.
run_sleela() { # program.sleela
  _rs_log=$(mktemp "${TMPDIR:-/tmp}/sleelactl.XXXXXX" 2>/dev/null) || _rs_log=""
  if [ -z "$_rs_log" ]; then "$SLEELA_BIN" run "$1"; return $?; fi
  "$SLEELA_BIN" run "$1" 2>"$_rs_log"; _rs_rc=$?
  if [ "${SLEELACTL_VERBOSE:-0}" = 1 ]; then cat "$_rs_log" >&2
  elif [ "$_rs_rc" -ne 0 ]; then
    err "sleela run exited $_rs_rc; last diagnostics:"
    grep -v -E '^(verification: PASS|\[security\]|\[defender\]|\[memory-manager\])' "$_rs_log" \
      | tail -n 15 | sed 's/^/      /' >&2
  fi
  rm -f "$_rs_log"
  return "$_rs_rc"
}

# =============================================================================
# systemctl plumbing for daemons. Scope is explicit and configurable:
#   system (default): system bus; root calls directly, non-root uses sudo.
#   user:             per-user bus; never invokes sudo.
# This avoids silently treating an unprivileged caller as a user service when
# the registry names a system unit. Containers/non-systemd hosts fail honestly.
# =============================================================================
have_systemctl() { command -v systemctl >/dev/null 2>&1; }
systemctl_scope() {
  case "${SLEELACTL_SYSTEMCTL_SCOPE:-system}" in
    system|user) printf '%s\n' "${SLEELACTL_SYSTEMCTL_SCOPE:-system}" ;;
    *) err "SLEELACTL_SYSTEMCTL_SCOPE must be 'system' or 'user'."; return 64 ;;
  esac
}
sctl() {
  have_systemctl || { err "systemctl not available on this host; cannot control daemons here."; return 3; }
  scope=$(systemctl_scope) || return $?
  case "$scope" in
    user) systemctl --user "$@" ;;
    system)
      if [ "$(id -u)" -eq 0 ]; then
        systemctl --system "$@"
      elif [ "${1:-}" = "--no-pager" ] && [ "${2:-}" = "status" ]; then
        # systemctl status is read-only and normally available to unprivileged
        # callers; do not require sudo merely to inspect a system unit.
        systemctl --system "$@"
      else
        command -v sudo >/dev/null 2>&1 || { err "sudo is required for system-unit control; use SLEELACTL_SYSTEMCTL_SCOPE=user for user units."; return 3; }
        sudo systemctl --system "$@"
      fi ;;
  esac
}

daemon_cmd() { # module verb
  unit=$(handle_of "$1")
  [ -n "$unit" ] || die "no systemd unit mapped for '$1'"
  scope=$(systemctl_scope) || return $?
  case "$2" in
    start|stop|restart|reload) info "systemctl --$scope $2 $unit"; sctl "$2" "$unit" && okay "$1: $2 issued ($scope scope)" ;;
    enable)  info "systemctl --$scope enable $unit";  sctl enable "$unit"  && okay "$1 enabled ($scope scope)" ;;
    disable) info "systemctl --$scope disable $unit"; sctl disable "$unit" && okay "$1 disabled ($scope scope)" ;;
    status)
      if have_systemctl; then sctl --no-pager status "$unit" 2>/dev/null \
        || { warn "$1 ($unit, $scope scope): not loaded/active"; return 1; }
      else warn "$1: systemctl unavailable; unit is $unit"; return 3; fi ;;
    *) die "daemon verb '$2' not understood" ;;
  esac
}

# =============================================================================
# registry (codecs/compression/video): drive the lib/<pkg> Controller. These
# are process-local registries, so "enable/disable/load/unload" operate on the
# Controller surface. We run the package's reference pipeline through the SLeeLa
# runtime; without a built runtime we report the intended action honestly.
# =============================================================================
registry_runtime_ok() { [ -x "$SLEELA_BIN" ] || [ "$SLEELA_BIN" = sleela ] && command -v "$SLEELA_BIN" >/dev/null 2>&1; }
registry_demo() { # pkg -> path to the runnable Controller pipeline, if any
  pkg="$1"
  for f in "$ROOT/lib/$pkg/codec-pipeline.sleela" \
           "$ROOT/lib/$pkg/video-codec-pipeline.sleela" \
           "$ROOT/lib/$pkg/compression-pipeline.sleela" \
           "$ROOT/lib/$pkg"/*pipeline*.sleela; do
    [ -f "$f" ] && { echo "$f"; return 0; }
  done
  return 1
}
registry_size() { # module -> declared handler count from its summary ("N handlers"), if any
  summary_of "$1" | sed -n 's/.*(\([0-9][0-9]*\) handlers.*/\1/p'
}
registry_cmd() { # module verb [id]
  pkg=$(handle_of "$1"); id="${3:-}"
  demo=$(registry_demo "$pkg" 2>/dev/null) || demo=""
  case "$2" in
    list|probe|status)
      [ "$#" -le 2 ] || usage_die "'$2' takes no handler id (got '$id'); try: $PROG $2 $1"
      if [ -z "$demo" ]; then warn "$1: no reference pipeline found under lib/$pkg"; return 1; fi
      if ! registry_runtime_ok; then
        warn "SLeeLa runtime not built ($SLEELA_BIN); cannot run the $pkg reference pipeline."
        info "build it:  (cd impl && make build/sleela)   then re-run"
        if [ "$2" = list ]; then
          info "registry sources in lib/$pkg:"
          ls "$ROOT/lib/$pkg"/*.sleela 2>/dev/null | sed 's|.*/|    |'
        fi
        return 3
      fi
      info "$pkg reference pipeline ($(basename "$demo")): Controller/Loader/Verifier/Processor"
      if run_sleela "$demo"; then
        okay "$1: reference pipeline completed (a demonstration run; no registry state persists after it)"
      else
        err "$1: reference pipeline failed"; return 1
      fi ;;
    load|unload|enable|disable|can)
      [ -n "$id" ] || usage_die "'$2' needs a handler id (a non-negative integer); try: $PROG list $1"
      case "$id" in *[!0-9]*) usage_die "handler id must be a non-negative integer, got '$id'" ;; esac
      size=$(registry_size "$1")
      if [ -n "$size" ] && [ "$id" -ge "$size" ]; then
        usage_die "handler id $id is out of range for $1 (0..$((size - 1)))"
      fi
      err "'$2 $1 $id' is not offered from the command line."
      info "the $pkg Controller is process-local: its loaded/backend state lives inside one"
      info "running SLeeLa program, and no daemon holds it between sleelactl calls."
      info "do it in SLeeLa (e.g. controller.$2($id)), or run the reference flow:  $PROG probe $1"
      return 3 ;;
    *) die "registry verb '$2' not understood" ;;
  esac
}

# =============================================================================
# datasource (database/ledger/...): availability is open/close/active, not
# start/stop. Drive the SLDataSource surface; honest about not fabricating a
# live connection when there is no runtime or no configured backend.
# =============================================================================
datasource_cmd() { # module verb
  pkg=$(handle_of "$1")
  case "$2" in
    status|available)
      info "$1 ($pkg) is an open/close/active data surface (SLDataSource)."
      if [ -d "$ROOT/lib/$pkg" ]; then
        okay "$pkg library present at lib/$pkg"
        info "availability is a per-connection runtime state: open() → active() == true; close() → false"
      else warn "lib/$pkg not present in this install"; return 1; fi ;;
    open|close)
      warn "$2 acts on a live SLDataSource instance inside a running SLeeLa program."
      info "sleelactl reports availability; it does not hold a connection of its own."
      info "in SLeeLa:  SLDataSource ds = new SLDataSource(); ds.configure(\"$pkg\"); ds.$2();" ;;
    *) die "datasource verb '$2' not understood" ;;
  esac
}

# =============================================================================
# protocol (http-N, cdma, wifi, resolver, route): specs / stacks / sims. The
# honest verbs are negotiate/grade/simulate/validate/info — built via the
# module's own Makefile or sim CLI.
# =============================================================================
protocol_cmd() { # module verb [args]
  dir="$ROOT/$(handle_of "$1")"
  [ -d "$dir" ] || { warn "$1: directory $(handle_of "$1") not present in this install"; return 1; }
  case "$2" in
    info)
      okay "$1 — $(summary_of "$1")"
      info "location: ${dir#$ROOT/}"
      [ -f "$dir/README.md" ] && info "see: ${dir#$ROOT/}/README.md"
      ls "$dir"/*.SPEC.md "$dir"/*.md 2>/dev/null | head -3 | sed 's|.*/|    spec: |' ;;
    validate)
      tgt=""
      if [ -f "$dir/Makefile" ]; then
        # Prefer an explicit validate target, then syntax, then test.
        for t in validate syntax test; do
          grep -qE "^$t:" "$dir/Makefile" && { tgt=$t; break; }
        done
      fi
      if [ -n "$tgt" ]; then
        info "make -C ${dir#$ROOT/} $tgt"
        if make -C "$dir" "$tgt"; then okay "$1 validated ($tgt)"; else err "$1 validation reported issues"; return 1; fi
      else warn "$1 has no validate/syntax/test target; nothing to run"; return 3; fi ;;
    simulate)
      sim=""
      for s in "$dir/tools/cdma-sim" "$dir/build/cdma-sim" "$dir"/tools/*sim* "$dir"/build/*sim*; do
        [ -x "$s" ] && { sim="$s"; break; }
      done
      if [ -n "$sim" ]; then shift 2; info "$sim $*"; "$sim" "$@"; \
      else warn "$1: no built simulator found; build it with  make -C ${dir#$ROOT/}  first"; return 3; fi ;;
    negotiate|grade)
      info "$1 '$2' is a protocol-metadata operation defined by the generated spec."
      [ -f "$dir/README.md" ] && info "see the $2 section in ${dir#$ROOT/}/README.md"
      warn "no standalone $2 CLI is built; this operation is exercised in the protocol's own tests/spec." ; return 3 ;;
    *) die "protocol verb '$2' not understood" ;;
  esac
}

# =============================================================================
# tool (compiler/decompiler/debugger): one-shot build-time tools.
# =============================================================================
# The CLI a tool's build produces. Matched by NAME only, never by "first
# executable in a directory" (which picked test/example binaries).
tool_binary_names() { # module
  case "$1" in
    compiler)   echo "sleelac" ;;
    decompiler) echo "sleela-decompiler" ;;
    debugger)   echo "sleela-debugger" ;;
    *)          echo "$1 sleela-$1" ;;
  esac
}
tool_binary() { # module dir -> path of the built CLI
  for name in $(tool_binary_names "$1"); do
    for sub in build build/Release build/stage/bin cli bin .; do
      for cand in "$2/$sub/$name" "$2/$sub/$name.exe"; do
        [ -f "$cand" ] && [ -x "$cand" ] && { printf '%s\n' "$cand"; return 0; }
      done
    done
  done
  return 1
}

tool_cmd() { # module verb [args]
  if [ "$1" = "native-drive" ]; then
    script=$(runtime_file "$(handle_of "$1")") || { warn "native-drive script not present in repository or installed runtime"; return 1; }
    : # run_python selects python3, py -3, or a verified Python 3 interpreter
    # Hand the driver the same sleela CLI sleelactl resolved, so .sleela builds
    # and xclass inspection work from a fresh repository build without PATH setup.
    SLEELA="${SLEELA:-$SLEELA_BIN}"; export SLEELA
    verb="$2"
    case "$verb" in
      info) okay "native-drive — $(summary_of "$1")"; info "location: ${script#$ROOT/}"; if [ -f "$ROOT/impl/native-drive/README.md" ]; then info "see: $ROOT/impl/native-drive/README.md"; else info "documentation: impl/native-drive/README.md in the source repository"; fi ;;
      build) shift 2; run_python "$script" build "$@" ;;
      run)
        shift 2
        if [ "${1:-}" = "pipe" ]; then shift; run_python "$script" pipe "$@"
        else run_python "$script" run "$@" ; fi ;;
      inspect)
        shift 2
        case "${1:-}" in
          xclass) shift; run_python "$script" xclass "$@" ;;
          service)
            shift
            service_script=$(runtime_file "tools/sleela-native-service.py") || { warn "native service helper not present in installed runtime"; return 1; }
            run_python "$service_script" "$@" ;;
          *) run_python "$script" --help ;;
        esac ;;
      *) die "native-drive verb '$verb' not understood" ;;
    esac
    return $?
  fi
  dir="$ROOT/$(handle_of "$1")"
  [ -d "$dir" ] || { warn "$1: directory not present in this install"; return 1; }
  case "$2" in
    info)
      okay "$1 — $(summary_of "$1")"; info "location: ${dir#$ROOT/}"
      [ -f "$dir/README.md" ] && info "see: ${dir#$ROOT/}/README.md" ;;
    build)
      [ -f "$dir/Makefile" ] || { warn "$1 has no Makefile to build"; return 3; }
      info "make -C ${dir#$ROOT/}"; make -C "$dir" && okay "$1 built" || { warn "$1 build failed"; return 1; } ;;
    run|inspect)
      bin=$(tool_binary "$1" "$dir") || bin=""
      if [ -n "$bin" ]; then shift 2; info "$bin $*"; "$bin" "$@"; \
      else warn "$1: no built CLI ($(tool_binary_names "$1" | tr ' ' '/')) found; run  $PROG build $1  first"; return 3; fi ;;
    *) die "tool verb '$2' not understood" ;;
  esac
}

# =============================================================================
# subject (math/physics/chemistry/...): a compiled native C/C++ subject library
# built INTO the sleela runtime (impl/subjects/<name>/*.cpp). It has no daemon,
# handler registry, data connection, or spec — it is reached from a .sleela
# program via `import <name>;` and qualified calls (e.g. math.sqrt(x)), which
# the frontend lowers onto the native __Native<Subject> methods. There is no
# standalone CLI to "run"; the honest, already-wired way to exercise the native
# backend is to run its reference demo through the SLeeLa runtime — the same
# `sleela run <demo>` mechanism the registry nature uses. So the handle is that
# demo's path (relative to the repo/install root), and:
#   run    -> sleela run <demo>     (executes the native subject end-to-end)
#   info   -> summary + location + how it is reached (import <name>;)
# There is deliberately NO `check` verb: `sleela check` does not load the
# SHEET-registered native subjects, so checking an `import math;` demo reports
# "use of undeclared variable 'math'". Only `run` performs the native lowering,
# so `run` is the sole, faithful execution verb — sleelactl never offers a verb
# it cannot honor.
# Honest degradation: no built runtime -> say so and point at the build command;
# no demo present -> report that and stop (never fake a result).
# =============================================================================
subject_cmd() { # module verb [args]
  demo_rel=$(handle_of "$1"); demo="$ROOT/$demo_rel"
  case "$2" in
    info)
      okay "$1 — $(summary_of "$1")"
      info "nature: subject — native C/C++ library compiled into the sleela runtime"
      info "reached from SLeeLa as:  import $1;   then qualified calls, e.g.  $1.<fn>(...)"
      [ -f "$demo" ] && info "reference demo: $demo_rel" || warn "reference demo $demo_rel not present in this install" ;;
    run)
      [ -f "$demo" ] || { warn "$1: reference demo $demo_rel not present; cannot run"; return 1; }
      if registry_runtime_ok; then
        info "$SLEELA_BIN run $demo_rel"
        if run_sleela "$demo"; then
          okay "$1: ran the native subject demo (its __Native* methods executed)"
        else
          err "$1: run of $demo_rel did not complete"; return 1
        fi
      else
        warn "SLeeLa runtime not built ($SLEELA_BIN); cannot run the native '$1' subject."
        info "build it:  (cd impl && make build/sleela)   then re-run"
        return 3
      fi ;;
    *) die "subject verb '$2' not understood" ;;
  esac
}

# --- dispatch one verb at one module, gating by nature -----------------------
dispatch() { # verb module [args...]
  verb="$1"; mod="$2"; shift 2
  nat=$(nature_of "$mod") || true
  [ -n "$nat" ] || usage_die "unknown module '$mod'  (try: $PROG list)"
  if ! verb_allowed "$verb" "$nat"; then
    err "'$verb' is not valid for '$mod' (a $nat module)."
    info "legal verbs for $mod:  $(verbs_for_nature "$nat")"
    return 64
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    if [ "$nat" = daemon ]; then
      _dr_scope=$(systemctl_scope) || return $?
      info "[dry-run] would run: systemctl --$_dr_scope $verb $(handle_of "$mod")"
    else
      info "[dry-run] would run: $PROG $verb $mod${*:+ $*}  ($nat)"
    fi
    return 0
  fi
  case "$nat" in
    daemon)     daemon_cmd "$mod" "$verb" "$@" ;;
    registry)   registry_cmd "$mod" "$verb" "$@" ;;
    datasource) datasource_cmd "$mod" "$verb" "$@" ;;
    protocol)   protocol_cmd "$mod" "$verb" "$@" ;;
    tool)       tool_cmd "$mod" "$verb" "$@" ;;
    subject)    subject_cmd "$mod" "$verb" "$@" ;;
    library)    [ "$verb" = info ] && { okay "$mod — $(summary_of "$mod")"; } ;;
    *)          die "module '$mod' has an unknown nature '$nat'" ;;
  esac
}

# --- 'all' fan-out: apply a verb to every module whose nature allows it ------
dispatch_all() { # verb [args...]
  verb="$1"; shift
  if is_mutating_daemon_verb "$verb" && [ "$DRY_RUN" -eq 0 ] && [ "$ASSUME_YES" -eq 0 ]; then
    usage_die "refusing to '$verb' every daemon without --yes (preview first: $PROG --dry-run $verb all)"
  fi
  _all_any=0; _all_rc=0
  for m in $(reg_names); do
    _all_nat=$(nature_of "$m")
    verb_allowed "$verb" "$_all_nat" || continue
    _all_any=1
    printf '%s== %s (%s) ==%s\n' "$B" "$m" "$_all_nat" "$R"
    if [ "$_all_nat" = registry ] && is_process_local_registry_verb "$verb"; then
      info "skipped: '$verb' on a process-local registry is not offered from the CLI"
      continue
    fi
    dispatch "$verb" "$m" "$@" || { _r=$?; [ "$_all_rc" -eq 0 ] && _all_rc=$_r; }
  done
  [ "$_all_any" -eq 1 ] || { err "no module accepts the verb '$verb'."; return 64; }
  return "$_all_rc"
}

# --- cross-cutting verbs -----------------------------------------------------
cmd_list() {
  filter="${1:-}"
  reg_require
  if [ -n "$filter" ] && ! is_nature "$filter"; then
    usage_die "unknown nature '$filter' (natures: $ALL_NATURES)"
  fi
  printf '%s%-18s %-11s %s%s\n' "$B" MODULE NATURE SUMMARY "$R"
  for m in $(reg_names "$filter"); do
    printf '  %-18s %s%-11s%s %s\n' "$m" "$G" "$(nature_of "$m")" "$R" "$(summary_of "$m")"
  done
}

cmd_status() {
  target="${1:-all}"
  if [ "$target" = all ]; then
    _st_rc=0
    for m in $(reg_names); do
      _st_nat=$(nature_of "$m")
      case "$_st_nat" in
        daemon|registry|datasource)
          printf '%s== %s (%s) ==%s\n' "$B" "$m" "$_st_nat" "$R"
          dispatch status "$m" || { _r=$?; [ "$_st_rc" -eq 0 ] && _st_rc=$_r; } ;;
        *) printf '  %-18s %s%s%s  (no runtime status; %s)\n' "$m" "$GY" "$_st_nat" "$R" "$(summary_of "$m")" ;;
      esac
    done
    # Non-zero when any controllable module failed or could not be checked.
    return "$_st_rc"
  fi
  nat=$(nature_of "$target") || true
  [ -n "$nat" ] || usage_die "unknown module '$target'  (try: $PROG list)"
  case "$nat" in
    daemon|registry|datasource) dispatch status "$target" ;;
    *) okay "$target ($nat) — $(summary_of "$target")"; info "a $nat module has no running status; use: $PROG info $target" ;;
  esac
}

cmd_natures() {
  say "${B}sleelactl module natures${R} — each family is controlled with verbs that fit it:"
  say ""
  printf '  %s%-11s%s  %s\n' "$G" daemon     "$R" "long-lived process + systemd unit"
  info  "      verbs: $(verbs_for_nature daemon)"
  printf '  %s%-11s%s  %s\n' "$G" registry   "$R" "closed handler set, load/unload by id (SLPluginService)"
  info  "      verbs: $(verbs_for_nature registry)"
  printf '  %s%-11s%s  %s\n' "$G" datasource "$R" "open/close/active data surface + pooling (SLDataSource)"
  info  "      verbs: $(verbs_for_nature datasource)"
  printf '  %s%-11s%s  %s\n' "$G" protocol   "$R" "spec / stack / reference model"
  info  "      verbs: $(verbs_for_nature protocol)"
  printf '  %s%-11s%s  %s\n' "$G" tool       "$R" "on-demand, one-shot toolchain component"
  info  "      verbs: $(verbs_for_nature tool)"
  printf '  %s%-11s%s  %s\n' "$G" subject    "$R" "native C/C++ subject library compiled into the runtime (import <name>;)"
  info  "      verbs: $(verbs_for_nature subject)"
  printf '  %s%-11s%s  %s\n' "$G" library    "$R" "pure library; informational only"
  info  "      verbs: $(verbs_for_nature library)"
}

cmd_help() {
  topic="${1:-}"
  if [ -n "$topic" ]; then
    if nat=$(nature_of "$topic" 2>/dev/null) && [ -n "$nat" ]; then
      okay "$topic — a $nat module"; info "$(summary_of "$topic")"
      info "legal verbs:  $(verbs_for_nature "$nat")"; return 0
    fi
    if is_nature "$topic"; then
      okay "$topic — a module nature"
      info "legal verbs:  $(verbs_for_nature "$topic")"
      info "modules:      $(reg_names "$topic" | tr '\n' ' ')"; return 0
    fi
    _hv_nats=$(natures_for_verb "$topic")
    if [ -n "$_hv_nats" ]; then
      okay "$topic — a verb accepted by: $_hv_nats"
      for n in $_hv_nats; do
        info "$n modules:  $(reg_names "$n" | tr '\n' ' ')"
      done
      is_mutating_daemon_verb "$topic" && info "with 'all' on daemons it needs --yes (preview with --dry-run)"
      [ "$topic" = load ] || [ "$topic" = unload ] || [ "$topic" = can ] && \
        info "on registries it validates the id, then is refused (exit 3): the Controller is process-local"
      return 0
    fi
    usage_die "no such verb, module, or nature: '$topic'  (try: $PROG help)"
  fi
  cat <<EOF
${B}sleelactl${R} — the unified SLeeLa control plane

${B}Usage${R}
  $PROG <verb> <module> [args]      control one module (verb must fit its nature)
  $PROG <verb> all                  fan a verb across every compatible module
  $PROG list [nature]               list modules (optionally filtered by nature)
  $PROG status [module|all]         show running status
  $PROG natures                     explain natures and their verbs
  $PROG help [verb|module|nature]   this help, or details for one topic

${B}Options${R} (before the verb, or right after 'all')
  --dry-run                         show what would be done; change nothing
  --yes, -y                         confirm a mutating daemon verb with 'all'

${B}Examples${R}
  $PROG start server-edition        start the server daemon (systemd)
  $PROG enable antivirus            enable the antivirus coordinator at boot
  $PROG status all                  status of every controllable module
  $PROG probe codecs                run the codec registry reference pipeline
  $PROG --dry-run stop all          preview stopping every daemon
  $PROG stop all --yes              stop every daemon
  $PROG list registry               list the registry-nature modules
  $PROG available database          report the database data-source availability
  $PROG validate http-9.0           validate the HTTP/9.0 protocol spec
  $PROG build decompiler            build the decompiler CLI
  $PROG inspect native-drive service --status --name worker
  $PROG inspect native-drive service --rollback --name worker

Verbs are gated by module nature (see '$PROG natures'); an unsupported verb is
refused with the correct verb set — sleelactl never fakes an action a module
cannot perform.

${B}Exit codes${R}
  0 success   1 operation failed / module absent   2 usage error
  3 mechanism unavailable or not offered from the CLI   64 verb not legal for the nature
EOF
}

# --- main --------------------------------------------------------------------
parse_flag() { # flag -> 0 if it was a global flag (and records it)
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --yes|-y)  ASSUME_YES=1 ;;
    *) return 1 ;;
  esac
}
while [ "$#" -ge 1 ] && parse_flag "$1"; do shift; done
[ "$#" -ge 1 ] || { cmd_help; exit 0; }
verb="$1"; shift

case "$verb" in
  -h|--help|help) cmd_help "${1:-}" ;;
  list)           cmd_list "${1:-}" ;;
  natures)        cmd_natures ;;
  status)         cmd_status "${1:-all}" ;;
  version|--version) say "sleelactl (SLeeLa control plane) 1.1" ;;
  -*)             usage_die "unknown option '$verb'  (try: $PROG help)" ;;
  *)
    [ "$#" -ge 1 ] || usage_die "verb '$verb' needs a module (or 'all'). Try: $PROG help $verb"
    mod="$1"; shift
    if [ "$mod" = all ]; then
      while [ "$#" -ge 1 ] && parse_flag "$1"; do shift; done
      dispatch_all "$verb" "$@"
    else
      dispatch "$verb" "$mod" "$@"
    fi
    ;;
esac
