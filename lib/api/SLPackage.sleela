/*
 * lib/api/SLPackage.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library package for api.
 */
#sleela 1.3
// Library facade for the API package. Original API sources remain authoritative.
class ApiPackage {
  String source;
  void configure(String path){source=path;}
  String path(){return source;}
  boolean available(){return source!=null;}
}
