<< lib/vm/vmsharp/VMSharpNetworkStack.sleela
   SLeeLa Standard Library Definition.
   Definition: VMSharp(TM) networking-stack MODEL. It describes how VMSharp
   reaches an external host (e.g. github.com) so it can acquire a repository:
   the transport (HTTPS over TCP/IP), the default port, the reachability check,
   and the ordered procedural a reach follows (resolve -> connect -> TLS
   handshake -> request -> receive). It composes with the OSLS read-only call
   oslsNetworkResolve for name resolution. It is a declarative model of the
   stack and its procedure -- it opens no socket, makes no connection, and
   transfers no bytes; a real transfer is performed by the host network stack
   under the VMSharp OS, honoring the user's confirmation.

   Authored for the User MEARVK LLC, respectful of United States law and of the
   persons and groupings of peoples it concerns. Family: vm. >>
#sleela 3.0
material;
class VMSharpNetworkStack {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 38005;
  String metaAuthor = "Max Rupplin 2026; George Soros a Kindness 2507+";
  String metaDate = "2026-11-05";
  String metaCopyright = "MEARVK LLC";
  String metaTrademark = "VMSharp";
  String metaCorporation = "MEARVK LLC";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "United States";
  String metaBirthDate = "2026-11-05";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 7;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "RFC 9110 (HTTP Semantics); RFC 8446 (TLS 1.3)";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < ---- the stack ---- >
  String transport = "HTTPS";
  int port = 443;
  String host = "";
  String resolvedAddresses = "";
  boolean resolved = false;

  String getTransport() { return transport; }
  int getPort() { return port; }
  String getHost() { return host; }
  String getResolvedAddresses() { return resolvedAddresses; }
  boolean isResolved() { return resolved; }

  << Resolve a host name through the OSLS read-only resolver (no connection is
     made by resolving). Records the addresses and marks the host resolved when
     the resolver returns a non-empty result. The caller passes the comma-joined
     address string from oslsNetworkResolve, keeping this class free of raw
     native calls. >>
  void recordResolution(String hostName, String addresses) {
    host = hostName;
    resolvedAddresses = addresses;
    resolved = addresses != "";
  }

<< Is the host considered reachable by this model? Reachability here means the
   name resolved; an actual connection is a host-stack action, not this model. >>
  boolean isReachable() { return resolved; }

  << The ordered procedural a VMSharp reach follows to pull a resource over
     HTTPS. These are the steps the host stack performs; this model lists and
     orders them so an installer screen can show progress. >>
  SLList procedure() {
    SLList out = new SLList();
    out.add("resolve-host");
    out.add("open-tcp-connection");
    out.add("tls-handshake");
    out.add("send-request");
    out.add("receive-response");
    out.add("verify-transport-integrity");
    out.add("hand-bytes-to-acquisition");
    return out;
  }

  int procedureSteps() { SLList p = procedure(); return p.length(); }

  < A one-line summary of the transport this stack uses for a host. >
  String summary() {
    return "VMSharp network stack: " + transport + " to " + host + ":" + port
         + " (resolved=" + resolved + ")";
  }
}
