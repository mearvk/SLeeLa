/*
 * lib/cpu/SLFullAdder.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLFullAdder — adds three 1-bit inputs (a, b, carry-in),
 *   producing a sum bit and a carry-out. Built from two half adders and an OR
 *   gate, exactly as in real silicon.
 *
 * h1: a + b           -> s1, c1
 * h2: s1 + carry_in   -> sum, c2
 * carry_out = c1 OR c2
 *
 * Family: cpu. Pure Sleela logic.
 */
#sleela 1.3
class SLFullAdder {
  SLHalfAdder h1;
  SLHalfAdder h2;
  SLGate orGate;
  int sum;
  int carryOut;

  void build() {
    h1 = new SLHalfAdder(); h1.build();
    h2 = new SLHalfAdder(); h2.build();
    orGate = new SLGate(); orGate.configure(SLGate.OR);
  }

  void add(int a, int b, int carryIn) {
    h1.add(a, b);
    h2.add(h1.sumBit(), carryIn);
    sum = h2.sumBit();
    carryOut = orGate.eval(h1.carryBit(), h2.carryBit());
  }

  int sumBit() { return sum; }
  int carryBit() { return carryOut; }
}
