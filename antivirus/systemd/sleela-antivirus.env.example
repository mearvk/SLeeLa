# Sleelavirin antivirus service host deployment guide
#
# This directory contains the deployment scaffolding for a real systemd host. The
# repository keeps the package logic and example policy; the host-specific values
# live in the environment file below and should be managed by the machine owner.
#
# Install order (recommended):
#   1. Review the example environment file.
#   2. Copy it to /etc/sleela-antivirus/sleela-antivirus.env.
#   3. Ensure the paths and permissions match the host.
#   4. Install the service unit into /etc/systemd/system.
#   5. Run systemctl daemon-reload and enable the unit.
#
# This service is intentionally conservative. It does not silently grant
# elevated privileges or imply that every package or every host should run an
# on-access scan in a privileged context by default.

# Required values for a real deployment.
SLEELA_ANTIVIRUS_ENGINE=both
SLEELA_ANTIVIRUS_ROOT=/var/lib/sleela-antivirus
SLEELA_ANTIVIRUS_REPORT=/var/log/sleela-antivirus/scan-report.json
SLEELA_ANTIVIRUS_QUARANTINE=/var/lib/sleela-antivirus/quarantine
SLEELA_ANTIVIRUS_DB=/opt/sleela/antivirus/signatures/native-sha256.txt
SLEELA_ANTIVIRUS_NATIVE=/opt/sleela/antivirus/build/sleelavirin-scan
SLEELA_ANTIVIRUS_SCAN_TIMEOUT=120
SLEELA_ANTIVIRUS_MAX_DEPTH=8
SLEELA_ANTIVIRUS_MAX_FILE_SIZE=100M
