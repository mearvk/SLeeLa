<< SLeeLa result record mirroring slcr_result. The accepted flag is a host-side convenience derived from the configured minimum similarity; it is not a native slcr_result field. >>
#sleela 3.0
material;
class SLCharacterResult {
  String label;
  double similarity = 0.0;
  boolean accepted = false;

  void setLabel(String value) { label = value; }
  String getLabel() { return label; }
  void setSimilarity(double value) { similarity = value; }
  double getSimilarity() { return similarity; }
  void setAccepted(boolean value) { accepted = value; }
  boolean isAccepted() { return accepted; }
}
