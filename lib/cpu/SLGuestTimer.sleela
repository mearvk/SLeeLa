/*
 * lib/cpu/SLGuestTimer.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLGuestTimer — a programmable interval timer exposed to
 *   the guest. The guest kernel programs a reload value; each tick decrements a
 *   counter, and on expiry the timer raises its IRQ (the guest's scheduler tick
 *   / preemption source). This is the heartbeat a guest OS needs for
 *   timekeeping and preemptive multitasking.
 *
 * MMIO registers: 0 = reload value (RW), 1 = current count (RO), 2 = control
 * (bit0 enable). IRQ fires on count reaching zero when enabled.
 *
 * Family: cpu. Extends SLGuestDevice.
 */
#sleela 1.3
class SLGuestTimer extends SLGuestDevice {
  int reload;
  int count;
  int enabled;
  int expiries;

  void init(int base, int irq) {
    configure("timer", base, 4, irq);
    reload = 0; count = 0; enabled = 0; expiries = 0;
  }

  int read(int addr) {
    int r = registerOf(addr);
    if (r == 0) { return reload; }
    if (r == 1) { return count; }
    if (r == 2) { return enabled; }
    return 0;
  }

  void write(int addr, int value) {
    int r = registerOf(addr);
    if (r == 0) { reload = value; count = value; }
    if (r == 2) { enabled = value % 2; }
  }

  // One timer tick: decrement; on reaching zero, reload and raise the IRQ.
  void tick() {
    if (enabled == 1 && reload > 0) {
      count = count - 1;
      if (count <= 0) { count = reload; expiries = expiries + 1; raiseIRQ(); }
    }
  }

  int expiryCount() { return expiries; }
}
