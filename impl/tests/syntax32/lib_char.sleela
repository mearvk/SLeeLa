#sleela 3.2
class LibChar {
  void main() {
    print(SLChar.toString('A') + SLChar.toString('z') + SLChar.toString('5'));
    print(SLChar.isDigit('7') + " " + SLChar.isDigit('x'));
    print(SLChar.isLetter('q') + " " + SLChar.isLetter('9') + " " + SLChar.isLetter('é'));
    print(SLChar.isUpperCase('Q') + " " + SLChar.isLowerCase('Q'));
    print(SLChar.isWhitespace(' ') + " " + SLChar.isWhitespace('\t') + " " + SLChar.isWhitespace('a'));
    print(SLChar.toUpperCase('m') + "" + SLChar.toLowerCase('M') + SLChar.toUpperCase('é'));
    print(SLChar.digitValue('f', 16) + " " + SLChar.digitValue('9', 10) + " " + SLChar.digitValue('9', 8) + " " + SLChar.digitValue('z', 36));
    print(SLChar.forDigit(11, 16) + "" + SLChar.forDigit(3, 10));
    print(SLChar.toCode('A') + " " + SLChar.fromCode(66) + " " + SLChar.fromCode(65601));
    print(SLChar.MAX_VALUE + " " + SLChar.MIN_VALUE);
    print(SLChar.isHighSurrogate(SLChar.fromCode(55357)) + " " + SLChar.isLowSurrogate(SLChar.fromCode(56832)) + " " + SLChar.isSurrogate('a'));
    print(SLChar.toCodePoint(SLChar.fromCode(55357), SLChar.fromCode(56832)));
    print(SLChar.compare('a', 'c') + " " + SLChar.hashCode('a'));
  }
}
