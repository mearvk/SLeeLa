<< lib/advantage/modules/trader/SLHstMarket.sleela
   SLeeLa Standard Library Definition.
   Definition: A deterministic synthetic market that feeds the high speed trader. >>
#sleela 3.0
material;
artifact;
pure;
gasoline;
< SLeeLa courseware model: a deterministic synthetic market for the high speed trader. >
< Illustrative data only; not a measurement of any real market. >
class SLHstMarket {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs. Values are faithful
     to the subject real origin where publicly known; unknown values use none. >>
  String metaVersion = "1.0.0";
  int metaId = 39502;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-13";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | nation | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-13";
  < metaScienceRating: maturity on a 1..10 scale; courseware model on synthetic data >
  int metaScienceRating = 5;
  < metaNationalSchedule: a real citable instrument or none >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < Deterministic synthetic candidate stream: same seed, same stream. >
  < Mix: noise, marginal, genuine, phantom (too good to be true), stale, >
  < oversize, high position, low trust, and a rare malformed record. >
  < The hidden truth decides the realized outcome, so learning has a signal. >
  int seed = 12345;
  boolean real = false;
  double lastE = 0.0;
  double lastC = 0.0;
  double lastV = 0.0;
  int kindCount = 0;

  void reseed(int s) { seed = s; }
  boolean lastWasReal() { return real; }

  double rnd() {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return (seed * 1.0) / 2147483648.0;
  }
  double between(double lo, double hi) { return lo + (hi - lo) * rnd(); }

  << Fill o[0..9] with the next candidate. o must have 10 elements. >>
  void next(double[] o) {
    double r = rnd();
    double e = 0.0;
    double c = between(2.0, 9.0);
    double n = between(0.0, 30.0);
    double v = between(3.0, 40.0);
    real = false;
    if (r < 0.70) {
      e = between(0.0, 10.0);
    } else {
      if (r < 0.95) {
        e = between(8.0, 25.0);
        real = rnd() < 0.5;
      } else {
        if (r < 0.975) {
          e = between(25.0, 60.0);
          n = between(8.0, 40.0);
          v = between(5.0, 30.0);
          real = rnd() < 0.9;
        } else {
          if (r < 0.995) {
            e = between(80.0, 300.0);
            v = between(1.0, 6.0);
            n = between(0.0, 2.0);
            real = false;
          } else {
            e = between(0.0, 30.0);
          }
        }
      }
    }
    double s = between(1.0, 12.0);
    double a = between(1.0, 200.0);
    double q = between(0.05, 1.0);
    double p = between(0.0, 0.9);
    double t = between(0.6, 1.0);
    double d = between(0.5, 6.0);
    double x = rnd();
    if (x < 0.003) { a = between(600.0, 3000.0); }
    if (x > 0.990) { q = 1.5; }
    if (x > 0.970 && x <= 0.990) { p = between(0.95, 1.0); }
    if (x > 0.940 && x <= 0.970) { t = between(0.2, 0.5); }
    if (x > 0.9995) { e = 1.0e30; }
    o[0] = e;
    o[1] = c;
    o[2] = n;
    o[3] = s;
    o[4] = v;
    o[5] = a;
    o[6] = q;
    o[7] = p;
    o[8] = t;
    o[9] = d;
    lastE = e;
    lastC = c;
    lastV = v;
    kindCount = kindCount + 1;
  }

  << Realized outcome in bps of the candidate just generated, with noise. >>
  double realized() {
    double noise = (rnd() - 0.5) * 6.0;
    if (real) { return lastE * 0.8 - lastC + noise; }
    return lastE * 0.1 - lastC * 1.2 - 0.2 * lastV + noise;
  }
}
