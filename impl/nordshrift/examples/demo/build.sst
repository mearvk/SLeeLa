#nordshrift 1.0
#sleela     1.1

/// Minimal Nordshrift sheet driving the triplet for the demo module.
/// Switch `target-language` between sleela | java | c to retarget.
sheet demo:
  version      1.0.0
  author       "Sleela Design Council"
  description  "Transpiles the demo Sleela sources; sleela target runs on the core."

source:
  root  "src"
  glob  "**/*.sleela"

network:
  objects: [Endpoint, NIC, Link, Packet, Queue, Switch, Router, Fabric, Listener, Connector, Gateway, LoadBalancer, Service, TLS, DNS]
  transports: [tcp, udp, tls, quic]
  address-family: dual
  tls: true

target:
  root            "out"
  layout          mirror-source
  java-version    21
  package-root    "com.example.demo"
  target-language sleela
