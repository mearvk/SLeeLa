/*
 * lib/compiler/frontends/cpp/CppLanguageCompiler.sleela
 * SLeeLa Standard Library Definition.
 * Definition: A modular front end that compiles the C++ programming language
 *   into SLeeLa IR and onward to a VM-ready artifact.
 *
 * Another example of the developer pattern: subclass SLLanguageCompiler and
 * declare C++'s identity and full pipeline. C++ accepts several canonical
 * source extensions, so the extension list carries each one; the native
 * registry resolves any of them to this front end.
 *
 * Family: compiler (front end). Native VM/OS work crosses an explicit bridge.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class CppLanguageCompiler extends SLLanguageCompiler {

  void configure() {
    declare("C++", "C-family", "C++17", ".cc,.cpp,.cxx,.c++", TARGET_SLVM);
    provide(PHASE_SOURCE);
    provide(PHASE_LEX);
    provide(PHASE_PARSE);
    provide(PHASE_RESOLVE);
    provide(PHASE_SEMANTIC);
    provide(PHASE_IR);
    provide(PHASE_LOWER);
    provide(PHASE_CODEGEN);
  }

  boolean runResolve(SLCompileRequest request) {
    // C++ name resolution: namespaces, overloads, templates, ADL, and
    // qualified lookup resolve to SLeeLa symbols here.
    return provides(PHASE_RESOLVE);
  }

  boolean runSemantic(SLCompileRequest request) {
    // C++ semantics: template instantiation, overload resolution, access
    // control, and type checking before IR construction.
    return provides(PHASE_SEMANTIC);
  }
}
