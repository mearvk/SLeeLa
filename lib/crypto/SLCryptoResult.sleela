/*
 * lib/crypto/SLCryptoResult.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLCryptoResult, the
 *   intermediate result produced after the main general intermix series runs,
 *   before comparison and registration.
 *
 * Order and Orientation: Produced immediately after SLCryptoSeries.run(). It is
 *   read by SLCryptoComparator and carried forward to the final result.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLCryptoResult {
  String cipherText;  // the running text after the main series
  int stepsApplied;   // how many ordered steps contributed
  int state;

  void capture(String text, int steps) {
    cipherText = text;
    stepsApplied = steps;
    state = 1;
  }

  void enable() { state = 1; }
  void disable() { state = 0; }
  boolean active() { return state == 1; }

  String value() { return cipherText; }
  int steps() { return stepsApplied; }
}
