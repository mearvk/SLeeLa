#sleela 1.3
// Unified SLeeLa standard-library module loader facade.
// The native compiler/Nordshrift index resolves the actual /lib tree.
// This object carries the resolved inventory into VM-facing code.
// Max Rupplin - MEARVK LLC - 2026
class SLVMModuleLoader {
  String name; String root; int state; int packages; int symbols;
  void configure(String n,String r){name=n;root=r;}
  void bindInventory(int p,int s){packages=p;symbols=s;}
  void start(){state=1;}
  void stop(){state=0;}
  boolean active(){return state==1;}
  boolean ready(){return root!=null && packages>0 && symbols>0;}
  int packageCount(){return packages;}
  int symbolCount(){return symbols;}
}
