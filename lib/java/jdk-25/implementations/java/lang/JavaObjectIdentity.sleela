<< lib/java/implementations/java/lang/JavaObjectIdentity.sleela
   SLeeLa-native identity contract for the default java.lang.Object behavior.
   The VM supplies a stable heap identity and object handle for each live object.
   This adapter implements identity equality and a stable identity-derived hash.
   It does not claim monitor, wait/notify, cloning, or default toString support. >>
#sleela 2.5
material;

class JavaObjectIdentity {
  int heapIdentity = -1;
  int objectHandle = -1;
  String runtimeClassName = "";

  < Bind only to a live VM object. heapIdentity must identify the owning heap
    instance and objectHandle must remain stable for this object's lifetime. >
  void bind(int heap, int handle, String className) {
    heapIdentity = heap;
    objectHandle = handle;
    runtimeClassName = className;
  }

  boolean isBound() {
    return heapIdentity >= 0 && objectHandle >= 0;
  }

  boolean equals(JavaObjectIdentity other) {
    if (!isBound() || other == null || !other.isBound()) { return false; }
    return heapIdentity == other.heapIdentity
        && objectHandle == other.objectHandle;
  }

  < A legal identity-derived hash: stable for the lifetime of the bound
    handle and equal for any pair that compares equal. Collisions are allowed. >
  int hashCode() {
    if (!isBound()) { return 0; }
    return heapIdentity * 31 + objectHandle;
  }

  String className() { return runtimeClassName; }
  String implementationName() { return "SLeeLa-native/java.lang.Object-identity"; }

  < Explicitly unsupported until runtime services are implemented. >
  boolean supportsMonitorOperations() { return false; }
  boolean supportsWaitNotify() { return false; }
  boolean supportsClone() { return false; }
  boolean supportsDefaultToString() { return false; }
}
