<< examples/java/JavaDeclaredApiConformance.sleela
   SLeeLa Java SE/JDK 28 conformance program.
   Definition: Exercises the API-declared part of lib/java generated by
   tools/jdk_api_declare.py: complete enums (identity, values, valueOf,
   ordinal, compareTo), a complete record (PEMRecord), and abstract methods
   that throw AbstractMethodError when called directly, as on the JVM.
   Prints one FAIL line per mismatch, then a summary line. >>
#sleela 3.0
material;
import java.java.time;
import java.java.math;
import java.java.util.concurrent;
import java.java.security;
class JavaDeclaredApiConformance {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Baseline identity for a worker-class conformance program. >>
  String metaVersion = "1.0.0";
  int metaId = 0;
  String metaAuthor = "Max Rupplin";
  String metaDate = "2026-11-10";
  String metaCopyright = "MEARVK LLC";
  String metaTrademark = "none";
  String metaCorporation = "MEARVK LLC";
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-10";
  int metaScienceRating = 7;
  String metaNationalSchedule = "Java SE 28 API Specification (JDK 28 early access)";

  String getMetaVersion() { return metaVersion; }
  int getMetaId() { return metaId; }
  String getAuthor() { return metaAuthor; }
  String getDate() { return metaDate; }
  String getCopyright() { return metaCopyright; }
  String getTrademark() { return metaTrademark; }
  String getCorporation() { return metaCorporation; }
  String getOrigin() { return metaOrigin; }
  String getBirthDate() { return metaBirthDate; }
  int getScienceRating() { return metaScienceRating; }
  String getNationalSchedule() { return metaNationalSchedule; }


  int bad = 0;
  void eq(String name, String got, String want) {
    if (got != want) { bad = bad + 1; print("FAIL " + name + " got=[" + got + "] want=[" + want + "]"); }
  }
  void yes(String name, boolean b) { if (!b) { bad = bad + 1; print("FAIL " + name); } }
  void main() {
    DayOfWeek days = new DayOfWeek(null, -1);
    DayOfWeek fri = days.valueOf("FRIDAY");
    DayOfWeek[] all = days.values();
    DayOfWeek first = all[0];
    DayOfWeek fifth = all[4];
    eq("enum", fri.name() + fri.ordinal() + arrayLength(all) + first.toString(), "FRIDAY47MONDAY");
    yes("enum identity", fifth == fri);
    yes("enum equals", fri.equals(days.valueOf("FRIDAY")));
    eq("enum compareTo", "" + first.compareTo(fri), "-4");
    boolean iae = false;
    try { days.valueOf("FUNDAY"); } catch (Any e) {
      IllegalArgumentException x = (IllegalArgumentException) e;
      iae = x.getMessage() == "No enum constant java.time.DayOfWeek.FUNDAY";
    }
    yes("enum valueOf unknown", iae);
    boolean npe = false;
    try { days.valueOf(null); } catch (Any e2) { npe = e2 instanceof NullPointerException; }
    yes("enum valueOf null", npe);
    RoundingMode rm = new RoundingMode(null, -1);
    RoundingMode he = rm.valueOf("HALF_EVEN");
    eq("RoundingMode", he.name() + he.ordinal(), "HALF_EVEN6");
    TimeUnit tu = new TimeUnit(null, -1);
    TimeUnit[] units = tu.values();
    TimeUnit last = units[6];
    eq("TimeUnit", "" + arrayLength(units) + last.name(), "7DAYS");
    int[] data = new int[1];
    data[0] = 7;
    PEMRecord r = new PEMRecord("CERTIFICATE", "MIIB", data);
    eq("record accessors", r.type() + "/" + r.content(), "CERTIFICATE/MIIB");
    PEMRecord r2 = new PEMRecord("CERTIFICATE", "MIIB", data);
    yes("record equals", r.equals(r2));
    yes("record not equals", !r.equals(new PEMRecord("KEY", "MIIB", data)));
    yes("record hash", r.hashCode() == r2.hashCode());
    Runnable task = new Runnable();
    boolean ame = false;
    try { task.run(); } catch (Any e3) { ame = e3 instanceof AbstractMethodError; }
    yes("abstract method throws AbstractMethodError", ame);
    print("failures=" + bad);
  }
}
