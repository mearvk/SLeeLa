;;; sleela-east-asian-theme.el --- SLeeLa East Asian theme -*- lexical-binding: t; -*-
(deftheme sleela-east-asian "Lacquer red, jade, ink black and ceremonial gold.")
(custom-theme-set-faces
 'sleela-east-asian
 '(default ((t (:foreground "#F2EFE7" :background "#171A1C"))))
 '(cursor ((t (:background "#72C7A5"))))
 '(region ((t (:background "#3A4541" :extend t))))
 '(highlight ((t (:background "#242A2B"))))
 '(fringe ((t (:foreground "#969F9B" :background "#171A1C"))))
 '(line-number ((t (:foreground "#969F9B" :background "#171A1C"))))
 '(line-number-current-line ((t (:foreground "#72C7A5" :weight bold))))
 '(mode-line ((t (:foreground "#F2EFE7" :background "#343D39" :weight bold))))
 '(mode-line-inactive ((t (:foreground "#969F9B" :background "#242A2B"))))
 '(minibuffer-prompt ((t (:foreground "#D97878" :weight bold))))
 '(font-lock-builtin-face ((t (:foreground "#72C7A5"))))
 '(font-lock-comment-face ((t (:foreground "#969F9B" :slant italic))))
 '(font-lock-constant-face ((t (:foreground "#E59B83"))))
 '(font-lock-function-name-face ((t (:foreground "#9FCB9A" :weight bold))))
 '(font-lock-keyword-face ((t (:foreground "#D97878" :weight bold))))
 '(font-lock-string-face ((t (:foreground "#D8B76A"))))
 '(font-lock-type-face ((t (:foreground "#72C7A5" :weight bold))))
 '(font-lock-variable-name-face ((t (:foreground "#F2EFE7"))))
 '(font-lock-warning-face ((t (:foreground "#FF7777" :weight bold :underline t))))
 '(error ((t (:foreground "#FF7777" :weight bold))))
 '(warning ((t (:foreground "#D8B76A" :weight bold))))
 '(success ((t (:foreground "#9FCB9A" :weight bold))))
 '(show-paren-match ((t (:foreground "#F2EFE7" :background "#3A4541" :weight bold))))
 '(isearch ((t (:foreground "#171A1C" :background "#D8B76A" :weight bold)))))
(provide-theme 'sleela-east-asian)
;;; sleela-east-asian-theme.el ends here
