/*
 * lib/regex/RegexPattern.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexPattern used within the regex library family.
 */
#sleela 1.3
class RegexPattern {
  string pattern;
  int flags;
  void setPattern(string value){pattern=value;}
  string getPattern(){return pattern;}
  void setFlags(int value){flags=value;}
  int getFlags(){return flags;}
}
