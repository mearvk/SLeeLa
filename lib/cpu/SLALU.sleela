<< lib/cpu/SLALU.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLALU — the Arithmetic Logic Unit. It is the CPU's
     calculator: given two operand words and an operation selector, it computes
     a result and sets condition flags (zero, negative, carry, overflow). It
     uses SLAdder for add/subtract (subtraction via two's-complement add) and
     gate-level logic for the bitwise operations.
   
   Operations: ADD, SUB, AND, OR, XOR, NOT, SHL, SHR, CMP, PASS.
   Flags follow the usual CPU status register convention.
   
   Family: cpu. Composes SLAdder; pure Sleela arithmetic. >>
#sleela 2.5
material;
class SLALU {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10197;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-10-16";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-06";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  static final int OP_ADD = 0;
  static final int OP_SUB = 1;
  static final int OP_AND = 2;
  static final int OP_OR  = 3;
  static final int OP_XOR = 4;
  static final int OP_NOT = 5;
  static final int OP_SHL = 6;
  static final int OP_SHR = 7;
  static final int OP_CMP = 8;
  static final int OP_PASS= 9;
  static final int OP_MUL = 10;
  static final int OP_DIV = 11;
  static final int OP_MOD = 12;
  static final int OP_NEG = 13;

  int width;
  SLAdder adder;
  int result;
  int flagZero;
  int flagNeg;
  int flagCarry;
  int flagOverflow;

  void configure(int bits) {
    width = bits;
    adder = new SLAdder(); adder.configure(bits);
    result = 0; flagZero = 0; flagNeg = 0; flagCarry = 0; flagOverflow = 0;
  }

  int pow2(int n) { int p = 1; int i = 0; while (i < n) { p = p * 2; i = i + 1; } return p; }
  < 2^width >
  int mask() { return pow2(width); }
  int bitAt(int v, int i) { return (v / pow2(i)) % 2; }
  int signBit(int v) { return bitAt(v, width - 1); }

  int bitwise(int a, int b, int op) {
    int out = 0; int i = 0;
    while (i < width) {
      int x = bitAt(a, i); int y = bitAt(b, i); int r = 0;
      if (op == OP_AND) { if (x == 1 && y == 1) { r = 1; } }
      if (op == OP_OR)  { if (x == 1 || y == 1) { r = 1; } }
      if (op == OP_XOR) { if (x != y) { r = 1; } }
      if (op == OP_NOT) { if (x == 0) { r = 1; } }
      if (r == 1) { out = out + pow2(i); }
      i = i + 1;
    }
    return out;
  }

  void setFlags(int value, int carry, int overflow) {
    int m = mask();
    int v = value % m;
    if (v < 0) { v = v + m; }
    result = v;
    if (result == 0) { flagZero = 1; } else { flagZero = 0; }
    flagNeg = signBit(result);
    flagCarry = carry;
    flagOverflow = overflow;
  }

  int execute(int a, int b, int op) {
    if (op == OP_ADD) {
      int s = adder.add(a % mask(), b % mask());
      setFlags(s, adder.carry(), 0);
    } else if (op == OP_SUB || op == OP_CMP) {
      < two's complement subtract: a + (~b + 1) >
      int nb = (bitwise(b, 0, OP_NOT) + 1) % mask();
      int s = adder.add(a % mask(), nb);
      setFlags(s, adder.carry(), 0);
    } else if (op == OP_MUL) {
      setFlags((a * b) % mask(), 0, 0);
    } else if (op == OP_DIV) {
      < div-by-zero sets overflow >
      if (b == 0) { setFlags(0, 0, 1); } else { setFlags(a / b, 0, 0); }
    } else if (op == OP_MOD) {
      if (b == 0) { setFlags(0, 0, 1); } else { setFlags(a % b, 0, 0); }
    } else if (op == OP_NEG) {
      setFlags((mask() - (a % mask())) % mask(), 0, 0);
    } else if (op == OP_AND || op == OP_OR || op == OP_XOR || op == OP_NOT) {
      setFlags(bitwise(a, b, op), 0, 0);
    } else if (op == OP_SHL) {
      setFlags((a * pow2(b)) % mask(), 0, 0);
    } else if (op == OP_SHR) {
      setFlags(a / pow2(b), 0, 0);
    } else {
      < OP_PASS >
      setFlags(a, 0, 0);
    }
    return result;
  }

  int out() { return result; }
  int zero() { return flagZero; }
  int negative() { return flagNeg; }
  int carry() { return flagCarry; }
  int overflow() { return flagOverflow; }
}
