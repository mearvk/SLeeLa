  public int getActualMaximum(int field) {
    if (field == 5) {
      long days = gfdiv(this.gcTime, 86400000);
      return monthLength(gYear(days), gMonth(days));
    }
    if (field == 6) {
      long days = gfdiv(this.gcTime, 86400000);
      if (leap(gYear(days))) { return 366; }
      return 365;
    }
    if (field == 2) { return 11; }
    if (field == 7) { return 7; }
    if (field == 9) { return 1; }
    if (field == 10) { return 11; }
    if (field == 11) { return 23; }
    if (field == 12 || field == 13) { return 59; }
    if (field == 14) { return 999; }
    throw new UnsupportedOperationException("java.util.GregorianCalendar.getActualMaximum: field " + field + " is not supported yet");
