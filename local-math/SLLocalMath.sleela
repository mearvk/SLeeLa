  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  << A deterministic linear congruential generator (Numerical Recipes constants).
     state is the 64-bit seed; next() advances and returns a value in [0,1). >>
  long state;
  void seed(long s) { state = s; }
  long nextLong() {
    state = state * 6364136223846793005 + 1442695040888963407;
    return state;
  }
  double next() {
    long v = nextLong();
    if (v < 0) { v = 0 - v; }
    double d = v;
    double max = 9223372036854775807.0;
    return d / max;
  }
  int nextInt(int bound) {
    double u = next();
    int r = (int) (u * bound);
    if (r >= bound) { r = bound - 1; }
    return r;
  }
}

