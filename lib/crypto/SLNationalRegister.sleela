/*
 * lib/crypto/SLNationalRegister.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLNationalRegister, the
 *   call stage that records a compared cryptography result into the national
 *   register of record.
 *
 * Order and Orientation: ORIENT_CALL. Runs after SLCryptoComparator confirms a
 *   match and before the final standard result is produced. The register call
 *   itself crosses the explicit VM/OS bridge; it does not alter the text.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLNationalRegister {
  String registryId;  // identity of the register being written to
  int state;
  boolean lastAccepted;

  void configure(String id) { registryId = id; state = 1; }
  void enable() { state = 1; }
  void disable() { state = 0; }
  boolean active() { return state == 1; }

  // Submit a confirmed result. Fail-closed: an unconfirmed comparator or an
  // inactive register refuses the submission.
  boolean submit(SLCryptoResult result, SLCryptoComparator comparator) {
    if (!active() || result == null || comparator == null) { lastAccepted = false; return false; }
    if (!comparator.matched()) { lastAccepted = false; return false; }
    lastAccepted = native sleela_crypto_national_register(registryId, result.value());
    return lastAccepted;
  }

  boolean accepted() { return lastAccepted; }
}
