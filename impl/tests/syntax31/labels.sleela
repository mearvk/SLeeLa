#sleela 3.1
class Labels {
  void main() {
    int found = 0;
    outer: for (int i = 0; i < 5; i++) {
      for (int j = 0; j < 5; j++) {
        if (j == 3) { continue outer; }
        if (i == 3) { break outer; }
        found = found + 1;
      }
    }
    print(found);
    int k = 0;
    scan: while (true) {
      k = k + 1;
      do {
        if (k > 4) { break scan; }
        if (k % 2 == 0) { continue scan; }
        print("odd " + k);
      } while (false);
    }
    print("k=" + k);
    block: {
      print("in block");
      if (k > 0) { break block; }
      print("never");
    }
    print("after block");
    for (int q = 0; q < 4; q++) {
      switch (q) {
        case 1: continue;
        case 3: break;
        default: print("q=" + q);
      }
    }
    print("inner break stays inner");
    for (int a = 0; a < 3; a++) {
      for (int b = 0; b < 3; b++) {
        if (b == 1) { break; }
        print(a + "," + b);
      }
    }
  }
}
