    int isAdult() {
        return ageYears >= 18;
    }

    int isWorkingAge() {
        return ageYears >= 16 && ageYears < 75;
    }

    int isEmployed() {
        return employed == 1 || selfEmployed == 1;
    }

    int isFinanciallyStable() {
        return povertyRisk < 50 && financialStress < 70;
    }

    int hasBasicUtilities() {
        return waterAccess == 1 && sanitationAccess == 1 && electricityAccess == 1;
    }

    int hasDigitalAccess() {
        return deviceAccess == 1 && internetAccess == 1;
    }

    int canParticipateCivically() {
        return isAlive == 1 && isResident == 1 && ageYears >= 18;
    }

    int adjustHealth(int delta) {
        healthScore = healthScore + delta;
        if (healthScore < 0) healthScore = 0;
        if (healthScore > maxHealthScore) healthScore = maxHealthScore;
        return healthScore;
    }

    int setAge(int years, int months) {
        if (years < 0) years = 0;
        if (months < 0) months = 0;
        if (months > 11) months = 11;
        ageYears = years;
        ageMonths = months;
        return ageYears;
    }

    int normalize() {
        if (maxHealthScore < 1) maxHealthScore = 1;
        if (healthScore < 0) healthScore = 0;
        if (healthScore > maxHealthScore) healthScore = maxHealthScore;
        if (ageYears < 0) ageYears = 0;
        if (ageMonths < 0) ageMonths = 0;
        if (ageMonths > 11) ageMonths = 11;
        if (householdSize < 1) householdSize = 1;
        if (dependents < 0) dependents = 0;
        if (hoursWorkedPerWeek < 0) hoursWorkedPerWeek = 0;
        if (hoursWorkedPerWeek > 168) hoursWorkedPerWeek = 168;
        if (taxRateBasisPoints < 0) taxRateBasisPoints = 0;
        if (taxRateBasisPoints > 10000) taxRateBasisPoints = 10000;
        if (dataCompleteness < 0) dataCompleteness = 0;
        if (dataCompleteness > 100) dataCompleteness = 100;
        if (dataConfidence < 0) dataConfidence = 0;
        if (dataConfidence > 100) dataConfidence = 100;
        return 1;
    }
}
