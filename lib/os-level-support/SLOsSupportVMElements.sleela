< SLeeLa Standard Library Definition.
  Definition: Factory catalogue for concrete VM OS-call elements.
  Each factory returns an SLOsSupportElement with its canonical grouping term,
  SLeeLa built-in, OP_OS opcode, native slos_* backend symbol, effect and status.
  These records describe the existing VM bridge; they do not bypass its dispatcher. >
#sleela 2.5
material;

class SLOsSupportVMElements {
  SLOsSupportElement platform() {
    SLOsSupportElement e = new SLOsSupportElement();
    e.configure("platform", "HostIdentity", "OSHost", "OP_OS_PLATFORM:103",
      "osPlatform", "slos_platform_name", "CommonBackend", "ReadOnlyQuery", "Implemented", 0, 0);
    e.setResultTerm("Utf8String");
    return e;
  }

  SLOsSupportElement capability() {
    SLOsSupportElement e = new SLOsSupportElement();
    e.configure("capability", "CapabilityDiscovery", "OSCapabilities", "OP_OS_CAPABILITY:104",
      "osCapability", "slos_capability", "CommonBackend", "ReadOnlyQuery", "Implemented", 1, 0);
    e.setResultTerm("Boolean");
    return e;
  }

  SLOsSupportElement getEnv() {
    SLOsSupportElement e = new SLOsSupportElement();
    e.configure("getEnv", "Environment", "OSEnvironment", "OP_OS_GETENV:105",
      "osGetEnv", "slos_getenv", "CommonBackend", "ReadOnlyQuery", "Implemented", 1, 0);
    e.setResultTerm("Utf8String");
    return e;
  }

