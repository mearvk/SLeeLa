  << A reproducible pseudo-random stream with an explicit seed, so a computation
     can be replayed exactly. Same LCG recurrence as SLRandomGenerator. >>
  long state;
  long initial;
  void seed(long s) { state = s; initial = s; }
  void reset() { state = initial; }
  double next() {
    state = state * 6364136223846793005 + 1442695040888963407;
    long v = state;
    if (v < 0) { v = 0 - v; }
    double d = v;
    return d / 9223372036854775807.0;
  }
}

