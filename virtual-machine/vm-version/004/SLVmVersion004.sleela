/*
 * virtual-machine/vm-version/004/SLVmVersion004.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLVmVersion004 — the loadable manifest for VM version 004
 *   ("telemetry"), the OOD selector record the native VM loads on system
 *   start or a user conference. It names this version's native directory and
 *   the C/C++ main the loader builds and boots, declares the hardening units it
 *   composes (cumulative through v004 of the think-tank arc), and carries the
 *   default configuration profile a user starts from. build() returns the
 *   configured SLVmRuntime a selection resolves to.
 *
 * Mirrors the C/C++ in this folder (the 71-file core + the additive vm_* units
 * through v004). It extends SLVmVersion (lib/vm/src/sleela/SLVmVersion.sleela).
 *
 * Family: vm. Composes SLVmVersion, SLVmConfig, SLVmRuntime.
 */
#sleela 1.3
class SLVmVersion004 extends SLVmVersion {
  void configure() {
    base(4, "idea-vm-004", "telemetry", "virtual-machine/vm-version/004", "vm_telemetry_test");
    composeThrough(4);
    // default profile tuning for this version (user-editable in setup/conference)
    profile.setVerbosity(SLVmConfig.VERBOSITY_NORMAL);
  }
}
