  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  double pi() { return 3.141592653589793; }
  double reduce(double x) {
    double twoPi = 6.283185307179586;
    while (x > 3.141592653589793) { x = x - twoPi; }
    while (x < 0.0 - 3.141592653589793) { x = x + twoPi; }
    return x;
  }
  double sin(double x) {
    x = reduce(x);
    double term = x;
    double sum = x;
    int n = 1;
    while (n < 20) {
      term = term * (0.0 - x * x) / ((2 * n) * (2 * n + 1));
      sum = sum + term;
      n = n + 1;
    }
    return sum;
  }
  double cos(double x) {
    x = reduce(x);
    double term = 1.0;
    double sum = 1.0;
    int n = 1;
    while (n < 20) {
      term = term * (0.0 - x * x) / ((2 * n - 1) * (2 * n));
      sum = sum + term;
      n = n + 1;
    }
    return sum;
  }
  double r;
  double theta;
  void set(double radius, double angle) { r = radius; theta = angle; }
  double toX() { return r * cos(theta); }
  double toY() { return r * sin(theta); }
  double getR() { return r; }
  double getTheta() { return theta; }
}

