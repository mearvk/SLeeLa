/*
 * lib/codecs/SLCodecWebmAudio.sleela
 * SLeeLa Standard Library Definition.
 * Definition: WebM Audio codec class — the SLeeLa-facing handle to codec id 19.
 */
#sleela 1.3
// Family: codecs. Individual codec class for WebM Audio:
// WebM container (a Matroska profile) carrying Opus or Vorbis audio. Mirrors codecs/codecs/webm_audio/ and the registry entry in
// sleela_codec_manager.h. SLeeLa never calls a codec directly; the
// SLCodecLoader loads this plugin by id and dispatches decode/encode. This
// class is the metadata + capability contract for that plugin.
//
// Handler state codes: 0 native, 1 backend, 2 recognized, 3 container, 4 event.
class SLCodecWebmAudio {
  // Registry identity (mirrors sleela_codec_handler).
  int id() { return 19; }
  String name() { return "WebM Audio"; }
  String mime() { return "audio/webm"; }
  String extensions() { return ".webm"; }

  // Capability state: 3 == container.
  int state() { return 3; }
  String stateName() { return "container"; }

  // Direction support advertised by the plugin vtable.
  boolean canDecode() { return true; }
  boolean canEncode() { return true; }

  // Native codecs implement encode/decode in-package (no external backend);
  // a backend codec reports its honest state and fails cleanly from
  // decode/encode until an approved backend adapter is registered.
  boolean isNative() { return false; }
  boolean needsBackend() { return false; }

  // ---- Descriptive metadata (version 1.11 nested-friendly accessors) ----
  // Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
  // or catalog can read and (where appropriate) override each codec's record.
  // Values are faithful to the codec's real origin where publicly known.
  String metaVersion = "1.0.0";
  int metaId = 19;
  String metaAuthor = "Google / WebM Project";
  String metaDate = "2026-09-28";
  String metaCopyright = "BSD (WebM Project)";
  String metaTrademark = "WebM";
  String metaCorporation = "Google LLC";
  String metaOrigin = "United States";
  String metaBirthDate = "2010";
  int metaScienceRating = 9;        // maturity/robustness on a 1..10 scale
  String metaNationalSchedule = "WebM Project (Matroska profile)";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
}
