/*
 * lib/crypto/SLAes.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLAes used within the crypto library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. AES-128/192/256 block cipher (FIPS 197). Native impl crosses the VM/OS bridge to /crypto.
class SLAes {
  String algorithm; int keyBits; int state;
  void configure(String a){algorithm=a;} void keySize(int b){keyBits=b;} void enable(){state=1;} void disable(){state=0;} boolean active(){return state==1;}
}
