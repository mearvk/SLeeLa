/*
 * lib/crypto/SLPlainTextField.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLPlainTextField, the
 *   ordered collection of one or more initial plaintext fields presented to the
 *   cryptography pipeline before any intermix occurs.
 *
 * Rationale: The user requires "1 or more initial plain text fields". This type
 *   guards that at least one field is present and preserves the order in which
 *   fields are supplied so the init pad and intermix stages read them 1..N.
 *
 * Order and Orientation: Stage-zero. SLPlainTextField feeds the init pad and the
 *   two secondary intermix stages. It performs no mixing itself.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLPlainTextField {
  static final int MAX_FIELDS = 255;

  SLPlainText[] fields;
  int count;
  int state;
  String lastError;

  void init() {
    fields = new SLPlainText[MAX_FIELDS];
    count = 0;
    state = 0;
    lastError = "";
  }

  // Append an initial plaintext field. The ordinal is assigned 1-based in call
  // order. Fail-closed when the bound is exceeded.
  boolean add(String label, String content) {
    if (count >= MAX_FIELDS) {
      lastError = "too many plaintext fields (max 255)";
      return false;
    }
    SLPlainText pt = new SLPlainText();
    pt.configure(label, content, count + 1);
    fields[count] = pt;
    count = count + 1;
    return true;
  }

  // Guard: a pipeline must have at least one initial plaintext field.
  boolean valid() {
    if (count < 1) { lastError = "at least one plaintext field required"; return false; }
    return true;
  }

  void enable() { if (valid()) { state = 1; } }
  void disable() { state = 0; }
  boolean active() { return state == 1 && valid(); }

  int size() { return count; }
  SLPlainText at(int index) {
    if (index < 0 || index >= count) { return null; }
    return fields[index];
  }
  SLPlainText primary() { return at(0); }
}
