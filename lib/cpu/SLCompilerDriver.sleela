/*
 * lib/cpu/SLCompilerDriver.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLCompilerDriver — the multi-language compiler driver. It
 *   selects the right frontend for a source language (C, C++, Java, Sleela),
 *   runs frontend -> SLIR -> SLLowering, and returns a runnable SLProgram for
 *   the Sleela CPU. This is the single entry point that makes the ISA accept
 *   all four languages: one driver, one IR, one backend.
 *
 *     source(.c/.cpp/.java/.sleela)
 *        -> SLFrontend{C,Cpp,Java,Sleela}.lower() -> SLIR
 *        -> SLLowering.lower() -> SLProgram  (SLInstructionSet machine code)
 *
 * Family: cpu. Composes the frontend hierarchy, SLIR, SLLowering, SLProgram.
 */
#sleela 1.3
class SLCompilerDriver {
  SLInstructionSet isa;
  int lastLanguage;

  void configure(SLInstructionSet instructionSet) { isa = instructionSet; lastLanguage = -1; }

  // Build the appropriate frontend for a language id.
  SLFrontend frontendFor(int langId, String path) {
    if (langId == 1) { SLFrontendC f = new SLFrontendC(); f.init(path); return f; }
    if (langId == 2) { SLFrontendCpp f = new SLFrontendCpp(); f.initCpp(path); return f; }
    if (langId == 3) { SLFrontendJava f = new SLFrontendJava(); f.init(path); return f; }
    SLFrontendSleela f = new SLFrontendSleela(); f.init(path); return f;
  }

  // Infer the language from a file extension.
  int languageOf(String path) {
    if (endsWith(path, ".c")) { return 1; }
    if (endsWith(path, ".cpp") || endsWith(path, ".cc") || endsWith(path, ".cxx")) { return 2; }
    if (endsWith(path, ".java") || endsWith(path, ".class")) { return 3; }
    return 0; // .sleela / default
  }

  boolean endsWith(String s, String suffix) {
    int sl = length(s); int fl = length(suffix);
    if (fl > sl) { return false; }
    return substring(s, sl - fl, sl) == suffix;
  }
  int length(String s) { return native sleela_str_length(s); }
  String substring(String s, int a, int b) { return native sleela_str_substring(s, a, b); }

  // Compile a source file in the given language into a runnable SLProgram.
  SLProgram compile(String path, int langId, String programName) {
    lastLanguage = langId;
    SLFrontend fe = frontendFor(langId, path);
    fe.parse();
    SLIR ir = fe.lower();

    SLProgram prog = new SLProgram(); prog.configure(programName, 4096);
    SLLowering backend = new SLLowering();
    backend.configure(isa, prog, ir);
    backend.lower();
    return prog;
  }

  // Convenience: infer language from the path extension.
  SLProgram compileFile(String path, String programName) {
    return compile(path, languageOf(path), programName);
  }

  int language() { return lastLanguage; }
}
