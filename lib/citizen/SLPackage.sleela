/*
 * lib/citizen/SLPackage.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library package for citizen.
 */
#sleela 1.3
// Library facade for module package: citizen
// Exposes the package to the SLeeLa compiler, Loader, and Nordshrift.
// The Master Classes (Citizen, Industry, BankAccount, FederalReserveID) are
// first-class one-class-per-file source units in this package; this facade
// only names the package itself, mirroring lib/ledger/SLPackage.sleela.
class SLPackage {
  String packageName;
  void configure(String name){packageName=name;}
  String name(){return packageName;}
  boolean available(){return packageName!=null;}
}
