/*
 * lib/crypto/SLCryptoBlockThree.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLCryptoBlockThree, the
 *   third ordered step of the main cryptography series — the "lightning rounds".
 *
 * Rationale: Mirrors pass three() of the reference AES2 module. It runs the
 *   first intermix (positions 1,2,6,7 via base-11/base-12) and the second
 *   intermix (positions 2,3,17 via base-11/base-17), in that fixed order.
 *
 * Order and Orientation:
 *   - Order:       3.
 *   - Orientation: ORIENT_INTERMIX.
 *   - Respect:     honours the two intermix stages beneath it (primary then
 *                  secondary) and never swaps their internal order.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLCryptoBlockThree extends SLCryptoBlock {
  static final int STEP_ORDER = 3;
  static final int STEP_BASE = 11; // leading base of the lightning rounds

  SLIntermixPrimary primaryMix;
  SLIntermixSecondary secondaryMix;

  void prepare() {
    configure(STEP_ORDER, ORIENT_INTERMIX, 180, STEP_BASE, 0x7716,
              "Order03.Intermix.LightningRounds.Respected");
    primaryMix = new SLIntermixPrimary();
    primaryMix.prepare();
    secondaryMix = new SLIntermixSecondary();
    secondaryMix.prepare();
    enable();
  }

  String advance(String running, SLRadixTable radices) {
    if (!active()) { return running; }
    // Respect the declared internal order: primary intermix first, then secondary.
    String woven = primaryMix.apply(running, radices);
    woven = secondaryMix.apply(woven, radices);
    return woven;
  }
}
