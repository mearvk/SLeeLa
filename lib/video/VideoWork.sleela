/*
 * lib/video/VideoWork.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type VideoWork used within the video library family.
 */
#sleela 1.3
class VideoWork {
  Video video;
  VideoRenderer renderer;
  VideoEncoder encoder;
  VideoDecoder decoder;
  void compose(Video value){video=value;}
  boolean ready(){return video!=null && video.ready();}
  void prepare(){if(ready()){renderer=new VideoRenderer();encoder=new VideoEncoder();}}
  boolean prepared(){return renderer!=null && encoder!=null;}
}