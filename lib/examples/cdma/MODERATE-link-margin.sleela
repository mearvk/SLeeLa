#sleela 1.7
// MODERATE: a full one-way link budget with gains, losses, and a margin check.
// This is how a radio planner decides whether a link will actually close.
// All values in dB / dBm; still pure arithmetic, no radio hardware.
class ModerateLinkMargin {
    void main() {
        // Transmit side
        double txPowerDbm = 23.0;        // 200 mW
        double txAntennaGainDb = 12.0;
        double txCableLossDb = 2.0;

        // Propagation
        double pathLossDb = 128.0;

        // Receive side
        double rxAntennaGainDb = 12.0;
        double rxCableLossDb = 2.0;

        // Effective isotropic radiated power
        double eirpDbm = txPowerDbm + txAntennaGainDb - txCableLossDb;

        // Received signal strength
        double rsrpDbm = eirpDbm - pathLossDb + rxAntennaGainDb - rxCableLossDb;

        // Receiver sensitivity (minimum usable signal)
        double sensitivityDbm = 0.0 - 110.0;

        double marginDb = rsrpDbm - sensitivityDbm;

        print("EIRP (dBm) = " + eirpDbm);
        print("received signal (dBm) = " + rsrpDbm);
        print("receiver sensitivity (dBm) = " + sensitivityDbm);
        print("link margin (dB) = " + marginDb);
        if (marginDb >= 0.0) print("verdict: link closes");
        if (marginDb < 0.0)  print("verdict: link fails -- increase power or gain");
    }
}
