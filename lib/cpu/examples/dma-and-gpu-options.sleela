/*
 * lib/cpu/examples/dma-and-gpu-options.sleela
 * SLeeLa example: enable the direct-DMA and native-GPU options and use them.
 *
 * Both are opt-in. Here they are requested at the Creator level, flow down
 * through the Secondary VM to the hosted CPU, and the program uses them: a DMA
 * block move without the CPU copying word by word, and a GPU kernel dispatch.
 */
#sleela 1.3
class DmaAndGpuOptionsExample {
  int moved;
  int gpuOut;

  void main() {
    SL6502CPU cpu = new SL6502CPU();
    cpu.configure();

    // Request both acceleration options on the build via the Creator.
    SleelaVMCreator creator = new SleelaVMCreator();
    creator.configure();
    creator.requestDMA();    // direct memory access
    creator.requestGPU();    // native GPU access
    creator.selectGeneration(5);
    creator.create();
    creator.installExecutor(cpu);

    // Direct DMA: seed a few words, then move a block without the CPU looping.
    SLDMAController dma = cpu.dmaEngine();
    cpu.writeMem(0, 11); cpu.writeMem(1, 22); cpu.writeMem(2, 33); cpu.writeMem(3, 44);
    moved = dma.transfer(0, 0, 100, 4, dma.MODE_MEM_TO_MEM);   // src=0 dst=100 len=4
    print("DMA moved " + moved + " words; mem[100]=" + cpu.readMem(100) +
          " mem[103]=" + cpu.readMem(103));

    // Native GPU access: build and dispatch a tiny compute kernel (2 + 3).
    SLGPUDevice gpu = cpu.gpuDevice();
    print("GPU: " + gpu.name() + ", " + gpu.totalLanes() + " lanes, native=" + gpu.nativeAccess());
    gpu.emitKernel(1, 2);    // OP_CONST 2
    gpu.emitKernel(1, 3);    // OP_CONST 3
    gpu.emitKernel(8, 0);    // OP_ADD
    gpu.emitKernel(27, 0);   // OP_PRINT
    gpu.emitKernel(48, 0);   // OP_HALT
    gpuOut = gpu.dispatch(gpu.totalLanes(), 100);
    print("GPU kernel result -> " + gpuOut);
  }
}
