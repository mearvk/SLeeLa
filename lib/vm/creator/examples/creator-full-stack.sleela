<< lib/vm/creator/examples/creator-full-stack.sleela
   SLeeLa example: the full Creator -> SLVM -> Sleela CPU -> program stack.
   
   Demonstrates the end-to-end chain in one object:
     1. SleelaVMCreator selects a VM generation and builds+boots a live Secondary
        Sleela VM (SLVM), which runs on the native Sleela VM substrate.
     2. The creator installs a Sleela CPU model (SL6502CPU) as the VM's executor,
        nested on the SLVM substrate.
     3. A C / C++ / Java / Sleela program is run through that CPU under the SLVM.
     4. The observable result surfaces back up through the creator.
   
   The same workload produces the same result whichever source language it came
   from (1:1 Turing effect) and whichever Sleela CPU hosts it. >>
#sleela 2.5
material;
class CreatorFullStackExample {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10478;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-10-16";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-09";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 7;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  int cResult;
  int javaResult;

  void main() {
    < A resource grant bounding the guest program. >
    SLCPUResource grant = new SLCPUResource();
    grant.configure(4096, 100000, grant.PRIORITY_NORMAL);

    < The executor: a Sleela CPU model. >
    SL6502CPU cpu = new SL6502CPU();
    cpu.configure();

    < Build the whole stack with the creator and run a C program through it. >
    SleelaVMCreator creator = new SleelaVMCreator();
    creator.configure();
    SLWorkload cJob = new SLWorkload();
    cJob.configure("hello-c", "examples/hello.c", cJob.LANG_C, grant);
    < run(generation, cpu, workload, budget): generation 5 == "Manager". >
    cResult = creator.run(5, cpu, cJob, 1000000);
    print("C via Creator->SLVM->6502 -> " + cResult +
          " (VM generation: " + creator.generationName() + ")");

    < Reuse the booted VM + CPU for a Java program (fresh grant). >
    SLCPUResource grant2 = new SLCPUResource();
    grant2.configure(4096, 100000, grant2.PRIORITY_NORMAL);
    SLWorkload javaJob = new SLWorkload();
    javaJob.configure("hello-java", "examples/Hello.java", javaJob.LANG_JAVA, grant2);
    javaResult = creator.runProgram(javaJob, 1000000);
    print("Java via Creator->SLVM->6502 -> " + javaResult);
  }
}
