/*
 * lib/citizen/character/FreemiumModel.sleela
 * SLeeLa Standard Library Definition.
 * Definition: FreemiumModel — a large crowd uses the product for free, a small
 *   fraction converts to paid, and that fraction quietly funds everyone else.
 *   The business of giving most of it away on purpose.
 *
 * A concrete BusinessModel: revenue comes only from the converted fraction;
 * cost scales with the whole free-plus-paid population. Family: character.
 */
#sleela 1.3
class FreemiumModel extends BusinessModel {

  int freeUsers;          // the generous majority
  int conversionPercent;  // share of free users who go paid (0..100)
  int priceCents;         // monthly price for a converted user
  int serveCostCents;     // cost to serve ONE user (free or paid) per month

  void setUp(int free, int conversion, int price, int serveCost) {
    load();
    configure("Freemium", KIND_FREEMIUM);
    if (free < 0) { free = 0; }
    if (conversion < 0) { conversion = 0; }
    if (conversion > 100) { conversion = 100; }
    if (price < 0) { price = 0; }
    if (serveCost < 0) { serveCost = 0; }
    freeUsers = free;
    conversionPercent = conversion;
    priceCents = price;
    serveCostCents = serveCost;
    setUnits(free);
  }

  int paidUsers() { return (freeUsers * conversionPercent) / 100; }
  int totalUsers() { return freeUsers; }

  int monthlyRevenue() { return paidUsers() * priceCents; }
  int monthlyCost() { return totalUsers() * serveCostCents; }
}
