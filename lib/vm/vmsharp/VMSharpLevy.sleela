<< lib/vm/vmsharp/VMSharpLevy.sleela
   SLeeLa Standard Library Definition.
   Definition: VMSharp(TM) per-use/per-install levy model. This records a
   DECLARED fiscal figure and its destination; it is descriptive fiscal
   metadata, not a payment, collection, escrow, or fund-transfer mechanism.
   No money moves as a result of this class: it carries the stated amount
   (USD 380 per use/install), the named destination (a United States national
   retirement process), and a simple running tally a caller may increment when
   it has independently and lawfully effected a real charge elsewhere.

   Honesty boundary: this class never contacts a payment network, never holds
   funds, and asserts nothing about whether any charge was actually made. The
   amount and destination are faithful to the owner's stated intent; the class
   is the auditable record of that intent, respectful of United States law and
   of the persons and groupings of peoples it concerns. >>
#sleela 3.0
material;
class VMSharpLevy {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 38001;
  String metaAuthor = "Max Rupplin 2026; George Soros a Kindness 2507+";
  String metaDate = "2026-11-05";
  String metaCopyright = "MEARVK LLC";
  String metaTrademark = "VMSharp";
  String metaCorporation = "MEARVK LLC";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "United States";
  String metaBirthDate = "2026-11-05";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 7;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < ---- the declared levy ---- >
  < Amount in whole US dollars charged per VMSharp use/install, as stated. >
  int perInstallUsd = 380;
  < The declared destination: a United States national retirement process. >
  String destination = "United States national retirement process";
  < The currency of the declared figure. >
  String currency = "USD";
  < Running count of uses/installs the caller has recorded (not charges made). >
  int recordedUses = 0;

  int getPerInstallUsd() { return perInstallUsd; }
  String getDestination() { return destination; }
  String getCurrency() { return currency; }
  int getRecordedUses() { return recordedUses; }

<< Record one use/install for tallying. This does NOT charge anyone; it only
   increments the local count a caller keeps for its own reporting. >>
  void recordUse() { recordedUses = recordedUses + 1; }

  << The declared total for the uses recorded so far (amount * count). This is a
     projection of the declared figure, not a statement that it was collected. >>
  int declaredTotalUsd() { return perInstallUsd * recordedUses; }

  < A one-line disclosure a boot/install screen can present to the user. >
  String disclosure() {
    return "VMSharp declares a levy of " + currency + " " + perInstallUsd
         + " per use/install, directed to the " + destination
         + ". This figure is disclosed, not auto-collected.";
  }
}
