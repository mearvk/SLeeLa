/*
 * lib/video/VideoCodecProcessor.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type VideoCodecProcessor used within the video library family.
 */
#sleela 1.3
// Family: video. The decode/encode dispatch layer for video codecs — the
// SLeeLa mirror of the audio SLCodecProcessor, applied to the native video
// registry (video/codecs/). It dispatches a decode/encode request against the
// current lifecycle/capability facts and returns an honest result code.
//
// This is a contract, not a fake processor: real frame coding happens in the
// native codec / a registered backend. The Processor is pure — the caller
// passes in whether the codec is loaded, whether it is native, and whether a
// backend is registered — so it composes with VideoCodecController /
// VideoCodecLoader without storing a class-typed field (method calls resolve on
// parameters, not fields, on this surface). It never reports a false success:
//
//   not loaded                        -> -5 (state)
//   native codec (Raw), loaded        ->  0 (ok)
//   backend codec, no backend         -> -1 (unsupported)
//
// Result codes (sleela_codec_result): 0 ok, -1 unsupported, -2 invalid,
// -3 format, -4 io, -5 state(not loaded).
class VideoCodecProcessor {

  boolean canProcess(boolean loaded, boolean nativeCodec, boolean backendReady){
    if(!loaded){ return false; }
    if(nativeCodec){ return true; }
    return backendReady;
  }

  int decode(boolean loaded, boolean nativeCodec, boolean backendReady){
    if(!loaded){ return -5; }
    if(nativeCodec){ return 0; }
    if(backendReady){ return 0; }
    return -1;
  }

  int encode(boolean loaded, boolean nativeCodec, boolean backendReady){
    if(!loaded){ return -5; }
    if(nativeCodec){ return 0; }
    if(backendReady){ return 0; }
    return -1;
  }
}
