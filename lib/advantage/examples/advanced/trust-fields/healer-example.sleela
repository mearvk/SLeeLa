<< lib/advantage/examples/advanced/trust-fields/healer-example.sleela
   SLeeLa Standard Library Definition.
   Definition: A professional example -- the HEALER -- restores trust over time
   and measures the cost of a breach, via the trust-decay SDE. >>
#sleela 3.0
material;
artifact;
pure;
gasoline;
<< A healer tends TRUST. Trust is modelled (advantage/physics, an analogy) as a
   Cox-Ingersoll-Ross mean-reverting process with a jump for a broken promise:
     d(tau) = kappa*(tauBar - tau) dt + sigma*sqrt(tau) dW - delta*dJ
   With kappa=0.5, tauBar=0.8 (healthy baseline), delta=0.4 (breach size):
   the expected (no-noise) path reverts a low 0.3 up toward 0.8, one expected
   step from 0.3 is 0.325, and a single breach of 0.8 drops trust to 0.4.
   Names SLTrustDecaySDE / SLPhysicsMath, resolved from lib/advantage/physics/. >>
class HealerExample {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Baseline identity record for a worker-class example. >>
  String metaVersion = "1.0.0";
  int metaId = 10572;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-08";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-08";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 8;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  boolean near(double a, double b, double tol) {
    double d = a - b;
    if (d < 0.0) { d = 0.0 - d; }
    return d < tol;
  }

  void main() {
    print("== professional: the Healer ==");
    SLTrustDecaySDE sde = new SLTrustDecaySDE();
    sde.configure(0.5, 0.8, 0.1, 0.4);
    double start = 0.3;
    double oneStep = sde.expectedStep(start, 0.1);
    double healed = sde.expectedPath(start, 0.1, 50);
    double afterBreach = sde.breach(0.8);
    print("  baseline trust tauBar   = 0.8");
    print("  starting (wounded) trust = " + start);
    print("  one expected step        = " + oneStep);
    print("  healed over 50 steps     = " + healed);
    print("  trust after a breach     = " + afterBreach);

    print("");
    print("== validation ==");
    boolean okStep = near(oneStep, 0.325, 0.00001);
    boolean okHeal = (healed > start) && (healed < 0.8001);
    boolean okBreach = near(afterBreach, 0.4, 0.00001);
    print("  one step == 0.325      ? " + okStep);
    print("  heals toward baseline  ? " + okHeal);
    print("  breach drops to 0.4    ? " + okBreach);
    if (okStep) { if (okHeal) { if (okBreach) {
      print("ALL CHECKS PASSED");
    } } }
  }
}
