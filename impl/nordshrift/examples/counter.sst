// counter.sst -- minimal single-component sheet exercising the attach language.
component Counter {
    limit: 6;

    main: {
        let n = 1;
        let acc = 1;
        while (n <= prop(limit)) {
            acc = acc * n;
            n = n + 1;
        }
        print("factorial of " + prop(limit) + " = " + acc);
    }
}
