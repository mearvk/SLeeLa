/*
 * lib/cpu/SLStatusRegister.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLStatusRegister — the processor status word (FLAGS). It
 *   holds the condition flags the ALU sets (zero, negative, carry, overflow)
 *   and the mode/interrupt-enable bits the control unit and OS use. Conditional
 *   branches read this register.
 *
 * Family: cpu. Pure Sleela state.
 */
#sleela 1.3
class SLStatusRegister {
  int zero;
  int negative;
  int carry;
  int overflow;
  int interruptEnable;
  int supervisor;    // 1 = kernel/supervisor mode, 0 = user mode

  void reset() {
    zero = 0; negative = 0; carry = 0; overflow = 0;
    interruptEnable = 0; supervisor = 1; // boot in supervisor mode
  }

  void setFromALU(SLALU alu) {
    zero = alu.zero(); negative = alu.negative();
    carry = alu.carry(); overflow = alu.overflow();
  }

  void enableInterrupts() { interruptEnable = 1; }
  void disableInterrupts() { interruptEnable = 0; }
  void enterUserMode() { supervisor = 0; }
  void enterSupervisorMode() { supervisor = 1; }

  int zeroFlag() { return zero; }
  int negativeFlag() { return negative; }
  int carryFlag() { return carry; }
  int overflowFlag() { return overflow; }
  boolean interruptsEnabled() { return interruptEnable == 1; }
  boolean inSupervisor() { return supervisor == 1; }
}
