  int floatToRawIntBits(double value) {
    double f = fround(value);
    if (f != f) { return 2143289344; }
    long sign = 0;
    double a = f;
    if (a < 0.0 || isNegativeZero(a)) { sign = 1; a = 0.0 - a; }
    long bits = 0;
    if (a != 0.0) {
      if (isInfinite(a)) { bits = 2139095040; }
      else {
        int e = binaryExponent(a);
