#sleela 2.2
< Recursion: the first fifteen Fibonacci numbers. >
class Fibonacci {

  int fib(int n) {
    if (n < 2) {
      return n;
    }
    return fib(n - 1) + fib(n - 2);
  }

  void main() {
    for (int n = 0; n < 15; n = n + 1) {
      print("fib(" + n + ") = " + fib(n));
    }
  }

  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Baseline identity for a worker-class example. Values are faithful to the real origin; unknown values are none. >>
