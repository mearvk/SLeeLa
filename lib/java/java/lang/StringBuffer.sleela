  < ---- StringBuffer members (procedural implementation in SLeeLa) ---- >
  << StringBuffer over a Java UTF-16 String value (buf). Text goes in
     through javaStringFromUtf8 and is spliced with javaStringSubstring and
     javaStringConcat, so every index counts UTF-16 code units, as in Java.
     Exceptions carry the JDK 25 messages. The VM has no char primitive, so
     char is an int code unit. append(char) / insert(int, char) accept the
     ASCII range 0..126 plus tab, newline and carriage return handled
     explicitly; larger code units throw UnsupportedOperationException until
     the VM can build a String from a runtime code unit. float / double /
     char[] / CharSequence overloads keep their exact-signature stubs. >>
  String buf = javaStringFromCodeUnits();
  String asciiTable = javaStringFromUtf8(" !?#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[?]^_`abcdefghijklmnopqrstuvwxyz{|}~");

  public StringBuffer() { this.buf = javaStringFromCodeUnits(); }
  public StringBuffer(int capacity) {
    if (capacity < 0) { throw new NegativeArraySizeException("" + capacity); }
    this.buf = javaStringFromCodeUnits();
  }
  public StringBuffer(java.lang.String str) {
    if (str == null) { throw new NullPointerException(); }
    this.buf = javaStringFromUtf8(str);
  }

  public synchronized int length() { return javaStringLength(this.buf); }
  public synchronized int capacity() { return javaStringLength(this.buf) + 16; }
  public synchronized boolean isEmpty() { return javaStringLength(this.buf) == 0; }
  public synchronized java.lang.String toString() { return this.buf; }
  public synchronized char charAt(int index) {
    checkIndex(index, length());
    return javaStringCharAt(this.buf, index);
  }
  public synchronized int codePointAt(int index) {
    checkIndex(index, length());
    return javaStringCodePointAt(this.buf, index);
  }
  public synchronized int compareTo(StringBuffer another) {
    return javaStringCompareTo(this.buf, another.buf);
  }
  public synchronized int hashCode() { return javaStringHashCode(this.buf); }

  public synchronized java.lang.String substring(int start) { return substring(start, length()); }
  public synchronized java.lang.String substring(int start, int end) {
    checkRange(start, end, length());
    return javaStringSubstring(this.buf, start, end);
  }

  public synchronized StringBuffer append(java.lang.String str) {
    if (str == null) { return appendText("null"); }
    return appendText(str);
  }
  public synchronized StringBuffer append(int i) { return appendText("" + i); }
  public synchronized StringBuffer append(long lng) { return appendText("" + lng); }
  public synchronized StringBuffer append(boolean b) {
    if (b) { return appendText("true"); }
    return appendText("false");
  }
  public synchronized StringBuffer appendCodePoint(int codePoint) {
    this.buf = javaStringConcat(this.buf, codeUnitString(codePoint));
    return this;
  }

  public synchronized StringBuffer insert(int offset, java.lang.String str) {
    checkOffset(offset, length());
    String t = "null";
    if (str != null) { t = str; }
    return spliceIn(offset, javaStringFromUtf8(t));
  }
  public StringBuffer insert(int offset, int i) { return insert(offset, "" + i); }
  public StringBuffer insert(int offset, long l) { return insert(offset, "" + l); }
  public StringBuffer insert(int offset, boolean b) {
    if (b) { return insert(offset, "true"); }
    return insert(offset, "false");
  }

  public synchronized StringBuffer delete(int start, int end) {
    int n = length();
    int e = end;
    if (e > n) { e = n; }
    checkRange(start, e, n);
    this.buf = javaStringConcat(javaStringSubstring(this.buf, 0, start), javaStringSubstring(this.buf, e, n));
    return this;
  }
  public synchronized StringBuffer deleteCharAt(int index) {
    checkIndex(index, length());
    return delete(index, index + 1);
  }
  public synchronized StringBuffer replace(int start, int end, java.lang.String str) {
    int n = length();
    int e = end;
    if (e > n) { e = n; }
    checkRange(start, e, n);
    String mid = javaStringFromUtf8(str);
    this.buf = javaStringConcat(javaStringConcat(javaStringSubstring(this.buf, 0, start), mid), javaStringSubstring(this.buf, e, n));
    return this;
  }
  public synchronized void setLength(int newLength) {
    if (newLength < 0) { throw new StringIndexOutOfBoundsException("String index out of range: " + newLength); }
    int n = length();
    if (newLength <= n) {
      this.buf = javaStringSubstring(this.buf, 0, newLength);
      return;
    }
    int k = newLength - n;
    while (k > 0) { this.buf = javaStringConcat(this.buf, codeUnitString(0)); k = k - 1; }
  }
  public synchronized void setCharAt(int index, char ch) {
    checkIndex(index, length());
    int n = length();
    this.buf = javaStringConcat(javaStringConcat(javaStringSubstring(this.buf, 0, index), codeUnitString(ch)), javaStringSubstring(this.buf, index + 1, n));
  }
  public synchronized StringBuffer reverse() {
    int n = length();
    String out = javaStringFromCodeUnits();
    int i = n - 1;
    while (i >= 0) { out = javaStringConcat(out, javaStringSubstring(this.buf, i, i + 1)); i = i - 1; }
    this.buf = out;
    return this;
  }
  public synchronized StringBuffer repeat(int codePoint, int count) {
    if (count < 0) { throw new IllegalArgumentException("count is negative: " + count); }
    String u = codeUnitString(codePoint);
    int k = count;
    while (k > 0) { this.buf = javaStringConcat(this.buf, u); k = k - 1; }
    return this;
  }

  public int indexOf(java.lang.String str) { return indexOf(str, 0); }
  public synchronized int indexOf(java.lang.String str, int fromIndex) {
    String t = javaStringFromUtf8(str);
    int n = length();
    int m = javaStringLength(t);
    int i = fromIndex;
    if (i < 0) { i = 0; }
    if (m == 0) {
      if (i > n) { return n; }
      return i;
    }
    while (i + m <= n) {
      if (javaStringSubstring(this.buf, i, i + m) == t) { return i; }
      i = i + 1;
    }
    return 0 - 1;
  }
  public int lastIndexOf(java.lang.String str) { return lastIndexOf(str, length()); }
  public synchronized int lastIndexOf(java.lang.String str, int fromIndex) {
    String t = javaStringFromUtf8(str);
    int n = length();
    int m = javaStringLength(t);
    int i = fromIndex;
    if (i > n - m) { i = n - m; }
    if (i < 0) { return 0 - 1; }
    while (i >= 0) {
      if (javaStringSubstring(this.buf, i, i + m) == t) { return i; }
      i = i - 1;
    }
    return 0 - 1;
  }

  public synchronized StringBuffer append(StringBuffer sb) {
    if (sb == null) { return appendText("null"); }
    this.buf = javaStringConcat(this.buf, sb.buf);
    return this;
  }
  public synchronized void ensureCapacity(int minimumCapacity) { }
  public synchronized void trimToSize() { }

  < internal helpers >
  StringBuffer appendText(java.lang.String text) {
    this.buf = javaStringConcat(this.buf, javaStringFromUtf8(text));
    return this;
  }
  StringBuffer spliceIn(int offset, java.lang.String utf16) {
    int n = length();
    this.buf = javaStringConcat(javaStringConcat(javaStringSubstring(this.buf, 0, offset), utf16), javaStringSubstring(this.buf, offset, n));
    return this;
  }
  < one UTF-16 code unit as a String; ASCII 0..126 plus the explicit controls >
  java.lang.String codeUnitString(int c) {
    if (c == 0) { return javaStringFromCodeUnits(0); }
    if (c == 9) { return javaStringFromCodeUnits(9); }
    if (c == 10) { return javaStringFromCodeUnits(10); }
    if (c == 13) { return javaStringFromCodeUnits(13); }
    if (c == 34) { return javaStringFromCodeUnits(34); }
    if (c == 92) { return javaStringFromCodeUnits(92); }
    if (c >= 32 && c <= 126) { return javaStringSubstring(this.asciiTable, c - 32, c - 31); }
    throw new UnsupportedOperationException("java.lang.StringBuffer: code unit " + c + " is outside the ASCII range the VM can build at run time");
  }
  void checkIndex(int index, int n) {
    if (index < 0 || index >= n) { throw new StringIndexOutOfBoundsException("Index " + index + " out of bounds for length " + n); }
  }
  void checkOffset(int offset, int n) {
    if (offset < 0 || offset > n) { throw new StringIndexOutOfBoundsException("Range [" + offset + ", " + n + ") out of bounds for length " + n); }
  }
  void checkRange(int start, int end, int n) {
    if (start < 0 || start > end || end > n) { throw new StringIndexOutOfBoundsException("Range [" + start + ", " + end + ") out of bounds for length " + n); }
  }
