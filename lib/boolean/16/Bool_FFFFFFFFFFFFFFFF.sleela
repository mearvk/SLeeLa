/*
 * lib/boolean/16/Bool_FFFFFFFFFFFFFFFF.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the Boolean/Binary word BOOLEAN.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE (depth 16) as a SLeeLa standard-library constant. HEAD syllable is the result (FALSE); the remaining 15 syllable(s) are carried caveat structure.
 */
#sleela 1.3
// SLeeLa boolean/16 front-end constant — one Boolean word per file.
// Word: BOOLEAN.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE
// Family: boolean. The HEAD syllable is the RESULT; trailing syllables are
// CARRY (caveat structure) that must be observed/agree. A FALSE carried behind
// a TRUE result means: result is TRUE, but a concern of carry is noted.
class Bool_FFFFFFFFFFFFFFFF {
  String word() { return "BOOLEAN.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE.FALSE"; }
  String glyphs() { return "FFFFFFFFFFFFFFFF"; }
  int depth() { return 16; }
  // Head syllable = the asserted result.
  boolean head() { return false; }
  String headSyllable() { return "FALSE"; }
  // Carry = the trailing syllables, read as a caveat structure.
  String carry() { return "FFFFFFFFFFFFFFF"; }
  int carryDepth() { return 15; }
  // A caveat exists when any carried syllable disagrees (a FALSE is carried).
  boolean caveat() { return true; }
  // Agreement: the whole word is uniform (all syllables equal the head).
  boolean agrees() { return true; }
  int trueCount() { return 0; }
  int falseCount() { return 16; }
  // Binary reading: TRUE=1, FALSE=0, head syllable most significant.
  String bits() { return "0000000000000000"; }
  String value() { return "0"; }
}
