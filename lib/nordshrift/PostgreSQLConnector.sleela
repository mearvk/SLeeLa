#sleela 1.3
// Nordshrift PostgreSQL connector semantic boundary.
class PostgreSQLConnector {
 String provider;
 String status;
 function initialize(){provider="postgresql";status="unresolved";}
 function resolve(){status="resolved";return status;}
 function connect(){status="connected";return status;}
 function disconnect(){status="disconnected";return status;}
 function install(){status="install-planned";return status;}
}
