  < ---- java.util.concurrent.atomic.AtomicLong members (procedural implementation in SLeeLa) ---- >
  << A long value updated atomically: every read-modify-write runs under VM
     lock 31 (reserved for java.util.concurrent.atomic), so updates from
     spawned threads never interleave. The plain / opaque / acquire / release
     access modes are all sequentially consistent here, which satisfies each
     of their Java contracts. compareAndSet compares with == (value equality
     for numbers, identity for objects). The functional update methods wait
     for lambda dispatch. >>
  long value;
  AtomicLong(long initialValue) { this.value = initialValue; }

  long get() { return this.value; }
  void set(long newValue) { lock(31); this.value = newValue; unlock(31); }
  void lazySet(long newValue) { set(newValue); }
  long getPlain() { return this.value; }
  void setPlain(long newValue) { this.value = newValue; }
  long getOpaque() { return get(); }
  void setOpaque(long newValue) { set(newValue); }
  long getAcquire() { return get(); }
  void setRelease(long newValue) { set(newValue); }
  long getAndSet(long newValue) {
    lock(31);
    long old = this.value;
    this.value = newValue;
    unlock(31);
    return old;
  }
  boolean compareAndSet(long expectedValue, long newValue) {
    lock(31);
    boolean hit = this.value == expectedValue;
    if (hit) { this.value = newValue; }
    unlock(31);
    return hit;
  }
  boolean weakCompareAndSet(long expectedValue, long newValue) { return compareAndSet(expectedValue, newValue); }
  boolean weakCompareAndSetPlain(long expectedValue, long newValue) { return compareAndSet(expectedValue, newValue); }
  boolean weakCompareAndSetVolatile(long expectedValue, long newValue) { return compareAndSet(expectedValue, newValue); }
  boolean weakCompareAndSetAcquire(long expectedValue, long newValue) { return compareAndSet(expectedValue, newValue); }
  boolean weakCompareAndSetRelease(long expectedValue, long newValue) { return compareAndSet(expectedValue, newValue); }
  long compareAndExchange(long expectedValue, long newValue) {
    lock(31);
    long witness = this.value;
    if (witness == expectedValue) { this.value = newValue; }
    unlock(31);
    return witness;
  }
  long compareAndExchangeAcquire(long expectedValue, long newValue) { return compareAndExchange(expectedValue, newValue); }
  long compareAndExchangeRelease(long expectedValue, long newValue) { return compareAndExchange(expectedValue, newValue); }

  long getAndIncrement() { return getAndAdd(1); }
  long getAndDecrement() { return getAndAdd(-1); }
  long getAndAdd(long delta) {
    lock(31);
    long old = this.value;
    this.value = old + delta;
    unlock(31);
    return old;
  }
  long incrementAndGet() { return addAndGet(1); }
  long decrementAndGet() { return addAndGet(-1); }
  long addAndGet(long delta) {
    lock(31);
    this.value = this.value + delta;
    long now = this.value;
    unlock(31);
    return now;
  }
