  << A quadratic objective f(x) = a x^2 + b x + c with its gradient and the exact
     minimizer (when a > 0). >>
  double a;
  double b;
  double c;
  void set(double pa, double pb, double pc) { a = pa; b = pb; c = pc; }
  double value(double x) { return a * x * x + b * x + c; }
  double gradient(double x) { return 2.0 * a * x + b; }
  double minimizer() { if (a == 0.0) { return 0.0; } return 0.0 - b / (2.0 * a); }
}

