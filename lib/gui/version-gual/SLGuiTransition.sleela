<< lib/gui/version-gual/SLGuiTransition.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLGuiTransition — the FADING-ACTION model (an "enter" /
     "exit" transition, a.k.a. intro/outro animation). It is a pure model: given
     a start and end opacity (the CSS `opacity` property, 0..100 %), a duration
     (the tween window), an easing curve, and an optional start delay, it tweens
     ("in-betweens") the current opacity for a given elapsed time. SLeeLa owns
     the curve + timing; the host realizes it with a CSS `transition` /
     `@keyframes` (or a toolkit animator) using the descriptor from toStyle().
   
     Terms (documentation labels): the component that fades is a Toast/Snackbar,
     Modal/Overlay, Transition-wrapper, or Skeleton; the ACTION here is the enter
     transition / tween / dissolve; the CSS surface is opacity + transition +
     @keyframes. This class is the reusable fade primitive the GUI components
     (SLGuiToast / SLGuiModal / SLGuiSkeleton) embed.
   
   Family: gui. A pure tween model (ints only); the host paints the pixels. >>
#sleela 2.5
material;
class SLGuiTransition {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 11405;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-10-19";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-19";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  < Direction of the transition. >
  < fade/scale IN  (opacity rises to target) >
  static final int KIND_ENTER = 0;
  < fade/scale OUT (opacity falls to target) >
  static final int KIND_EXIT  = 1;

  < Easing curves (how the tween accelerates). Mirrors the common CSS set plus >
  < a film/game "dissolve" (a smooth cross-fade feel == ease-in-out here). >
  < constant rate >
  static final int EASE_LINEAR      = 0;
  < starts slow, speeds up >
  static final int EASE_IN          = 1;
  < starts fast, slows down >
  static final int EASE_OUT         = 2;
  < slow, fast, slow >
  static final int EASE_IN_OUT      = 3;
  < seamless cross-fade (== in-out feel) >
  static final int EASE_DISSOLVE    = 4;

  < Opacity is carried in PERCENT (0..100); progress in PERMILLE (0..1000) so >
  < the model stays integer-only (SLeeLa ints). Callers divide by 100.0 / 1000.0 >
  < when they need the [0,1] double a toolkit wants. >
  static final int PCT  = 100;
  static final int UNIT = 1000;

  < KIND_ENTER / KIND_EXIT >
  int kind;
  < EASE_* >
  int easing;
  < start opacity, 0..100 >
  int fromPct;
  < end opacity, 0..100 >
  int toPct;
  < tween duration, 0..60000 ms >
  int durationMs;
  < start delay before the tween begins, 0..60000 ms >
  int delayMs;
  < time advanced so far (clamped to delay+duration) >
  int elapsedMs;

  int clamp(int v, int lo, int hi) {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
  }

  < Safe defaults: a 200 ms ease-out fade-in from fully transparent to opaque. >
  void configure() {
    kind = KIND_ENTER;
    easing = EASE_OUT;
    fromPct = 0; toPct = 100;
    durationMs = 200; delayMs = 0; elapsedMs = 0;
  }

  < Configure a fade-IN (enter): 0 -> 100 % over `ms` with `ease`. >
  void fadeIn(int ms, int ease) {
    kind = KIND_ENTER;
    fromPct = 0; toPct = 100;
    durationMs = clamp(ms, 0, 60000);
    setEasing(ease);
    delayMs = 0; elapsedMs = 0;
  }
  < Configure a fade-OUT (exit): 100 -> 0 % over `ms` with `ease`. >
  void fadeOut(int ms, int ease) {
    kind = KIND_EXIT;
    fromPct = 100; toPct = 0;
    durationMs = clamp(ms, 0, 60000);
    setEasing(ease);
    delayMs = 0; elapsedMs = 0;
  }
  < A general enter/exit between arbitrary opacities. >
  void between(int kindVal, int fromOpacityPct, int toOpacityPct, int ms, int ease) {
    kind = (kindVal == KIND_EXIT) ? KIND_EXIT : KIND_ENTER;
    fromPct = clamp(fromOpacityPct, 0, 100);
    toPct = clamp(toOpacityPct, 0, 100);
    durationMs = clamp(ms, 0, 60000);
    setEasing(ease);
    delayMs = 0; elapsedMs = 0;
  }

  void setEasing(int ease) {
    if (ease >= EASE_LINEAR && ease <= EASE_DISSOLVE) { easing = ease; }
  }
  void setDelay(int ms) { delayMs = clamp(ms, 0, 60000); }
  void setDuration(int ms) { durationMs = clamp(ms, 0, 60000); }

  < ---- playback ----------------------------------------------------------- >
  void reset() { elapsedMs = 0; }
  < Advance the tween by `deltaMs`; clamps to the delay+duration window. >
  void advance(int deltaMs) {
    if (deltaMs < 0) { deltaMs = 0; }
    elapsedMs = clamp(elapsedMs + deltaMs, 0, delayMs + durationMs);
  }
  < The tween is finished once the whole delay+duration window has elapsed. >
  boolean done() { return elapsedMs >= delayMs + durationMs; }

  < Linear progress through the active (post-delay) window, in permille 0..1000. >
  int rawProgressPermille() {
    if (durationMs <= 0) { return UNIT; }
    int active = elapsedMs - delayMs;
    if (active <= 0) { return 0; }
    if (active >= durationMs) { return UNIT; }
    return clamp((active * UNIT) / durationMs, 0, UNIT);
  }

  < Apply the easing curve to a linear permille progress. Integer-only: >
  < ease-in  : p^2                 (slow start) >
  < ease-out : 1-(1-p)^2           (slow end) >
  < in-out   : piecewise quadratic (slow start & end) >
  < dissolve : == in-out (seamless cross-fade feel) >
  int easeProgress(int p) {
    if (easing == EASE_LINEAR) { return p; }
    if (easing == EASE_IN) {
      < p^2 >
      return (p * p) / UNIT;
    }
    if (easing == EASE_OUT) {
      int inv = UNIT - p;
      < 1-(1-p)^2 >
      return UNIT - (inv * inv) / UNIT;
    }
    < EASE_IN_OUT / EASE_DISSOLVE: symmetric quadratic ease. >
    if (p < UNIT / 2) {
      < 2p^2 >
      return (2 * p * p) / UNIT;
    }
    int inv = UNIT - p;
    < 1-2(1-p)^2 >
    return UNIT - (2 * inv * inv) / UNIT;
  }

  < The eased progress (permille) at the current elapsed time. >
  int progressPermille() { return easeProgress(rawProgressPermille()); }

  < The current tweened opacity in PERCENT (0..100), interpolating from->to by >
  < the eased progress. This is the value the host writes to CSS `opacity`. >
  int opacityPct() {
    int p = progressPermille();
    < may be negative (exit) >
    int span = toPct - fromPct;
    return clamp(fromPct + (span * p) / UNIT, 0, 100);
  }
  < Convenience: the opacity at an explicit elapsed time (does not mutate state). >
  int opacityAt(int atElapsedMs) {
    int save = elapsedMs;
    elapsedMs = clamp(atElapsedMs, 0, delayMs + durationMs);
    int o = opacityPct();
    elapsedMs = save;
    return o;
  }

  < ---- readers ------------------------------------------------------------ >
  int getKind() { return kind; }
  int getEasing() { return easing; }
  int getFrom() { return fromPct; }
  int getTo() { return toPct; }
  int getDuration() { return durationMs; }
  int getDelay() { return delayMs; }
  int getElapsed() { return elapsedMs; }

  String kindName() { return (kind == KIND_EXIT) ? "exit" : "enter"; }
  String easingName() {
    if (easing == EASE_IN)       { return "ease-in"; }
    if (easing == EASE_OUT)      { return "ease-out"; }
    if (easing == EASE_IN_OUT)   { return "ease-in-out"; }
    if (easing == EASE_DISSOLVE) { return "dissolve"; }
    return "linear";
  }

  < Internally consistent: opacities and timings within their clamped windows. >
  boolean honored() {
    if (fromPct < 0 || fromPct > 100 || toPct < 0 || toPct > 100) { return false; }
    if (durationMs < 0 || durationMs > 60000) { return false; }
    if (delayMs < 0 || delayMs > 60000) { return false; }
    int o = opacityPct();
    return o >= 0 && o <= 100;
  }

  < Flatten into the descriptor the SLGuiMount reconciler copies onto the widget >
  < style; the host maps it to a CSS `transition` + `@keyframes` (or a toolkit >
  < animator). Shape: "fade:<from>-><to>/<ms>ms/<easing>[+delay<ms>]". >
  String toStyle() {
    String s = "fade:" + fromPct + "->" + toPct + "/" + durationMs + "ms/" + easingName();
    if (delayMs > 0) { s = s + "+delay" + delayMs; }
    return s;
  }

  String report() {
    return kindName() + " transition: opacity " + fromPct + "%->" + toPct + "% over "
        + durationMs + "ms (" + easingName() + ")"
        + (delayMs > 0 ? (" after " + delayMs + "ms delay") : "")
        + " now=" + opacityPct() + "% progress=" + progressPermille() + "/1000"
        + " done=" + done();
  }
}
