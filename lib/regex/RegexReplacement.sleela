/*
 * lib/regex/RegexReplacement.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexReplacement used within the regex library family.
 */
#sleela 1.3
class RegexReplacement {
  string source;
  string replacement;
  void setSource(string value){source=value;}
  void setReplacement(string value){replacement=value;}
  string getReplacement(){return replacement;}
}
