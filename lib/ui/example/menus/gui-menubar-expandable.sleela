<<
  SLeeLa GUI Menu Showcase
  Demonstrates a horizontal menu bar, dropdown menus, and expandable/collapsible
  nested menu groups using the native SleelaUI ui* bridge.
  Run from repository root: ./impl/build/sleela run example/menus/gui-menubar-expandable.sleela
>>
#sleela 2.5
material;
class GuiMenubarExpandable {
  int PAD = 10;
  int GAP = 6;
  int VERTICAL = 0;
  int HORIZONTAL = 1;

  int statusLabel;
  int openMenuIndex = -1;
  boolean recentOpen = false;
  boolean panelsOpen = false;

  int fileButton;
  int editButton;
  int viewButton;
  int helpButton;

  int filePanel;
  int editPanel;
  int viewPanel;
  int helpPanel;

  int recentToggle;
  int recentPanel;
  int recentOne;
  int recentTwo;
  int recentThree;

  int panelsToggle;
  int panelsPanel;
  int panelEditor;
  int panelInspector;

  int fileNew;
  int fileSave;
  int editUndo;
  int editSelectAll;
  int viewZoomIn;
  int viewZoomOut;
  int helpAbout;

  void setStatus(String message) {
    uiWidgetSetText(statusLabel, message);
  }

  // Exactly one top-level dropdown is open at a time. Clicking its heading
  // again collapses it; choosing another heading switches directly to it.
  void openMenu(int which) {
    int next = openMenuIndex == which ? -1 : which;
    openMenuIndex = next;
    uiWidgetVisible(filePanel, next == 0 ? 1 : 0);
    uiWidgetVisible(editPanel, next == 1 ? 1 : 0);
    uiWidgetVisible(viewPanel, next == 2 ? 1 : 0);
    uiWidgetVisible(helpPanel, next == 3 ? 1 : 0);
    if (next != 0) {
      recentOpen = false;
      uiWidgetVisible(recentPanel, 0);
      uiWidgetSetText(recentToggle, "Recent Files  >");
    }
    if (next != 2) {
      panelsOpen = false;
      uiWidgetVisible(panelsPanel, 0);
      uiWidgetSetText(panelsToggle, "Panels  >");
    }
  }

  void toggleRecentFiles() {
    recentOpen = !recentOpen;
    uiWidgetVisible(recentPanel, recentOpen ? 1 : 0);
    uiWidgetSetText(recentToggle, recentOpen ? "Recent Files  v" : "Recent Files  >");
  }

  void togglePanels() {
    panelsOpen = !panelsOpen;
    uiWidgetVisible(panelsPanel, panelsOpen ? 1 : 0);
    uiWidgetSetText(panelsToggle, panelsOpen ? "Panels  v" : "Panels  >");
  }

  void closeMenus() {
    openMenuIndex = -1;
    recentOpen = false;
    panelsOpen = false;
    uiWidgetVisible(filePanel, 0);
    uiWidgetVisible(editPanel, 0);
    uiWidgetVisible(viewPanel, 0);
    uiWidgetVisible(helpPanel, 0);
    uiWidgetVisible(recentPanel, 0);
    uiWidgetVisible(panelsPanel, 0);
    uiWidgetSetText(recentToggle, "Recent Files  >");
    uiWidgetSetText(panelsToggle, "Panels  >");
  }

  void main() {
    print("SLeeLa Menu Showcase — expandable and collapsible menus");
    int app = uiAppCreate("com.mearvk.SLeeLa.MenuShowcase");
    if (app < 0) {
      print("No display available; run this example in a desktop session.");
      return;
    }

    int theme = uiThemePreset(5);
    uiThemeSetRadius(theme, 6);
    uiThemeSetControlHeight(theme, 32);
    int screenW = uiScreenWidth(app);
    int screenH = uiScreenHeight(app);
    int winW = 820;
    int winH = 560;
    if (screenW > 0 && winW > screenW - 32) { winW = screenW - 32; }
    if (screenH > 0 && winH > screenH - 64) { winH = screenH - 64; }
    if (winW < 360) { winW = screenW; }
    if (winH < 300) { winH = screenH; }

    int win = uiWindowCreate(app, "SLeeLa — Menu Showcase", winW, winH, theme);
    int root = uiWindowRoot(win);
    uiWidgetMargin(root, PAD, PAD, PAD, PAD);

    // Single-row horizontal menubar.
    int menubar = uiBox(root, HORIZONTAL, GAP);
    uiWidgetMargin(menubar, 0, 0, 0, 0);
    fileButton = uiButton(menubar, "File  v");
    editButton = uiButton(menubar, "Edit  v");
    viewButton = uiButton(menubar, "View  v");
    helpButton = uiButton(menubar, "Help  v");

    // File dropdown, with a genuinely nested expandable Recent Files group.
    filePanel = uiBox(root, VERTICAL, GAP);
    uiWidgetMargin(filePanel, PAD, PAD, PAD, PAD);
    fileNew = uiButton(filePanel, "New Document");
    fileSave = uiButton(filePanel, "Save Document");
    recentToggle = uiButton(filePanel, "Recent Files  >");
    recentPanel = uiBox(filePanel, VERTICAL, GAP);
    uiWidgetMargin(recentPanel, 0, 18, 0, 18);
    recentOne = uiButton(recentPanel, "Welcome.sleela");
    recentTwo = uiButton(recentPanel, "MenuDemo.sleela");
    recentThree = uiButton(recentPanel, "Settings.sleela");
    uiWidgetVisible(recentPanel, 0);
    uiWidgetVisible(filePanel, 0);

    editPanel = uiBox(root, VERTICAL, GAP);
    uiWidgetMargin(editPanel, PAD, PAD, PAD, PAD);
    editUndo = uiButton(editPanel, "Undo");
    editSelectAll = uiButton(editPanel, "Select All");
    uiWidgetVisible(editPanel, 0);

    // View dropdown, with a second expandable group.
    viewPanel = uiBox(root, VERTICAL, GAP);
    uiWidgetMargin(viewPanel, PAD, PAD, PAD, PAD);
    viewZoomIn = uiButton(viewPanel, "Zoom In");
    viewZoomOut = uiButton(viewPanel, "Zoom Out");
    panelsToggle = uiButton(viewPanel, "Panels  >");
    panelsPanel = uiBox(viewPanel, VERTICAL, GAP);
    uiWidgetMargin(panelsPanel, 0, 18, 0, 18);
    panelEditor = uiButton(panelsPanel, "Editor Panel  (visible)");
    panelInspector = uiButton(panelsPanel, "Inspector Panel  (visible)");
    uiWidgetVisible(panelsPanel, 0);
    uiWidgetVisible(viewPanel, 0);

    helpPanel = uiBox(root, VERTICAL, GAP);
    uiWidgetMargin(helpPanel, PAD, PAD, PAD, PAD);
    helpAbout = uiButton(helpPanel, "About SLeeLa Menus");
    uiWidgetVisible(helpPanel, 0);

    int content = uiCard(root);
    uiWidgetExpand(content, 1, 1);
    uiWidgetMargin(content, PAD, PAD, PAD, PAD);
    int heading = uiHeading(content, "Expandable Menu Demonstration", 22);
    int description = uiLabel(content, "Choose a top-level menu. Use the > / v entries to expand or collapse nested groups.");
    statusLabel = uiLabel(content, "Ready — no menu action selected.");
    uiWidgetMargin(description, 0, 0, GAP, 0);
    uiWidgetMargin(statusLabel, GAP, 0, 0, 0);

    uiWindowShow(win);
    boolean running = true;
    while (running) {
      int dispatched = uiAppPump(app, 1);
      if (dispatched < 0) { running = false; }
      else {
        if (uiWidgetTakeActivated(fileButton) == 1) { openMenu(0); }
        if (uiWidgetTakeActivated(editButton) == 1) { openMenu(1); }
        if (uiWidgetTakeActivated(viewButton) == 1) { openMenu(2); }
        if (uiWidgetTakeActivated(helpButton) == 1) { openMenu(3); }

        if (uiWidgetTakeActivated(recentToggle) == 1) { toggleRecentFiles(); }
        if (uiWidgetTakeActivated(panelsToggle) == 1) { togglePanels(); }

        if (uiWidgetTakeActivated(fileNew) == 1) {
          setStatus("File · New Document selected");
          closeMenus();
        }
        if (uiWidgetTakeActivated(fileSave) == 1) {
          setStatus("File · Save Document selected");
          closeMenus();
        }
        if (uiWidgetTakeActivated(recentOne) == 1) {
          setStatus("Recent Files · Welcome.sleela selected");
          closeMenus();
        }
        if (uiWidgetTakeActivated(recentTwo) == 1) {
          setStatus("Recent Files · MenuDemo.sleela selected");
          closeMenus();
        }
        if (uiWidgetTakeActivated(recentThree) == 1) {
          setStatus("Recent Files · Settings.sleela selected");
          closeMenus();
        }
        if (uiWidgetTakeActivated(editUndo) == 1) {
          setStatus("Edit · Undo selected");
          closeMenus();
        }
        if (uiWidgetTakeActivated(editSelectAll) == 1) {
          setStatus("Edit · Select All selected");
          closeMenus();
        }
        if (uiWidgetTakeActivated(viewZoomIn) == 1) {
          setStatus("View · Zoom In selected");
          closeMenus();
        }
        if (uiWidgetTakeActivated(viewZoomOut) == 1) {
          setStatus("View · Zoom Out selected");
          closeMenus();
        }
        if (uiWidgetTakeActivated(panelEditor) == 1) {
          setStatus("View · Editor Panel command selected");
          closeMenus();
        }
        if (uiWidgetTakeActivated(panelInspector) == 1) {
          setStatus("View · Inspector Panel command selected");
          closeMenus();
        }
        if (uiWidgetTakeActivated(helpAbout) == 1) {
          setStatus("Help · About SLeeLa Menus");
          closeMenus();
        }
      }
    }
    uiThemeDestroy(theme);
    uiAppDestroy(app);
    print("Menu showcase closed.");
  }
}
