<< lib/cpu/examples/circuit-grades.sleela
   SLeeLa example: build, clock and grade the circuit model of every CPU in
   lib/cpu. Prints one line per CPU with its grade, score out of 10, total
   verification violations and timing violations, then the grade totals.
   See SLCircuitModel.circuitScore for how the grade is computed. >>
#sleela 2.5
import cpu;
class SLCircuitGradesExample {
  int gA;
  int gB;
  int gC;
  int gD;
  int gF;
  int failing;

  void tally(String name, String dir, String grade, int score, int violations, int timing) {
    print(grade + "  " + score + "/10  violations=" + violations + "  timing=" + timing + "  " + dir + "  " + name);
    if (grade == "A") { gA = gA + 1; }
    if (grade == "B") { gB = gB + 1; }
    if (grade == "C") { gC = gC + 1; }
    if (grade == "D") { gD = gD + 1; }
    if (grade == "F") { gF = gF + 1; }
    if (violations > 0) { failing = failing + 1; }
  }

  void main() {
    gA = 0; gB = 0; gC = 0; gD = 0; gF = 0; failing = 0;
    SL6502Circuit m0 = new SL6502Circuit(); m0.build(); m0.runCycles(16);
    tally(m0.name(), "6502", m0.circuitGrade(), m0.circuitScore(), m0.verifyAll(), m0.timingViolations());
    SL68020Circuit m1 = new SL68020Circuit(); m1.build(); m1.runCycles(16);
    tally(m1.name(), "68020", m1.circuitGrade(), m1.circuitScore(), m1.verifyAll(), m1.timingViolations());
    SL68030Circuit m2 = new SL68030Circuit(); m2.build(); m2.runCycles(16);
    tally(m2.name(), "68030", m2.circuitGrade(), m2.circuitScore(), m2.verifyAll(), m2.timingViolations());
