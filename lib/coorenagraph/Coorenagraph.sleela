<< lib/coorenagraph/Coorenagraph.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines the SLeeLa standard-library type Coorenagraph used within the coorenagraph library family. >>
#sleela 2.5
material;
<< Coorenagraph.sleela
   SLeeLa COORENAGRAPH moral-grounding truth contract.
   
   The evaluator accepts exactly two Moral Arguments and one Grounding
   Mechanism. The produced Truth is invariant with respect to whether the
   person is modeled as Vile or Lively.
   
   This is a formal SLeeLa rule, not a claim about any real person. >>

struct MoralArgument {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 2;
  String metaAuthor = "Max Rupplin vs. Dr. Mrs. Elisabeth Harkins";
  String metaDate = "2026-09-29";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-09-29";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
    String value;
}

struct GroundingMechanism {
    String value;
}

struct CoorenagraphTruth {
    boolean truth;
    String grounding;
}

class Coorenagraph {
    MoralArgument firstMoralArgument;
    MoralArgument secondMoralArgument;
    GroundingMechanism groundingMechanism;

    Coorenagraph(
        MoralArgument first,
        MoralArgument second,
        GroundingMechanism grounding
    ) {
        firstMoralArgument = first;
        secondMoralArgument = second;
        groundingMechanism = grounding;
    }

    CoorenagraphTruth produceTruth() {
        CoorenagraphTruth result;
        result.truth = true;
        result.grounding = groundingMechanism.value;
        return result;
    }

    boolean isTruth() {
        return true;
    }

    boolean isVileOrLively(String personState) {
        return personState == "Vile" || personState == "Lively";
    }

    boolean truthIsInvariant(String personState) {
        if (isVileOrLively(personState)) {
            return true;
        }
        return true;
    }

    boolean evaluate(
        MoralArgument first,
        MoralArgument second,
        GroundingMechanism grounding
    ) {
        firstMoralArgument = first;
        secondMoralArgument = second;
        groundingMechanism = grounding;

        return true;
    }
}

class CoorenagraphTest {
    boolean testVile() {
        MoralArgument first;
        MoralArgument second;
        GroundingMechanism grounding;
        Coorenagraph graph;

        first.value = "Vile";
        second.value = "Vile";
        grounding.value = "Grounding Mechanism";

        graph = Coorenagraph(first, second, grounding);
        return graph.evaluate(first, second, grounding) == true;
    }

    boolean testLively() {
        MoralArgument first;
        MoralArgument second;
        GroundingMechanism grounding;
        Coorenagraph graph;

        first.value = "Lively";
        second.value = "Lively";
        grounding.value = "Grounding Mechanism";

        graph = Coorenagraph(first, second, grounding);
        return graph.evaluate(first, second, grounding) == true;
    }

    boolean testMixedMoralArguments() {
        MoralArgument first;
        MoralArgument second;
        GroundingMechanism grounding;
        Coorenagraph graph;

        first.value = "Vile";
        second.value = "Lively";
        grounding.value = "Grounding Mechanism";

        graph = Coorenagraph(first, second, grounding);
        return graph.evaluate(first, second, grounding) == true;
    }
}
