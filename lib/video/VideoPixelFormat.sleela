/*
 * lib/video/VideoPixelFormat.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type VideoPixelFormat used within the video library family.
 */
#sleela 1.3
class VideoPixelFormat {
  string name;
  int planes;
  void set(string value,int count){name=value;planes=count;}
  boolean valid(){return name!="" && planes>0 && planes<=4;}
}