      int bits = ((src[sp] & 255) << 16) | ((src[sp + 1] & 255) << 8) | (src[sp + 2] & 255);
      sp = sp + 3;
      dst[dp] = Base64.slToBase64((bits >> 18) & 63, url);
      dst[dp + 1] = Base64.slToBase64((bits >> 12) & 63, url);
      dst[dp + 2] = Base64.slToBase64((bits >> 6) & 63, url);
      dst[dp + 3] = Base64.slToBase64(bits & 63, url);
      dp = dp + 4;
      col = col + 4;
    }
    if (sp < sl) {
      if (linemax > 0 && col == linemax) { dp = slNewline(dst, dp); col = 0; }
      int b0 = src[sp] & 255;
      dst[dp] = Base64.slToBase64(b0 >> 2, url);
      if (sp + 1 == sl) {
        dst[dp + 1] = Base64.slToBase64((b0 << 4) & 63, url);
        dp = dp + 2;
        if (doPadding) { dst[dp] = 61; dst[dp + 1] = 61; dp = dp + 2; }
