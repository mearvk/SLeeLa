    int abilityModifier(int score) {
        return (score - 10) / 2;
    }

    int strengthModifier() { return abilityModifier(STR); }
    int dexterityModifier() { return abilityModifier(DEX); }
    int constitutionModifier() { return abilityModifier(CON); }
    int intelligenceModifier() { return abilityModifier(INT); }
    int wisdomModifier() { return abilityModifier(WIS); }
    int charismaModifier() { return abilityModifier(CHA); }

    int isAlive() { return alive != 0 && health > 0; }
    int isConscious() { return isAlive() && conscious != 0 && incapacitated == 0; }

    void restoreHealth(int amount) {
        if (amount <= 0 || !isAlive()) return;
        health = health + amount;
        if (health > maxHealth) health = maxHealth;
    }

    void restoreMana(int amount) {
        if (amount <= 0) return;
        mana = mana + amount;
        if (mana > maxMana) mana = maxMana;
    }

    void restoreStamina(int amount) {
        if (amount <= 0) return;
        stamina = stamina + amount;
        if (stamina > maxStamina) stamina = maxStamina;
    }

    void applyDamage(int amount) {
        if (amount <= 0 || !isAlive()) return;
        if (shield > 0) {
            int absorbed = amount;
            if (absorbed > shield) absorbed = shield;
            shield = shield - absorbed;
            amount = amount - absorbed;
        }
        if (amount > 0) {
            health = health - amount;
            if (health <= 0) {
                health = 0;
                alive = 0;
                conscious = 0;
            }
        }
    }

    void normalizePools() {
        if (maxHealth < 0) maxHealth = 0;
        if (maxMana < 0) maxMana = 0;
        if (maxStamina < 0) maxStamina = 0;
        if (maxShield < 0) maxShield = 0;
        if (maxBarrier < 0) maxBarrier = 0;
        if (health < 0) health = 0;
        if (mana < 0) mana = 0;
        if (stamina < 0) stamina = 0;
        if (shield < 0) shield = 0;
        if (barrier < 0) barrier = 0;
        if (health > maxHealth) health = maxHealth;
        if (mana > maxMana) mana = maxMana;
        if (stamina > maxStamina) stamina = maxStamina;
        if (shield > maxShield) shield = maxShield;
        if (barrier > maxBarrier) barrier = maxBarrier;
        if (health == 0) {
            alive = 0;
            conscious = 0;
        }
    }
}
