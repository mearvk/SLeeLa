  < ---- java.util.concurrent.atomic.AtomicBoolean members (procedural implementation in SLeeLa) ---- >
  << A boolean value updated atomically: every read-modify-write runs under VM
     lock 31 (reserved for java.util.concurrent.atomic), so updates from
     spawned threads never interleave. The plain / opaque / acquire / release
     access modes are all sequentially consistent here, which satisfies each
     of their Java contracts. compareAndSet compares with == (value equality
     for numbers, identity for objects). The functional update methods wait
     for lambda dispatch. >>
  boolean value;
  AtomicBoolean(boolean initialValue) { this.value = initialValue; }

  boolean get() { return this.value; }
  void set(boolean newValue) { lock(31); this.value = newValue; unlock(31); }
  void lazySet(boolean newValue) { set(newValue); }
  boolean getPlain() { return this.value; }
  void setPlain(boolean newValue) { this.value = newValue; }
  boolean getOpaque() { return get(); }
  void setOpaque(boolean newValue) { set(newValue); }
  boolean getAcquire() { return get(); }
  void setRelease(boolean newValue) { set(newValue); }
  boolean getAndSet(boolean newValue) {
    lock(31);
    boolean old = this.value;
    this.value = newValue;
    unlock(31);
    return old;
  }
  boolean compareAndSet(boolean expectedValue, boolean newValue) {
    lock(31);
    boolean hit = this.value == expectedValue;
    if (hit) { this.value = newValue; }
    unlock(31);
    return hit;
  }
  boolean weakCompareAndSet(boolean expectedValue, boolean newValue) { return compareAndSet(expectedValue, newValue); }
  boolean weakCompareAndSetPlain(boolean expectedValue, boolean newValue) { return compareAndSet(expectedValue, newValue); }
  boolean weakCompareAndSetVolatile(boolean expectedValue, boolean newValue) { return compareAndSet(expectedValue, newValue); }
  boolean weakCompareAndSetAcquire(boolean expectedValue, boolean newValue) { return compareAndSet(expectedValue, newValue); }
  boolean weakCompareAndSetRelease(boolean expectedValue, boolean newValue) { return compareAndSet(expectedValue, newValue); }
  boolean compareAndExchange(boolean expectedValue, boolean newValue) {
    lock(31);
    boolean witness = this.value;
    if (witness == expectedValue) { this.value = newValue; }
    unlock(31);
    return witness;
  }
  boolean compareAndExchangeAcquire(boolean expectedValue, boolean newValue) { return compareAndExchange(expectedValue, newValue); }
  boolean compareAndExchangeRelease(boolean expectedValue, boolean newValue) { return compareAndExchange(expectedValue, newValue); }
  String toString() { boolean v = get(); return "" + v; }
