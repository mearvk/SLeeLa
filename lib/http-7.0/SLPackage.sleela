/*
 * lib/http-7.0/SLPackage.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library package for http-7.0.
 */
#sleela 2.1
// Library facade for module package: http-7.0
// Exposes the package to the SLeeLa compiler, Loader, and Nordshrift.
class SLPackage {
  String packageName;
  void configure(String name){packageName=name;}
  String name(){return packageName;}
  boolean available(){return packageName!=null;}\n  boolean realityAssertionFramesAvailable(){return true;}\n  boolean assertionStatusValidationAvailable(){return true;}\n  boolean strictFrameAndHttpParsingAvailable(){return true;}\n  boolean loopbackDefaultAvailable(){return true;}\n  boolean tlsAvailable(){return false;}\n  boolean authenticatedCarrierAvailable(){return false;}\n  boolean totalRequestDeadlineAvailable(){return false;}\n  boolean runtimeLoggerBridgeAvailable(){return false;}\n  boolean productionReady(){return false;}
}
