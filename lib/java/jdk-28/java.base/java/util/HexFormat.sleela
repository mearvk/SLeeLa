  public static boolean isHexDigit(int ch) {
    return (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 70) || (ch >= 97 && ch <= 102);
  }
  public static int fromHexDigit(int ch) {
    if (ch >= 48 && ch <= 57) { return ch - 48; }
    if (ch >= 65 && ch <= 70) { return ch - 55; }
    if (ch >= 97 && ch <= 102) { return ch - 87; }
    if (ch > 0 && ch <= 65535 && (ch < 55296 || ch > 57343)) { throw new NumberFormatException("not a hexadecimal digit: \"" + JavaText.charString(ch) + "\" = " + ch); }
    throw new NumberFormatException("not a hexadecimal digit: code " + ch);
  }


