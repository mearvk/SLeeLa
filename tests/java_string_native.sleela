#sleela 3.0
class JavaStringNativeSmoke {
  static void main() {
    JavaStringValue factory = new JavaStringValue();
    JavaStringValue hello = factory.bind(0, "Hello");
    JavaStringValue world = factory.bind(0, " World");
    JavaStringValue combined = hello.concat(world);
    print("JAVA-STRING-VM=PASS");
    print(combined.length());
    print(combined.charAt(1));
    print(combined.codePointAt(6));
    JavaStringValue prefix = combined.substring(0, 5);
    print(prefix.length());
    print(prefix.equals(hello));
    print(combined.compareTo(combined));
    print(combined.hashCode());
    print(hello.isEmpty());
    print(hello.supportsUtf16Indexing());
    print(hello.supportsCodePointIteration());
    print(hello.supportsJavaHashCode());

    JavaStringValue exact = factory.fromUtf16(
      javaStringFromCodeUnits(0x0041, 0x0000, 0xD800));
    print(exact.length());
    print(exact.charAt(1));
    print(exact.charAt(2));
  }
}
