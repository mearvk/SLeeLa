#sleela 1.3
// SST PostgreSQL connector contract. Installation is intentionally deferred.
class PostgreSQLConnector {
 String host;
 int port;
 String database;
 String user;
 String status;
 function initialize(){port=5432;status="configured";}
 function configure(){status="configured";return status;}
 function connect(){status="connected";return status;}
 function disconnect(){status="disconnected";return status;}
 function install(){status="install-planned";return status;}
}
