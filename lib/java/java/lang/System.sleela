  public static java.lang.String getenv(java.lang.String name) {
    if (name == null) { throw new NullPointerException(); }
    String v = osGetEnv(name);
    if (v == "") { return null; }
    return v;
  }
  public static java.lang.String getProperty(java.lang.String key) {
    if (key == null) { throw new NullPointerException("key can't be null"); }
    if (key == "") { throw new IllegalArgumentException("key can't be empty"); }
    int i = 0;
    while (i < propCount) {
      if (propKeys[i] == key) { return propVals[i]; }
      i = i + 1;
    }
    if (key == "os.name") { return osPlatform(); }
    if (key == "user.name") { return osUserName(); }
    if (key == "user.dir") { return osCurrentDir(); }
    if (key == "java.io.tmpdir") { return osTempDir(); }
    if (key == "file.separator") { return "/"; }
    if (key == "path.separator") { return ":"; }
    if (key == "line.separator") { return lineSeparator(); }
    return null;
  }
  public static java.lang.String getProperty(java.lang.String key, java.lang.String def) {
    String v = getProperty(key);
    if (v == null) { return def; }
    return v;
  }
  public static java.lang.String setProperty(java.lang.String key, java.lang.String value) {
    if (key == null) { throw new NullPointerException("key can't be null"); }
    if (key == "") { throw new IllegalArgumentException("key can't be empty"); }
    String old = getProperty(key);
    int i = 0;
    while (i < propCount) {
      if (propKeys[i] == key) { propVals[i] = value; return old; }
      i = i + 1;
    }
    if (propCount >= 64) { throw new IllegalStateException("System property table is full"); }
    propKeys[propCount] = key;
    propVals[propCount] = value;
    propCount = propCount + 1;
    return old;
  }
  public static java.lang.String clearProperty(java.lang.String key) {
    if (key == null) { throw new NullPointerException("key can't be null"); }
    if (key == "") { throw new IllegalArgumentException("key can't be empty"); }
    String old = getProperty(key);
    int i = 0;
    while (i < propCount) {
      if (propKeys[i] == key) {
        propCount = propCount - 1;
        propKeys[i] = propKeys[propCount];
        propVals[i] = propVals[propCount];
        propKeys[propCount] = null;
        propVals[propCount] = null;
        return old;
      }
      i = i + 1;
    }
    return old;
  }
