  double pi() { return 3.141592653589793; }
  double radians;
  void setRadians(double r) { radians = r; }
  void setDegrees(double d) { radians = d * pi() / 180.0; }
  double getRadians() { return radians; }
  double getDegrees() { return radians * 180.0 / pi(); }
  < Normalize to the half-open interval from 0 up to two pi. >
  double normalized() {
    double twoPi = 6.283185307179586;
    double a = radians;
    while (a < 0.0) { a = a + twoPi; }
    while (a >= twoPi) { a = a - twoPi; }
    return a;
  }
}

