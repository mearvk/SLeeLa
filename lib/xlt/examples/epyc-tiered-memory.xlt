#xlt 1.0
// An EPYC model with TIERED memory: DDR2 for usual activities and DDR5 for
// competency/accuracy-critical work. Functions marked `usualmem` run against
// the usual tier, `accuratemem` against the accurate tier; everything else
// (including the main program) inherits the declared main tier — DDR5 here.
//
// This is the XLT counterpart of a program whose functions are annotated with
// the Sleela memory-tier modifiers:
//   usualmem    void logActivity()   { ... }   // DDR2 tier
//   accuratemem int settleLedger()   { ... }   // DDR5 tier
model EpycTieredMemory {
  cpu       "SLAMDEPYC9575F";
  memory    "ddr5_6400" 65536;        // the base module the build assembles on
  storage   "nvmeGen4";
  bus       "pcieGen5x16";
  memtier   "ddr2_800" usual;          // usual activities -> DDR2
  memtier   "ddr5_6400" accurate;      // competency/accuracy -> DDR5
  maintier  "accurate";                // the main program runs on the DDR5 tier
  target    sleela;
}
