/*
 * lib/io/SLConsole.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLConsole used within the io library family.
 */
#sleela 1.3
// Unified SLeeLa standard-library front-end object.
// Family: io. Native VM/OS work crosses an explicit bridge.
class SLConsole {
  int state; int units; void open(){state=1;} void close(){state=0;} void transfer(int n){units=units+n;} boolean isOpen(){return state==1;}
}
