/*
 * lib/crypto/SLCryptoBlockTwo.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLCryptoBlockTwo, the
 *   second ordered step of the main cryptography series.
 *
 * Rationale: Mirrors pass two() of the reference AES2 module — the initial
 *   padding field of symmetry rows permuted at base-18, base-13, and base-6 at
 *   fixed row positions (2nd, 7th, 6th).
 *
 * Order and Orientation:
 *   - Order:       2.
 *   - Orientation: ORIENT_INTERMIX (weaves fixed row positions).
 *   - Respect:     high, below the init pad but above the lightning rounds.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLCryptoBlockTwo extends SLCryptoBlock {
  static final int STEP_ORDER = 2;

  // The three (base, mask, row) permutation points of the reference pass two.
  static final int BASE_ROW2 = 18;  static final int MASK_ROW2 = 0x166F2;    // 2nd row
  static final int BASE_ROW7 = 13;  static final int MASK_ROW7 = 0x0134431;  // 7th row
  static final int BASE_ROW6 = 6;   static final int MASK_ROW6 = 0x45344321; // 6th row

  void prepare() {
    // The dominant orientation of this step is intermix; base-18 is the leading
    // conversion. The row-level bases/masks are applied natively in order.
    configure(STEP_ORDER, ORIENT_INTERMIX, 200, BASE_ROW2, MASK_ROW2,
              "Order02.Intermix.SymmetryRows.Respected");
    enable();
  }

  String advance(String running, SLRadixTable radices) {
    if (!active()) { return running; }
    return native sleela_crypto_block_two_rows(
        running,
        BASE_ROW2, MASK_ROW2,
        BASE_ROW7, MASK_ROW7,
        BASE_ROW6, MASK_ROW6);
  }
}
