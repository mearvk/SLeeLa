<< lib/gui/version-thual/SLPackage.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines the SLeeLa standard-library package for gui — the thual
     line (version 3.0). It builds on the gual (2.0) settings surface and adds a
     clean, professional visual-effects layer: lighting/glow/3D shine, shadow,
     metal look-and-feel, component rotation (incl. scheduled "schene" rotation),
     fade in/out, activation audio, and logo branding. >>
#sleela 2.5
material;
< Library facade for module package: gui >
< Exposes the package to the SLeeLa compiler, Loader, and Nordshrift. >
< This package is the SLeeLa-facing *consequence* of the top-level gui/ work >
< (the Java host, the native C ABI bridge gui/native/sleela_gui_bridge.*, and >
< the 1..14 document-change listener). The Master Classes (SLGuiBackend, >
< SLGuiWindow, SLGuiAction, SLGuiRuntime, SLGuiHost, SLGuiDocument, >
< SLGuiDocumentListener, SLGuiBridge, SLGuiIntegration) are first-class >
< one-class-per-file source units; this facade only names the package itself, >
< mirroring lib/citizen/SLPackage.sleela. >
class SLPackage {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 11275;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-10-16";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-16";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  < Version identity: this is the thual line — the 3.0 GUI package. mual is the >
  < 1.0 baseline, gual the 2.0 settings-first line; thual (3.0) adds the clean, >
  < professional visual-effects surface (lighting/glow/3D shine, rotation + >
  < scheduled "schene" rotation, fade in/out, activation audio, shadow, metal >
  < look-and-feel, logo branding). featureLevel() lets callers branch. >
  < 3 = thual/3.0 ; 2 = gual/2.0 ; 1 = mual/1.0 >
  static final int FEATURE_LEVEL = 3;
  String packageName;
  String packageVersion;
  void configure(String name) { packageName = name; packageVersion = "3.0"; }
  String name() { return packageName; }
  String version() { return packageVersion; }
  int featureLevel() { return FEATURE_LEVEL; }
  boolean isTwoPointZero() { return FEATURE_LEVEL >= 2; }
  boolean isThreePointZero() { return FEATURE_LEVEL >= 3; }
  boolean available() { return packageName != null; }
}
