<< lib/cpu/SLTimedGate.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLTimedGate, an SLGate that takes time. It wraps one
     Boolean SLGate and adds what a real gate has: a rising-output delay, a
     falling-output delay, an output voltage taken from its SLLogicFamily, a
     fanout load that slows it, and inertial behaviour. An input pulse shorter
     than the gate delay never reaches the output and is counted as a swallowed
     glitch, which is how a real gate filters a runt pulse.

   Time is supplied by the caller in picoseconds. eval(a, b, tPs) reports the
   output as it stands at time tPs, after any pending transition has matured.

   Family: cpu. Pure Sleela timing logic over SLGate. >>
#sleela 2.5
material;
class SLTimedGate {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 39536;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-21";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-21";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 7;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  SLGate gate;
  SLLogicFamily family;
  < rising and falling output delay in picoseconds, before fanout loading >
  int delayLhPs;
  int delayHlPs;
  < number of gate inputs this output currently drives >
  int load;
  < output value after all matured transitions >
  int committed;
  < transition waiting to mature, valid only when pendingAtPs is not negative >
  int pendingVal;
  int pendingAtPs;
  int transitions;
  int glitches;
  int overloads;

  < Kinds follow SLGate: 0 AND, 1 OR, 2 NOT, 3 NAND, 4 NOR, 5 XOR, 6 XNOR, 7 BUF. >
  void configure(int gateKind, SLLogicFamily fam) {
    gate = new SLGate(); gate.configure(gateKind);
    family = fam;
    delayLhPs = fam.delayPs(); delayHlPs = fam.delayPs();
    load = 1; committed = 0; pendingVal = 0; pendingAtPs = -1;
    transitions = 0; glitches = 0; overloads = 0;
  }

  < Real gates are rarely symmetric. Set the two delays separately. >
  void setDelays(int lhPs, int hlPs) {
    if (lhPs >= 0) { delayLhPs = lhPs; }
    if (hlPs >= 0) { delayHlPs = hlPs; }
  }

  void setLoad(int fanoutLoad) { if (fanoutLoad >= 0) { load = fanoutLoad; } }

  < Fanout loading: each input beyond one adds half a base delay divided by the >
  < family fanout limit. This is a derived linear model, not a measurement. >
  int loaded(int baseDelayPs) {
    int extra = 0;
    if (load > 1) { extra = (baseDelayPs * (load - 1)) / (2 * family.fanout()); }
    return baseDelayPs + extra;
  }

  boolean fanoutOk() { return load <= family.fanout(); }

  < Let a pending transition mature if its time has come. >
  void advance(int tPs) {
    if (pendingAtPs >= 0 && tPs >= pendingAtPs) {
      committed = pendingVal; pendingAtPs = -1; transitions = transitions + 1;
    }
  }

  < Present inputs at time tPs and read the output as it stands at tPs. >
  int eval(int a, int b, int tPs) {
    advance(tPs);
    if (!fanoutOk()) { overloads = overloads + 1; }
    int want = gate.eval(a, b);
    if (pendingAtPs >= 0) {
      if (want == committed) { pendingAtPs = -1; glitches = glitches + 1; }
    } else {
      if (want != committed) {
        pendingVal = want;
        if (want == 1) { pendingAtPs = tPs + loaded(delayLhPs); }
        else { pendingAtPs = tPs + loaded(delayHlPs); }
      }
    }
    return committed;
  }

  < The time at which the output will next be stable, or tPs when already stable. >
  int settleAtPs(int tPs) {
    if (pendingAtPs >= 0) { return pendingAtPs; }
    return tPs;
  }

  < Output voltage, worst case, from the family levels. >
  int outputMv() {
    if (committed == 1) { return family.vohMv; }
    return family.volMv;
  }

  int output() { return committed; }
  int transitionCount() { return transitions; }
  int glitchCount() { return glitches; }
  int overloadCount() { return overloads; }
  boolean clean() { return overloads == 0; }
}
