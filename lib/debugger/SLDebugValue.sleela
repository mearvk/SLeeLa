/*
 * lib/debugger/SLDebugValue.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLDebugValue used within the debugger library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: debugger. Native implementation crosses an explicit VM/OS bridge.
class SLDebugValue {
  String target; int state; int count; void attach(String t){target=t;state=1;} void detach(){state=0;} void mark(){count=count+1;} boolean attached(){return state==1;}
}
