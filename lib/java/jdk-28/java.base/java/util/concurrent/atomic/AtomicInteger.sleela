  << A int value updated atomically: every read-modify-write runs under VM
     lock 31 (reserved for java.util.concurrent.atomic), so updates from
     spawned threads never interleave. The plain / opaque / acquire / release
     access modes are all sequentially consistent here, which satisfies each
     of their Java contracts. compareAndSet compares with == (value equality
     for numbers, identity for objects). The functional update methods wait
     for lambda dispatch. >>
  int value;
  AtomicInteger(int initialValue) { this.value = initialValue; }

  int get() { return this.value; }
  void set(int newValue) { lock(31); this.value = newValue; unlock(31); }
  void lazySet(int newValue) { set(newValue); }
  int getPlain() { return this.value; }
  void setPlain(int newValue) { this.value = newValue; }
  int getOpaque() { return get(); }
  void setOpaque(int newValue) { set(newValue); }
  int getAcquire() { return get(); }
  void setRelease(int newValue) { set(newValue); }
  int getAndSet(int newValue) {
    lock(31);
    int old = this.value;
    this.value = newValue;
    unlock(31);
    return old;
  }
  boolean compareAndSet(int expectedValue, int newValue) {
    lock(31);
    boolean hit = this.value == expectedValue;
    if (hit) { this.value = newValue; }
    unlock(31);
    return hit;
  }
  boolean weakCompareAndSet(int expectedValue, int newValue) { return compareAndSet(expectedValue, newValue); }
  boolean weakCompareAndSetPlain(int expectedValue, int newValue) { return compareAndSet(expectedValue, newValue); }
  boolean weakCompareAndSetVolatile(int expectedValue, int newValue) { return compareAndSet(expectedValue, newValue); }
  boolean weakCompareAndSetAcquire(int expectedValue, int newValue) { return compareAndSet(expectedValue, newValue); }
  boolean weakCompareAndSetRelease(int expectedValue, int newValue) { return compareAndSet(expectedValue, newValue); }
  int compareAndExchange(int expectedValue, int newValue) {
    lock(31);
    int witness = this.value;
    if (witness == expectedValue) { this.value = newValue; }
    unlock(31);
    return witness;
  }
  int compareAndExchangeAcquire(int expectedValue, int newValue) { return compareAndExchange(expectedValue, newValue); }
  int compareAndExchangeRelease(int expectedValue, int newValue) { return compareAndExchange(expectedValue, newValue); }

  int getAndIncrement() { return getAndAdd(1); }
  int getAndDecrement() { return getAndAdd(-1); }
  int getAndAdd(int delta) {
    lock(31);
    int old = this.value;
    this.value = wrap32(old + delta);
    unlock(31);
    return old;
