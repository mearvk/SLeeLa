/*
 * lib/character/SubscriptionModel.sleela
 * SLeeLa Standard Library Definition.
 * Definition: SubscriptionModel — recurring revenue from subscribers who each
 *   pay the same price every month and leave at a steady churn rate. The
 *   classic "predictable until it isn't" business.
 *
 * A concrete BusinessModel: subclass, declare identity in setUp(), and override
 * the revenue/cost hooks. Revenue is subscribers x price, minus the ones who
 * quietly cancelled this month. Family: character.
 */
#sleela 1.3
class SubscriptionModel extends BusinessModel {

  int subscribers;        // paying seats right now
  int priceCents;         // monthly price per subscriber
  int churnPercent;       // share who cancel each month (0..100)
  int serviceCostCents;   // cost to serve one subscriber per month

  void setUp(int seats, int price, int churn, int serviceCost) {
    load();
    configure("Subscription", KIND_SUBSCRIPTION);
    if (seats < 0) { seats = 0; }
    if (price < 0) { price = 0; }
    if (churn < 0) { churn = 0; }
    if (churn > 100) { churn = 100; }
    if (serviceCost < 0) { serviceCost = 0; }
    subscribers = seats;
    priceCents = price;
    churnPercent = churn;
    serviceCostCents = serviceCost;
    setUnits(seats);
  }

  // Subscribers who are still around after this month's churn pay full price.
  int retained() { return subscribers - (subscribers * churnPercent) / 100; }

  int monthlyRevenue() { return retained() * priceCents; }
  int monthlyCost() { return subscribers * serviceCostCents; }
}
