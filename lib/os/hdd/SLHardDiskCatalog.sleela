<< lib/os/hdd/SLHardDiskCatalog.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLHardDiskCatalog — a by-name factory for rotational hard
     disks from the surviving HDD manufacturers. The spinning-disk market has
     consolidated to a finite set — Seagate, Western Digital, and Toshiba — so a
     machine description can request bulk storage by maker and model name and
     get a representative, correctly-specified SLHardDisk back.
   
   Representative family names (Seagate IronWolf/Exos, WD Red/Gold, Toshiba
   MG/N300) stand in for identity; exact capacity/RPM bins vary by SKU.
   
   Family: os. Produces SLHardDisk. >>
#sleela 2.5
material;
class SLHardDiskCatalog {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10895;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-10-16";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-10";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  void configure() {}

  < A 7200 RPM SATA desktop/NAS drive from a named manufacturer. >
  SLHardDisk sata7200(String manufacturer, int capacityGb) {
    SLHardDisk d = new SLHardDisk();
    d.configure(manufacturer, desktopPart(manufacturer), d.IF_SATA3, 7200, capacityGb);
    return d;
  }
  < A 7200 RPM SAS enterprise drive from a named manufacturer. >
  SLHardDisk enterprise(String manufacturer, int capacityGb) {
    SLHardDisk d = new SLHardDisk();
    d.configure(manufacturer, enterprisePart(manufacturer), d.IF_SAS, 7200, capacityGb);
    return d;
  }
  < A high-RPM (10k/15k) SAS performance drive. >
  SLHardDisk performance(String manufacturer, int rpm, int capacityGb) {
    SLHardDisk d = new SLHardDisk();
    d.configure(manufacturer, enterprisePart(manufacturer), d.IF_SAS, rpm, capacityGb);
    return d;
  }

  boolean known(String manufacturer) {
    return manufacturer == "Seagate" || manufacturer == "Western Digital"
        || manufacturer == "Toshiba";
  }

  String desktopPart(String mfr) {
    if (mfr == "Seagate")         { return "IronWolf"; }
    if (mfr == "Western Digital") { return "WD Red Plus"; }
    if (mfr == "Toshiba")         { return "N300"; }
    return "Desktop-HDD";
  }
  String enterprisePart(String mfr) {
    if (mfr == "Seagate")         { return "Exos X"; }
    if (mfr == "Western Digital") { return "WD Gold"; }
    if (mfr == "Toshiba")         { return "MG Series"; }
    return "Enterprise-HDD";
  }
}
