/*
 * lib/opcodes/SLOpFilewrite.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLOpFilewrite, the single-opcode class for OP_FILEWRITE (canonical code 45).
 *
 * This class carries exactly ONE opcode: OP_FILEWRITE.
 * Semantics: write to an open file.
 * Membership: base 98 of the canonical SLeeLa ISA (lib/vm/InstructionSet.sleela).
 *
 * step() honours the family contract: it first calls the VM to advance to the
 * next instruction, then executes precisely this one opcode and returns the
 * next instruction pointer for the following opcode object.
 *
 * Family: opcodes. Native VM/OS work crosses an explicit bridge.
 */
#sleela 1.3
// Unified SLeeLa standard-library front-end object.
class SLOpFilewrite extends SLOpcodeBase {
  static final int CODE = 45;
  static final String MNEMONIC = "OP_FILEWRITE";

  void prepare() { configure(CODE, MNEMONIC); }
}
