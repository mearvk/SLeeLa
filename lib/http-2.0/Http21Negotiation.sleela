/*
 * SLeeLa HTTP 2.0/2.1 application-generation negotiation.
 * These generation labels are not Internet HTTP protocol versions.
 */
#sleela 2.1

class Http21Negotiation {
  String localGeneration = "2.1";
  String peerGeneration = "";
  String peerAccept = "";
  boolean fallbackAllowed = true;

  void setPeerGeneration(String value) { peerGeneration = value; }
  void setPeerAccept(String value) { peerAccept = value; }
  void allowFallback(boolean value) { fallbackAllowed = value; }
  String generation() { return localGeneration; }

  boolean acceptsHttp21() {
    return peerGeneration == "" || peerGeneration == "2.1" || peerGeneration == "2.0"
      || peerAccept == "2.1" || peerAccept == "2.0"
      || peerAccept == "2.1, 2.0" || peerAccept == "2.0, 2.1";
  }
  boolean acceptsHttp20() {
    return peerGeneration == "2.0" || peerAccept == "2.0"
      || peerAccept == "2.1, 2.0" || peerAccept == "2.0, 2.1";
  }
  boolean canFallback() { return fallbackAllowed; }

  String selectedGeneration() {
    if (peerGeneration == "2.1") return "2.1";
    if (peerGeneration == "2.0") return "2.0";
    if (peerAccept == "2.1") return "2.1";
    if (peerAccept == "2.0") return "2.0";
    if (peerAccept == "2.1, 2.0" || peerAccept == "2.0, 2.1") return "2.1";
    if (fallbackAllowed) return "2.0";
    return "";
  }
  boolean isNegotiated() { return selectedGeneration() != ""; }
}
