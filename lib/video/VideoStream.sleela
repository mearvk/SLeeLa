/*
 * lib/video/VideoStream.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type VideoStream used within the video library family.
 */
#sleela 1.3
class VideoStream {
  string identifier;
  VideoTrack track;
  boolean active;
  void open(string id,VideoTrack value){identifier=id;track=value;active=value!=null;}
  boolean running(){return active;}
  void close(){active=false;}
}