<< lib/java/support/SLJavaProperty.sleela
   One Java property, as a general model: a name, a Java type named by its
   Java spelling, a value with a default, and the JavaBeans traits (bound,
   constrained, read-only, indexed). It is the common ground of the two kinds
   of property Java has: the String entries of java.util.Properties and
   System properties, and the typed get/set properties of a JavaBean. >>
#sleela 3.0
material;
import java.jdk-28;

<< A property is created by SLJavaPropertyModel.define, which supplies the
   source bean and the change-support objects, or on its own with
   new SLJavaProperty(name, javaType).

   Types. javaType is the Java type name: int, long, double, boolean, byte,
   short, char, float, java.lang.String, a boxed name (java.lang.Integer,
   java.lang.Long, java.lang.Double, java.lang.Boolean), or any other
   reference type name. set checks the value against the five value kinds
   (integral, double, boolean, String, other) and throws ClassCastException
   naming the property, the expected type and the value. int, byte, short and
   char also check their range, and float rounds to binary32, as Java
   assignment would. A primitive type rejects null with
   IllegalArgumentException (a bean setter with a primitive parameter cannot
   take null); a reference type accepts null. Any other reference type is not
   checked: Java generics and erasure to Any (PURPOSE.md row 11).

   Text. toText and fromText convert a value to and from the String form that
   java.util.Properties stores: Integer.toString / parseInt and the Long,
   Double and Boolean equivalents, so a malformed number throws
   NumberFormatException as Java does.

   JavaBeans. A constrained property asks the VetoableChangeSupport first; a
   veto (PropertyVetoException) leaves the value unchanged and propagates. A
   bound property then reports the change through the PropertyChangeSupport.
   An indexed property holds an Any[] (setArray) and reports an element change
   with an IndexedPropertyChangeEvent. >>
class SLJavaProperty {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs. Shared support
     class of the /lib/java Java container; written for SLeeLa, not copied
     from the JDK. It models the property of the JavaBeans 1.01 specification
     (Sun Microsystems, 1997) and the String property of java.util.Properties. >>
  String metaVersion = "1.0.0";
  int metaId = 39407;
  String metaAuthor = "Max Rupplin";
  String metaDate = "2026-11-12";
  String metaCopyright = "MEARVK LLC";
  String metaTrademark = "none";
  String metaCorporation = "MEARVK LLC";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-12";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 6;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "JavaBeans API Specification 1.01 (Sun Microsystems, 1997), chapter 7 Properties";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < ---- the property ---- >
  String name;
  String javaType;
  Any value;
  Any defaultValue;
  boolean valueSet;
  boolean bound;
  boolean constrained;
  boolean readOnly;
  boolean indexed;
  String shortDescription;
  Any source;
  PropertyChangeSupport changes;
  VetoableChangeSupport vetoes;

  SLJavaProperty(String name_, String javaType_) {
    if (name_ == null || name_ == "") { throw new IllegalArgumentException("SLJavaProperty: a property needs a name"); }
    if (javaType_ == null || javaType_ == "") { throw new IllegalArgumentException("SLJavaProperty " + name_ + ": a property needs a Java type"); }
    this.name = name_;
    this.javaType = javaType_;
    this.value = null;
    this.valueSet = false;
    this.bound = false;
    this.constrained = false;
    this.readOnly = false;
    this.indexed = false;
    this.shortDescription = "";
    this.source = null;
    this.changes = null;
    this.vetoes = null;
    this.defaultValue = zeroOf(javaType_);
  }

  < traits; each returns this so a definition reads as one line >
  SLJavaProperty bound(boolean b) { this.bound = b; return this; }
  SLJavaProperty constrained(boolean c) { this.constrained = c; return this; }
  SLJavaProperty readOnly(boolean r) { this.readOnly = r; return this; }
  SLJavaProperty indexed(boolean x) { this.indexed = x; return this; }
  SLJavaProperty describedAs(String text) { this.shortDescription = text; return this; }
  SLJavaProperty withDefault(Any v) { this.defaultValue = checked(v); return this; }
  SLJavaProperty attach(Any source_, PropertyChangeSupport changes_, VetoableChangeSupport vetoes_) {
    this.source = source_;
    this.changes = changes_;
    this.vetoes = vetoes_;
    return this;
  }

  String getName() { return this.name; }
  String getJavaType() { return this.javaType; }
  boolean isBound() { return this.bound; }
  boolean isConstrained() { return this.constrained; }
  boolean isReadOnly() { return this.readOnly; }
  boolean isIndexed() { return this.indexed; }
  boolean isSet() { return this.valueSet; }
  String getShortDescription() { return this.shortDescription; }
  Any getDefault() { return this.defaultValue; }

  < the value, or the default while none was set >
  Any get() {
    if (this.valueSet) { return this.value; }
    return this.defaultValue;
  }

  << Set the value: type check, veto check (constrained), store, then report
     the change (bound). Returns the previous value. A read-only property
     refuses with UnsupportedOperationException. >>
  Any set(Any v) {
    if (this.readOnly) { throw new UnsupportedOperationException("SLJavaProperty " + this.name + " is read-only"); }
    Any nv = checked(v);
    Any old = get();
    if (this.constrained && this.vetoes != null) { this.vetoes.fireVetoableChange(this.name, old, nv); }
    this.value = nv;
    this.valueSet = true;
    if (this.bound && this.changes != null) { this.changes.firePropertyChange(this.name, old, nv); }
    return old;
  }
  < store the value without type check, events or the read-only rule: for loading a bean from storage >
  void initialize(Any v) {
    this.value = checked(v);
    this.valueSet = true;
  }
  < drop the set value, so get returns the default again; reported like set >
  void reset() {
    Any old = get();
    if (this.constrained && this.vetoes != null) { this.vetoes.fireVetoableChange(this.name, old, this.defaultValue); }
    this.valueSet = false;
    this.value = null;
    if (this.bound && this.changes != null) { this.changes.firePropertyChange(this.name, old, this.defaultValue); }
  }

  < ---- indexed access: the value is an Any[] ---- >
  Any getIndexed(int index) {
    Any[] a = elements();
    if (index < 0 || index >= arrayLength(a)) { throw new ArrayIndexOutOfBoundsException("Index " + index + " out of bounds for length " + arrayLength(a)); }
    return a[index];
  }
  void setIndexed(int index, Any v) {
    if (this.readOnly) { throw new UnsupportedOperationException("SLJavaProperty " + this.name + " is read-only"); }
    Any[] a = elements();
    if (index < 0 || index >= arrayLength(a)) { throw new ArrayIndexOutOfBoundsException("Index " + index + " out of bounds for length " + arrayLength(a)); }
    Any old = a[index];
    if (this.constrained && this.vetoes != null) {
      this.vetoes.fireVetoableChange(new IndexedPropertyChangeEvent(this.source, this.name, old, v, index));
    }
    a[index] = v;
    if (this.bound && this.changes != null) { this.changes.fireIndexedPropertyChange(this.name, index, old, v); }
  }
  int indexedLength() { return arrayLength(elements()); }
  < the array of an indexed property, set with setArray >
  Any[] items;
  void setArray(Any[] a) {
    if (!this.indexed) { throw new UnsupportedOperationException("SLJavaProperty " + this.name + " is not indexed"); }
    if (this.readOnly) { throw new UnsupportedOperationException("SLJavaProperty " + this.name + " is read-only"); }
    this.items = a;
  }
  Any[] elements() {
    if (!this.indexed) { throw new UnsupportedOperationException("SLJavaProperty " + this.name + " is not indexed"); }
    if (this.items == null) { throw new NullPointerException("SLJavaProperty " + this.name + " has no array"); }
    return this.items;
  }

  < ---- the String form used by java.util.Properties ---- >
  String toText() { return textOf(get()); }
  String textOf(Any v) {
    if (v == null) { return null; }
    String k = kind();
    if (k == "double") { double d = (double) v; return Double.toString(d); }
    if (k == "boolean") { boolean b = (boolean) v; return Boolean.toString(b); }
    if (k == "char") { int c = (int) v; return JavaText.charString(c); }
    return "" + v;
  }
  Any fromText(String s) {
    if (s == null) { return null; }
    String k = kind();
    if (k == "int" || k == "long" || k == "byte" || k == "short") {
      long n = Long.parseLong(s);
      return checked(n);
    }
    if (k == "char") {
      if (JavaText.length(s) != 1) { throw new IllegalArgumentException("SLJavaProperty " + this.name + ": a char property needs one character, got \"" + s + "\""); }
      return JavaText.charAt(s, 0);
    }
    if (k == "double" || k == "float") {
      Double parser = new Double(0.0);
      return checked(parser.parseDouble(s));
    }
    if (k == "boolean") {
      return Boolean.parseBoolean(s);
    }
    if (k == "string") { return s; }
    throw new UnsupportedOperationException("SLJavaProperty " + this.name + ": no text form for Java type " + this.javaType);
  }
  void setText(String s) { set(fromText(s)); }

  < ---- types ---- >
  << The value kind of the Java type: int, long, byte, short, char, float,
     double, boolean, string, or object (unchecked). A boxed type name maps to
     its primitive kind but stays nullable. >>
  String kind() {
    String t = this.javaType;
    if (t == "int" || t == "java.lang.Integer") { return "int"; }
    if (t == "long" || t == "java.lang.Long") { return "long"; }
    if (t == "byte" || t == "java.lang.Byte") { return "byte"; }
    if (t == "short" || t == "java.lang.Short") { return "short"; }
    if (t == "char" || t == "java.lang.Character") { return "char"; }
    if (t == "float" || t == "java.lang.Float") { return "float"; }
    if (t == "double" || t == "java.lang.Double") { return "double"; }
    if (t == "boolean" || t == "java.lang.Boolean") { return "boolean"; }
    if (t == "java.lang.String" || t == "String") { return "string"; }
    return "object";
  }
  boolean isPrimitive() {
    String t = this.javaType;
    return t == "int" || t == "long" || t == "byte" || t == "short" || t == "char" || t == "float" || t == "double" || t == "boolean";
  }
  Any zeroOf(String t) {
    if (t == "int" || t == "long" || t == "byte" || t == "short" || t == "char") { return 0; }
    if (t == "float" || t == "double") { return 0.0; }
    if (t == "boolean") { return false; }
    return null;
  }
  Any checked(Any v) {
    if (v == null) {
      if (isPrimitive()) { throw new IllegalArgumentException("SLJavaProperty " + this.name + ": a " + this.javaType + " property cannot be null"); }
      return null;
    }
    String k = kind();
    if (k == "int") { return inRange(v, -2147483648, 2147483647); }
    if (k == "long") {
      if (v instanceof int) { return v; }
      throw mismatch(v);
    }
    if (k == "byte") { return inRange(v, -128, 127); }
    if (k == "short") { return inRange(v, -32768, 32767); }
    if (k == "char") { return inRange(v, 0, 65535); }
    if (k == "double" || k == "float") {
      double d = 0.0;
      if (v instanceof double) { d = (double) v; }
      else if (v instanceof int) { long n = (long) v; d = n * 1.0; }
      else { throw mismatch(v); }
      if (k == "float") { Float f = new Float(0.0); return f.fround(d); }
      return d;
    }
    if (k == "boolean") {
      if (v instanceof boolean) { return v; }
      throw mismatch(v);
    }
    if (k == "string") {
      if (v instanceof string) { return v; }
      throw mismatch(v);
    }
    return v;
  }
  Any inRange(Any v, long lo, long hi) {
    if (!(v instanceof int)) { throw mismatch(v); }
    long n = (long) v;
    if (n < lo || n > hi) { throw new IllegalArgumentException("SLJavaProperty " + this.name + ": " + n + " is out of range for " + this.javaType); }
    return v;
  }
  ClassCastException mismatch(Any v) {
    return new ClassCastException("SLJavaProperty " + this.name + ": expected " + this.javaType + ", got " + v);
  }

  < one line that describes the property, in the manner of a java.beans.PropertyDescriptor >
  String describe() {
    String traits = "";
    if (this.bound) { traits = traits + " bound"; }
    if (this.constrained) { traits = traits + " constrained"; }
    if (this.readOnly) { traits = traits + " read-only"; }
    if (this.indexed) { traits = traits + " indexed"; }
    return this.name + " : " + this.javaType + traits + " = " + toText();
  }
}
