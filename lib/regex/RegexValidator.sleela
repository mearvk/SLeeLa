/*
 * lib/regex/RegexValidator.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexValidator used within the regex library family.
 */
#sleela 1.3
class RegexValidator {
  boolean valid;
  void clear(){valid=false;}
  void accept(){valid=true;}
  boolean isValid(){return valid;}
}
