/*
 * lib/video/VideoTrack.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type VideoTrack used within the video library family.
 */
#sleela 1.3
class VideoTrack {
  string name;
  int frameCount;
  VideoFormat format;
  void configure(string trackName,VideoFormat trackFormat){name=trackName;format=trackFormat;frameCount=0;}
  void addFrame(){if(format!=null)frameCount=frameCount+1;}
  int frames(){return frameCount;}
}