# Phraign(TM) City 3D -- configuration
# Format: key = value, one per line. '#' begins a comment. Unknown keys are
# ignored (forward-compatible). Missing keys keep their documented defaults.

# ---- Model ---------------------------------------------------------------
# The city is a square grid of blocks. 64 x 64 = 4096 (~4000 square blocks).
grid_cols = 64
grid_rows = 64

# Per-user identity. If seed = 0, the seed is derived from this user name, so
# every user gets their own reproducible city.
user      = anon
seed      = 0

# ---- Year / modernity ----------------------------------------------------
# The city's Year. A larger, more modern year makes the city newer: taller
# buildings, more floors and windows, more glass, and better condition. The
# city is a model of finality (quality of condition) that improves with the
# Year. Try a modern future number like 2807 or 2407.
year          = 2807
# Year mapped to modernity 0, and how many years above it reach modernity 1.
# modernity = clamp((year - year_baseline) / year_span, 0..1).
year_baseline = 2000
year_span     = 1000

# ---- Building quality targets --------------------------------------------
# Buildings vary around these; the Year scales them up as the city modernizes.
avg_floors        = 14      # target mean number of floors
floor_height      = 1.1     # world units per floor (height = floors * this)
windows_per_floor = 6       # target windows on a visible face, per floor

# ---- Roads & bridges (real features) -------------------------------------
# Roads are corridors every road_spacing blocks; bridges are spans laid along
# them. Proximity to roads/bridges is *computed* per building (BFS distance),
# and contributes to finality via the weights below.
road_spacing = 8
bridge_count = 6

# ---- Finality weights (quality of condition) -----------------------------
# How much each factor contributes to a building's finality (0..1). Values are
# normalized, so only their relative sizes matter.
w_year             = 1.0    # newer year        -> higher finality
w_floors           = 0.6    # more floors       -> more finished / dense
w_windows          = 0.6    # more windows      -> more modern / glassy
w_road_proximity   = 0.8    # closer to a road  -> better serviced
w_bridge_proximity = 0.5    # closer to a bridge-> better connected
# Distance (in blocks) at which the proximity benefit fades to zero.
proximity_falloff  = 6.0

# ---- Appearance ----------------------------------------------------------
# Color theme: green | white | blue. Green is the default.
theme        = green
# Detailing toggles.
draw_bridges = true
draw_windows = true

# ---- Viewpoint (seen from the top and slightly to the side) --------------
# Oblique projection. Increase tilt_* for a stronger side angle; set them near
# 0 for a near-top-down view. scale_height controls how tall buildings appear.
# Defaults frame a modern (tall) 64x64 city in a 1024x768 frame.
tilt_x       = 0.55
tilt_y       = 0.42
scale_x      = 9.0
scale_height = 1.1
block_pitch  = 9.0
origin_x     = 150.0
origin_y     = 380.0

# ---- Frame ---------------------------------------------------------------
# Phraign frame size in pixels (the per-pixel render target).
frame_width  = 1024
frame_height = 768

# ---- Persistence ---------------------------------------------------------
# Where a saved model should live: github | server | local.
#   github -> save_location is an owner/repo slug
#   server -> save_location is a public upload URL
#   local  -> save_location is a filesystem path (defaults to the model file)
save_target   = local
save_location =
