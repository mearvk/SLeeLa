/*
 * lib/crypto/SLAesGcm.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLAesGcm used within the crypto library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. AES-GCM authenticated encryption (NIST SP 800-38D). Native impl crosses the VM/OS bridge to /crypto.
//
// SECURITY NOTE: the native /crypto backend is a correct, specification-faithful
// REFERENCE implementation. It is NOT guaranteed constant-time and is NOT
// side-channel resistant. For data that must be protected use an audited library
// (BoringSSL, OpenSSL, libsodium, liboqs). See crypto/README.md.
class SLAesGcm {
  // Status codes mirror slcrypto_status in crypto/include/slcrypto.h.
  static final int OK = 0;
  static final int ERR_PARAM = -1;
  static final int ERR_AUTH = -2;      // tag verification failed on decrypt
  static final int ERR_UNIMPL = -3;

  // SP 800-38D recommends a 96-bit (12-byte) nonce and a 16-byte tag.
  static final int RECOMMENDED_IV_BYTES = 12;
  static final int MAX_TAG_BYTES = 16;

  String algorithm;
  int keyBits;       // 128, 192, or 256
  int tagBytes;      // 1..16 (16 recommended)
  int state;         // 1 = enabled, 0 = disabled
  int configured;    // 1 once a supported algorithm name has been accepted
  int keySet;        // 1 once a valid key size has been accepted
  int tagSet;        // 1 once a valid tag size has been accepted
  int backend;       // 1 when the native /crypto backend is linked and ready

  int configure(String a) {
    if (a == null) { configured = 0; return ERR_PARAM; }
    if (a == "AES-GCM") { algorithm = a; configured = 1; return OK; }
    configured = 0;
    return ERR_PARAM;
  }

  // key_bits must be 128, 192, or 256.
  int keySize(int b) {
    if (b == 128 || b == 192 || b == 256) { keyBits = b; keySet = 1; return OK; }
    keySet = 0;
    return ERR_PARAM;
  }

  // tag_len must be 1..16 (SP 800-38D); 16 recommended.
  int tagSize(int t) {
    if (t >= 1 && t <= MAX_TAG_BYTES) { tagBytes = t; tagSet = 1; return OK; }
    tagSet = 0;
    return ERR_PARAM;
  }

  void bindBackend(int ready) { if (ready == 1) { backend = 1; } else { backend = 0; } }
  boolean backendReady() { return backend == 1; }

  void enable() { state = 1; }
  void disable() { state = 0; }

  boolean active() {
    return state == 1 && configured == 1 && keySet == 1 && tagSet == 1 && backend == 1;
  }

  // AEAD encrypt. Models slc_aes_gcm_encrypt(); validates the nonce before dispatch.
  int encrypt(String iv, int ivLen, String aad, String pt) {
    if (active() == false) { return ERR_UNIMPL; }
    if (iv == null || pt == null) { return ERR_PARAM; }
    if (ivLen < 1) { return ERR_PARAM; }
    return OK;
  }

  // AEAD decrypt. Models slc_aes_gcm_decrypt(); a bad tag yields ERR_AUTH and
  // the native layer releases no plaintext.
  int decrypt(String iv, int ivLen, String aad, String ct, String tag) {
    if (active() == false) { return ERR_UNIMPL; }
    if (iv == null || ct == null || tag == null) { return ERR_PARAM; }
    if (ivLen < 1) { return ERR_PARAM; }
    return OK;
  }

  String securityNote() {
    return "Reference-grade: not constant-time, not side-channel resistant; use an audited library in production.";
  }
}
