/*
 * lib/data-structures/DSMap.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type DSMap used within the data-structures library family.
 */
#sleela 1.2

// Key/value association contract.

struct DSMap {
    int size;
}

class DSMapOperations {
    boolean empty(DSMap map) { return map.size == 0; }
    int size(DSMap map) { return map.size; }
    boolean hasEntries(DSMap map) { return map.size > 0; }
}
