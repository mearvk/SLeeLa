/*
 * lib/math/SLCovariance.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLCovariance used within the math library family.
 */
#sleela 2.1
// SLeeLa math front-end contract.
class SLCovariance { int state; int count; void reset(){state=0;count=0;} void activate(){state=1;count=count+1;} boolean active(){return state==1;} int status(){return state;} }
