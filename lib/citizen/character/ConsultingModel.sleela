/*
 * lib/citizen/character/ConsultingModel.sleela
 * SLeeLa Standard Library Definition.
 * Definition: ConsultingModel — sell time, dressed up as insight. Revenue is
 *   billable hours x rate, bounded by the brutal truth that there are only so
 *   many hours and consultants insist on sleeping some of them.
 *
 * A concrete BusinessModel: revenue scales with utilization, not headcount
 * alone; cost is the consultants' salaries whether or not they billed. Family:
 * character.
 */
#sleela 1.3
class ConsultingModel extends BusinessModel {

  int consultants;         // people who can bill
  int billableHours;       // total hours actually billed this month
  int rateCents;           // billing rate per hour
  int salaryPerHeadCents;  // monthly salary cost per consultant

  void setUp(int heads, int hours, int rate, int salaryPerHead) {
    load();
    configure("Consulting", KIND_CONSULTING);
    if (heads < 0) { heads = 0; }
    if (hours < 0) { hours = 0; }
    if (rate < 0) { rate = 0; }
    if (salaryPerHead < 0) { salaryPerHead = 0; }
    consultants = heads;
    billableHours = hours;
    rateCents = rate;
    salaryPerHeadCents = salaryPerHead;
    setUnits(hours);
  }

  // Utilization as a percent of a nominal 160-hour month across all heads.
  int utilizationPercent() {
    int capacity = consultants * 160;
    if (capacity <= 0) { return 0; }
    return (billableHours * 100) / capacity;
  }

  int monthlyRevenue() { return billableHours * rateCents; }
  int monthlyCost() { return consultants * salaryPerHeadCents; }
}
