/*
 * lib/thermodynamics/curriculum/courses/SLStatisticalMechanics.sleela
 * Statistical Thermodynamics / Statistical Mechanics - algorithms.
 * Connects microscopic atomic states to macroscopic quantities via the
 * Boltzmann framework: partition function, occupation probabilities, average
 * energy, and the entropy S = k_B ln W.
 *
 * exp/ln are not SLeeLa 1.3 builtins; self-contained series are provided.
 * Native core is authoritative (C: sl_thermo_partition_function etc.). SI units.
 * Max Rupplin - MEARVK LLC - 2026
 */
#sleela 1.3
class SLStatisticalMechanics {
  double kB;   // Boltzmann constant J/K
  void configure() { kB = 0.0000000000000000000000138649; }

  double expSeries(double x) {
    double term = 1.0; double sum = 1.0; int n = 1;
    while (n <= 30) { term = term * x / n; sum = sum + term; n = n + 1; }
    return sum;
  }
  double ln(double x) {
    if (x <= 0.0) { return 0.0; }
    double t = (x - 1.0) / (x + 1.0);
    double t2 = t * t; double term = t; double sum = 0.0; int k = 1;
    while (k <= 99) { sum = sum + term / k; term = term * t2; k = k + 2; }
    return 2.0 * sum;
  }

  // Boltzmann factor exp(-E / (kB*T)) for a microstate of energy E.
  double boltzmannFactor(double energy, double temperature) {
    if (temperature <= 0.0) { return 0.0; }
    double beta = 1.0 / (kB * temperature);
    return expSeries((0.0 - beta) * energy);
  }

  // Two-level partition function Z = g0*w0 + g1*w1 (degeneracies g).
  double partitionTwoLevel(double g0, double e0, double g1, double e1, double temperature) {
    return g0 * boltzmannFactor(e0, temperature) + g1 * boltzmannFactor(e1, temperature);
  }

  // Occupation probability p_i = g_i * w_i / Z.
  double probability(double g, double energy, double temperature, double z) {
    if (z <= 0.0) { return 0.0; }
    return g * boltzmannFactor(energy, temperature) / z;
  }

  // Average energy <E> = p0*E0 + p1*E1 for a two-level system.
  double averageEnergy(double g0, double e0, double g1, double e1, double temperature) {
    double z = partitionTwoLevel(g0, e0, g1, e1, temperature);
    double p0 = probability(g0, e0, temperature, z);
    double p1 = probability(g1, e1, temperature, z);
    return p0 * e0 + p1 * e1;
  }

  // Boltzmann entropy S = kB * ln(W), W = number of accessible microstates.
  double entropyBoltzmann(double microstates) {
    if (microstates <= 0.0) { return 0.0; }
    return kB * ln(microstates);
  }

  // Gibbs/Shannon entropy of a two-state distribution:
  //   S = -kB * (p0 ln p0 + p1 ln p1).
  double entropyGibbsTwoState(double p0, double p1) {
    double s = 0.0;
    if (p0 > 0.0) { s = s + p0 * ln(p0); }
    if (p1 > 0.0) { s = s + p1 * ln(p1); }
    return (0.0 - kB) * s;
  }
}
