    if (m > 2147483647) { m = m - 4294967296; }
    return (int) m;
  }
  << Bitwise xor of two 32-bit two-complement ints. >>
  int xorInt(int a, int b) {
    long x = a;
    long y = b;
    if (x < 0) { x = x + 4294967296; }
    if (y < 0) { y = y + 4294967296; }
    long r = 0;
    long bit = 1;
    int k = 0;
    while (k < 32) {
      if ((x % 2) != (y % 2)) { r = r + bit; }
      x = x / 2; y = y / 2; bit = bit * 2; k = k + 1;
    }
    return wrap32(r);
  }
  String pad(long v, int width) {
