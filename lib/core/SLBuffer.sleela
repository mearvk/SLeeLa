/*
 * lib/core/SLBuffer.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLBuffer used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Buffer.
// Role: runtime. Responsibility: bounded byte/value storage.
class SLBuffer {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
