/*
 * lib/video/VideoTimestamp.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type VideoTimestamp used within the video library family.
 */
#sleela 1.3
class VideoTimestamp {
  long value;
  int numerator;
  int denominator;
  void set(long v,int n,int d){value=v;numerator=n;denominator=d;}
  boolean valid(){return numerator>0 && denominator>0;}
}