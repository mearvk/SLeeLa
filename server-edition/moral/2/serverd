#!/usr/bin/env sh
# Discord-2™ — SLeeLa Server Edition Service 2
set -eu
umask 077
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$DIR/../../.." && pwd)
CONFIG="${SLEELA_SERVER_CONFIG:-$DIR/config/server.conf}"
[ -f "$CONFIG" ] || { echo "serverd: configuration not found: $CONFIG" >&2; exit 1; }
HTTPCTL="$ROOT/server-edition/http/httpctl"
HTTP_VERSION="2.1"; LOGICAL_PORT="19866"; DOWNLOAD_SIZE="0"
NATIONAL_ID_REF=""; CITIZEN_ID_REF=""; BANK_ID_REF=""; RELAY_PURPOSE=""
ENGINE=""
INBOX=""
STATE=""
SOURCE=""
LOG=""
MODE="local"
TICK="false"
FOREGROUND="false"
MANIFEST=""
NETWORK="false"
PORT="19866"; PORT_PROTO="tcp"; FIREWALL="auto"; FIREWALL_REQUIRED="true"
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in ""|#*) continue;; esac
  case "$line" in *=*) key=${line%%=*}; value=${line#*=};; *) echo "serverd: invalid configuration line" >&2; exit 2;; esac
  case "$key" in
    http_version) HTTP_VERSION=$value;; logical_port) LOGICAL_PORT=$value;; download_size_bytes) DOWNLOAD_SIZE=$value;; http_api) HTTPCTL=$value;;
    national_id_ref) NATIONAL_ID_REF=$value;; citizen_id_ref) CITIZEN_ID_REF=$value;; bank_id_ref) BANK_ID_REF=$value;; relay_purpose) RELAY_PURPOSE=$value;;
    engine) ENGINE=$value;; inbox) INBOX=$value;; state) STATE=$value;; server_source) SOURCE=$value;;
    log) LOG=$value;; mode) MODE=$value;; tick) TICK=$value;; foreground) FOREGROUND=$value;;
    sha256_manifest) MANIFEST=$value;; allow_network) NETWORK=$value;;
    port) PORT=$value;; port_protocol) PORT_PROTO=$value;; firewall) FIREWALL=$value;; firewall_required) FIREWALL_REQUIRED=$value;;
    *) echo "serverd: unknown configuration key: $key" >&2; exit 2;;
  esac
done < "$CONFIG"
[ -x "$HTTPCTL" ] || { echo "serverd: HTTP API controller not executable: $HTTPCTL" >&2; exit 1; }
case "$HTTP_VERSION" in 1.0|2.0|2.1|3.0) ;; *) echo "serverd: invalid http_version" >&2; exit 2;; esac
case "$LOGICAL_PORT" in ""|*[!0-9]*) echo "serverd: logical_port must be decimal" >&2; exit 2;; esac
case "$DOWNLOAD_SIZE" in ""|*[!0-9]*) echo "serverd: download_size_bytes must be decimal" >&2; exit 2;; esac
[ -n "$ENGINE" ] || ENGINE="$ROOT/impl/build/sleela"
[ -n "$INBOX" ] || INBOX="$ROOT/server-edition/inbox/requests.txt"
[ -n "$STATE" ] || STATE="$ROOT/server-edition/state"
[ -n "$SOURCE" ] || SOURCE="$DIR/src/Server.sleela"
[ -n "$LOG" ] || LOG="$STATE/results.log"
[ -n "$MANIFEST" ] || MANIFEST="$ROOT/security/important-sha256-manifest.json"
case "$MODE" in local|service) ;; *) echo "serverd: mode must be local or service" >&2; exit 2;; esac
case "$TICK" in true|false) ;; *) echo "serverd: tick must be true or false" >&2; exit 2;; esac
case "$FOREGROUND" in true|false) ;; *) echo "serverd: foreground must be true or false" >&2; exit 2;; esac
case "$NETWORK" in true|false) ;; *) echo "serverd: allow_network must be true or false" >&2; exit 2;; esac
[ -x "$ENGINE" ] || { echo "serverd: engine not executable: $ENGINE" >&2; exit 1; }
[ -f "$SOURCE" ] || { echo "serverd: source not found: $SOURCE" >&2; exit 1; }
PORTCTL="$ROOT/server-edition/port-awareness/portctl.sh"
[ -f "$PORTCTL" ] || { echo "serverd: port controller missing: $PORTCTL" >&2; exit 1; }
export SLEELA_RELAY_NATIONAL_ID_REF="$NATIONAL_ID_REF" SLEELA_RELAY_CITIZEN_ID_REF="$CITIZEN_ID_REF" SLEELA_RELAY_BANK_ID_REF="$BANK_ID_REF" SLEELA_RELAY_PURPOSE="$RELAY_PURPOSE"
export SLEELA_BIN="$ENGINE" SLEELA_SHA256_MANIFEST="$MANIFEST" SLEELA_SERVER_CONFIG="$CONFIG"
export SLEELA_SERVER_INBOX="$INBOX" SLEELA_SERVER_STATE="$STATE" SLEELA_SERVER_ALLOW_NETWORK="$NETWORK"
mkdir -p "$STATE" "$(dirname "$INBOX")"
LOCK="$STATE/.serverd.lock"
mkdir "$LOCK" 2>/dev/null || { echo "serverd: another instance is active" >&2; exit 3; }
cleanup() {
  rc=$?
  if ! sh "$PORTCTL" close "Discord-2" "$PORT" "$PORT_PROTO" >>"$LOG" 2>&1; then
    echo "serverd: failed to close firewall port $PORT/$PORT_PROTO" >&2
    rc=1
  fi
  rmdir "$LOCK" 2>/dev/null || true
  exit "$rc"
}
trap cleanup EXIT HUP INT TERM
sh "$PORTCTL" close "Discord-2" "$PORT" "$PORT_PROTO" >>"$LOG" 2>&1 || true
if [ "$FIREWALL_REQUIRED" = true ]; then
  sh "$PORTCTL" open "Discord-2" "$PORT" "$PORT_PROTO" >>"$LOG" 2>&1 || { echo "serverd: firewall could not open $PORT/$PORT_PROTO; refusing to start" >&2; exit 1; }
else
  sh "$PORTCTL" open "Discord-2" "$PORT" "$PORT_PROTO" >>"$LOG" 2>&1 || echo "serverd: firewall open unavailable; continuing by configuration"
fi
"$HTTPCTL" --logical-port "$LOGICAL_PORT" --size "$DOWNLOAD_SIZE" --version "$HTTP_VERSION" >>"$LOG" 2>&1 || { echo "serverd: HTTP capability validation failed" >&2; exit 1; }
[ -f "$INBOX" ] || printf "%s\n" "hello" > "$INBOX"
[ "$TICK" = true ] && printf "tick %s\n" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo now)" >> "$INBOX"
{ echo "=== SLeeLa Server Edition Service 2 ==="; cd "$ROOT"; "$ENGINE" run "$SOURCE"; } >> "$LOG" 2>&1
[ "$FOREGROUND" = true ] && tail -n 12 "$LOG"
echo "Discord-2™ serverd: completed; results=$LOG"
