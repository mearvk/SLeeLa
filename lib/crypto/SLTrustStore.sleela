/*
 * lib/crypto/SLTrustStore.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLTrustStore used within the crypto library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Set of trusted root/anchor certificates used for chain
// validation over /crypto. Native implementation crosses an explicit VM/OS bridge.
//
// SECURITY NOTE: the native /crypto backend is a correct, specification-faithful
// REFERENCE implementation. It is NOT guaranteed constant-time and is NOT
// side-channel resistant. For data that must be protected use an audited library
// (BoringSSL, OpenSSL, libsodium, liboqs). See crypto/README.md.
class SLTrustStore {
  // Status codes mirror slcrypto_status in crypto/include/slcrypto.h.
  static final int OK = 0;
  static final int ERR_PARAM = -1;
  static final int ERR_AUTH = -2;      // chain did not validate to a trust anchor
  static final int ERR_UNIMPL = -3;

  String algorithm;
  int anchors;       // number of trust anchors held
  int state;         // 1 = enabled, 0 = disabled
  int configured;    // 1 once an algorithm name has been accepted
  int backend;       // 1 when the native /crypto backend is linked and ready

  int configure(String a) {
    if (a == null) { configured = 0; return ERR_PARAM; }
    algorithm = a;
    configured = 1;
    return OK;
  }

  void bindBackend(int ready) { if (ready == 1) { backend = 1; } else { backend = 0; } }
  boolean backendReady() { return backend == 1; }

  void enable() { state = 1; }
  void disable() { state = 0; }
  boolean active() { return state == 1 && configured == 1 && backend == 1; }

  int anchorCount() { return anchors; }

  // Install a trusted root/anchor certificate.
  int addAnchor(String encoded) {
    if (active() == false) { return ERR_UNIMPL; }
    if (encoded == null) { return ERR_PARAM; }
    anchors = anchors + 1;
    return OK;
  }

  // Validate a certificate chain to a trust anchor.
  // OK = trusted, ERR_AUTH = did not chain to an anchor.
  int validateChain(String leafEncoded) {
    if (active() == false) { return ERR_UNIMPL; }
    if (leafEncoded == null) { return ERR_PARAM; }
    if (anchors == 0) { return ERR_PARAM; }
    return OK;
  }

  String securityNote() {
    return "Reference-grade: not constant-time, not side-channel resistant; use an audited library in production.";
  }
}
