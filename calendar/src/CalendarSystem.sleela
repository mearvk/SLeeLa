  void setNationalSchedule(String v) { metaNationalSchedule = v; }
}

<< ============================================================= >>
<< SLCalendarGregorian — the Gregorian reform (doc 02).            >>
<< ============================================================= >>
class SLCalendarGregorian {

  << The Gregorian leap rule: 4/100/400. >>
  boolean isLeapYear(int year) {
    if ((year % 400) == 0) { return true; }
    if ((year % 100) == 0) { return false; }
    if ((year % 4) == 0) { return true; }
    return false;
  }

  int daysInMonth(int year, int month) {
    if (month == 2) {
      if (isLeapYear(year)) { return 29; }
      return 28;
    }
    if (month == 4) { return 30; }
    if (month == 6) { return 30; }
    if (month == 9) { return 30; }
    if (month == 11) { return 30; }
    return 31;
  }

  int daysInYear(int year) {
    if (isLeapYear(year)) { return 366; }
    return 365;
  }

  int toSerial(int year, int month, int day) {
    int y = year;
    int m = month;
    if (m <= 2) {
      y = y - 1;
      m = m + 12;
    }
    int monthDays = ((153 * (m - 3)) + 2) / 5;
    int leapDays = (y / 4) - (y / 100) + (y / 400);
    return (y * 365) + leapDays + monthDays + (day - 1);
  }

  << Day of week, 0 = Sunday .. 6 = Saturday, anchored on Sat 2000-01-01. >>
  int dayOfWeek(int year, int month, int day) {
    int serial = toSerial(year, month, day);
    int anchorSerial = toSerial(2000, 1, 1);
    int diff = serial - anchorSerial;
    int w = (6 + diff) % 7;
    if (w < 0) { w = w + 7; }
    return w;
  }

  << ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >>
  String metaVersion = "1.0.0";
  int metaId = 2;
  String metaAuthor = "Pope Gregory XIII / Aloysius Lilius / Christopher Clavius";
  String metaDate = "2026-11-07";
  String metaCopyright = "Public domain (historical calendar)";
  String metaTrademark = "none";
  String metaCorporation = "mearvk LLC";
  String metaOrigin = "International";
  String metaBirthDate = "1582";
  int metaScienceRating = 10;
  String metaNationalSchedule = "Inter gravissimas (papal bull, 1582)";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
