/*
 * lib/boolean/32/Bool_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the Boolean/Binary word BOOLEAN.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE (depth 32) as a SLeeLa standard-library constant. HEAD syllable is the result (TRUE); the remaining 31 syllable(s) are carried caveat structure.
 */
#sleela 1.3
// SLeeLa boolean/32 front-end constant — one Boolean word per file.
// Word: BOOLEAN.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE
// Family: boolean. The HEAD syllable is the RESULT; trailing syllables are
// CARRY (caveat structure) that must be observed/agree. A FALSE carried behind
// a TRUE result means: result is TRUE, but a concern of carry is noted.
class Bool_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT {
  String word() { return "BOOLEAN.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE"; }
  String glyphs() { return "TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"; }
  int depth() { return 32; }
  // Head syllable = the asserted result.
  boolean head() { return true; }
  String headSyllable() { return "TRUE"; }
  // Carry = the trailing syllables, read as a caveat structure.
  String carry() { return "TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"; }
  int carryDepth() { return 31; }
  // A caveat exists when any carried syllable disagrees (a FALSE is carried).
  boolean caveat() { return false; }
  // Agreement: the whole word is uniform (all syllables equal the head).
  boolean agrees() { return true; }
  int trueCount() { return 32; }
  int falseCount() { return 0; }
  // Binary reading: TRUE=1, FALSE=0, head syllable most significant.
  String bits() { return "11111111111111111111111111111111"; }
  String value() { return "4294967295"; }
}
