/*
 * lib/telephony-skya/Socio.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines Socio, the Skya social-fabric Master Class — the
 *   people-and-ties layer above raw peers (members, standing, ties, density).
 *
 * Socio is an emblematic Skya module and a NATURAL / LOADABLE MODULE: a
 * self-describing SLeeLa class the Skya program can load and compose. It shares
 * the common module contract (load / loaded / moduleName / describe) with the
 * other Skya emblematic classes so a loader can treat them uniformly. It holds
 * no socket; it models the social layer the networking classes serve. The
 * runnable orchestration example lives in telephony-skya/sleela/Socio.sleela.
 *
 * Family: telephony-skya. Native VM/OS work crosses an explicit bridge.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class Socio {

  static final String MODULE = "Socio";

  int loadedFlag;      // 1 once the module is loaded
  int members;         // social members currently present
  int ties;            // acknowledged ties between members
  int standing;        // 0 guest, 1 member, 2 trusted, 3 steward

  // --- loadable-module contract ------------------------------------------
  void load() { loadedFlag = 1; members = 0; ties = 0; standing = 0; }
  boolean loaded() { return loadedFlag == 1; }
  String moduleName() { return MODULE; }

  // --- social behavior ----------------------------------------------------
  void admit(int atStanding) {
    members = members + 1;
    if (atStanding > standing) { standing = atStanding; }
  }

  void tie() { if (members >= 2) { ties = ties + 1; } }

  int density() {
    if (members < 2) { return 0; }
    return (ties * 100) / members;
  }

  int memberCount() { return members; }
  int tieCount() { return ties; }
  int topStanding() { return standing; }

  String describe() {
    return MODULE + " members=" + members + " ties=" + ties
         + " density=" + density() + " standing=" + standing;
  }
}
