#!/usr/bin/env sh
# serverd -- the SLeeLa Server Edition launcher.
#
# Runs the local SLeeLa server quietly. Runtime state remains under
# server-edition/inbox and server-edition/state; source is under moral/.
#
# Usage:
#   server-edition/moral/serverd
#   server-edition/moral/serverd --tick
#   server-edition/moral/serverd --foreground
#   server-edition/moral/serverd --design-activity <science> <correctness> <reproducibility> <observability> <safety> <resource> <interoperability>
#   server-edition/moral/serverd --help
#
# Environment:
#   SLEELA_BIN               path to the sleela engine
#   SLEELA_SHA256_MANIFEST   path to the trusted SHA-256 manifest
set -u
umask 077

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$DIR/../.." && pwd)

SLEELA="${SLEELA_BIN:-}"
if [ -z "$SLEELA" ] || [ ! -x "$SLEELA" ]; then
    if [ -x "$ROOT/bin/sleela" ]; then SLEELA="$ROOT/bin/sleela"
    elif [ -x "$ROOT/impl/build/sleela" ]; then SLEELA="$ROOT/impl/build/sleela"
    else echo "serverd: sleela engine not found (set SLEELA_BIN or build impl/)" >&2; exit 1
    fi
fi

if [ -z "${SLEELA_SHA256_MANIFEST:-}" ]; then
    if [ -f "$ROOT/security/important-sha256-manifest.json" ]; then
        SLEELA_SHA256_MANIFEST="$ROOT/security/important-sha256-manifest.json"
        export SLEELA_SHA256_MANIFEST
    elif [ -f "$ROOT/security/sha256-manifest.json" ]; then
        SLEELA_SHA256_MANIFEST="$ROOT/security/sha256-manifest.json"
        export SLEELA_SHA256_MANIFEST
    fi
fi

INBOX="$ROOT/server-edition/inbox/requests.txt"
STATE_DIR="$ROOT/server-edition/state"
LOG="$STATE_DIR/results.log"
SERVER="$DIR/src/Server.sleela"

mkdir -p "$ROOT/server-edition/inbox" "$STATE_DIR"
LOCKDIR="$STATE_DIR/.serverd.lock"
if ! mkdir "$LOCKDIR" 2>/dev/null; then echo "serverd: another run is active" >&2; exit 3; fi
trap 'rmdir "$LOCKDIR" 2>/dev/null || true' EXIT HUP INT TERM
[ -f "$INBOX" ] || printf 'hello\n' > "$INBOX"

FOREGROUND=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --help|-h)
            sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
            exit 0 ;;
        --tick)
            printf 'tick %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo now)" >> "$INBOX"
            shift ;;
        --foreground|-f)
            FOREGROUND=1
            shift ;;
        --design-activity)
            if [ "$#" -ne 8 ]; then
                echo "serverd: --design-activity requires science plus six 0-100 scores" >&2
                exit 2
            fi
            exec "$SLEELA" design-activity "$2" "$3" "$4" "$5" "$6" "$7" "$8" ;;
        *)
            echo "serverd: unknown option '$1' (see --help)" >&2
            exit 2 ;;
    esac
done

{
    echo "=== serverd run $(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo now) ==="
    ( cd "$ROOT" && "$SLEELA" run "$SERVER" 2>&1 |
        sed -e '/^\[security\]/d' -e '/^\[defender\]/d' -e '/^verification: PASS$/d' )
} >> "$LOG" 2>&1

if [ "$FOREGROUND" -eq 1 ]; then
    tail -n 8 "$LOG"
fi

echo "serverd: processed inbox -> $LOG (quiet)"
