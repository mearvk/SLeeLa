;;; sleela-sleela-theme.el --- SLeeLa brand theme -*- lexical-binding: t; -*-
(deftheme sleela-sleela "SLeeLa: the potent cut -- deep black with vivid purple, electric blue, brilliant yellow and white.")
(custom-theme-set-faces
 'sleela-sleela
 '(default ((t (:foreground "#FFFFFF" :background "#08080E"))))
 '(cursor ((t (:background "#B07CFF"))))
 '(region ((t (:background "#17236A" :extend t))))
 '(highlight ((t (:background "#141022"))))
 '(fringe ((t (:foreground "#6E5F9E" :background "#08080E"))))
 '(line-number ((t (:foreground "#5B4F82" :background "#08080E"))))
 '(line-number-current-line ((t (:foreground "#B07CFF" :weight bold))))
 '(mode-line ((t (:foreground "#FFFFFF" :background "#2A1358" :box nil :weight bold))))
 '(mode-line-inactive ((t (:foreground "#6E5F9E" :background "#141022" :box nil))))
 '(minibuffer-prompt ((t (:foreground "#B07CFF" :weight bold))))
 '(font-lock-builtin-face ((t (:foreground "#5A7CFF"))))
 '(font-lock-comment-face ((t (:foreground "#6E5F9E" :slant italic))))
 '(font-lock-constant-face ((t (:foreground "#D7B3FF"))))
 '(font-lock-function-name-face ((t (:foreground "#FFE23D" :weight bold))))
 '(font-lock-keyword-face ((t (:foreground "#B07CFF" :weight bold))))
 '(font-lock-string-face ((t (:foreground "#FFD21E"))))
 '(font-lock-type-face ((t (:foreground "#5A7CFF" :weight bold))))
 '(font-lock-variable-name-face ((t (:foreground "#FFFFFF"))))
 '(font-lock-preprocessor-face ((t (:foreground "#C98CFF"))))
 '(font-lock-warning-face ((t (:foreground "#FF5C7A" :weight bold :underline t))))
 '(error ((t (:foreground "#FF5C7A" :weight bold))))
 '(warning ((t (:foreground "#FFD21E" :weight bold))))
 '(success ((t (:foreground "#FFE23D" :weight bold))))
 '(show-paren-match ((t (:foreground "#FFFFFF" :background "#17236A" :weight bold))))
 '(isearch ((t (:foreground "#08080E" :background "#FFD21E" :weight bold))))
 '(lazy-highlight ((t (:foreground "#FFFFFF" :background "#2A1358")))))
(provide-theme 'sleela-sleela)
;;; sleela-sleela-theme.el ends here
