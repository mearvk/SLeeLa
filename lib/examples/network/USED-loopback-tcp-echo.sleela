#sleela 1.7
// USED: real loopback TCP echo smoke test. Uses only 127.0.0.1:45218.
class NetworkEcho {
    static int listener;
    static void server() {
        int client = accept(listener);
        String request = sockread(client);
        sockwrite(client, "pong");
        sockclose(client);
    }
    static String client() {
        int socket = connect("127.0.0.1", 45218);
        sockwrite(socket, "ping");
        String response = sockread(socket);
        sockclose(socket);
        return response;
    }
    static void main() {
        listener = listen(45218);
        spawn(server);
        String response = client();
        print(response);
        join();
        sockclose(listener);
    }
}
