     (so temperature-like affine units work): value_SI = raw*scale + offset. >>
  double scale;
  double offset;
  void configure(double s, double o) { scale = s; offset = o; }
  double toBase(double raw) { return raw * scale + offset; }
  double fromBase(double si) { if (scale == 0.0) { return 0.0; } return (si - offset) / scale; }
}

