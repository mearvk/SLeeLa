/*
 * lib/telephony-skya/SkyaModules.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SkyaModules, the Skya emblematic-module loader Master
 *   Class — loads and composes Socio, Network, Servers, Communication, and
 *   RealAcquaintances as naturals.
 *
 * SkyaModules is the small registry that brings the emblematic Skya modules up
 * together and confirms each loaded. Each module is a self-describing, loadable
 * SLeeLa class sharing the common contract (load / loaded / moduleName /
 * describe), so the Skya program can treat them uniformly — load now, or load
 * on demand as naturals. The runnable orchestration example lives in
 * telephony-skya/sleela/SkyaModules.sleela.
 *
 * Family: telephony-skya. Native VM/OS work crosses an explicit bridge.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class SkyaModules {

  Socio socio;
  Network network;
  Servers servers;
  Communication comm;
  RealAcquaintances acquaintances;
  int ready;

  void loadAll() {
    ready = 0;

    socio = new Socio();                 socio.load();
    if (socio.loaded()) { ready = ready + 1; }

    network = new Network();             network.load();
    if (network.loaded()) { ready = ready + 1; }

    servers = new Servers();             servers.load();
    if (servers.loaded()) { ready = ready + 1; }

    comm = new Communication();          comm.load();
    if (comm.loaded()) { ready = ready + 1; }

    acquaintances = new RealAcquaintances(); acquaintances.load();
    if (acquaintances.loaded()) { ready = ready + 1; }
  }

  int readyCount() { return ready; }
  boolean allReady() { return ready == 5; }
}
