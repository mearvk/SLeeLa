<< lib/cpu/SLRamTiming.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLRamTiming — the expert memory-timing settings of a RAM
     channel, stated the way a DRAM datasheet / BIOS does: the actual data rate
     (MT/s), the Vddq rail, and the primary timings CL, tRCD, tRP, tRAS, tRC and
     command rate as CLOCK CYCLES, plus the derived nanosecond latencies those
     cycles cost at the dialed data rate. Rather than assume memory keeps up,
     each primary timing becomes a named SLTiming budget checked against the bus
     period, and the first-word read latency is reported in real nanoseconds.
   
   Expert knobs are explicit: an operator tightens CL/tRCD/tRP/tRAS and the
   class recomputes real access latency and re-checks every budget against the
   settled Vddq, so tightening past what the voltage honors is refused.
   
   Family: cpu. Composes SLTiming and SLVoltageRail; partners SLRAM/SLBusTiming. >>
#sleela 2.5
material;
class SLRamTiming {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 11091;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-10-16";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-13";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  < nameful: "DIMM-A ch0", ... >
  String name;
  < transfers per second, millions (e.g. 3200 = DDR4-3200) >
  int dataRateMTs;
  < lowest data rate the operator may dial >
  int minMTs;
  < highest validated data rate >
  int maxMTs;

  < Primary timings, in command-clock CYCLES (the datasheet surface). >
  < CAS latency: read command -> first data >
  int cl;
  < RAS-to-CAS delay: activate -> read/write >
  int trcd;
  < row precharge: precharge -> next activate >
  int trp;
  < row active time: activate -> precharge >
  int tras;
  < row cycle: activate -> activate (same bank) >
  int trc;
  < 1 (1T) or 2 (2T) command rate >
  int commandRate;

  < the DRAM I/O supply rail >
  SLVoltageRail vddq;
  < settled Vddq each extra MT/s step of ceiling needs >
  int mvPerStep;
  < the MT/s granularity one voltage step buys >
  int stepMTs;

  < CAS-to-DQ named budget >
  SLTiming casBudget;
  < activate-to-CAS named budget >
  SLTiming rcdBudget;
  < precharge named budget >
  SLTiming rpBudget;

  void configure(String channelName, int rateMTs, int floorMTs, int ceilingMTs) {
    name = channelName; dataRateMTs = rateMTs; minMTs = floorMTs; maxMTs = ceilingMTs;
    cl = 16; trcd = 16; trp = 16; tras = 36; trc = 52; commandRate = 1;
    mvPerStep = 0; stepMTs = 0;

    casBudget = new SLTiming(); casBudget.configure("cas->dq", commandPeriodPs(), 50);
    casBudget.describe("read data must appear on DQ CL command-clocks after the CAS strobe");
    rcdBudget = new SLTiming(); rcdBudget.configure("act->cas", commandPeriodPs(), 50);
    rcdBudget.describe("the row must be fully sensed before a column command is honored");
    rpBudget = new SLTiming(); rpBudget.configure("precharge", commandPeriodPs(), 50);
    rpBudget.describe("the bank must precharge fully before the next row is activated");
    restamp();
  }

  void attachVddq(SLVoltageRail rail, int millivoltsPerStep, int mtsPerStep) {
    vddq = rail; mvPerStep = millivoltsPerStep; stepMTs = mtsPerStep;
  }

  < The command clock runs at half the data rate on DDR (two transfers per >
  < command clock). Period of one command clock, in picoseconds. >
  int commandClockMHz() { return dataRateMTs / 2; }
  int commandPeriodPs() { int f = commandClockMHz(); if (f <= 0) { return 0; } return 1000000 / f; }

  < Set each primary timing (in command-clock cycles). Larger = looser/safer. >
  void setCL(int cycles) { if (cycles > 0) { cl = cycles; restamp(); } }
  void setTRCD(int cycles) { if (cycles > 0) { trcd = cycles; restamp(); } }
  void setTRP(int cycles) { if (cycles > 0) { trp = cycles; restamp(); } }
  void setTRAS(int cycles) { if (cycles > 0) { tras = cycles; restamp(); } }
  void setTRC(int cycles) { if (cycles > 0) { trc = cycles; restamp(); } }
  void setCommandRate(int t) { if (t == 1 || t == 2) { commandRate = t; } }

  < Dial the data rate, clamped into [min,max] and into what settled Vddq >
  < supports. DDR data rate changes the command period every budget rides on. >
  int setDataRate(int mts) {
    int target = mts;
    if (target < minMTs) { target = minMTs; }
    if (target > maxMTs) { target = maxMTs; }
    int ceiling = voltageCeilingMTs();
    if (ceiling > 0 && target > ceiling) { target = ceiling; }
    dataRateMTs = target;
    restamp();
    return dataRateMTs;
  }

  int voltageCeilingMTs() {
    if (vddq == null || mvPerStep <= 0 || stepMTs <= 0) { return maxMTs; }
    int steps = vddq.effectiveMv() / mvPerStep;
    return steps * stepMTs;
  }

  < Re-derive each budget. A primary timing of N command-clocks must physically >
  < complete inside N clock periods: the window the controller allows is N >
  < periods, and the DRAM's internal settle (modeled as the array's fixed ~ns >
  < access translated back into this period) must fit with margin. We model the >
  < settle as (N-1) periods of propagation, so a tighter N shrinks the slack — >
  < tighten too far and the budget stops being honored. >
  void restamp() {
    int p = commandPeriodPs();
    casBudget.setPeriod(p * cl);     casBudget.setPropagation(p * (cl - 1));     casBudget.setSetup(0);
    rcdBudget.setPeriod(p * trcd);   rcdBudget.setPropagation(p * (trcd - 1));   rcdBudget.setSetup(0);
    rpBudget.setPeriod(p * trp);     rpBudget.setPropagation(p * (trp - 1));     rpBudget.setSetup(0);
  }

  < First-word read latency in nanoseconds: (tRCD + CL) command-clocks times >
  < the command period, divided by 1000 ps/ns. >
  int firstWordLatencyNs() { return ((trcd + cl) * commandPeriodPs()) / 1000; }

  < Random full-row access latency in ns: tRP (close) + tRCD (open) + CL. >
  int randomAccessLatencyNs() { return ((trp + trcd + cl) * commandPeriodPs()) / 1000; }

  < Honored when tRAS >= tRCD + CL (row stays open long enough to read it), >
  < tRC >= tRAS + tRP (the row cycle closes cleanly), and Vddq is in limits. >
  boolean honored() {
    boolean activeOk = tras >= (trcd + cl);
    boolean cycleOk = trc >= (tras + trp);
    boolean power = (vddq == null) || vddq.withinLimits();
    casBudget.honored(); rcdBudget.honored(); rpBudget.honored();
    return activeOk && cycleOk && power;
  }

  String channelName() { return name; }
  int dataRate() { return dataRateMTs; }
  int casLatency() { return cl; }
  int rasToCas() { return trcd; }
  int rowPrecharge() { return trp; }
  int rowActive() { return tras; }
  int rowCycle() { return trc; }
  int commandRateT() { return commandRate; }
}
