#sst 2.0
sheet DynamiteSQL {
  use sst.DynamiteConnector;
  use sst.MySQLConnector;
  system "DatabaseDefaults" {
    group "storage.sql";
    name "ConfiguredDatabase";
  }
  target sleela;
}

# Target SLeeLa form:
# import dynamite connector /lib/db/MySQL.sleela;
# dynamite config database-defaults;
# dynamite property port = 3306;
