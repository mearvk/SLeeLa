#sleela 2.1
/* Defensive model defaults; native enforcement must be verified independently. */
class Http40Limits {
  int maxEnvelopePayloadBytes = 4096;
  int maxTextEnvelopeBytes = 16384;
  int maxServices = 64;
  int maxOperationsPerService = 64;
  int maxNameBytes = 63;
  int maxBasketItems = 14;
  int macKeyBytes = 16;
  int digestBytes = 8;
  int intactxBytes = 8;
  int nonceBytes = 8;
  int basketBlockBytes = 172;
  int requestTimeoutMillis = 10000;
  int maxConcurrentStreams = 256;
  int maxHeaderBytes = 32768;
  int maxQueuedRequests = 1024;
  long downloadResumeThresholdBytes = 52428800;
  long maxStreamBytes = 0;
  boolean validPayloadLength(long n) { return n >= 0 && n <= maxEnvelopePayloadBytes; }
  boolean validDictionarySize(int services, int operations) {
    return services >= 0 && services <= maxServices &&
      operations >= 0 && operations <= maxOperationsPerService;
  }
  boolean validStreamCount(int streams) { return streams >= 0 && streams <= maxConcurrentStreams; }
  boolean validHeaderLength(int bytes) { return bytes >= 0 && bytes <= maxHeaderBytes; }
}
