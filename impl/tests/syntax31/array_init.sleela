#sleela 3.1
class ArrayInit {
  static int[] primes = {2, 3, 5, 7};
  void main() {
    int[] a = {3, 1, 2};
    String[] s = {"x", "y", "z"};
    double[] d = {1, 2.5, 4};
    boolean[] b = {true, false};
    int[] e = {};
    int[] t = {10, 20, 30,};
    print(arrayLength(a) + " " + a[0] + " " + a[1] + " " + a[2]);
    print(arrayLength(s) + " " + s[0] + s[1] + s[2]);
    print(d[0] / 2 + " " + d[1] + " " + d[2]);
    print(b[0] + " " + b[1]);
    print(arrayLength(e));
    print(arrayLength(t) + " " + t[2]);
    print(arrayLength(primes) + " " + primes[3]);
    int[] n = new int[]{4, 5, 6};
    print(arrayLength(n) + " " + (n[0] + n[1] + n[2]));
    print(sum(new int[]{1, 2, 3, 4}));
    int total = 0;
    for (int v : a) { total = total + v; }
    print(total);
  }
  int sum(int[] xs) {
    int r = 0;
    for (int i = 0; i < arrayLength(xs); i++) { r = r + xs[i]; }
    return r;
  }
}
