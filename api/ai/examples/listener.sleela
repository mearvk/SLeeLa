#sleela 1.3
// listener.sleela -- XML model/data listener declaration.
// The listener receives authorized source events; it does not grant
// implicit filesystem, network, or execution authority.

class AiXmlListener {
    int listener;

    void onSource(String kind, String url, String args) {
        print("source: " + kind + ": " + url + ": " + args);
    }

    void main() {
        listener = xmlListener("127.0.0.1", 45230, "http", "/ai/source");
        listenerAccept(listener, onSource);
        listenerClose(listener);
    }
}
