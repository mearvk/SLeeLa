  << Conversions between the seven units through each unit length in
     nanoseconds. Converting to a finer unit saturates at Long.MAX_VALUE and
     Long.MIN_VALUE, and converting to a coarser unit truncates toward zero,
     exactly as Java does. sleep(timeout) uses the SLeeLa sleep builtin, at
     millisecond resolution. The Duration, ChronoUnit, timedWait and timedJoin
     forms keep their stubs. >>
  long unitNanos() {
    if (this.enumOrdinal == 0) { return 1; }
    if (this.enumOrdinal == 1) { return 1000; }
    if (this.enumOrdinal == 2) { return 1000000; }
    if (this.enumOrdinal == 3) { return 1000000000; }
    if (this.enumOrdinal == 4) { return 60000000000; }
    if (this.enumOrdinal == 5) { return 3600000000000; }
    return 86400000000000;
  }
  long scaleTo(long d, long fromNanos, long toNanos) {
    if (fromNanos == toNanos) { return d; }
    if (fromNanos < toNanos) { return d / (toNanos / fromNanos); }
    long r = fromNanos / toNanos;
    long max = 9223372036854775807 / r;
    if (d > max) { return 9223372036854775807; }
    if (d < 0 - max) { return 0 - 9223372036854775807 - 1; }
    return d * r;
  }
  public long convert(long sourceDuration, TimeUnit sourceUnit) {
    return scaleTo(sourceDuration, sourceUnit.unitNanos(), unitNanos());
  }
  public long toNanos(long duration) { return scaleTo(duration, unitNanos(), 1); }
  public long toMicros(long duration) { return scaleTo(duration, unitNanos(), 1000); }
  public long toMillis(long duration) { return scaleTo(duration, unitNanos(), 1000000); }
  public long toSeconds(long duration) { return scaleTo(duration, unitNanos(), 1000000000); }
  public long toMinutes(long duration) { return scaleTo(duration, unitNanos(), 60000000000); }
  public long toHours(long duration) { return scaleTo(duration, unitNanos(), 3600000000000); }
  public long toDays(long duration) { return scaleTo(duration, unitNanos(), 86400000000000); }
  public void sleep(long timeout) {
    if (timeout > 0) { sleep(toMillis(timeout)); }
