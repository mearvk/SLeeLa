/*
 * lib/core/SLIdentifier.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLIdentifier used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Identifier.
// Role: language. Responsibility: stable identity.
class SLIdentifier {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
