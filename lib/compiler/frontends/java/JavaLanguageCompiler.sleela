/*
 * lib/compiler/frontends/java/JavaLanguageCompiler.sleela
 * SLeeLa Standard Library Definition.
 * Definition: A modular front end that compiles the Java programming language
 *   into SLeeLa IR and onward to an SLJVM artifact.
 *
 * Java is a JVM-family language. This front end declares the SLJVM target as
 * its default so lowering targets the SLeeLa JVM-family artifact rather than
 * the native SLVM. It demonstrates that the modular framework spans managed and
 * native language families through one common contract.
 *
 * Family: compiler (front end). Native VM/OS work crosses an explicit bridge.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class JavaLanguageCompiler extends SLLanguageCompiler {

  void configure() {
    declare("Java", "JVM", "Java 21", ".java", TARGET_SLJVM);
    provide(PHASE_SOURCE);
    provide(PHASE_LEX);
    provide(PHASE_PARSE);
    provide(PHASE_RESOLVE);
    provide(PHASE_SEMANTIC);
    provide(PHASE_IR);
    provide(PHASE_LOWER);
    provide(PHASE_CODEGEN);
  }

  boolean runParse(SLCompileRequest request) {
    // Java parsing: compilation units, package/imports, class/interface/record
    // declarations, members, and statements.
    return provides(PHASE_PARSE);
  }
}
