<< lib/java/support/SLJavaBits.sleela
Bit arithmetic for the Java container: 32-bit and/or/xor/not, rotate, and the
   unsigned halves of a 64-bit long, built from arithmetic because the VM has no
   bitwise operators. >>
#sleela 3.0
material;

class SLJavaBits {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs. Shared support
     class of the /lib/java Java container; written for SLeeLa, not copied from
     the JDK. MD5 follows RFC 1321 by R. Rivest (IETF, April 1992). >>
  String metaVersion = "1.0.0";
  int metaId = 39401;
  String metaAuthor = "Max Rupplin";
  String metaDate = "2026-11-12";
  String metaCopyright = "MEARVK LLC";
  String metaTrademark = "none";
  String metaCorporation = "MEARVK LLC";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-12";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 8;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  << The VM has no bitwise operators, so these work on unsigned 32-bit values
     held in a long (range 0 .. 4294967295) and on the two halves of a 64-bit long. >>

  < the unsigned low and high 32-bit halves of a signed long, and the inverse >
  static long lo(long v) {
    long r = v % 4294967296;
    if (r < 0) { r = r + 4294967296; }
    return r;
  }
  static long hi(long v) {
    long l = lo(v);
    long h = (v - l) / 4294967296;
    if (h < 0) { h = h + 4294967296; }
    return h;
  }
  static long make(long hiUnsigned, long loUnsigned) {
    long h = hiUnsigned;
    if (h >= 2147483648) { h = h - 4294967296; }
    return h * 4294967296 + loUnsigned;
  }

  < op 0 = and, 1 = or, 2 = xor, on two unsigned 32-bit values >
  static long bit(long a, long b, int op) {
    long r = 0;
    long p = 1;
    int i = 0;
    while (i < 32) {
      long x = a % 2;
      long y = b % 2;
      long z = 0;
      if (op == 0) { z = x * y; }
      if (op == 1) { z = x + y; if (z > 1) { z = 1; } }
      if (op == 2) { z = (x + y) % 2; }
      r = r + z * p;
      p = p * 2;
      a = a / 2;
      b = b / 2;
      i = i + 1;
    }
    return r;
  }
  static long and32(long a, long b) { return bit(a, b, 0); }
  static long or32(long a, long b) { return bit(a, b, 1); }
  static long xor32(long a, long b) { return bit(a, b, 2); }
  static long not32(long a) { return 4294967295 - a; }

  < rotate an unsigned 32-bit value left by n bits (0 .. 31) >
  static long rotl32(long x, int n) {
    long p = 1;
    int i = 0;
    while (i < n) { p = p * 2; i = i + 1; }
    long h = x / (4294967296 / p);
    long l = (x % (4294967296 / p)) * p;
    return l + h;
  }

  < x modulo m, always in 0 .. m-1 (Java x % m can be negative) >
  static long mod(long x, long m) {
    long r = x % m;
    if (r < 0) { r = r + m; }
    return r;
  }

  < wrap x to a signed two-complement value of the given width (8, 16, 32) >
  static long wrap(long x, int bits) {
    long m = 1;
    int i = 0;
    while (i < bits) { m = m * 2; i = i + 1; }
    long r = mod(x, m);
    if (r >= m / 2) { r = r - m; }
    return r;
  }
}
