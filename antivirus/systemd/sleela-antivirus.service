[Unit]
Description=SLeeLa Antivirus Coordinator
Documentation=https://github.com/mearvk/SLeeLa/tree/master/antivirus
After=local-fs.target network.target
Wants=clamd.service clamav-daemon.service

[Service]
Type=simple
Environment=SLEELA_ANTIVIRUS_ENGINE=both
Environment=SLEELA_ANTIVIRUS_ROOT=/var/lib/sleela-antivirus
Environment=SLEELA_ANTIVIRUS_REPORT=/var/log/sleela-antivirus/scan-report.json
Environment=SLEELA_ANTIVIRUS_QUARANTINE=/var/lib/sleela-antivirus/quarantine
Environment=SLEELA_ANTIVIRUS_DB=/opt/sleela/antivirus/signatures/native-sha256.txt
Environment=SLEELA_ANTIVIRUS_NATIVE=/opt/sleela/antivirus/build/sleelavirin-scan
WorkingDirectory=/opt/sleela
ExecStart=/usr/bin/env python3 /opt/sleela/antivirus/tools/sleelavirin_scan.py \
  --engine ${SLEELA_ANTIVIRUS_ENGINE} \
  --database ${SLEELA_ANTIVIRUS_DB} \
  --native-scanner ${SLEELA_ANTIVIRUS_NATIVE} \
  --report-json ${SLEELA_ANTIVIRUS_REPORT} \
  --quarantine-dir ${SLEELA_ANTIVIRUS_QUARANTINE} \
  ${SLEELA_ANTIVIRUS_ROOT}
Restart=on-failure
RestartSec=30
RuntimeDirectory=sleela-antivirus
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/sleela-antivirus /var/log/sleela-antivirus

[Install]
WantedBy=multi-user.target
