/*
 * lib/regex/RegexReplacer.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexReplacer used within the regex library family.
 */
#sleela 2.1
class RegexReplacer {
  string replacement;
  void set(string value){replacement=value;}
  string get(){return replacement;}
}
