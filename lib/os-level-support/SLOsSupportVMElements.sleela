      "osTempDir", "slos_tempdir", "CommonBackend", "ReadOnlyQuery", "Implemented", 0, 0);
    e.setResultTerm("Utf8Path");
    return e;
  }

  SLOsSupportElement processId() {
    SLOsSupportElement e = new SLOsSupportElement();
    e.configure("processId", "ProcessInspection", "OSProcess", "OP_OS_PID:112",
