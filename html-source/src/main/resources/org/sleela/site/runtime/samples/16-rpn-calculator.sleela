#sleela 2.2
< A stack machine: evaluates reverse Polish programs. Operators are negative codes: -1 add, -2 subtract, -3 multiply, -4 divide. >
class RpnCalculator {
  int[] stack = new int[16];
  int top = 0;

  void push(int v) {
    stack[top] = v;
    top = top + 1;
  }

  int pop() {
    top = top - 1;
    return stack[top];
  }

  int run(int[] program, int length) {
    top = 0;
    for (int i = 0; i < length; i = i + 1) {
      int t = program[i];
      if (t >= 0) {
        push(t);
      } else {
        int b = pop();
        int a = pop();
        if (t == -1) { push(a + b); }
        if (t == -2) { push(a - b); }
        if (t == -3) { push(a * b); }
        if (t == -4) { push(a / b); }
      }
    }
    return pop();
  }

  void main() {
    for (int i = 0; i < 16; i = i + 1) {
      stack[i] = 0;
    }
    int[] p1 = new int[5];
    p1[0] = 3; p1[1] = 4; p1[2] = -1; p1[3] = 5; p1[4] = -3;
    print("3 4 + 5 *     = " + run(p1, 5));
    int[] p2 = new int[7];
    p2[0] = 20; p2[1] = 4; p2[2] = -4; p2[3] = 7; p2[4] = 2; p2[5] = -2; p2[6] = -3;
    print("20 4 / 7 2 - * = " + run(p2, 7));
    int[] p3 = new int[11];
    p3[0] = 1; p3[1] = 2; p3[2] = 3; p3[3] = 4; p3[4] = 5;
    p3[5] = -1; p3[6] = -1; p3[7] = -1; p3[8] = -1; p3[9] = 0; p3[10] = -1;
    print("1 2 3 4 5 + + + + 0 + = " + run(p3, 11));
  }

  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Baseline identity for a worker-class example. Values are faithful to the real origin; unknown values are none. >>
  String metaVersion = "1.0.0";
  int metaId = 9116;
  String metaAuthor = "MEARVK LLC";
  String metaDate = "2026-11-18";
  String metaCopyright = "none";
  String metaTrademark = "none";
  String metaCorporation = "MEARVK LLC";
  String metaOrigin = "National";
  String metaBirthDate = "2026";
  int metaScienceRating = 4;
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getMetaAuthor() { return metaAuthor; }
  void setMetaAuthor(String v) { metaAuthor = v; }
  String getMetaDate() { return metaDate; }
  void setMetaDate(String v) { metaDate = v; }
  String getMetaCopyright() { return metaCopyright; }
  void setMetaCopyright(String v) { metaCopyright = v; }
  String getMetaTrademark() { return metaTrademark; }
  void setMetaTrademark(String v) { metaTrademark = v; }
  String getMetaCorporation() { return metaCorporation; }
  void setMetaCorporation(String v) { metaCorporation = v; }
  String getMetaOrigin() { return metaOrigin; }
  void setMetaOrigin(String v) { metaOrigin = v; }
  String getMetaBirthDate() { return metaBirthDate; }
  void setMetaBirthDate(String v) { metaBirthDate = v; }
  int getMetaScienceRating() { return metaScienceRating; }
  void setMetaScienceRating(int v) { metaScienceRating = v; }
  String getMetaNationalSchedule() { return metaNationalSchedule; }
  void setMetaNationalSchedule(String v) { metaNationalSchedule = v; }
}
