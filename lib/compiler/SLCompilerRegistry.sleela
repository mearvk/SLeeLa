/*
 * lib/compiler/SLCompilerRegistry.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLCompilerRegistry, the catalog where a developer
 *   registers many language front ends and looks them up by name or by source
 *   file extension.
 *
 * The registry is what makes the framework modular: each language is an
 * independent SLLanguageCompiler subclass, and the registry holds them side by
 * side with no per-language allow-list baked into the compiler. A developer can
 * register as many implementations as they like; lookup resolves a compile
 * request to exactly one front end, or reports that none claims it.
 *
 * Family: compiler. Native VM/OS work crosses an explicit bridge.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class SLCompilerRegistry {

  // Clear the registry back to empty.
  void reset() {
    native sleela_lang_registry_reset();
  }

  // Register (or replace by name) a language front end. Returns true on success.
  boolean add(SLLanguageCompiler frontEnd) {
    int rc = frontEnd.register();
    return rc == 1; // SLEELA_LANG_OK
  }

  // How many front ends are registered.
  int count() {
    return native sleela_lang_registry_count();
  }

  // Is a language registered?
  boolean has(String languageName) {
    return native sleela_lang_has(languageName) == 1;
  }

  // Resolve a compile request to a front-end language name by the input's
  // extension. Returns the matched language name, or the empty string when no
  // registered front end claims the extension (unresolved is surfaced, not
  // guessed).
  String resolveByExtension(String fileName) {
    return native sleela_lang_resolve_extension(fileName);
  }
}
