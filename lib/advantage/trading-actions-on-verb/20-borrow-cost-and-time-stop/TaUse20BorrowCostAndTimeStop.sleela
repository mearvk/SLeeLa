<< lib/advantage/trading-actions-on-verb/20-borrow-cost-and-time-stop/TaUse20BorrowCostAndTimeStop.sleela
   SLeeLa trading-action use case.
   Definition: Time on short: borrow cost is exact per share-day, accrues on open lots, is paid on cover, and a time stop covers shares short too long. >>
#sleela 3.0
material;
artifact;
pure;
gasoline;
< Use case 20 (time, short). Borrow rate 3 cents per share per day. 40 shares >
< short from day 0 and 60 from day 50. Accrued cost on open lots is shares times >
< days times rate; it is paid when the shares are covered. A time stop covers >
< every share short for more than 90 days, using the same bounded loop idea as the >
< long time stop: the old quantity strictly falls, so the loop ends. >
class TaUse20BorrowCostAndTimeStop {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs. A worker-class
     lesson carries the baseline identity record. >>
  String metaVersion = "1.0.0";
  int metaId = 39320;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-11";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-11";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 5;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }


  int passed = 0;
  int failed = 0;

  void expect(String label, int got, int want) {
    if (got == want) {
      print("  ok   " + label + " = " + got);
      passed = passed + 1;
    } else {
      print("  FAIL " + label + " got " + got + " want " + want);
      failed = failed + 1;
    }
  }

  void expectTrue(String label, boolean got) {
    if (got) {
      print("  ok   " + label);
      passed = passed + 1;
    } else {
      print("  FAIL " + label);
      failed = failed + 1;
    }
  }

  void summary() {
    print("  checks passed=" + passed + " failed=" + failed);
  }

  void act(SLLongBook b, String text, int code) {
    print("  " + text + " : " + b.reason(code));
  }

  void act2(SLShortBook b, String text, int code) {
    print("  " + text + " : " + b.reason(code));
  }

  void main() {
    SLShortBook book = new SLShortBook();
    print("== Use case 20: borrow cost and time stop ==");
    expect("set the borrow rate", book.setBorrowRate(3), 0);
    act2(book, "short 40 @ 5000 on day 0", book.shortSell(0, 40, 5000, 0));
    act2(book, "short 60 @ 5100 on day 50", book.shortSell(50, 60, 5100, 0));
    print("-- day 100 --");
    expect("oldest age", book.oldestAge(100), 100);
    expect("weighted age (40*100 + 60*50) / 100", book.weightedAgeFloor(100), 70);
    expect("borrow accrued, not yet paid", book.borrowAccrued(100), 21000);
    expect("shares short for more than 60 days", book.qtyOlderThan(100, 60), 40);
    act2(book, "cover 40 @ 4900 on day 100", book.cover(100, 40, 4900, 0));
    expect("profit of that cover", book.lastCoverPnl, 4000);
    expect("borrow paid (40 * 100 * 3)", book.borrowCostPaid(), 12000);
    expect("borrow accrued on what remains", book.borrowAccrued(100), 9000);
    print("-- day 150: time stop at 90 days --");
    act2(book, "hold to day 150", book.hold(150));
    int old = book.qtyOlderThan(150, 90);
    expect("shares short for more than 90 days", old, 60);
    int passes = 0;
    while (old > 0 && passes < 10) {
      act2(book, "time stop: cover " + old + " @ 4950 on day 150", book.cover(150, old, 4950, 0));
      passes = passes + 1;
      old = book.qtyOlderThan(150, 90);
    }
    expect("passes taken", passes, 1);
    expect("shares short", book.totalShort(), 0);
    expect("total borrow paid", book.borrowCostPaid(), 30000);
    expect("realized net", book.realizedNet(), -17000);
    expect("oldest age when flat", book.oldestAge(150), 0 - 1);
    expect("a day before the book day has no answer", book.borrowAccrued(10), 0 - 1);
    expectTrue("invariants hold", book.invariantsHold());
    summary();
  }
}
