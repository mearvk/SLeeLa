<< lib/advantage/math/trade-math-demo.sleela
   SLeeLa Standard Library Definition.
   Definition: Runnable demonstration + validation of the advantage/math trade
   subject (joint profit max, Nash bargaining, bilateral newsvendor). >>
#sleela 2.5
material;
< `run` auto-links the sibling subject classes in advantage/math (SLTradeMath, >
< SLJointProfitMax, SLNashBargaining, SLBilateralNewsvendor), so no imports are >
< needed. Curves: R_B(Q)=100Q-Q^2, C_S(Q)=20Q+Q^2. Hand-computed anchors: >
< Q*=20, Pi_total=800, Nash P*(0.5)=60 splitting 400/400, F(Q*)=80/95~0.8421. >
class TradeMathDemo {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs. A worker-class demo
     carries the baseline identity record. >>
  String metaVersion = "1.0.0";
  int metaId = 10529;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-08";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-08";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 8;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  boolean near(double a, double b, double tol) {
    double d = a - b;
    if (d < 0.0) { d = 0.0 - d; }
    return d < tol;
  }

  void main() {
    print("== advantage/math trade subject ==");

    SLJointProfitMax jpm = new SLJointProfitMax();
    jpm.configureCurves(100.0, 1.0, 20.0, 1.0);
    double qstar = jpm.optimalQuantity();
    double piMax = jpm.maxJointProfit();
    print("1. " + jpm.describe());

    SLNashBargaining nash = new SLNashBargaining();
    nash.configure(jpm);
    double pstar = nash.nashPrice(0.0, 0.0, 0.5);
    double sProf = nash.sellerProfit(pstar, qstar);
    double bProf = nash.buyerProfit(pstar, qstar);
    print("2. " + nash.describe(0.0, 0.0, 0.5));
    double pPow = nash.nashPrice(0.0, 0.0, 0.75);
    double sPow = nash.sellerProfit(pPow, qstar);
    print("   alpha=0.75 -> P*=" + pPow + " sellerProfit=" + sPow);

    SLBilateralNewsvendor nv = new SLBilateralNewsvendor();
    double cr = nv.criticalRatio(100.0, 20.0, 5.0);
    double gap = nv.coordinationGap(100.0, 20.0, 60.0, 5.0);
    print("3. " + nv.describe(100.0, 20.0, 5.0));
    print("   coordination gap (P=60) = " + gap);

    print("");
    print("== validation ==");
    boolean okQ   = near(qstar, 20.0, 0.00001);
    boolean okPi  = near(piMax, 800.0, 0.00001);
    boolean okP   = near(pstar, 60.0, 0.00001);
    boolean okSB  = near(sProf, 400.0, 0.00001);
    boolean okBB  = near(bProf, 400.0, 0.00001);
    boolean okPow = near(sPow, 600.0, 0.00001);
    boolean okCR  = near(cr, 0.8421052631578947, 0.0001);
    print("  Q* == 20             ? " + okQ);
    print("  Pi_total == 800      ? " + okPi);
    print("  Nash P* == 60        ? " + okP);
    print("  seller == 400        ? " + okSB);
    print("  buyer == 400         ? " + okBB);
    print("  alpha .75 seller=600 ? " + okPow);
    print("  critical ratio ~.842 ? " + okCR);
    if (okQ) {
      if (okPi) {
        if (okP) {
          if (okSB) {
            if (okBB) {
              if (okPow) {
                if (okCR) {
                  print("ALL CHECKS PASSED");
                }
              }
            }
          }
        }
      }
    }
  }
}
