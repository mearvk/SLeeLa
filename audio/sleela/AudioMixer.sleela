#sleela 1.3
// Handle-oriented mixer facade. The handle never exposes a native pointer.
class AudioMixer {
  static int create(int sampleRate, String outputPath) {
    return audioNew(sampleRate, outputPath);
  }

  static int add(int handle, String path, double startSeconds, double gainDb) {
    return audioAdd(handle, path, startSeconds, gainDb);
  }

  static int setControls(int handle, double bassDb, double midDb, double trebleDb,
                         double masterGainDb, double pan, double leftGain, double rightGain) {
    return audioControls(handle, bassDb, midDb, trebleDb, masterGainDb, pan, leftGain, rightGain);
  }

  static bool render(int handle) { return audioRender(handle); }
  static void reset(int handle) { audioClose(handle); return; }
}
