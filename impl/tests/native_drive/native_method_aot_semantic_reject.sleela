#sleela 3.0
class NativeAotSemanticReject {
    @native
    static boolean invalidLogical(int value) {
        return value && true;
    }

    @native
    static boolean invalidConditional(int value) {
        return value ? true : false;
    }

    @native
    static boolean invalidNegation(int value) {
        return !value;
    }

    @native
    static int invalidWhile(int value) {
        while (value) {
            return 1;
        }
        return 0;
    }

    @native
    static int invalidFor(int value) {
        for (int i = 0; value; i = i + 1) {
            break;
        }
        return 0;
    }

    static int main() {
        if (1) {
            return 1;
        }
        return 0;
    }
}
