/*
 * lib/regex/RegexOptions.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexOptions used within the regex library family.
 */
#sleela 1.3
class RegexOptions {
  int value;
  void clear(){value=0;}
  void set(int option){value=value+option;}
  int get(){return value;}
}
