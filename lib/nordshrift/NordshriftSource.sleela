#sleela 2.5
< Source-facing Nordshrift contract. >
< .sst remains the authoring surface; this object records its resolved >
< SLeeLa source result before the normal compiler/VM pipeline. >
class NordshriftSource {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10027;
  String metaAuthor = "Max Rupplin vs. Dr. Mrs. Elisabeth Harkins";
  String metaDate = "2026-10-16";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-02";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
 String sheetPath;
 String libraryRoot;
 String outputSource;
 String target;
 uint32 resolvedPackages;
 uint32 resolvedSymbols;
 uint32 resolved;
 uint32 emitted;
 < Whole-tree access facts. Nordshrift resolves through the SAME recursive >
 < sleela::library::Index the compiler uses, so it reaches EVERY package >
 < under /lib and every .sleela unit inside them -- no per-folder allow-list. >
 uint32 availablePackages;
 uint32 availableSymbols;
 uint32 fullTreeAccess;

 function configure(sheet,root,targetName){
  sheetPath=sheet;libraryRoot=root;target=targetName;
 }
 function resolveLibrary(){resolved=1;return 1;}
 function recordResolution(packages,symbols){
  resolvedPackages=packages;resolvedSymbols=symbols;
 }
 < Record the complete /lib index the driver discovered (every package and >
 < every .sleela unit under the root), so the SLeeLa-layer contract reflects >
 < that resolution spans the entire library tree, not a curated subset. >
 function recordLibraryIndex(packages,symbols){
  availablePackages=packages;availableSymbols=symbols;
  fullTreeAccess=(packages>0 && symbols>0 &&
                  resolvedPackages==packages && resolvedSymbols==symbols)?1:0;
  return fullTreeAccess;
 }
 < True only when this source resolved against the full discovered index -- >
 < i.e. it can see all /lib folders and what is inside them. >
 function reachesWholeLibrary(){return fullTreeAccess==1;}
 function emitSleela(sourcePath){
  outputSource=sourcePath;emitted=1;return 1;
 }
 function validate(){
  return resolved==1;
 }
}
