    else if (field == 3 || field == 4 || field == 8) { this.gcTime = this.gcTime + amount * 7 * 86400000; }
    else if (field == 5 || field == 6 || field == 7) { this.gcTime = this.gcTime + amount * 86400000; }
    else if (field == 9) { this.gcTime = this.gcTime + amount * 43200000; }
    else if (field == 10 || field == 11) { this.gcTime = this.gcTime + amount * 3600000; }
    else if (field == 12) { this.gcTime = this.gcTime + amount * 60000; }
    else if (field == 13) { this.gcTime = this.gcTime + amount * 1000; }
    else if (field == 14) { this.gcTime = this.gcTime + amount; }
    else if (field == 0 || field == 15 || field == 16) {
