<< Deterministic summary of Registry records and validation outcomes. >>
#sleela 3.0
material;
class SLRegistryReview {
  int recordCount;
  int relationshipCount;
  int verifiedCount;
  int quarantinedCount;
  String report;

  void reset() {
    recordCount = 0;
    relationshipCount = 0;
    verifiedCount = 0;
    quarantinedCount = 0;
    report = "";
  }

  void setReport(String value) { report = value; }
}