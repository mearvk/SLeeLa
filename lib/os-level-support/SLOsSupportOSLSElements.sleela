      "osls_get_cpu_info", "osls_get_cpu_info", "CommonBackend",
      "ReadOnlyQuery", "Partial", 1, 0);
    e.setResultTerm("StatusAndCPURecord");
    return e;
  }

  SLOsSupportElement getEnvironmentValue() {
    SLOsSupportElement e = new SLOsSupportElement();
    e.configure("getEnvironmentValue", "Environment", "OSEnvironment", "OP_OSLS_CALL:155/3",
      "osls_get_environment_value", "osls_get_environment_value", "CommonBackend",
