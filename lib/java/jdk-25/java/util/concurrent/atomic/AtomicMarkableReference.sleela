  < ---- java.util.concurrent.atomic.AtomicMarkableReference members (procedural implementation in SLeeLa) ---- >
  << A reference and an boolean mark updated together under VM lock 31 (reserved
     for java.util.concurrent.atomic), so a spawned thread never sees one
     without the other. compareAndSet compares the reference with == (value
     equality for numbers, identity for objects) and the mark by value;
     weakCompareAndSet is the same operation. >>
  Any stRef;
  boolean stMark = false;

  public AtomicMarkableReference(Any initialRef, boolean initialMark) {
    this.stRef = initialRef;
    this.stMark = initialMark;
  }
  public Any getReference() { return this.stRef; }
  public boolean isMarked() { return this.stMark; }
  public Any get(boolean[] markHolder) {
    lock(31);
    Any r = this.stRef;
    markHolder[0] = this.stMark;
    unlock(31);
    return r;
  }
  public void set(Any newReference, boolean newMark) {
    lock(31);
    this.stRef = newReference;
    this.stMark = newMark;
    unlock(31);
  }
  public boolean compareAndSet(Any expectedReference, Any newReference, boolean expectedMark, boolean newMark) {
    lock(31);
    boolean ok = false;
    if (this.stRef == expectedReference && this.stMark == expectedMark) {
      this.stRef = newReference;
      this.stMark = newMark;
      ok = true;
    }
    unlock(31);
    return ok;
  }
  public boolean weakCompareAndSet(Any expectedReference, Any newReference, boolean expectedMark, boolean newMark) {
    return compareAndSet(expectedReference, newReference, expectedMark, newMark);
  }
  public boolean attemptMark(Any expectedReference, boolean newMark) {
    lock(31);
    boolean ok = false;
    if (this.stRef == expectedReference) {
      this.stMark = newMark;
      ok = true;
    }
    unlock(31);
    return ok;
  }
