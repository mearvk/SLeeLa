  << java.lang.Byte in SLeeLa, written from the JDK 28 API specification
     (Java Source above). Java names, static modifiers and return types are
     kept. The VM has no byte primitive: a Byte value is an int held inside the
     Java range -128..127, and slNarrow wraps any int back into it with the
     two's-complement rule Java applies on overflow. parseByte, valueOf and decode
     go through Integer and then range-check, throwing NumberFormatException
     with the JDK messages. >>
  byte value;

  public Byte(byte value) { this.value = value; }
  @throwable("java.lang.NumberFormatException")
  public Byte(java.lang.String s) { this.value = parseByte(s, 10); }

  static int slNarrow(long v) {
    long m = v % 256;
    if (m < 0) { m = m + 256; }
    if (m > 127) { m = m - 256; }
    return m;
  }
  static int slRange(int i, java.lang.String s, int radix) {
    if (i < -128 || i > 127) {
      throw new NumberFormatException("Value out of range. Value:\"" + s + "\" Radix:" + radix);
    }
    return i;
  }

  < instance members >
  public byte byteValue() { return value; }
  public short shortValue() { return slNarrowShort(value); }
  public int intValue() { return value; }
  public long longValue() { return value; }
  public float floatValue() { double d = value; return d; }
  public double doubleValue() { double d = value; return d; }
  public java.lang.String toString() { return Integer.toString(value); }
  public int hashCode() { return value; }
  public boolean equals(java.lang.Object obj) {
    if (obj instanceof Byte) { Byte o = (Byte) obj; return o.value == value; }
    return false;
  }
  public int compareTo(java.lang.Byte anotherByte) { Byte o = (Byte) anotherByte; return compare(value, o.value); }

  < static members >
  public static java.lang.String toString(byte x) { return Integer.toString(x); }
  public static int hashCode(byte value) { return value; }
  public static int compare(byte x, byte y) { return x - y; }
  public static int compareUnsigned(byte x, byte y) { return toUnsignedInt(x) - toUnsignedInt(y); }
  public static int toUnsignedInt(byte x) { return x & 255; }
  public static long toUnsignedLong(byte x) { return x & 255; }
  static int slNarrowShort(long v) { return v; }
  @throwable("java.lang.NumberFormatException")
  public static byte parseByte(java.lang.String s, int radix) {
    int i = Integer.parseInt(s, radix);
    return slRange(i, s, radix);
  }
  @throwable("java.lang.NumberFormatException")
  public static byte parseByte(java.lang.String s) { return parseByte(s, 10); }
  @throwable("java.lang.NumberFormatException")
  public static java.lang.Byte valueOf(java.lang.String s, int radix) { return new Byte(parseByte(s, radix)); }
  @throwable("java.lang.NumberFormatException")
  public static java.lang.Byte valueOf(java.lang.String s) { return new Byte(parseByte(s, 10)); }
  public static java.lang.Byte valueOf(byte x) { return new Byte(x); }
  @throwable("java.lang.NumberFormatException")
  public static java.lang.Byte decode(java.lang.String nm) {
    Integer boxed = (Integer) Integer.decode(nm);
    int i = boxed.intValue();
    if (i < -128 || i > 127) {
      throw new NumberFormatException("Value " + i + " out of range from input " + nm);
    }
    return new Byte(i);
  }
