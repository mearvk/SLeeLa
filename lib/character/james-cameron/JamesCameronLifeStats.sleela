/*
 * James Cameron life-capability profile for SLeeLa simulation.
 * Every 1..30 value below is a hypothetical modeling input, NOT a measured
 * IQ, diagnosis, personality test, private-life fact, or verified statistic.
 * Unknown real-world measures remain explicitly unavailable.
 */
#sleela 2.1

class JamesCameronLifeStats {
  String subjectName;
  String scaleDefinition;
  String profileStatus;
  String evidenceNote;
  String sourceUrl;

  int intelligence;
  int creativity;
  int systemsThinking;
  int technicalInnovation;
  int execution;
  int exploration;
  int collaboration;
  int resilience;
  int sustainability;

  int publicCareerYears;
  int majorProfessionalDomains;
  int academyAwardsPersonallyWon;
  int billionDollarFilms;
  int dataConfidence;

  void load() {
    subjectName = "James Cameron";
    scaleDefinition = "1..30 illustrative capability scale; 0 means unknown";
    profileStatus = "hypothetical-scenario";
    evidenceNote = "Capability scores are simulation assumptions, not measured facts. Public career counts require source verification.";
    sourceUrl = "";

    // Scenario values requested for modeling; not claims about actual cognition.
    intelligence = 19;
    creativity = 20;
    systemsThinking = 19;
    technicalInnovation = 19;
    execution = 18;
    exploration = 18;
    collaboration = 16;
    resilience = 18;
    sustainability = 0; // unknown; never infer health or private-life efficiency

    // Public-career indicators default to unknown until a dated source is attached.
    publicCareerYears = 0;
    majorProfessionalDomains = 0;
    academyAwardsPersonallyWon = 0;
    billionDollarFilms = 0;
    dataConfidence = 0;
  }

  boolean setPublicCareerMetrics(int years, int domains, int awards, int billionFilms,
                                 int confidence, String source) {
    if (years < 0 || domains < 0 || awards < 0 || billionFilms < 0
        || confidence < 0 || confidence > 100) { return false; }
    publicCareerYears = years;
    majorProfessionalDomains = domains;
    academyAwardsPersonallyWon = awards;
    billionDollarFilms = billionFilms;
    dataConfidence = confidence;
    if (source != null) { sourceUrl = source; }
    return true;
  }

  int intelligenceModifier() {
    if (intelligence == 0) { return 0; }
    return floorHalf(intelligence - 10);
  }

  // Game-like normalized index: INT 10 -> 100; each point adds five.
  // This is a scenario throughput index, not real-world cognition or output.
  int intelligencePlanningIndex() {
    if (intelligence == 0) { return 0; }
    return 100 + (intelligence - 10) * 5;
  }

  int creativeSystemsIndex() {
    if (creativity == 0 || systemsThinking == 0 || technicalInnovation == 0) { return 0; }
    return (creativity + systemsThinking + technicalInnovation) * 100 / 90;
  }

  int floorHalf(int value) {
    if (value >= 0) { return value / 2; }
    return (value - 1) / 2;
  }

  boolean hasVerifiedCareerMetrics() {
    return dataConfidence >= 80 && sourceUrl != null && sourceUrl.length() > 0;
  }

  String report() {
    return subjectName + " life-capability profile"
      + " status=" + profileStatus
      + " INT=" + intelligence
      + " INT_modifier=" + intelligenceModifier()
      + " INT_planning_index=" + intelligencePlanningIndex()
      + " creative_systems_index=" + creativeSystemsIndex()
      + " career_years=" + publicCareerYears
      + " domains=" + majorProfessionalDomains
      + " awards=" + academyAwardsPersonallyWon
      + " billion_dollar_films=" + billionDollarFilms
      + " confidence=" + dataConfidence;
  }
}
