/*
 * lib/regex/RegexResult.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexResult used within the regex library family.
 */
#sleela 2.1
class RegexResult {
  boolean success;
  int code;
  string message;
  void clear(){success=false;code=0;message="";}
  void ok(){success=true;code=0;}
  boolean passed(){return success;}
}
