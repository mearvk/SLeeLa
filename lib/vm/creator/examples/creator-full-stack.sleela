/*
 * lib/vm/creator/examples/creator-full-stack.sleela
 * SLeeLa example: the full Creator -> SLVM -> Sleela CPU -> program stack.
 *
 * Demonstrates the end-to-end chain in one object:
 *   1. SleelaVMCreator selects a VM generation and builds+boots a live Secondary
 *      Sleela VM (SLVM), which runs on the native Sleela VM substrate.
 *   2. The creator installs a Sleela CPU model (SL6502CPU) as the VM's executor,
 *      nested on the SLVM substrate.
 *   3. A C / C++ / Java / Sleela program is run through that CPU under the SLVM.
 *   4. The observable result surfaces back up through the creator.
 *
 * The same workload produces the same result whichever source language it came
 * from (1:1 Turing effect) and whichever Sleela CPU hosts it.
 */
#sleela 1.3
class CreatorFullStackExample {
  int cResult;
  int javaResult;

  void main() {
    // A resource grant bounding the guest program.
    SLCPUResource grant = new SLCPUResource();
    grant.configure(4096, 100000, grant.PRIORITY_NORMAL);

    // The executor: a Sleela CPU model.
    SL6502CPU cpu = new SL6502CPU();
    cpu.configure();

    // Build the whole stack with the creator and run a C program through it.
    SleelaVMCreator creator = new SleelaVMCreator();
    creator.configure();
    SLWorkload cJob = new SLWorkload();
    cJob.configure("hello-c", "examples/hello.c", cJob.LANG_C, grant);
    // run(generation, cpu, workload, budget): generation 5 == "Manager".
    cResult = creator.run(5, cpu, cJob, 1000000);
    print("C via Creator->SLVM->6502 -> " + cResult +
          " (VM generation: " + creator.generationName() + ")");

    // Reuse the booted VM + CPU for a Java program (fresh grant).
    SLCPUResource grant2 = new SLCPUResource();
    grant2.configure(4096, 100000, grant2.PRIORITY_NORMAL);
    SLWorkload javaJob = new SLWorkload();
    javaJob.configure("hello-java", "examples/Hello.java", javaJob.LANG_JAVA, grant2);
    javaResult = creator.runProgram(javaJob, 1000000);
    print("Java via Creator->SLVM->6502 -> " + javaResult);
  }
}
