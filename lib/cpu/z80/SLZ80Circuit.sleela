<< lib/cpu/z80/SLZ80Circuit.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLZ80Circuit, the physical circuit model of the Zilog Z80:
     NMOS depletion-load logic on a single 5 V supply with TTL-compatible
     levels, a single-phase clock input, an 8-bit data bus, a 16-bit address bus
     and a 4-bit ALU that processes each 8-bit operation in two passes.

   Provenance of the figures:
     published  5 V supply, original clock 2.5 MHz (Z80A 4 MHz), single-phase
                clock input, TTL-compatible levels, introduced 1976.
     cited      about 8500 transistors and a 4 micrometre feature size are the
                commonly quoted secondary-source figures. They were not checked
                against a primary source here.
     derived    gate delay, edge time, fanout, block counts and depths. They are
                planning figures from the SLeeLa gate structure, not die
                measurements. The block named other is the cited transistor
                total minus the modelled blocks.

   Family: cpu. Extends SLCircuitModel. >>
#sleela 2.5
material;
class SLZ80Circuit extends SLCircuitModel {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 39542;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-21";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "Zilog";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "United States";
  String metaBirthDate = "2026-11-21";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 6;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  void build() {
    SLLogicFamily f = new SLLogicFamily();
    f.configure("NMOS-depletion-load", 4000, 5000, 250);
    f.setThresholds(800, 2000, 400, 2400);
    f.setSpeed(8000, 15000, 4);
    f.setProvenance("supply and levels published; feature size cited; speed derived");

    SLVoltageRail vcc = new SLVoltageRail();
    vcc.configure("Vcc", 5000, 4750, 5250);

    configure("Zilog Z80", f, vcc, 2500, 1);
    setWidths(8, 16);
    setTransistors(8500);
    setProvenance("cited: about 8500 transistors, 4 um NMOS; unverified against primary source");

    SLCircuitBlock alu = addBlock("alu-4bit", "alu", 4, 10, 36, 144);
    alu.setCellFactor(60);
    alu.setProvenance("derived: 4-bit ALU, an 8-bit operation takes two passes");
    SLCircuitBlock regs = addBlock("register-file", "regfile", 208, 2, 208, 1248);
    regs.setCellFactor(60);
    regs.setProvenance("derived: main, alternate and special registers as latch bits");
    SLCircuitBlock addr = addBlock("address-path", "bus", 16, 3, 40, 160);
    addr.setCellFactor(60);
    addr.setProvenance("derived: address latch, incrementer and drivers");
    SLCircuitBlock data = addBlock("data-path", "bus", 8, 3, 24, 96);
    data.setCellFactor(60);
    data.setProvenance("derived: internal data bus and bidirectional buffer");
    SLCircuitBlock pla = addBlock("instruction-decode", "decode", 8, 6, 300, 1200);
    pla.setCellFactor(60);
    pla.setProvenance("derived: opcode and prefix decode, timing control");
    SLCircuitBlock clk = addBlock("clock-buffer", "clock", 1, 3, 6, 24);
    clk.setCellFactor(60);
    clk.setProvenance("derived: single-phase input buffer and internal phase split");
    SLCircuitBlock rest = addRemainder("other");
    if (rest != null) { rest.setCellFactor(60); }

    SLCircuitPath rd = addPath("address-to-data-read", 20000);
    rd.describe("derived: address out, memory access, data captured at the end of T3");
    rd.addStage("address-drive", 120000);
    rd.addStage("memory-access-allowance", 160000);
    rd.constrain(50000, 0, 0);

    SLCircuitPath add = addPath("alu-nibble-add", 0);
    add.setPeriod(periodPs());
    add.describe("derived: one 4-bit pass, repeated for the second nibble");
    add.addStage("operand-latch", 8000);
    add.addStage("carry-chain-4-bits", 64000);
    add.addStage("result-latch", 8000);
    add.constrain(10000, 2000, 0);

    SLSignalQuality n0 = addNet("CLK");
    n0.setEdgeLimit(60000);
    SLSignalQuality n1 = addNet("A0");
    SLSignalQuality n2 = addNet("D0");
    SLSignalQuality n3 = addNet("WAIT");

    SLCircuitSemaphore latch = addSemaphore("latch", 1, 2);
    SLCircuitSemaphore abus = addSemaphore("address-bus", 1, 2);
    SLCircuitSemaphore dbus = addSemaphore("data-bus", 1, 2);
  }
}
