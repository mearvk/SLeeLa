  String byteDigits(int b) {
    long v = hfmod(b, 256);
    return hexDigit((int) (v / 16)) + hexDigit((int) (v % 16));
  }
  String hexDigit(int v) {
    if (v < 10) { return "" + v; }
    String s = "a";
    if (v == 10) { s = "a"; }
    if (v == 11) { s = "b"; }
    if (v == 12) { s = "c"; }
    if (v == 13) { s = "d"; }
    if (v == 14) { s = "e"; }
    if (v == 15) { s = "f"; }
    if (this.upper) {
      if (v == 10) { s = "A"; }
      if (v == 11) { s = "B"; }
      if (v == 12) { s = "C"; }
      if (v == 13) { s = "D"; }
      if (v == 14) { s = "E"; }
      if (v == 15) { s = "F"; }
    }
    return s;
  }
  int hexCode(long v) {
    if (v < 10) { return (int) v + 48; }
    if (this.upper) { return (int) v + 55; }
    return (int) v + 87;
  }
  static long hfdiv(long a, long b) {
    long q = a / b;
    if ((a % b != 0) && ((a < 0) != (b < 0))) { q = q - 1; }
    return q;
  }
  static long hfmod(long a, long b) { return a - hfdiv(a, b) * b; }
