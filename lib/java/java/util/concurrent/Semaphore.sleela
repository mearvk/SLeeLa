  < ---- java.util.concurrent.Semaphore members (procedural implementation in SLeeLa) ---- >
  << A permit count guarded by VM lock 30 (reserved for java.util.concurrent
     synchronizers). Every check-and-take happens under the lock, so permits
     are never handed out twice across spawned threads. acquire waits by
     polling once a millisecond. There is no wait queue, so the fair flag is
     recorded but not enforced, hasQueuedThreads is false and getQueueLength
     is 0. toString and getQueuedThreads keep their stubs. >>
  int semPermits = 0;
  boolean semFair = false;

  public Semaphore(int permits) { this.semPermits = permits; }
  public Semaphore(int permits, boolean fair) {
    this.semPermits = permits;
    this.semFair = fair;
  }
  public int availablePermits() { return this.semPermits; }
  public boolean isFair() { return this.semFair; }
  public final boolean hasQueuedThreads() { return false; }
  public final int getQueueLength() { return 0; }

  public boolean tryAcquire() { return takePermits(1); }
  public boolean tryAcquire(int permits) {
    if (permits < 0) { throw new IllegalArgumentException(); }
    return takePermits(permits);
  }
  public boolean tryAcquire(long timeout, TimeUnit unit) { return tryAcquire(1, timeout, unit); }
  public boolean tryAcquire(int permits, long timeout, TimeUnit unit) {
    if (permits < 0) { throw new IllegalArgumentException(); }
    long deadline = timeMonotonicNanos() + unit.toNanos(timeout);
    while (!takePermits(permits)) {
      if (timeMonotonicNanos() >= deadline) { return false; }
      sleep(1);
    }
    return true;
  }
  public void acquire() {
    while (!takePermits(1)) { sleep(1); }
  }
  public void acquire(int permits) {
    if (permits < 0) { throw new IllegalArgumentException(); }
    while (!takePermits(permits)) { sleep(1); }
  }
  public void acquireUninterruptibly() { acquire(); }
  public void acquireUninterruptibly(int permits) { acquire(permits); }

  public void release() { addPermits(1); }
  public void release(int permits) {
    if (permits < 0) { throw new IllegalArgumentException(); }
    addPermits(permits);
  }
  public int drainPermits() {
    lock(30);
    int n = this.semPermits;
    if (n > 0) { this.semPermits = 0; } else { n = 0; }
    unlock(30);
    return n;
  }
  @JavaProtected
  void reducePermits(int reduction) {
    if (reduction < 0) { throw new IllegalArgumentException(); }
    lock(30);
    this.semPermits = this.semPermits - reduction;
    unlock(30);
  }

  boolean takePermits(int n) {
    lock(30);
    boolean ok = false;
    if (this.semPermits >= n) {
      this.semPermits = this.semPermits - n;
      ok = true;
    }
    unlock(30);
    return ok;
  }
  void addPermits(int n) {
    lock(30);
    if (this.semPermits + n < this.semPermits) {
      unlock(30);
      throw new Error("Maximum permit count exceeded");
    }
    this.semPermits = this.semPermits + n;
    unlock(30);
  }
