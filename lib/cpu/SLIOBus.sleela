<< lib/cpu/SLIOBus.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLIOBus — the I/O interconnect (modeling PCIe / the
     peripheral bus). It owns a set of I/O ports and routes CPU IN/OUT accesses
     to the right port by number. Devices register their ports here; drivers
     reach their device through the bus.
   
   Up to 16 ports are wired as fields (SLeeLa surface has no arrays); this is
   ample for a modeled machine (console, disk, keyboard, timer, NIC, ...).
   
   Family: cpu. Composes SLIOPort. >>
#sleela 2.5
material;
class SLIOBus {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10248;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-10-16";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-06";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  static final int MAX_PORTS = 16;
  SLIOPort p0; SLIOPort p1; SLIOPort p2; SLIOPort p3;
  SLIOPort p4; SLIOPort p5; SLIOPort p6; SLIOPort p7;
  SLIOPort p8; SLIOPort p9; SLIOPort p10; SLIOPort p11;
  SLIOPort p12; SLIOPort p13; SLIOPort p14; SLIOPort p15;
  int registered;

  void configure() { registered = 0; }

  void registerPort(int number, SLIOPort port) {
    if (number == 0) { p0 = port; } if (number == 1) { p1 = port; }
    if (number == 2) { p2 = port; } if (number == 3) { p3 = port; }
    if (number == 4) { p4 = port; } if (number == 5) { p5 = port; }
    if (number == 6) { p6 = port; } if (number == 7) { p7 = port; }
    if (number == 8) { p8 = port; } if (number == 9) { p9 = port; }
    if (number == 10) { p10 = port; } if (number == 11) { p11 = port; }
    if (number == 12) { p12 = port; } if (number == 13) { p13 = port; }
    if (number == 14) { p14 = port; } if (number == 15) { p15 = port; }
    registered = registered + 1;
  }

  SLIOPort port(int number) {
    if (number == 0) { return p0; } if (number == 1) { return p1; }
    if (number == 2) { return p2; } if (number == 3) { return p3; }
    if (number == 4) { return p4; } if (number == 5) { return p5; }
    if (number == 6) { return p6; } if (number == 7) { return p7; }
    if (number == 8) { return p8; } if (number == 9) { return p9; }
    if (number == 10) { return p10; } if (number == 11) { return p11; }
    if (number == 12) { return p12; } if (number == 13) { return p13; }
    if (number == 14) { return p14; } if (number == 15) { return p15; }
    return p0;
  }

  < CPU-side IN/OUT routed through the bus. >
  int in(int number) { SLIOPort p = port(number); if (p != null) { return p.in(); } return -1; }
  void out(int number, int value) { SLIOPort p = port(number); if (p != null) { p.out(value); } }

  int portsRegistered() { return registered; }
}
