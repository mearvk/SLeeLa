/*
 * lib/cpu/SLNativeGuard.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLNativeGuard — the single object that names, in the
 *   clear, every safety and security concern a native CPU runner must satisfy
 *   before and while it runs. Running native, OS-specific code quickly is only
 *   acceptable if each concern is explicit and checked; this guard is where
 *   those concerns live as named, auditable fields rather than as scattered,
 *   implicit assumptions:
 *
 *     - verification     : the native artifact must match its trusted SHA-256
 *                          before it is loaded (the repository's build gate).
 *     - capability sandbox: the deny-by-default set naming exactly what the
 *                          native path may touch (SLNativeCapability).
 *     - bounded handles  : the native core returns VM-local integer handles,
 *                          never raw pointers (the runtime's handle discipline).
 *     - resource ownership: every native resource has an owner and is released
 *                          deterministically; stale handles fail closed.
 *     - deadline         : a wall-clock budget after which a run is cancelled,
 *                          so a native path can never hang the host unbounded.
 *     - cancellation     : a cooperative token observable at safe points.
 *     - teardown         : an ordered, idempotent quiesce/close/finalize.
 *
 * A runner refuses to start until the guard is `satisfied()`. This is the
 * safety contract stated as prose a reviewer can read top to bottom.
 *
 * Family: cpu. Composes SLNativeCapability; governs SLNativeRunner.
 */
#sleela 1.3
class SLNativeGuard {
  // ---- verification (trusted SHA-256 before load) ----
  int requireVerification;   // 1 = refuse to load an unverified artifact
  String expectedSha256;     // the trusted digest the artifact must match
  int verified;              // 1 once the artifact's digest matched

  // ---- capability sandbox ----
  SLNativeCapability allowed; // the authorized capability ceiling, by name

  // ---- bounded handles ----
  int requireBoundedHandles; // 1 = the native core must return VM-local handles

  // ---- resource ownership + teardown ----
  int ownResources;          // 1 = runner owns and must release every resource
  int failClosed;            // 1 = a stale/invalid handle is rejected, not reused

  // ---- deadline + cancellation ----
  int deadlineMs;            // wall-clock budget for a run (0 = no explicit cap)
  int cancelRequested;       // 1 = a cooperative cancel has been raised
  int safepointsPolled;      // how many safe points observed the cancel token

  // The default guard is strict: verification required, least-privilege sandbox,
  // bounded handles, owned resources, fail-closed, a deadline, no cancel yet.
  void configure(int deadlineMillis) {
    requireVerification = 1; expectedSha256 = ""; verified = 0;
    allowed = new SLNativeCapability(); allowed.grantRunnerMinimum();
    requireBoundedHandles = 1;
    ownResources = 1; failClosed = 1;
    deadlineMs = deadlineMillis; cancelRequested = 0; safepointsPolled = 0;
  }

  // State the trusted digest the artifact must match before it may be loaded.
  void expectSha256(String digest) { expectedSha256 = digest; }

  // Record the result of comparing the artifact's measured digest to the
  // expected one. Verification is the first gate the runner clears.
  boolean verifyDigest(String measured) {
    if (requireVerification == 0) { verified = 1; return true; }
    verified = (measured == expectedSha256 && expectedSha256 != "") ? 1 : 0;
    return verified == 1;
  }

  // Narrow or widen (within the OS's own ceiling) the capability sandbox.
  SLNativeCapability capabilities() { return allowed; }
  void grant(int capability) { allowed.grant(capability); }
  void revoke(int capability) { allowed.revoke(capability); }

  // Cooperative cancellation: raise the token; the runner observes it at safe
  // points and unwinds through the teardown sequence.
  void requestCancel() { cancelRequested = 1; }
  boolean cancelled() { return cancelRequested == 1; }
  // The runner calls this at each safe point; returns true if it should stop.
  boolean pollSafepoint() { safepointsPolled = safepointsPolled + 1; return cancelRequested == 1; }

  // Has a run exceeded its wall-clock budget? (elapsed supplied by the runner.)
  boolean deadlineExceeded(int elapsedMs) { return deadlineMs > 0 && elapsedMs > deadlineMs; }

  // The whole safety contract, satisfied: the artifact is verified (or
  // verification was explicitly not required), the sandbox is a real
  // deny-by-default set, bounded handles and ownership are demanded, and the
  // run has not been cancelled. A runner refuses to start unless this holds.
  boolean satisfied() {
    boolean verifyOk = (requireVerification == 0) || (verified == 1);
    boolean sandboxOk = allowed != null && allowed.grantCount() >= 1;
    boolean handlesOk = requireBoundedHandles == 1;
    boolean ownedOk = ownResources == 1 && failClosed == 1;
    return verifyOk && sandboxOk && handlesOk && ownedOk && cancelRequested == 0;
  }

  // A one-line, nameful reason the guard is not yet satisfied — so a refusal is
  // never silent. Empty string means satisfied.
  String unsatisfiedReason() {
    if (requireVerification == 1 && verified == 0) { return "artifact not verified against trusted SHA-256"; }
    if (allowed == null || allowed.grantCount() < 1) { return "capability sandbox is empty"; }
    if (requireBoundedHandles != 1) { return "bounded native handles not required"; }
    if (ownResources != 1 || failClosed != 1) { return "resource ownership / fail-closed not enforced"; }
    if (cancelRequested == 1) { return "run was cancelled"; }
    return "";
  }

  boolean isVerified() { return verified == 1; }
  int deadline() { return deadlineMs; }
  int safepoints() { return safepointsPolled; }
}
