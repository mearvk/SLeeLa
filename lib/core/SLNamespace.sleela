/*
 * lib/core/SLNamespace.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLNamespace used within the core library family.
 */
#sleela 1.3
// SLeeLa core/base language contract.
class SLNamespace {
  int state;
  int count;
  void reset(){state=0;count=0;}
  void activate(){state=1;count=count+1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
