/*
 * lib/ui/SLTextField.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLTextField used within the ui library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: ui. Native implementation crosses an explicit VM/OS bridge.
class SLTextField {
  String title; int state; int children; void configure(String t){title=t;} void show(){state=1;} void hide(){state=0;} void add(){children=children+1;} boolean visible(){return state==1;}
}
