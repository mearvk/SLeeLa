/*
 * lib/gui/version-dual/SLGuiApp.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLGuiApp — the top-level support structure that ties the
 *   whole /lib/gui dynamic stack together into one object: it opens a SleelaUI
 *   application and window (via /lib/user-interface), owns the SLeeLa DOM
 *   (SLGuiDom), the reconciler (SLGuiMount) that projects the DOM onto widgets,
 *   the host adapter (SLGuiHostAdapter) that raises widget activations back as
 *   events, and an optional script engine (SLGuiScript). Its run loop pumps the
 *   toolkit event loop, polls widget activations into the event bus, re-mounts
 *   any newly-created nodes, and reconciles dirty nodes each turn. This is the
 *   "basic support structure" a program (or the IDE) builds on: construct the
 *   DOM declaratively or by script, bind callbacks, and call run().
 *
 * Family: gui. SLeeLa owns the DOM, dispatch, and script execution; SleelaUI
 * owns presentation; this object is the wiring between them.
 */
#sleela 2.1
class SLGuiApp {
  SLUserInterface ui;
  SLWindow window;
  SLGuiDom dom;
  SLGuiMount mount;
  SLGuiHostAdapter host;
  SLGuiScript script;
  SLGuiBranding branding;   // 3.0 logo/brand identity painted into the chrome
  SLGuiAudioCues audio;     // 3.0 activation-audio cue registry
  SLGuiCodecs codecs;       // 4.0 codec registry (mirror of /codecs) GUI can see
  SLGuiHtmlRenderer html;   // 4.0 HTML/CSS/JS renderer (quick-responsive)
  int frameMillis;          // nominal per-loop tick for scheduled effects
  int ready;

  // Open the application + window and stand up the DOM/mount/host wiring.
  // Returns true when the toolkit came up (false on a headless host).
  boolean boot(String appId, String title, int width, int height) {
    ui = new SLUserInterface();
    ui.configure(appId);
    if (!ui.open()) { ready = 0; return false; }

    SLTheme theme = new SLTheme();
    theme.slickBlack();
    window = ui.openWindow(title, width, height, theme.handle());

    dom = new SLGuiDom(); dom.init();
    // The document root mirrors the window's existing root container.
    dom.createRoot("window", "root");

    mount = new SLGuiMount(); mount.init(dom, window.rootHandle());
    host = new SLGuiHostAdapter(); host.init(dom, mount);
    script = new SLGuiScript(); script.init(dom);

    // 3.0 surfaces: a brand identity and the activation-audio cue registry.
    branding = new SLGuiBranding(); branding.configure("");
    audio = new SLGuiAudioCues(); audio.configure();
    // 4.0 surfaces: the codec registry (so GUI components can SEE what /codecs
    // supports) and the quick-responsive HTML/CSS/JS renderer, which shares the
    // same codec registry for its media gate.
    codecs = new SLGuiCodecs(); codecs.configure();
    html = new SLGuiHtmlRenderer(); html.configure();
    frameMillis = 16;   // ~60 fps nominal tick for scheduled rotation/fade

    ready = 1;
    return true;
  }

  // ---- 4.0 codecs + HTML renderer access ----------------------------------
  // The codec registry every GUI media component can consult.
  SLGuiCodecs codecRegistry() { return codecs; }
  SLGuiHtmlRenderer htmlRenderer() { return html; }
  // Convenience capability questions for GUI implementations.
  boolean canPlayCodec(String codecName) { return codecs.playable(codecName); }
  boolean canPlayExtension(String ext) { return codecs.playableExtension(ext); }
  int supportedCodecs() { return codecs.playableCount(); }

  // ---- 3.0 branding + audio access ----------------------------------------
  SLGuiBranding brand() { return branding; }
  SLGuiAudioCues audioCues() { return audio; }
  void setFrameMillis(int ms) { if (ms > 0) { frameMillis = ms; } }

  // Apply a brand logo + accent in one call (host paints it into the chrome).
  void setLogo(String asset, String accent) {
    branding.setLogo(asset);
    if (accent != null) { branding.setColors(accent, null); }
  }

  // Give a node an effects bundle and (optionally) an activation cue, then
  // flatten it into the node's style for the next reconcile.
  SLGuiEffects effectsFor(String nodeId) {
    SLGuiNode n = dom.getElementById(nodeId);
    if (n == null) { return null; }
    SLGuiEffects e = n.effects();
    return e;
  }

  boolean isReady() { return ready == 1; }

  // ---- document access ----------------------------------------------------

  SLGuiDom document() { return dom; }
  SLGuiScript scripting() { return script; }
  SLWindow hostWindow() { return window; }

  // Convenience: append an element to a parent in the DOM (then mount+show on
  // the next loop turn, or immediately via refresh()).
  SLGuiNode add(String parentId, String tag, String id) {
    return dom.appendElement(parentId, tag, id);
  }

  // Bind a click callback (DHTML onClick) by node id.
  SLGuiHandler onClick(String id, String operation) { return dom.onClick(id, operation); }

  // Run a UI script against the DOM (build + bind + fire), then refresh.
  int runScript() {
    int n = script.run();
    refresh();
    return n;
  }

  // ---- the loop -----------------------------------------------------------

  // Mount everything, show the window, then run the toolkit event loop:
  // pump -> poll activations -> mount new nodes -> reconcile. Returns the
  // process-style exit code.
  int run() {
    if (ready == 0) { return 1; }
    mount.mountAll();
    window.show();
    while (ui.active()) {
      int dispatched = ui.pump(true);
      if (dispatched < 0) { break; }
      host.poll();           // widget activations -> SLGuiEvents -> handlers
      advanceEffects(frameMillis);  // tick scheduled ("schene") rotations/fades
      mount.mountNew();      // pick up nodes added by handlers/scripts
      mount.reconcile();     // push dirty DOM state onto widgets
      window.requestRedraw();
    }
    return 0;
  }

  // Advance every node's scheduled effects by `elapsedMillis`: scheduled
  // rotations turn (and their bound memorandum key epoch rotates with them),
  // and the host interpolates fades. Returns how many nodes moved this tick.
  int advanceEffects(int elapsedMillis) {
    if (ready == 0) { return 0; }
    int moved = 0;
    int n = dom.size();
    for (int i = 0; i < n; i = i + 1) {
      SLGuiNode node = dom.nodeAt(i);
      if (node != null && node.hasEffects()) {
        if (node.tickEffects(elapsedMillis)) { moved = moved + 1; }
      }
    }
    return moved;
  }

  // A single synchronous refresh (mount new + reconcile) without the loop,
  // for building a UI up front or driving it from a test/host step.
  void refresh() {
    if (ready == 0) { return; }
    mount.mountNew();
    mount.reconcile();
  }

  // Pump one turn (pump + poll + refresh); returns events raised this turn.
  int step(boolean block) {
    if (ready == 0) { return 0; }
    ui.pump(block);
    int raised = host.poll();
    refresh();
    window.requestRedraw();
    return raised;
  }

  void quit(int code) { if (ui != null) { ui.quit(code); } }
  void shutdown() { if (ui != null) { ui.close(); } ready = 0; }
}
