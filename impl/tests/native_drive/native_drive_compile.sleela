#sleela 3.0

class NativeDriveCompile {
    static int fallback(int value) {
        return value * 3;
    }

    static int main() {
        int module = nativeOpen("@NATIVE_PLUGIN_PATH@");
        int nativeResult = nativeCall(module, "twice", 21);
        int fallbackResult = nativeCall(module, "fallback", 7);
        nativeClose(module);
        return nativeResult + fallbackResult;
    }
}
