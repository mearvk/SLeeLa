/*
 * lib/data-structures/DSStack.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type DSStack used within the data-structures library family.
 */
#sleela 1.2

// LIFO stack contract.

struct DSStack {
    int size;
}

class DSStackOperations {
    boolean empty(DSStack stack) { return stack.size == 0; }
    int size(DSStack stack) { return stack.size; }
    boolean canPop(DSStack stack) { return stack.size > 0; }
}
