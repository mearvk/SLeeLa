/*
 * lib/crypto/SLKeyDerivation.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLKeyDerivation used within the crypto library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Key-derivation front-end (dispatches to HKDF-SHA-256 in /crypto).
// Native implementation crosses an explicit VM/OS bridge.
//
// SECURITY NOTE: the native /crypto backend is a correct, specification-faithful
// REFERENCE implementation. It is NOT guaranteed constant-time and is NOT
// side-channel resistant. For data that must be protected use an audited library
// (BoringSSL, OpenSSL, libsodium, liboqs). See crypto/README.md.
class SLKeyDerivation {
  // Status codes mirror slcrypto_status in crypto/include/slcrypto.h.
  static final int OK = 0;
  static final int ERR_PARAM = -1;
  static final int ERR_AUTH = -2;
  static final int ERR_UNIMPL = -3;

  String algorithm;
  int outBytes;      // requested derived-key length
  int state;         // 1 = enabled, 0 = disabled
  int configured;    // 1 once a supported algorithm name has been accepted
  int outSet;        // 1 once a valid output size has been accepted
  int backend;       // 1 when the native /crypto backend is linked and ready

  // Only HKDF-SHA-256 is currently wired through the native layer.
  int configure(String a) {
    if (a == null) { configured = 0; return ERR_PARAM; }
    if (a == "HKDF-SHA-256") { algorithm = a; configured = 1; return OK; }
    configured = 0;
    return ERR_PARAM;
  }

  int outputSize(int n) {
    if (n >= 1 && n <= 8160) { outBytes = n; outSet = 1; return OK; }
    outSet = 0;
    return ERR_PARAM;
  }

  void bindBackend(int ready) { if (ready == 1) { backend = 1; } else { backend = 0; } }
  boolean backendReady() { return backend == 1; }

  void enable() { state = 1; }
  void disable() { state = 0; }
  boolean active() { return state == 1 && configured == 1 && outSet == 1 && backend == 1; }

  int outputLength() { return outBytes; }

  int derive(String salt, String ikm, String info) {
    if (active() == false) { return ERR_UNIMPL; }
    if (ikm == null) { return ERR_PARAM; }
    return OK;
  }

  String securityNote() {
    return "Reference-grade: not constant-time, not side-channel resistant; use an audited library in production.";
  }
}
