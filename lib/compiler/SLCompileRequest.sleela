/*
 * lib/compiler/SLCompileRequest.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLCompileRequest, a single request to compile one input
 *   with a chosen language front end toward a chosen target.
 *
 * A request is pure intent: it names the language, the input path, the desired
 * target, and whether the compile must fail closed when a required phase is
 * absent. It does not open, read, parse, link, load, or execute the input.
 *
 * Family: compiler. Native VM/OS work crosses an explicit bridge.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class SLCompileRequest {
  String languageName;   // which registered front end to use
  String inputPath;      // the source path (not opened here)
  int    requestedTarget;// one of SLLanguageCompiler.TARGET_*; 0 => front end default
  boolean strict;        // true => any absent required phase fails the request

  void configure(String language, String path, int target) {
    languageName = language;
    inputPath = path;
    requestedTarget = target;
    strict = false;
  }

  void beStrict() { strict = true; }

  String language() { return languageName; }
  String input()    { return inputPath; }
  int    target()   { return requestedTarget; }
  boolean isStrict(){ return strict; }
}
