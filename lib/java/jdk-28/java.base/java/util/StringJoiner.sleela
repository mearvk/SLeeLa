  public StringJoiner add(java.lang.CharSequence newElement) {
    String text = "null";
    if (newElement != null) { text = "" + newElement; }
    if (this.sjCount == 0) { this.sjJoined = text; }
    else { this.sjJoined = this.sjJoined + this.sjDelim + text; }
    this.sjCount = this.sjCount + 1;
    return this;
  }
  public StringJoiner merge(StringJoiner other) {
    if (other == null) { throw new NullPointerException(); }
    if (other.sjCount > 0) {
      String content = other.sjJoined;
      add(content);
    }
    return this;
  }
  public java.lang.String toString() {
    if (this.sjCount == 0) {
      if (this.sjEmpty != null) { return this.sjEmpty; }
      return this.sjPrefix + this.sjSuffix;
    }
    return this.sjPrefix + this.sjJoined + this.sjSuffix;
  }
