/*
 * lib/database/SLPreparedStatement.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLPreparedStatement used within the database library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: database. Native implementation crosses an explicit VM/OS bridge.
class SLPreparedStatement {
  String name; int state; int count; void configure(String n){name=n;} void open(){state=1;} void close(){state=0;} void add(){count=count+1;} boolean active(){return state==1;}
}
