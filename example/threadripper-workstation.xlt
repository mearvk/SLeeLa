#xlt 1.0
// example/threadripper-workstation.xlt
// A worked XLT (.xlt) CPU-model sheet — a standalone counterpart of the sheets
// under lib/xlt/examples, kept here as a hands-on starting point.
//
// It authors an AMD Threadripper workstation on a modern DDR5 board, splits
// memory into two tiers (DDR4 for usual activities, DDR5 for accuracy-critical
// work), requests the native-compute capabilities, and then politely runs a
// program on the machine it just assembled — all from this one declarative
// document. No setters and no new keyword: each part is declared once, in
// order, and the document's orthogonality is what guarantees the model's
// integrity. Compile it with:
//
//     make -C impl/xlt                 # builds impl/xlt/build/xltc
//     ./impl/xlt/build/xltc example/threadripper-workstation.xlt
//
// xltc reports SUCCESS with a build list, or a congruence of why a part could
// not be resolved.
model ThreadripperWorkstation {
  cpu       "SLAMDThreadripper9980X";  // a real high-core-count workstation SKU
  memory    "ddr5_6400" 131072;        // base module the build assembles on, 128 GiB
  cadence   "DDR5";                    // present a DDR5 refresh cadence (SLCadenceConnector)
  storage   "nvmeGen4";
  bus       "pcieGen5x16";

  // Native-compute capabilities (bare directives; each declared at most once).
  gpu;                                 // native GPU compute (build.enableGPU)
  dma;                                 // DMA bulk-move engine (build.enableDMA)
  nativeram;                           // run the VM's linear memory on real host RAM

  // Two memory tiers: usual activities on DDR4, accuracy-critical work on DDR5.
  memtier   "ddr4_3200" usual;         // usual activities -> DDR4 tier
  memtier   "ddr5_6400" accurate;      // competency / accuracy -> DDR5 tier
  maintier  "accurate";                // the main program runs on the DDR5 tier

  // Build the machine AND run a program on it: source path + language, then the
  // admission budget (memory words + cycle budget) the workload is granted.
  program   "examples/hello.sleela" sleela;
  grant     131072 2000000;

  target    sleela;
}
