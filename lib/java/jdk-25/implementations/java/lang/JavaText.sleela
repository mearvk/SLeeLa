<< lib/java/implementations/java/lang/JavaText.sleela
   Text bridge between plain SLeeLa Strings and Java UTF-16 Strings. A plain
   String has no character access, so these helpers convert it to UTF-16
   (javaStringFromUtf8), work on the code units, and convert back with
   javaStringToUtf8 (VM opcode 183), which carries any Unicode text. A plain
   String cannot hold NUL, an unpaired surrogate or more than 65536 bytes, so
   plainOf checks first and throws UnsupportedOperationException for those
   instead of reaching the fail-closed VM error. Text built one character at a
   time should be built in UTF-16 (codePointU / unitU, VM opcode 184) and
   converted once, so a surrogate pair is never split. Callers reach it as
   JavaText.name(...). >>
#sleela 3.0
material;

class JavaText {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 0;
  String metaAuthor = "SLeeLa /lib/java";
  String metaDate = "2026-11-11";
  String metaCopyright = "none";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-11";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 6;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < the reason a UTF-16 String has no plain form, or "" when it has one: NUL, an unpaired surrogate, or more than 65536 UTF-8 bytes >
  static String plainBlocker(String u) {
    int n = javaStringLength(u);
    int bytes = 0;
    int i = 0;
    while (i < n) {
      int c = javaStringCharAt(u, i);
      if (c == 0) { return "the text contains NUL, which a plain SLeeLa String cannot hold"; }
      if (c >= 55296 && c <= 56319) {
        if (i + 1 >= n) { return "unpaired surrogate code unit " + c; }
        int low = javaStringCharAt(u, i + 1);
        if (low < 56320 || low > 57343) { return "unpaired surrogate code unit " + c; }
        bytes = bytes + 4;
        i = i + 2;
      } else if (c >= 56320 && c <= 57343) {
        return "unpaired surrogate code unit " + c;
      } else {
        if (c < 128) { bytes = bytes + 1; }
        else if (c < 2048) { bytes = bytes + 2; }
        else { bytes = bytes + 3; }
        i = i + 1;
      }
    }
    if (bytes > 65536) { return "the text is longer than the 65536-byte plain String limit"; }
    return "";
  }

  < plain String to Java UTF-16 String, and back (any Unicode text) >
  static String utf16(String plain) { return javaStringFromUtf8(plain); }
  static String plainOf(String u) {
    String why = plainBlocker(u);
    if (why != "") { throw new UnsupportedOperationException("JavaText: " + why); }
    return javaStringToUtf8(u);
  }
  < the plain form of a UTF-16 String when it has one, else the UTF-16 String itself >
  static String plainIfRepresentable(String u) {
    if (plainBlocker(u) != "") { return u; }
    return javaStringToUtf8(u);
  }

  < one code unit, or one code point (two units above U+FFFF), as a UTF-16 String >
  static String unitU(int c) {
    if (c < 0 || c > 65535) { throw new IllegalArgumentException("JavaText: code unit " + c + " is outside 0..65535"); }
    return javaStringFromCodeUnit(c);
  }
  static String codePointU(int cp) {
    if (cp < 0 || cp > 1114111) { throw new IllegalArgumentException("Not a valid Unicode code point: 0x" + hexUpper(cp)); }
    if (cp < 65536) { return javaStringFromCodeUnit(cp); }
    int v = cp - 65536;
    return javaStringConcat(javaStringFromCodeUnit(55296 + v / 1024), javaStringFromCodeUnit(56320 + v % 1024));
  }
  < the plain one-character String for a code unit (no surrogate halves, no NUL) >
  static String charString(int c) { return plainOf(unitU(c)); }

  static String hexUpper(int v) {
    long x = v;
    if (x < 0) { x = x + 4294967296; }
    if (x == 0) { return "0"; }
    String out = "";
    while (x > 0) {
      int d = (int) (x % 16);
      if (d < 10) { out = "" + d + out; }
      else { out = charString(55 + d) + out; }
      x = x / 16;
    }
    return out;
  }

  < character access on a plain String, counted in UTF-16 code units as Java does >
  static int length(String s) { return javaStringLength(javaStringFromUtf8(s)); }
  static int charAt(String s, int index) {
    String u = javaStringFromUtf8(s);
    int n = javaStringLength(u);
    if (index < 0 || index >= n) { throw new StringIndexOutOfBoundsException("Index " + index + " out of bounds for length " + n); }
    return javaStringCharAt(u, index);
  }
  static String substring(String s, int begin, int end) {
    String u = javaStringFromUtf8(s);
    int n = javaStringLength(u);
    if (begin < 0 || begin > end || end > n) {
      throw new StringIndexOutOfBoundsException("begin " + begin + ", end " + end + ", length " + n);
    }
    return plainOf(javaStringSubstring(u, begin, end));
  }
  static int indexOfChar(String s, int ch, int fromIndex) {
    String u = javaStringFromUtf8(s);
    int n = javaStringLength(u);
    int i = fromIndex;
    if (i < 0) { i = 0; }
    while (i < n) {
      if (javaStringCharAt(u, i) == ch) { return i; }
      i = i + 1;
    }
    return 0 - 1;
  }
  static int lastIndexOfChar(String s, int ch) {
    String u = javaStringFromUtf8(s);
    int i = javaStringLength(u) - 1;
    while (i >= 0) {
      if (javaStringCharAt(u, i) == ch) { return i; }
      i = i - 1;
    }
    return 0 - 1;
  }
}
