## SLeeLa syntax highlighting for nano (Kiro palette).
## Requires nano >= 5.0 for 24-bit "color #RRGGBB" values.
syntax sleela "\.sleela$"
comment "//"

## keywords, types, literals
color #a98eda "\<(let|var|const|if|else|while|for|in|return|break|continue|class|interface|extends|implements|new|this|super|import|package|public|private|protected|static|final|true|false|null|nil|and|or|not|try|catch|throw|synchronized|finally|switch|case|default|do|assert|yield|instanceof)\>"
color #6e8be0 "\<(String|SLString|Integer|Int|Long|Double|Float|Boolean|Character|Byte|Short|Void|Object|List|Map|Set|Array|int64|int128|long|double|boolean)\>"
## function-call heads
color #f2d45c "[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\("
## numbers
color #8a7bd8 "\<[0-9]+\>"
## strings (double- and single-quoted; inner double-quote escaped as \")
color #e8c547 "\"(\\.|[^\"\\])*\""
color #e8c547 "'(\\.|[^'\\])*'"
## annotations and the document pragmas
color #b79ce6 "@[A-Za-z_][A-Za-z0-9_]*"
color #b79ce6 "^[[:space:]]*#(sleela|schema)\>.*$"
## document markers (only when alone on a line, optional ;)
color #b79ce6 "^[[:space:]]*(author|authorial|material|memory|determine)[[:space:]]*;?[[:space:]]*$"
## comments: // line and /* */ block, plus << >> and < > angle forms
color #6a6482 "//.*$"
color #6a6482 start="/\*" end="\*/"
color #6a6482 start="^[[:space:]]*<<" end=">>"
color #6a6482 "^[[:space:]]*<[^<].*>?$"
## TODO/FIXME/NOTE/XXX inside comments
color #e8c547 "\<(TODO|FIXME|NOTE|XXX)\>"
