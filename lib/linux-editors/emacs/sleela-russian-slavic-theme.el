;;; sleela-russian-slavic-theme.el --- SLeeLa Russian and Slavic theme -*- lexical-binding: t; -*-
(deftheme sleela-russian-slavic "Medium-intensity slate, muted blue, restrained ruby and antique gold.")
(custom-theme-set-faces
 'sleela-russian-slavic
 '(default ((t (:foreground "#E8EAF0" :background "#202733"))))
 '(cursor ((t (:background "#9CB4D0"))))
 '(region ((t (:background "#3B4655" :extend t))))
 '(highlight ((t (:background "#293341"))))
 '(fringe ((t (:foreground "#9AA3AF" :background "#202733"))))
 '(line-number ((t (:foreground "#9AA3AF" :background "#202733"))))
 '(line-number-current-line ((t (:foreground "#B7C9DF" :weight bold))))
 '(mode-line ((t (:foreground "#F1F3F6" :background "#3B4655" :weight bold))))
 '(mode-line-inactive ((t (:foreground "#9AA3AF" :background "#293341"))))
 '(minibuffer-prompt ((t (:foreground "#B7C9DF" :weight bold))))
 '(font-lock-builtin-face ((t (:foreground "#8FC4B2"))))
 '(font-lock-comment-face ((t (:foreground "#9AA3AF" :slant italic))))
 '(font-lock-constant-face ((t (:foreground "#D99198"))))
 '(font-lock-function-name-face ((t (:foreground "#A7C69C" :weight bold))))
 '(font-lock-keyword-face ((t (:foreground "#A9C0DD" :weight bold))))
 '(font-lock-string-face ((t (:foreground "#D6BD8B"))))
 '(font-lock-type-face ((t (:foreground "#8FC4B2" :weight bold))))
 '(font-lock-variable-name-face ((t (:foreground "#E8EAF0"))))
 '(font-lock-warning-face ((t (:foreground "#E58B91" :weight bold :underline t))))
 '(error ((t (:foreground "#E58B91" :weight bold))))
 '(warning ((t (:foreground "#C9AD76" :weight bold))))
 '(success ((t (:foreground "#A7C69C" :weight bold))))
 '(show-paren-match ((t (:foreground "#F1F3F6" :background "#465568" :weight bold))))
 '(isearch ((t (:foreground "#202733" :background "#C9AD76" :weight bold)))))
(provide-theme 'sleela-russian-slavic)
;;; sleela-russian-slavic-theme.el ends here
