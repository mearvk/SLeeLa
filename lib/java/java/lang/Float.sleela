  << Round a double to the nearest binary32 value (Java (float) conversion). >>
  double fround(double d) {
    if (d != d || isInfinite(d) || d == 0.0) { return d; }
    double a = d;
    boolean neg = a < 0.0;
    if (neg) { a = 0.0 - a; }
    int e = binaryExponent(a);
    int q = e - 23;
    if (q < -149) { q = -149; }
    double r = rintD(a * pow2(0 - q)) * pow2(q);
    if (r >= 3.4028235677973366E38) { r = posInf(); }
    if (neg) { return 0.0 - r; }
    return r;
  }

