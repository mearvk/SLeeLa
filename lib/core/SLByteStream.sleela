/*
 * lib/core/SLByteStream.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLByteStream used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for ByteStream.
// Role: runtime. Responsibility: sequential byte transport abstraction.
class SLByteStream {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
