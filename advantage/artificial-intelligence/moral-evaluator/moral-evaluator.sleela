  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < The facts of one trade, set by the caller. Defaults describe an exemplary >
  < trade, so a test changes only the one fact it wants to break. >
  boolean endangersLife = false;
  boolean humanIsEnd = true;
  boolean consent = true;
  boolean deceptive = false;
  boolean coerced = false;
  double priceRatio = 1.0;
  boolean hasRemedy = true;
  boolean thirdPartyHarm = false;
  boolean bothBenefit = true;
  boolean exploitsUrgency = false;
  double coolingOffHours = 24.0;
  double decisionMinutes = 30.0;
  boolean timestamped = true;
  double termDays = 30.0;
  double quoteAgeSeconds = 5.0;
  double tradesPerMinute = 100.0;
  boolean listerIdentified = true;
  double listerStanding = 0.9;
  boolean listingTruthful = true;
  boolean listerProhibited = false;
  boolean provenanceKnown = true;
  boolean conflictDisclosed = true;
  int listerCount = 3;
  boolean listerAccountable = true;
  boolean inUsBoundary = true;
  boolean lawfulSubject = true;
  boolean sanctionedCounterparty = false;
  boolean recordsKept = true;
  boolean feesAccounted = true;
  boolean manipulative = false;
  boolean protectionsHonored = true;
  boolean respectsUS = true;
}

< SLeeLa courseware model: the Moral Evaluator, up to 41 yes or no points. >
< Human centered and life centered; five cardinal points are vetoes. >
< A teaching model of rule based judgement, not an authority on morals or law. >
class SLMoralEvaluator {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs. Values are faithful
     to the subject real origin where publicly known; unknown values use none. >>
  String metaVersion = "1.0.0";
  int metaId = 39512;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-13";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | nation | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-13";
  < metaScienceRating: maturity on a 1..10 scale; courseware model with rule based judgement >
  int metaScienceRating = 6;
  < metaNationalSchedule: a real citable instrument or none >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < The Moral Evaluator. A trade is judged by up to 41 yes or no points in >
  < five dimensions: 0 trades, 1 time, 2 listers, 3 united states, 4 tall >
  < science. The orientation is the human at the center and the living person: >
  < five CARDINAL points (life safe, human is the end, informed consent, no >
  < deception, lawful subject) are vetoes that no amount of merit can buy. >
  < Verdicts: 0 NO, 1 YES, 2 COMPLETE (every one of the 41 points is yes). >
  < In binary mode COMPLETE is reported as YES. Fail closed: not ready is NO. >
  boolean[] yes;
  int[] dim;
  boolean[] cardinal;
  int[] order;
  String[] pname;
  int[] dimTotal;
  int[] dimYes;
  double[] dimFrac;
  int active = 41;
  int mode = 3;
  boolean ready = false;
  double threshold = 0.80;
  double dimFloor = 0.50;
  double lastMerit = 0.0;
  int lastVerdict = 0;
  int lastCardinalFail = -1;
  int lastWeakDim = -1;
  String lastReason = "not ready";
  int reviews = 0;

  boolean configure(int points, int verdictStates) {
    ready = false;
    if (points < 5 || points > 41) { return false; }
    if (verdictStates != 2 && verdictStates != 3) { return false; }
    active = points;
    mode = verdictStates;
    yes = new boolean[41];
    dim = new int[41];
    cardinal = new boolean[41];
    order = new int[41];
    pname = new String[41];
    dimTotal = new int[5];
    dimYes = new int[5];
    dimFrac = new double[5];
    int i = 0;
    while (i < 41) { yes[i] = false; cardinal[i] = false; i = i + 1; }
    i = 0;
    while (i < 5) { dimTotal[i] = 0; dimYes[i] = 0; dimFrac[i] = 0.0; i = i + 1; }
    names();
    i = 0;
    while (i < 41) {
      if (i < 9) { dim[i] = 0; }
      else { if (i < 16) { dim[i] = 1; }
      else { if (i < 24) { dim[i] = 2; }
      else { if (i < 32) { dim[i] = 3; } else { dim[i] = 4; } } } }
      i = i + 1;
    }
    cardinal[0] = true;
    cardinal[1] = true;
    cardinal[2] = true;
    cardinal[3] = true;
    cardinal[25] = true;
    order[0] = 0; order[1] = 1; order[2] = 2; order[3] = 3; order[4] = 25;
    int n = 5;
    i = 0;
    while (i < 41) {
      if (cardinal[i] == false) { order[n] = i; n = n + 1; }
      i = i + 1;
    }
    ready = true;
    lastReason = "configured";
    return true;
  }

  void names() {
    pname[0] = "T01 life is safe";
    pname[1] = "T02 the human is the end";
    pname[2] = "T03 informed consent";
    pname[3] = "T04 no deception";
    pname[4] = "T05 no coercion";
    pname[5] = "T06 fair value";
    pname[6] = "T07 remedy exists";
    pname[7] = "T08 no third party harm";
    pname[8] = "T09 both sides benefit";
    pname[9] = "M01 urgency not exploited";
    pname[10] = "M02 cooling off offered";
    pname[11] = "M03 time to decide";
    pname[12] = "M04 timestamped";
    pname[13] = "M05 commitment has an end";
    pname[14] = "M06 quote is fresh";
    pname[15] = "M07 pace is sustainable";
    pname[16] = "L01 lister identified";
    pname[17] = "L02 lister in good standing";
    pname[18] = "L03 listing truthful";
    pname[19] = "L04 lister not prohibited";
    pname[20] = "L05 provenance known";
    pname[21] = "L06 conflict disclosed";
    pname[22] = "L07 more than one lister";
    pname[23] = "L08 lister accountable";
    pname[24] = "U01 within US boundary";
    pname[25] = "U02 lawful subject";
    pname[26] = "U03 no sanctioned counterparty";
    pname[27] = "U04 records kept";
    pname[28] = "U05 fees accounted";
    pname[29] = "U06 no manipulation";
    pname[30] = "U07 protections honored";
    pname[31] = "U08 respects the United States";
    pname[32] = "S01 US item cataloged";
    pname[33] = "S02 subject nouns listed";
    pname[34] = "S03 canonical name the United States";
    pname[35] = "S04 names listed";
    pname[36] = "S05 scientific individuals listed";
    pname[37] = "S06 moral individuals listed";
    pname[38] = "S07 nouns and names paired respectively";
    pname[39] = "S08 inside US boundaries";
    pname[40] = "S09 respected";
  }

  int getActive() { return active; }
  boolean isReady() { return ready; }
  double getThreshold() { return threshold; }
  double getMerit() { return lastMerit; }
  double getRisk() { return 1.0 - lastMerit; }
  int getVerdict() { return lastVerdict; }
  String getReason() { return lastReason; }
  int getCardinalFail() { return lastCardinalFail; }
  int getWeakDim() { return lastWeakDim; }
  double getDimFrac(int d) { return dimFrac[d]; }
  boolean getAnswer(int id) { return yes[id]; }
  String pointName(int id) { return pname[id]; }
  String verdictName(int v) {
    if (v == 2) { return "COMPLETE"; }
    if (v == 1) { return "YES"; }
    return "NO";
  }
  String dimName(int d) {
    if (d == 0) { return "trades"; }
    if (d == 1) { return "time"; }
    if (d == 2) { return "listers"; }
    if (d == 3) { return "united states"; }
    return "tall science";
  }

  < ---- the 41 yes or no answers, straight line ---- >
  void answers(SLMoralTrade t, SLTallScience ts) {
    yes[0] = t.endangersLife == false;
    yes[1] = t.humanIsEnd;
    yes[2] = t.consent;
    yes[3] = t.deceptive == false;
    yes[4] = t.coerced == false;
    yes[5] = t.priceRatio >= 0.8 && t.priceRatio <= 1.25;
    yes[6] = t.hasRemedy;
    yes[7] = t.thirdPartyHarm == false;
    yes[8] = t.bothBenefit;
    yes[9] = t.exploitsUrgency == false;
    yes[10] = t.coolingOffHours > 0.0;
    yes[11] = t.decisionMinutes >= 5.0;
    yes[12] = t.timestamped;
    yes[13] = t.termDays > 0.0;
    yes[14] = t.quoteAgeSeconds >= 0.0 && t.quoteAgeSeconds <= 60.0;
    yes[15] = t.tradesPerMinute >= 0.0 && t.tradesPerMinute <= 2000.0;
    yes[16] = t.listerIdentified;
    yes[17] = t.listerStanding >= 0.5;
    yes[18] = t.listingTruthful;
    yes[19] = t.listerProhibited == false;
    yes[20] = t.provenanceKnown;
    yes[21] = t.conflictDisclosed;
    yes[22] = t.listerCount >= 2;
    yes[23] = t.listerAccountable;
    yes[24] = t.inUsBoundary;
    yes[25] = t.lawfulSubject;
    yes[26] = t.sanctionedCounterparty == false;
    yes[27] = t.recordsKept;
    yes[28] = t.feesAccounted;
    yes[29] = t.manipulative == false;
    yes[30] = t.protectionsHonored;
    yes[31] = t.respectsUS;
    if (ts == null) {
      int i = 32;
      while (i < 41) { yes[i] = false; i = i + 1; }
      return;
    }
    yes[32] = ts.hasItem;
    yes[33] = ts.countNouns() >= 1;
    yes[34] = ts.canonical();
    yes[35] = ts.countNames() >= 1;
    yes[36] = ts.countScientific() >= 1;
    yes[37] = ts.countMoral() >= 1;
    yes[38] = ts.paired();
    yes[39] = ts.inBoundary;
    yes[40] = ts.respected;
  }

  < ---- judge one trade: 0 NO, 1 YES, 2 COMPLETE ---- >
  << Order of judgement: cardinal veto first, then each dimension must reach
     the floor, then overall merit (the mean of the dimension fractions that
     have active points) must reach the threshold. COMPLETE needs all 41 points
     active and yes. getReason says why. >>
  int evaluate(SLMoralTrade t, SLTallScience ts) {
    lastCardinalFail = -1;
    lastWeakDim = -1;
    lastMerit = 0.0;
    if (ready == false || t == null) { lastReason = "not ready"; lastVerdict = 0; return 0; }
    answers(t, ts);
    int d = 0;
    while (d < 5) { dimTotal[d] = 0; dimYes[d] = 0; d = d + 1; }
    int i = 0;
    int yesCount = 0;
    while (i < active) {
      int k = order[i];
      int dk = dim[k];
      dimTotal[dk] = dimTotal[dk] + 1;
      if (yes[k]) { dimYes[dk] = dimYes[dk] + 1; yesCount = yesCount + 1; }
      else { if (cardinal[k] && lastCardinalFail < 0) { lastCardinalFail = k; } }
      i = i + 1;
    }
    double sum = 0.0;
    int used = 0;
    d = 0;
    while (d < 5) {
      if (dimTotal[d] > 0) {
        dimFrac[d] = (dimYes[d] * 1.0) / dimTotal[d];
        sum = sum + dimFrac[d];
        used = used + 1;
        if (dimFrac[d] < dimFloor && lastWeakDim < 0) { lastWeakDim = d; }
      } else { dimFrac[d] = 0.0; }
      d = d + 1;
    }
    lastMerit = sum / used;
    if (lastCardinalFail >= 0) { lastReason = "cardinal veto"; lastVerdict = 0; return 0; }
    if (lastWeakDim >= 0) { lastReason = "dimension below floor"; lastVerdict = 0; return 0; }
    if (lastMerit < threshold) { lastReason = "merit below threshold"; lastVerdict = 0; return 0; }
    if (yesCount == 41 && mode == 3) { lastReason = "complete"; lastVerdict = 2; return 2; }
    lastReason = "merit sufficient";
    lastVerdict = 1;
    return 1;
  }

  < ---- evolution: a human reviewer confirms or corrects the verdict ---- >
  << A reviewer who says a YES was wrong raises the threshold by 0.01; a NO that
     was wrong lowers it by 0.01. The threshold stays in 0.60..0.95. Cardinal
     points and the dimension floor never change. Returns false when refused. >>
  boolean review(int verdictWas, boolean correct) {
    if (ready == false) { return false; }
    if (verdictWas < 0 || verdictWas > 2) { return false; }
    reviews = reviews + 1;
    if (correct) { return true; }
    if (verdictWas >= 1) { threshold = threshold + 0.01; }
    else { threshold = threshold - 0.01; }
    if (threshold < 0.60) { threshold = 0.60; }
    if (threshold > 0.95) { threshold = 0.95; }
    return true;
  }
}

< SLeeLa courseware model: the ledger of verdicts and merit over many trades. >
< Counts, mean and recent merit, the risk of merit, and where trades fail. >
class SLMoralLedger {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs. Values are faithful
     to the subject real origin where publicly known; unknown values use none. >>
  String metaVersion = "1.0.0";
  int metaId = 39513;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-13";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | nation | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-13";
  < metaScienceRating: maturity on a 1..10 scale; courseware model with rule based judgement >
  int metaScienceRating = 5;
  < metaNationalSchedule: a real citable instrument or none >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < Overall trades over time: a running record of verdicts and merit. >
  int count = 0;
  int nNo = 0;
  int nYes = 0;
  int nComplete = 0;
  double sumMerit = 0.0;
  double ema = 0.0;
  double minMerit = 1.0;
  int[] weak;
  int[] cardinalFails;
  boolean built = false;

  void build() {
    if (built) { return; }
    weak = new int[5];
    cardinalFails = new int[41];
    int i = 0;
    while (i < 5) { weak[i] = 0; i = i + 1; }
    i = 0;
    while (i < 41) { cardinalFails[i] = 0; i = i + 1; }
    built = true;
  }

  void noteTrade(SLMoralEvaluator ev) {
    build();
    count = count + 1;
    int v = ev.getVerdict();
    if (v == 2) { nComplete = nComplete + 1; }
    else { if (v == 1) { nYes = nYes + 1; } else { nNo = nNo + 1; } }
    double m = ev.getMerit();
    sumMerit = sumMerit + m;
    if (count == 1) { ema = m; } else { ema = 0.9 * ema + 0.1 * m; }
    if (m < minMerit) { minMerit = m; }
    int wd = ev.getWeakDim();
    if (wd >= 0) { weak[wd] = weak[wd] + 1; }
    int cf = ev.getCardinalFail();
    if (cf >= 0) { cardinalFails[cf] = cardinalFails[cf] + 1; }
  }

  int getCount() { return count; }
  int getNo() { return nNo; }
  int getYes() { return nYes; }
  int getComplete() { return nComplete; }
  double meanMerit() { if (count == 0) { return 0.0; } return sumMerit / count; }
  double recentMerit() { return ema; }
  double worstMerit() { return minMerit; }
  double riskOfMerit() { return 1.0 - meanMerit(); }
  int weakCount(int d) { build(); return weak[d]; }
  int cardinalCount(int id) { build(); return cardinalFails[id]; }
}

< SLeeLa courseware demo: judges trades with the Moral Evaluator and checks the result. >
< Synthetic trades; illustrative only. >
class MoralDemo {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs. Values are faithful
     to the subject real origin where publicly known; unknown values use none. >>
  String metaVersion = "1.0.0";
  int metaId = 39514;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-13";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | nation | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-13";
  < metaScienceRating: maturity on a 1..10 scale; courseware model with rule based judgement >
  int metaScienceRating = 5;
  < metaNationalSchedule: a real citable instrument or none >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  int passed = 0;
  int failed = 0;
  int seed = 20261113;

  void check(String what, boolean ok) {
    if (ok) { passed = passed + 1; print("  PASS  " + what); }
    else { failed = failed + 1; print("  FAIL  " + what); }
  }

  double rnd() {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return (seed * 1.0) / 2147483648.0;
  }

  void show(SLMoralEvaluator ev, String label) {
    print("  " + label + ": " + ev.verdictName(ev.getVerdict()) + "  merit=" + ev.getMerit()
          + "  risk=" + ev.getRisk() + "  reason=" + ev.getReason());
  }

  void main() {
    print("=== Moral Evaluator courseware model (rule based, synthetic, a teaching model) ===");

    print("-- 1. fail closed configuration --");
    SLMoralEvaluator bad = new SLMoralEvaluator();
    SLMoralTrade anyT = new SLMoralTrade();
    check("4 points refused (cardinals need 5)", bad.configure(4, 3) == false);
    check("42 points refused", bad.configure(42, 3) == false);
    check("4 verdict states refused", bad.configure(41, 4) == false);
    check("unconfigured evaluator says NO", bad.evaluate(anyT, null) == 0);
    check("unconfigured reason is not ready", bad.getReason() == "not ready");

    print("-- 2. the Tall Science catalog: the United States as an Item --");
    SLTallScience us = new SLTallScience();
    check("empty text refused", us.register(0, "") == false);
    check("unknown list refused", us.register(9, "x") == false);
    us.seed();
    check("seeded item is cataloged", us.hasItem);
    check("canonical name is the United States", us.canonical());
    check("nouns and names are paired respectively", us.paired());
    check("3 nouns, 3 names, 3 scientific, 3 moral", us.countNouns() == 3 && us.countNames() == 3
          && us.countScientific() == 3 && us.countMoral() == 3);
    us.register(0, "boundary");
    check("an unmatched noun breaks the respective pairing", us.paired() == false);
    us.register(1, "the United States border");
    check("adding the matching name restores it", us.paired());

    print("-- 3. judging trades (all 41 points, three verdict states) --");
    SLMoralEvaluator ev = new SLMoralEvaluator();
    ev.configure(41, 3);
    SLMoralTrade t = new SLMoralTrade();
    SLTallScience ts = new SLTallScience();
    ts.seed();
    check("exemplary trade is COMPLETE", ev.evaluate(t, ts) == 2);
    show(ev, "exemplary");
    check("merit is 1.0 and risk 0.0", ev.getMerit() == 1.0 && ev.getRisk() == 0.0);

    t.listerCount = 1;
    t.quoteAgeSeconds = 90.0;
    check("two soft failures: YES, not COMPLETE", ev.evaluate(t, ts) == 1);
    show(ev, "two soft misses");

    SLMoralTrade h = new SLMoralTrade();
    h.endangersLife = true;
    check("danger to life is NO even with 40 of 41 points yes", ev.evaluate(h, ts) == 0);
    show(ev, "endangers life");
    check("the cardinal veto names T01", ev.getCardinalFail() == 0 && ev.getReason() == "cardinal veto");
    check("merit alone would have passed", ev.getMerit() > 0.95);

    SLMoralTrade c = new SLMoralTrade();
    c.consent = false;
    check("no consent is NO", ev.evaluate(c, ts) == 0 && ev.getCardinalFail() == 2);
    SLMoralTrade u = new SLMoralTrade();
    u.humanIsEnd = false;
    check("a human used only as a means is NO", ev.evaluate(u, ts) == 0 && ev.getCardinalFail() == 1);
    SLMoralTrade l = new SLMoralTrade();
    l.lawfulSubject = false;
    check("unlawful subject is NO", ev.evaluate(l, ts) == 0 && ev.getCardinalFail() == 25);

    check("a missing Tall Science catalog is NO", ev.evaluate(new SLMoralTrade(), null) == 0);
    show(ev, "no Tall Science catalog");
    check("the weak dimension is tall science", ev.getWeakDim() == 4);

    SLMoralTrade m = new SLMoralTrade();
    m.priceRatio = 3.0;
    m.hasRemedy = false;
    m.thirdPartyHarm = true;
    m.bothBenefit = false;
    m.coerced = true;
    check("trades dimension below its floor is NO", ev.evaluate(m, ts) == 0 && ev.getWeakDim() == 0);
    show(ev, "unfair trade");

    SLMoralTrade s = new SLMoralTrade();
    s.exploitsUrgency = true;
    s.coolingOffHours = 0.0;
    s.decisionMinutes = 1.0;
    s.listerStanding = 0.2;
    s.listerCount = 1;
    s.listingTruthful = true;
    s.recordsKept = false;
    s.feesAccounted = false;
    check("scattered soft misses lower merit but still pass as YES", ev.evaluate(s, ts) == 1 && ev.getMerit() < 0.9);
    show(ev, "scattered soft misses");

    print("-- 4. as few as 5 points, binary or three states --");
    SLMoralEvaluator core = new SLMoralEvaluator();
    core.configure(5, 3);
    check("5 cardinal points: a fine trade is YES, never COMPLETE", core.evaluate(new SLMoralTrade(), ts) == 1);
    check("5 cardinal points still veto danger to life", core.evaluate(h, ts) == 0);
    SLMoralEvaluator bin = new SLMoralEvaluator();
    bin.configure(41, 2);
    check("binary mode reports an exemplary trade as YES", bin.evaluate(new SLMoralTrade(), ts) == 1);

    print("-- 5. evolution: a human reviewer moves the threshold --");
    SLMoralEvaluator rv = new SLMoralEvaluator();
    rv.configure(41, 3);
    double th0 = rv.getThreshold();
    rv.review(1, false);
    check("a wrong YES raises the threshold", rv.getThreshold() > th0);
    rv.review(0, false);
    rv.review(0, false);
    check("wrong NOs lower it again", rv.getThreshold() < th0 + 0.005);
    int j = 0;
    while (j < 100) { rv.review(1, false); j = j + 1; }
    check("the threshold stays at or below 0.95", rv.getThreshold() <= 0.95);
    check("a cardinal veto is not affected by review", rv.evaluate(h, ts) == 0);
    check("an out of range verdict in review is refused", rv.review(7, true) == false);

    print("-- 6. overall trades over time: the ledger --");
    SLMoralLedger led = new SLMoralLedger();
    SLMoralEvaluator ev2 = new SLMoralEvaluator();
    ev2.configure(41, 3);
    int n = 20000;
    int i = 0;
    int t0 = timeMonotonicNanos();
    while (i < n) {
      SLMoralTrade x = new SLMoralTrade();
      double r = rnd();
      if (r < 0.02) { x.endangersLife = true; }
      if (rnd() < 0.10) { x.listerCount = 1; }
      if (rnd() < 0.05) { x.quoteAgeSeconds = 120.0; }
      if (rnd() < 0.04) { x.consent = false; }
      if (rnd() < 0.03) { x.lawfulSubject = false; }
      if (rnd() < 0.08) { x.recordsKept = false; }
      if (rnd() < 0.03) { x.exploitsUrgency = true; x.coolingOffHours = 0.0; }
      ev2.evaluate(x, ts);
      led.noteTrade(ev2);
      i = i + 1;
    }
    int t1 = timeMonotonicNanos();
    double secs = ((t1 - t0) * 1.0) / 1.0e9;
    print("  trades=" + led.getCount() + "  NO=" + led.getNo() + "  YES=" + led.getYes()
          + "  COMPLETE=" + led.getComplete());
    print("  mean merit=" + led.meanMerit() + "  recent merit=" + led.recentMerit()
          + "  worst=" + led.worstMerit() + "  risk of merit=" + led.riskOfMerit());
    print("  cardinal vetoes: life=" + led.cardinalCount(0) + " consent=" + led.cardinalCount(2)
          + " lawful=" + led.cardinalCount(25));
    print("  judged " + (n / secs) + " trades per second (41 points each)");
    check("every trade is accounted for", led.getNo() + led.getYes() + led.getComplete() == n);
    check("risk of merit equals one minus mean merit", led.riskOfMerit() == 1.0 - led.meanMerit());
    check("some trades were vetoed", led.getNo() > 0 && led.cardinalCount(0) > 0);
    check("some trades were COMPLETE", led.getComplete() > 0);
    check("judges at least 1000 trades per second", n / secs >= 1000.0);

    print("=== checks passed=" + passed + " failed=" + failed + " ===");
  }
}
