/*
 * virtual-machine/vm-version/009/SLVmVersion009.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLVmVersion009 — the loadable manifest for VM version 009
 *   ("audit trail"), the OOD selector record the native VM loads on system
 *   start or a user conference. It names this version's native directory and
 *   the C/C++ main the loader builds and boots, declares the hardening units it
 *   composes (cumulative through v009 of the think-tank arc), and carries the
 *   default configuration profile a user starts from. build() returns the
 *   configured SLVmRuntime a selection resolves to.
 *
 * Mirrors the C/C++ in this folder (the 71-file core + the additive vm_* units
 * through v009). It extends SLVmVersion (lib/vm/src/sleela/SLVmVersion.sleela).
 *
 * Family: vm. Composes SLVmVersion, SLVmConfig, SLVmRuntime.
 */
#sleela 1.3
class SLVmVersion009 extends SLVmVersion {
  void configure() {
    base(9, "idea-vm-009", "audit trail", "virtual-machine/vm-version/009", "vm_audit_test");
    composeThrough(9);
    // default profile tuning for this version (user-editable in setup/conference)
    profile.setVerbosity(SLVmConfig.VERBOSITY_NORMAL);
  }
}
