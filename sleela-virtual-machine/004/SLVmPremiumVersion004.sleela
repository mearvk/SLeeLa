/*
 * sleela-virtual-machine/004/SLVmPremiumVersion004.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLVmPremiumVersion004 -- the loadable SLeeLa manifest for
 *   premium VM generation slvm-4 ("authenticated/distributed execution"), the OOD selector record the native
 *   VM can enumerate and select via `sleela vm select premium 4` (or p4).
 *   It names this generation's C/C++ project directory and admission validator,
 *   composes the cumulative premium capability set through generation 4, and
 *   carries the default configuration profile. build() returns the configured
 *   SLVmRuntime a selection resolves to; nativeBinary() names the binary the
 *   master build produces (vm-build/slvm-4).
 *
 * Faithful to impl/frontend/driver.cpp (kPremium) and virtual-machine/USER-GUIDE.md
 * (per-grade validator list). It extends SLVmPremiumVersion
 * (lib/vm/src/sleela/SLVmPremiumVersion.sleela).
 *
 * Family: vm. Composes SLVmPremiumVersion, SLVmConfig, SLVmRuntime.
 */
#sleela 2.4
class SLVmPremiumVersion004 extends SLVmPremiumVersion {
  void configure() {
    base(4, "slvm-4", "authenticated/distributed execution", "sleela-virtual-machine/004", "authenticated distributed nodes");
    composeThrough(4);
    // default profile tuning for this generation (user-editable in setup/conference)
    profile.setVerbosity(SLVmConfig.VERBOSITY_NORMAL);
  }
}
