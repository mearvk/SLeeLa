  public void firePropertyChange(java.lang.String propertyName, java.lang.Object oldValue, java.lang.Object newValue) {
    if (oldValue == null || newValue == null || oldValue != newValue) {
      firePropertyChange(new PropertyChangeEvent(this.sourceBean, propertyName, oldValue, newValue));
    }
  }
  public void firePropertyChange(java.beans.PropertyChangeEvent event) {
    PropertyChangeEvent e = (PropertyChangeEvent) event;
    Any oldValue = e.getOldValue();
    Any newValue = e.getNewValue();
    if (oldValue != null && newValue != null && oldValue == newValue) { return; }
    String name = e.getPropertyName();
    Any[] all = snapshot(this.allListeners, this.allCount);
    int i = 0;
    while (i < arrayLength(all)) { SLJavaBeanEvents.notifyPropertyChange(all[i], e); i = i + 1; }
    if (name != null) {
      Any[] named = getPropertyChangeListeners(name);
      int j = 0;
      while (j < arrayLength(named)) { SLJavaBeanEvents.notifyPropertyChange(named[j], e); j = j + 1; }
    }
  }
  public void fireIndexedPropertyChange(java.lang.String propertyName, int index, java.lang.Object oldValue, java.lang.Object newValue) {
    if (oldValue == null || newValue == null || oldValue != newValue) {
      firePropertyChange(new IndexedPropertyChangeEvent(this.sourceBean, propertyName, oldValue, newValue, index));
    }
  }

