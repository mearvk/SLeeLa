/*
 * lib/runtime/SLObjectFactory.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLObjectFactory used within the runtime library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: runtime. Native implementation crosses an explicit VM/OS bridge.
class SLObjectFactory {
  String name; int state; int count; void configure(String n){name=n;} void start(){state=1;} void stop(){state=0;} void register(){count=count+1;} boolean active(){return state==1;}
}
