<< lib/cpu/SLCircuitModel.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLCircuitModel, the physical circuit description a CPU
     carries inside its source. It gathers, for one processor: the logic family
     and its voltage thresholds, the supply rail, the clock and its phases, the
     functional blocks with their width, depth, gate and transistor counts, the
     timing paths with stage delays, the monitored nets with signal-quality
     checks, and the semaphores that arbitrate shared buses and latches.

   verifyAll() checks every part and returns the number of violations found:
     timing paths against the clock period, nets against the logic thresholds,
     the supply rail against its window, and semaphores for misuse or a
     permit held too long. runCycles(n) clocks the circuit, hands the shared
     latch to each clock phase in turn through its semaphore, samples every net
     at the level the loaded rail actually delivers, and ticks the semaphores.

   A per-CPU subclass overrides build() and fills the model with that
   processor figures. Every figure carries a provenance of published, derived
   or unknown. Unknown figures stay at zero or are omitted; they are never
   invented. This base class is generic and carries no CPU data of its own.

   Family: cpu. Pure Sleela circuit model; consumed by per-CPU circuit classes. >>
#sleela 2.5
material;
class SLCircuitModel {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 39540;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-21";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-21";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 7;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  String cpuName;
  SLLogicFamily family;
  SLVoltageRail rail;
  < clock frequency in kilohertz, so sub-megahertz parts stay exact >
  int clockKHz;
  < non-overlapping clock phases per cycle >
  int phases;
  int dataBits;
  int addrBits;
  < total transistors as published; 0 means unknown >
  int transistors;
  String provenance;
  SLCircuitBlock[] blocks;
  int blockCount;
  SLCircuitPath[] paths;
  int pathCount;
  SLSignalQuality[] nets;
  int netCount;
  SLCircuitSemaphore[] sems;
  int semCount;
  int cyclesRun;
  int phaseHandoffs;
  int phaseRefusals;
  < 2 when the figure was checked against a source, 1 when recalled but not checked, >
  < 0 when derived or unknown >
  int knownTransistors;
  int knownNode;
  int knownSupply;
  int knownClock;

  void configure(String name, SLLogicFamily fam, SLVoltageRail supply, int kHz, int phaseCount) {
    cpuName = name; family = fam; rail = supply;
    clockKHz = kHz; phases = phaseCount;
    dataBits = 0; addrBits = 0; transistors = 0; provenance = "unknown";
    blocks = new SLCircuitBlock[16]; blockCount = 0;
    paths = new SLCircuitPath[8]; pathCount = 0;
    nets = new SLSignalQuality[16]; netCount = 0;
    sems = new SLCircuitSemaphore[8]; semCount = 0;
    cyclesRun = 0; phaseHandoffs = 0; phaseRefusals = 0;
    knownTransistors = 0; knownNode = 0; knownSupply = 0; knownClock = 0;
  }

  < Declare how each of the four headline figures is backed: 2 checked, 1 recalled, 0 derived. >
  void setKnown(int transistorsKnown, int nodeKnown, int supplyKnown, int clockKnown) {
    knownTransistors = transistorsKnown; knownNode = nodeKnown;
    knownSupply = supplyKnown; knownClock = clockKnown;
  }

  < Override in each CPU circuit class to populate blocks, paths, nets and semaphores. >
  void build() { }

  void setWidths(int data, int addr) { dataBits = data; addrBits = addr; }
  void setTransistors(int count) { if (count >= 0) { transistors = count; } }
  void setProvenance(String p) { provenance = p; }

  < Clock period in picoseconds: 1e9 divided by kilohertz. >
  int periodPs() { if (clockKHz <= 0) { return 0; } return 1000000000 / clockKHz; }

  < Length of one clock phase in picoseconds. >
  int phasePs() { if (phases <= 0) { return periodPs(); } return periodPs() / phases; }

  SLCircuitBlock addBlock(String name, String kind, int bits, int depth, int gates, int xtors) {
    if (blockCount >= 16) { return null; }
    SLCircuitBlock b = new SLCircuitBlock();
    b.configure(name, kind, bits, depth, gates, xtors);
    blocks[blockCount] = b; blockCount = blockCount + 1;
    return b;
  }

  < Account for transistors the named blocks do not cover: the published total >
  < minus the modelled blocks. Does nothing when the total is unknown. >
  SLCircuitBlock addRemainder(String name) {
    if (transistors <= 0) { return null; }
    int left = transistors - blocksTransistors();
    if (left <= 0) { return null; }
    SLCircuitBlock b = addBlock(name, "other", 0, 0, 0, left);
    if (b != null) { b.setProvenance("derived: published total minus modelled blocks"); }
    return b;
  }

  < Add a timing path whose period defaults to one full clock period. >
  SLCircuitPath addPath(String name, int guardbandPs) {
    if (pathCount >= 8) { return null; }
    SLCircuitPath p = new SLCircuitPath();
    p.configure(name, periodPs(), guardbandPs);
    paths[pathCount] = p; pathCount = pathCount + 1;
    return p;
  }

  SLSignalQuality addNet(String name) {
    if (netCount >= 16) { return null; }
    SLSignalQuality n = new SLSignalQuality();
    n.configure(name, family);
    nets[netCount] = n; netCount = netCount + 1;
    return n;
  }

  SLCircuitSemaphore addSemaphore(String name, int permits, int holdLimitTicks) {
    if (semCount >= 8) { return null; }
    SLCircuitSemaphore s = new SLCircuitSemaphore();
    s.configure(name, permits, holdLimitTicks);
    sems[semCount] = s; semCount = semCount + 1;
    return s;
  }

  < Find a semaphore by name, or null. >
  SLCircuitSemaphore semaphore(String name) {
    int i = 0;
    while (i < semCount) {
      SLCircuitSemaphore s = sems[i];
      if (s.semName() == name) { return s; }
      i = i + 1;
    }
    return null;
  }

  int blocksTransistors() {
    int sum = 0; int i = 0;
    while (i < blockCount) { SLCircuitBlock b = blocks[i]; sum = sum + b.transistorCount(); i = i + 1; }
    return sum;
  }

  < Total modelled area in square micrometres across all blocks. >
  int areaUm2() {
    int sum = 0; int i = 0;
    while (i < blockCount) { SLCircuitBlock b = blocks[i]; sum = sum + b.areaUm2(family); i = i + 1; }
    return sum;
  }

  < The deepest block delay: the stage that bounds the clock. >
  int slowestBlockPs() {
    int worst = 0; int i = 0;
    while (i < blockCount) {
      SLCircuitBlock b = blocks[i];
      int d = b.delayThrough(family);
      if (d > worst) { worst = d; }
      i = i + 1;
    }
    return worst;
  }

  int timingViolations() {
    int bad = 0; int i = 0;
    while (i < pathCount) {
      SLCircuitPath p = paths[i];
      if (!p.honored()) { bad = bad + 1; }
      i = i + 1;
    }
    return bad;
  }

  int signalViolations() {
    int bad = 0; int i = 0;
    while (i < netCount) { SLSignalQuality n = nets[i]; bad = bad + n.violations(); i = i + 1; }
    return bad;
  }

  int semaphoreViolations() {
    int bad = 0; int i = 0;
    while (i < semCount) { SLCircuitSemaphore s = sems[i]; bad = bad + s.violations(); i = i + 1; }
    return bad;
  }

  int railViolations() { if (rail.withinLimits()) { return 0; } return 1; }

  < Check that the family itself has positive noise margins. >
  int familyViolations() { if (family.sound()) { return 0; } return 1; }

  < Run every check and return the total number of violations. >
  int verifyAll() {
    return familyViolations() + railViolations() + timingViolations()
         + signalViolations() + semaphoreViolations();
  }

  < Clock the circuit for n cycles. In each phase the shared latch semaphore is >
  < taken by that phase, every net is sampled at the level the loaded rail >
  < delivers, the phase gives the latch back, and the semaphores tick. >
  void runCycles(int n) {
    SLCircuitSemaphore latch = semaphore("latch");
    int droop = rail.droopMv();
    int c = 0;
    while (c < n) {
      int ph = 0;
      while (ph < phases) {
        String who = "phase" + ph;
        boolean got = true;
        if (latch != null) {
          got = latch.tryAcquire(who);
          if (got) { phaseHandoffs = phaseHandoffs + 1; } else { phaseRefusals = phaseRefusals + 1; }
        }
        int k = 0;
        while (k < netCount) {
          SLSignalQuality probe = nets[k];
          int level = family.vohMv;
          if ((c + ph + k) % 2 == 1) { level = family.volMv; }
          if (level == family.vohMv) {
            if (family.vddMv >= 0) { level = level - droop; } else { level = level + droop; }
          }
          probe.sample(level);
          k = k + 1;
        }
        if (latch != null && got) { latch.release(who); }
        int s = 0;
        while (s < semCount) { SLCircuitSemaphore sm = sems[s]; sm.tick(); s = s + 1; }
        ph = ph + 1;
      }
      c = c + 1;
      cyclesRun = cyclesRun + 1;
    }
  }

  << Circuit grade. Ten points, from two sources:
       data (4 points): one each for a transistor count, feature size, supply
         voltage and clock that was checked against a source. A recalled
         figure that was not checked scores 0 here and is counted by
         recalledFigures() instead, so checking it raises the grade;
       structure and checks (6 points): blocks present (1), at least two
         timing paths (1), at least three monitored nets (1), at least two
         semaphores (1), every timing path honored (1), and a clean
         verifyAll after runCycles, meaning no signal, rail, family or
         semaphore violation (1).
     The letter is A for 9 or 10, B for 7 or 8, C for 5 or 6, D for 3 or 4,
     and F below 3. The grade measures how well the model is sourced and how
     cleanly it verifies. It does not rank the processor itself. >>
  int sourced(int level) { if (level == 2) { return 1; } return 0; }

  < How many of the four headline figures are recalled but not yet checked. >
  int recalledFigures() {
    int n = 0;
    if (knownTransistors == 1) { n = n + 1; }
    if (knownNode == 1) { n = n + 1; }
    if (knownSupply == 1) { n = n + 1; }
    if (knownClock == 1) { n = n + 1; }
    return n;
  }

  int circuitScore() {
    int score = sourced(knownTransistors) + sourced(knownNode) + sourced(knownSupply) + sourced(knownClock);
    if (blockCount > 0) { score = score + 1; }
    if (pathCount >= 2) { score = score + 1; }
    if (netCount >= 3) { score = score + 1; }
    if (semCount >= 2) { score = score + 1; }
    if (timingViolations() == 0) { score = score + 1; }
    if (cyclesRun > 0 && verifyAll() == 0) { score = score + 1; }
    return score;
  }

  String circuitGrade() {
    int s = circuitScore();
    if (s >= 9) { return "A"; }
    if (s >= 7) { return "B"; }
    if (s >= 5) { return "C"; }
    if (s >= 3) { return "D"; }
    return "F";
  }

  String name() { return cpuName; }
  SLLogicFamily logicFamily() { return family; }
  SLVoltageRail supplyRail() { return rail; }
  int clock() { return clockKHz; }
  int phaseCount() { return phases; }
  int widthData() { return dataBits; }
  int widthAddr() { return addrBits; }
  int publishedTransistors() { return transistors; }
  String source() { return provenance; }
  int blockTotal() { return blockCount; }
  int pathTotal() { return pathCount; }
  int netTotal() { return netCount; }
  int semaphoreTotal() { return semCount; }
  int cycles() { return cyclesRun; }

  < Print a plain report of the whole circuit and its verification result. >
  void report() {
    print("circuit: " + cpuName + "  family=" + family.familyName() + " (" + family.source() + ")");
    print("  node=" + family.nodeNm() + "nm  supply=" + rail.effectiveMv() + "mV  clock=" + clockKHz + "kHz  phases=" + phases + "  period=" + periodPs() + "ps  data/addr=" + dataBits + "/" + addrBits);
    print("  noise margin high/low = " + family.noiseMarginHighMv() + "/" + family.noiseMarginLowMv() + " mV  gate delay=" + family.delayPs() + "ps  fanout=" + family.fanout());
    print("  transistors published=" + transistors + "  modelled=" + blocksTransistors() + "  area=" + areaUm2() + "um2  slowest block=" + slowestBlockPs() + "ps");
    int i = 0;
    while (i < blockCount) {
      SLCircuitBlock b = blocks[i];
      print("  block " + b.blockName() + " [" + b.blockKind() + "] " + b.width() + "b x " + b.depth() + " deep, " + b.gates() + " gates, " + b.transistorCount() + " xtors, " + b.delayThrough(family) + "ps (" + b.source() + ")");
      i = i + 1;
    }
    i = 0;
    while (i < pathCount) {
      SLCircuitPath p = paths[i];
      print("  path " + p.pathName() + " delay=" + p.totalDelayPs() + "ps slack=" + p.slackPs() + "ps critical=" + p.criticalStage() + " max=" + p.maxMHz() + "MHz");
      i = i + 1;
    }
    i = 0;
    while (i < netCount) {
      SLSignalQuality n = nets[i];
      print("  net " + n.netName() + " samples=" + n.sampleCount() + " violations=" + n.violations());
      i = i + 1;
    }
    i = 0;
    while (i < semCount) {
      SLCircuitSemaphore s = sems[i];
      print("  semaphore " + s.semName() + " acquires=" + s.acquires + " contended=" + s.contention() + " violations=" + s.violations());
      i = i + 1;
    }
    print("  verifyAll violations = " + verifyAll());
    print("  circuit grade = " + circuitGrade() + " (" + circuitScore() + "/10), recalled figures awaiting a check = " + recalledFigures());
  }
}
