/*
 * lib/codecs/SLCodecMatroskaAudio.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Matroska Audio codec class — the SLeeLa-facing handle to codec id 18.
 */
#sleela 1.3
// Family: codecs. Individual codec class for Matroska Audio:
// Matroska container carrying audio; shares the EBML header. Mirrors codecs/codecs/matroska_audio/ and the registry entry in
// sleela_codec_manager.h. SLeeLa never calls a codec directly; the
// SLCodecLoader loads this plugin by id and dispatches decode/encode. This
// class is the metadata + capability contract for that plugin.
//
// Handler state codes: 0 native, 1 backend, 2 recognized, 3 container, 4 event.
class SLCodecMatroskaAudio {
  // Registry identity (mirrors sleela_codec_handler).
  int id() { return 18; }
  String name() { return "Matroska Audio"; }
  String mime() { return "audio/x-matroska"; }
  String extensions() { return ".mka"; }

  // Capability state: 3 == container.
  int state() { return 3; }
  String stateName() { return "container"; }

  // Direction support advertised by the plugin vtable.
  boolean canDecode() { return true; }
  boolean canEncode() { return true; }

  // Native codecs implement encode/decode in-package (no external backend);
  // a backend codec reports its honest state and fails cleanly from
  // decode/encode until an approved backend adapter is registered.
  boolean isNative() { return false; }
  boolean needsBackend() { return false; }
}
