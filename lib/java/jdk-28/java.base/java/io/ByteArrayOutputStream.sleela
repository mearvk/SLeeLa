  << java.io.ByteArrayOutputStream over the declared buf / count fields; the
     buffer grows as Java grows it. Bytes are stored as Java does, as signed
     values -128..127. The toString forms need a byte-to-String decoder, which
     SLeeLa does not have yet, and writeTo needs a base-typed OutputStream
     receiver; both keep their stubs. close is a reserved SLeeLa built-in. >>
  public ByteArrayOutputStream() { initBuffer(32); }
  public ByteArrayOutputStream(int size) {
    if (size < 0) { throw new IllegalArgumentException("Negative initial size: " + size); }
    initBuffer(size);
  }
  void initBuffer(int size) {
    this.buf = new byte[size];
    this.count = 0;
  }
  void ensureCapacity(int minCapacity) {
    int cap = arrayLength(this.buf);
    if (minCapacity <= cap) { return; }
    int nc = cap * 2;
    if (nc < minCapacity) { nc = minCapacity; }
    byte[] nb = new byte[nc];
    int i = 0;
    while (i < this.count) { nb[i] = this.buf[i]; i = i + 1; }
    this.buf = nb;
  }
  public synchronized void write(int b) {
    ensureCapacity(this.count + 1);
    this.buf[this.count] = signedByte(b);
    this.count = this.count + 1;
  }
  public synchronized void write(byte[] b, int off, int len) {
    int n = arrayLength(b);
    if (off < 0 || len < 0 || off > n || len > n - off) {
      throw new IndexOutOfBoundsException("Range [" + off + ", " + off + " + " + len + ") out of bounds for length " + n);
    }
    ensureCapacity(this.count + len);
    int i = 0;
    while (i < len) { this.buf[this.count + i] = signedByte(b[off + i]); i = i + 1; }
    this.count = this.count + len;
  }
  public void writeBytes(byte[] b) { this.write(b, 0, arrayLength(b)); }
  public synchronized byte[] toByteArray() {
    byte[] out = new byte[this.count];
    int i = 0;
    while (i < this.count) { out[i] = this.buf[i]; i = i + 1; }
    return out;
  }
  public synchronized int size() { return this.count; }
  public synchronized void reset() { this.count = 0; }

  int signedByte(int b) {
    int v = b % 256;
    if (v < 0) { v = v + 256; }
    if (v > 127) { v = v - 256; }
    return v;
  }
