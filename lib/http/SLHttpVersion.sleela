/*
 * lib/http/SLHttpVersion.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLHttpVersion used within the http library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: http. Native implementation crosses an explicit VM/OS bridge.
class SLHttpVersion {
  String path; int status; int state; void configure(String p){path=p;} void open(){state=1;} void close(){state=0;} void setStatus(int s){status=s;} boolean active(){return state==1;}
}
