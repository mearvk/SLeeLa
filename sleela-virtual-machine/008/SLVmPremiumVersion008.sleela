/*
 * sleela-virtual-machine/008/SLVmPremiumVersion008.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLVmPremiumVersion008 -- the loadable SLeeLa manifest for
 *   premium VM generation slvm-8 (codename "Executive"; "supervised execution, admission, leases, transactions, audit"), the OOD selector
 *   record the native VM can enumerate and select via `sleela vm select premium
 *   8` (or p8). It names this generation's C/C++ project directory, codename,
 *   and admission validator, composes the cumulative premium capability set
 *   through generation 8, and carries the default configuration profile.
 *   build() returns the configured SLVmRuntime a selection resolves to;
 *   nativeBinary() names the binary the master build produces (vm-build/slvm-8).
 *
 * Faithful to impl/frontend/driver.cpp (kPremium), each VM's SLVM_CODENAME
 * (src/slvm08_vm.c), and virtual-machine/USER-GUIDE.md (per-grade validator).
 * It extends SLVmPremiumVersion (lib/vm/src/sleela/SLVmPremiumVersion.sleela).
 *
 * Family: vm. Composes SLVmPremiumVersion, SLVmConfig, SLVmRuntime.
 */
#sleela 2.4
class SLVmPremiumVersion008 extends SLVmPremiumVersion {
  void configure() {
    base(8, "slvm-8", "Executive", "supervised execution, admission, leases, transactions, audit", "sleela-virtual-machine/008", "admission gate");
    composeThrough(8);
    // default profile tuning for this generation (user-editable in setup/conference)
    profile.setVerbosity(SLVmConfig.VERBOSITY_NORMAL);
  }
}
