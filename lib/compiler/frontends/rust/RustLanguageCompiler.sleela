/*
 * lib/compiler/frontends/rust/RustLanguageCompiler.sleela
 * SLeeLa Standard Library Definition.
 * Definition: A modular front end that compiles the Rust programming language
 *   into SLeeLa IR and onward to a VM-ready artifact.
 *
 * Rust is a compiled, statically typed, ownership-checked language. Its
 * semantic phase carries borrow/lifetime analysis in addition to type checking,
 * illustrating how a front end extends the shared semantic phase with
 * language-specific rules while keeping the common pipeline shape.
 *
 * Family: compiler (front end). Native VM/OS work crosses an explicit bridge.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class RustLanguageCompiler extends SLLanguageCompiler {

  void configure() {
    declare("Rust", "systems", "Rust 2021", ".rs", TARGET_SLVM);
    provide(PHASE_SOURCE);
    provide(PHASE_LEX);
    provide(PHASE_PARSE);
    provide(PHASE_RESOLVE);
    provide(PHASE_SEMANTIC);
    provide(PHASE_IR);
    provide(PHASE_LOWER);
    provide(PHASE_CODEGEN);
  }

  boolean runSemantic(SLCompileRequest request) {
    // Rust semantics: trait resolution, type checking, and ownership /
    // borrow / lifetime analysis before IR construction.
    return provides(PHASE_SEMANTIC);
  }
}
