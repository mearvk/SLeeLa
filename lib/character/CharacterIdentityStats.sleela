#sleela 1.10
/*
 * CharacterIdentityStats.sleela
 * SLeeLa CharacterStats component: identity and progression.
 *
 * This focused value class separates one coherent group of CharacterStats
 * fields for reuse by games, simulations, and interactive fiction. Values and
 * scales are defined by the consuming game's ruleset; no universal caps are
 * assumed unless explicitly enforced by a method.
 */
class CharacterIdentityStats {
    string characterId;
    string characterName;
    string characterClass;
    string characterRace;
    string characterArchetype;
    int level;
    long experience;
    long experienceToNextLevel;
    int proficiencyBonus;
    int alignment;
    int age;
    int lifespan;
    int schemaVersion;
    int rulesetId;

    int isVeteran() { return level > 1; }
    int hasIdentity() { return characterId != "" || characterName != ""; }
}
