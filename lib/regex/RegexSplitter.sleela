/*
 * lib/regex/RegexSplitter.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexSplitter used within the regex library family.
 */
#sleela 1.3
class RegexSplitter {
  int parts;
  void clear(){parts=0;}
  void addPart(){parts=parts+1;}
  int count(){return parts;}
}
