/*
 * lib/text/SLString.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLString used within the text library family.
 */
#sleela 1.3
// Unified SLeeLa standard-library front-end object.
// Family: text. Native VM/OS work crosses an explicit bridge.
class SLString {
  String value; void set(String v){value=v;} String get(){return value;} void clear(){value="";}
}
