# SLPDP4CPU — SLeeLa PDP-4 CPU profile
#
# Functional, profile-driven model. Cycle accuracy is not implied.
# Keep PDP-4 decoding separate from other DEC PDP-family decoders.

class SLPDP4CPU extends SLCPU {
    const WORD_BITS = 18;

    state {
        pc;
        ac;
        linkState;
        instructionRegister;
        memory;
        addressBits;
        deviceMap;
        timingProfile;
    }

    configure(profile) {
        require(profile.wordBits == WORD_BITS);
        require(profile.memoryWords > 0);
        require(profile.addressBits > 0);
        this.addressBits = profile.addressBits;
        this.memory = SLRAM.create(profile.memoryWords, WORD_BITS);
        this.deviceMap = profile.deviceMap ?? {};
        this.timingProfile = profile.timingProfile ?? "functional";
        return this;
    }

    step() {
        let instruction = this.fetchWord(this.pc, WORD_BITS);
        this.instructionRegister = instruction;
        let decoded = this.decodePDP4(instruction, this.addressBits);
        if (!decoded.supported) {
            this.reportUnsupported("PDP4_OPCODE", instruction, this.pc);
            return this.result("unsupported", instruction);
        }
        return this.executePDP4(decoded);
    }

    # Exact opcode fields, flags, and timing must come from a verified PDP-4 profile.
    # Do not silently reuse PDP-5/PDP-8 or later PDP-family instruction semantics.
}