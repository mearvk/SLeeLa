/* Shared SLeeLa GUI family palette. Keep chrome tokens identical across lines. */
#sleela 2.1
class SLGuiTheme {
  static final String TITLE_BAR = "#1D2025";
  static final String MENU_BAR = "#1D2025";
  static final String URL_BAR = "#383C47";
  static final String PANEL = "#292D35";
  static final String SURFACE = "#22262D";
  static final String TEXT = "#E8EAED";
  static final String MUTED_TEXT = "#B0B7C3";
  static final String BORDER = "#444A56";
  static final String ACCENT = "#4F8CFF";
  static final String FOCUS = "#8AB4F8";
  static final String DANGER = "#D9534F";
  static final String SUCCESS = "#3FA776";

  // Typed SLColor words (0xRRGGBBAA) used by SLTheme at runtime.
  static final int TITLE_BAR_COLOR = 0x1D2025FF;
  static final int MENU_BAR_COLOR = 0x1D2025FF;
  static final int URL_BAR_COLOR = 0x383C47FF;
  static final int PANEL_COLOR = 0x292D35FF;
  static final int SURFACE_COLOR = 0x22262DFF;
  static final int TEXT_COLOR = 0xE8EAEDFF;
  static final int MUTED_TEXT_COLOR = 0xB0B7C3FF;
  static final int BORDER_COLOR = 0x444A56FF;
  static final int ACCENT_COLOR = 0x4F8CFFFF;
  static final int FOCUS_COLOR = 0x8AB4F8FF;
  static final int DANGER_COLOR = 0xD9534FFF;
  static final int SUCCESS_COLOR = 0x3FA776FF;

  String titleBar() { return TITLE_BAR; }
  String urlBar() { return URL_BAR; }
  String panel() { return PANEL; }
  String surface() { return SURFACE; }
  String text() { return TEXT; }
  String mutedText() { return MUTED_TEXT; }
  String border() { return BORDER; }
  String accent() { return ACCENT; }
  String focus() { return FOCUS; }
  String danger() { return DANGER; }
  String success() { return SUCCESS; }
}
