<< lib/math/SLMatrix.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines the SLeeLa standard-library type SLMatrix used within the math library family. >>
#sleela 2.5
material;
< SLeeLa math front-end contract. >
class SLMatrix {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 550;
  String metaAuthor = "Max Rupplin vs. Dr. Mrs. Elisabeth Harkins";
  String metaDate = "2026-10-16";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-09-28";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < Row-major dense matrix stored as a flat double[] of length rows*cols. >
  int rows;
  int cols;
  void shape(int r, int c) { rows = r; cols = c; }
  double at(double[] m, int r, int c) { return m[r * cols + c]; }
  void put(double[] m, int r, int c, double v) { m[r * cols + c] = v; }
  int getRows() { return rows; }
  int getCols() { return cols; }

  < Dense row-major multiplication. >
  void multiply(double[] a, double[] b, double[] out,
                int r, int shared, int c) {
    int i = 0;
    while (i < r * c) { out[i] = 0.0; i = i + 1; }
    int row = 0;
    while (row < r) {
      int k = 0;
      while (k < shared) {
        int col = 0;
        while (col < c) {
          out[row * c + col] = out[row * c + col] +
            a[row * shared + k] * b[k * c + col];
          col = col + 1;
        }
        k = k + 1;
      }
      row = row + 1;
    }
  }
  void transpose(double[] a, double[] out, int r, int c) {
    int row = 0;
    while (row < r) {
      int col = 0;
      while (col < c) {
        out[col * r + row] = a[row * c + col];
        col = col + 1;
      }
      row = row + 1;
    }
  }
  double absolute(double x) { if (x < 0.0) { return 0.0 - x; } return x; }
  < Caller supplies scratch for pivoted Gaussian elimination. >
  double determinant(double[] a, double[] scratch, int n) {
    int i = 0;
    while (i < n * n) { scratch[i] = a[i]; i = i + 1; }
    double det = 1.0;
    int sign = 1;
    int k = 0;
    while (k < n) {
      int pivot = k;
      int row = k + 1;
      while (row < n) {
        if (absolute(scratch[row * n + k]) >
            abs(scratch[pivot * n + k])) { pivot = row; }
        row = row + 1;
      }
      if (scratch[pivot * n + k] == 0.0) { return 0.0; }
      if (pivot != k) {
        int col = 0;
        while (col < n) {
          double t = scratch[k * n + col];
          scratch[k * n + col] = scratch[pivot * n + col];
          scratch[pivot * n + col] = t;
          col = col + 1;
        }
        sign = 0 - sign;
      }
      double diagonal = scratch[k * n + k];
      det = det * diagonal;
      row = k + 1;
      while (row < n) {
        double factor = scratch[row * n + k] / diagonal;
        int col = k + 1;
        while (col < n) {
          scratch[row * n + col] = scratch[row * n + col] -
            factor * scratch[k * n + col];
          col = col + 1;
        }
        row = row + 1;
      }
      k = k + 1;
    }
    return det * sign;
  }
  < Identity matrix of order n written into `m`. >
  void identity(double[] m, int n) {
    int i = 0;
    while (i < n * n) { m[i] = 0.0; i = i + 1; }
    int d = 0;
    while (d < n) { m[d * n + d] = 1.0; d = d + 1; }
  }
}
