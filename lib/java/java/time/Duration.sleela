  long parseTimeNanos() {
    long h = digits(2, 2);
    expectUnit(58);
    long mi = digits(2, 2);
    long s = 0;
    long nano = 0;
    if (peekUnit() == 58) {
      this.parsePos = this.parsePos + 1;
      s = digits(2, 2);
      if (peekUnit() == 46) {
        this.parsePos = this.parsePos + 1;
        int start = this.parsePos;
        long f = digits(1, 9);
        int n = this.parsePos - start;
        while (n < 9) { f = f * 10; n = n + 1; }
        nano = f;
