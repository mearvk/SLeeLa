/*
 * lib/core/SLSession.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLSession used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Session.
// Role: service. Responsibility: session state/lifecycle.
class SLSession {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
