    if (i == 24) { return s24; } if (i == 25) { return s25; } if (i == 26) { return s26; }
    if (i == 27) { return s27; } if (i == 28) { return s28; } if (i == 29) { return s29; }
    if (i == 30) { return s30; } if (i == 31) { return s31; } if (i == 32) { return s32; }
    if (i == 33) { return s33; } if (i == 34) { return s34; } if (i == 35) { return s35; }
    if (i == 36) { return s36; } if (i == 37) { return s37; } if (i == 38) { return s38; }
