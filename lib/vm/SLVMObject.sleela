/*
 * lib/vm/SLVMObject.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLVMObject used within the vm library family.
 */
#sleela 1.3
// Unified SLeeLa standard-library front-end object.
// Family: vm. Native VM/OS work crosses an explicit bridge.
class SLVMObject {
  String name; int state; int count; void configure(String n){name=n;} void start(){state=1;} void stop(){state=0;} void register(){count=count+1;} boolean active(){return state==1;}
}
