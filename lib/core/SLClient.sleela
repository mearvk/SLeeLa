/*
 * lib/core/SLClient.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLClient used within the core library family.
 */
#sleela 2.1
// Native foundational bridge contract for Client.
// Role: service. Responsibility: client endpoint lifecycle.
class SLClient {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
