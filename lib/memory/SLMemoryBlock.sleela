/*
 * lib/memory/SLMemoryBlock.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLMemoryBlock used within the memory library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: memory. Native implementation crosses an explicit VM/OS bridge.
class SLMemoryBlock {
  int capacity; int used; void configure(int n){capacity=n;used=0;} void consume(int n){used=used+n;} int available(){return capacity-used;}
}
