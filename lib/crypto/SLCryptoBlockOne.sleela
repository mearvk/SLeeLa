/*
 * lib/crypto/SLCryptoBlockOne.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLCryptoBlockOne, the
 *   first ordered step of the main cryptography series.
 *
 * Rationale: Mirrors pass one() of the reference AES2 module — the initial pad.
 *   It converts the primary plaintext through base 12 and ORs it with the
 *   initial constant to produce the first running value.
 *
 * Order and Orientation:
 *   - Order:       1 (always first in the main series).
 *   - Orientation: ORIENT_ALTERATION (alters the single primary field).
 *   - Respect:     highest, so the init pad is never reordered beneath later steps.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLCryptoBlockOne extends SLCryptoBlock {
  static final int STEP_ORDER = 1;
  static final int STEP_BASE = 12;        // reference pass one uses base-12
  static final int STEP_MASK = 0x88034321; // reference initial OR constant

  void prepare() {
    configure(STEP_ORDER, ORIENT_ALTERATION, 255, STEP_BASE, STEP_MASK,
              "Order01.Alteration.InitialPad.Respected");
    enable();
  }
}
