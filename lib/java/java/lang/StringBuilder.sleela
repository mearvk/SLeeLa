  < ---- StringBuilder members (procedural implementation in SLeeLa) ---- >
  << StringBuilder over a Java UTF-16 String value (buf). Text goes in
     through javaStringFromUtf8 and is spliced with javaStringSubstring and
     javaStringConcat, so every index counts UTF-16 code units, as in Java.
     Exceptions carry the JDK 25 messages. String arguments may be plain SLeeLa
     Strings or Java UTF-16 Strings. toString() returns a plain String when every
     code unit has a plain form (printable ASCII, tab, newline, carriage
     return), so the result concatenates and compares like any SLeeLa String,
     and the UTF-16 String otherwise. CharSequence arguments may be plain
     Strings, StringBuilder or StringBuffer. The VM has no char primitive, so a
     char is an int code unit; building text from a run-time code unit covers
     printable ASCII plus tab, newline and carriage return and throws
     UnsupportedOperationException otherwise. append(char) cannot be told apart
     from append(int) and keeps its stub, as do the float and double forms. >>
  String buf = javaStringFromCodeUnits();
  String asciiTable = javaStringFromUtf8(" !?#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[?]^_`abcdefghijklmnopqrstuvwxyz{|}~");

  public StringBuilder() { this.buf = javaStringFromCodeUnits(); }
  public StringBuilder(int capacity) {
    if (capacity < 0) { throw new NegativeArraySizeException("" + capacity); }
    this.buf = javaStringFromCodeUnits();
  }
  public StringBuilder(java.lang.String str) {
    if (str == null) { throw new NullPointerException(); }
    this.buf = toU(str);
  }

  public int length() { return javaStringLength(this.buf); }
  public int capacity() { return javaStringLength(this.buf) + 16; }
  public boolean isEmpty() { return javaStringLength(this.buf) == 0; }
  public java.lang.String toString() { return JavaText.plainIfRepresentable(this.buf); }
  public char charAt(int index) {
    checkIndex(index, length());
    return javaStringCharAt(this.buf, index);
  }
  public int codePointAt(int index) {
    checkIndex(index, length());
    return javaStringCodePointAt(this.buf, index);
  }
  public int compareTo(StringBuilder another) {
    return javaStringCompareTo(this.buf, another.buf);
  }
  public int hashCode() { return javaStringHashCode(this.buf); }

  public java.lang.String substring(int start) { return substring(start, length()); }
  public java.lang.String substring(int start, int end) {
    checkRange(start, end, length());
    return javaStringSubstring(this.buf, start, end);
  }

  public StringBuilder append(java.lang.String str) {
    if (str == null) { return appendText("null"); }
    return appendText(str);
  }
  public StringBuilder append(int i) { return appendText("" + i); }
  public StringBuilder append(long lng) { return appendText("" + lng); }
  public StringBuilder append(boolean b) {
    if (b) { return appendText("true"); }
    return appendText("false");
  }
  public StringBuilder appendCodePoint(int codePoint) {
    this.buf = javaStringConcat(this.buf, codeUnitString(codePoint));
    return this;
  }

  public StringBuilder insert(int offset, java.lang.String str) {
    checkOffset(offset, length());
    String t = "null";
    if (str != null) { t = str; }
    return spliceIn(offset, toU(t));
  }
  public StringBuilder insert(int offset, int i) { return insert(offset, "" + i); }
  public StringBuilder insert(int offset, long l) { return insert(offset, "" + l); }
  public StringBuilder insert(int offset, boolean b) {
    if (b) { return insert(offset, "true"); }
    return insert(offset, "false");
  }

  public StringBuilder delete(int start, int end) {
    int n = length();
    int e = end;
    if (e > n) { e = n; }
    checkRange(start, e, n);
    this.buf = javaStringConcat(javaStringSubstring(this.buf, 0, start), javaStringSubstring(this.buf, e, n));
    return this;
  }
  public StringBuilder deleteCharAt(int index) {
    checkIndex(index, length());
    return delete(index, index + 1);
  }
  public StringBuilder replace(int start, int end, java.lang.String str) {
    int n = length();
    int e = end;
    if (e > n) { e = n; }
    checkRange(start, e, n);
    String mid = toU(str);
    this.buf = javaStringConcat(javaStringConcat(javaStringSubstring(this.buf, 0, start), mid), javaStringSubstring(this.buf, e, n));
    return this;
  }
  public void setLength(int newLength) {
    if (newLength < 0) { throw new StringIndexOutOfBoundsException("String index out of range: " + newLength); }
    int n = length();
    if (newLength <= n) {
      this.buf = javaStringSubstring(this.buf, 0, newLength);
      return;
    }
    int k = newLength - n;
    while (k > 0) { this.buf = javaStringConcat(this.buf, codeUnitString(0)); k = k - 1; }
  }
  public void setCharAt(int index, char ch) {
    checkIndex(index, length());
    int n = length();
    this.buf = javaStringConcat(javaStringConcat(javaStringSubstring(this.buf, 0, index), codeUnitString(ch)), javaStringSubstring(this.buf, index + 1, n));
  }
  public StringBuilder reverse() {
    int n = length();
    String out = javaStringFromCodeUnits();
    int i = n - 1;
    while (i >= 0) { out = javaStringConcat(out, javaStringSubstring(this.buf, i, i + 1)); i = i - 1; }
    this.buf = out;
    return this;
  }
  public StringBuilder repeat(int codePoint, int count) {
    if (count < 0) { throw new IllegalArgumentException("count is negative: " + count); }
    String u = codeUnitString(codePoint);
    int k = count;
    while (k > 0) { this.buf = javaStringConcat(this.buf, u); k = k - 1; }
    return this;
  }

  public int indexOf(java.lang.String str) { return indexOf(str, 0); }
  public int indexOf(java.lang.String str, int fromIndex) {
    String t = toU(str);
    int n = length();
    int m = javaStringLength(t);
    int i = fromIndex;
    if (i < 0) { i = 0; }
    if (m == 0) {
      if (i > n) { return n; }
      return i;
    }
    while (i + m <= n) {
      if (javaStringSubstring(this.buf, i, i + m) == t) { return i; }
      i = i + 1;
    }
    return 0 - 1;
  }
  public int lastIndexOf(java.lang.String str) { return lastIndexOf(str, length()); }
  public int lastIndexOf(java.lang.String str, int fromIndex) {
    String t = toU(str);
    int n = length();
    int m = javaStringLength(t);
    int i = fromIndex;
    if (i > n - m) { i = n - m; }
    if (i < 0) { return 0 - 1; }
    while (i >= 0) {
      if (javaStringSubstring(this.buf, i, i + m) == t) { return i; }
      i = i - 1;
    }
    return 0 - 1;
  }

  public StringBuilder append(java.lang.CharSequence s) {
    if (s == null) { return appendText("null"); }
    this.buf = javaStringConcat(this.buf, seqU(s));
    return this;
  }
  public StringBuilder append(java.lang.CharSequence s, int start, int end) {
    String u = javaStringFromUtf8("null");
    if (s != null) { u = seqU(s); }
    int n = javaStringLength(u);
    if (start < 0 || start > end || end > n) { throw new IndexOutOfBoundsException("Range [" + start + ", " + end + ") out of bounds for length " + n); }
    this.buf = javaStringConcat(this.buf, javaStringSubstring(u, start, end));
    return this;
  }
  public StringBuilder append(char[] str) { return append(str, 0, arrayLength(str)); }
  public StringBuilder append(char[] str, int offset, int len) {
    int n = arrayLength(str);
    if (offset < 0 || len < 0 || offset > n - len) { throw new IndexOutOfBoundsException("Range [" + offset + ", " + (offset + len) + ") out of bounds for length " + n); }
    this.buf = javaStringConcat(this.buf, unitsU(str, offset, len));
    return this;
  }
  public StringBuilder insert(int offset, char[] str) {
    checkOffset(offset, length());
    return spliceIn(offset, unitsU(str, 0, arrayLength(str)));
  }
  public StringBuilder insert(int index, char[] str, int offset, int len) {
    checkOffset(index, length());
    int n = arrayLength(str);
    if (offset < 0 || len < 0 || offset > n - len) { throw new StringIndexOutOfBoundsException("Range [" + offset + ", " + (offset + len) + ") out of bounds for length " + n); }
    return spliceIn(index, unitsU(str, offset, len));
  }
  public StringBuilder insert(int dstOffset, java.lang.CharSequence s) {
    checkOffset(dstOffset, length());
    if (s == null) { return spliceIn(dstOffset, javaStringFromUtf8("null")); }
    return spliceIn(dstOffset, seqU(s));
  }
  public StringBuilder insert(int dstOffset, java.lang.CharSequence s, int start, int end) {
    checkOffset(dstOffset, length());
    String u = javaStringFromUtf8("null");
    if (s != null) { u = seqU(s); }
    int n = javaStringLength(u);
    if (start < 0 || start > end || end > n) { throw new IndexOutOfBoundsException("Range [" + start + ", " + end + ") out of bounds for length " + n); }
    return spliceIn(dstOffset, javaStringSubstring(u, start, end));
  }
  public StringBuilder repeat(java.lang.CharSequence cs, int count) {
    if (count < 0) { throw new IllegalArgumentException("count is negative: " + count); }
    String u = javaStringFromUtf8("null");
    if (cs != null) { u = seqU(cs); }
    int k = count;
    while (k > 0) { this.buf = javaStringConcat(this.buf, u); k = k - 1; }
    return this;
  }

  < text of either String kind as UTF-16 >
  java.lang.String toU(java.lang.String s) {
    if (s instanceof string) { return javaStringFromUtf8(s); }
    return s;
  }
  < a CharSequence argument as UTF-16: a plain String, a StringBuilder or a StringBuffer >
  java.lang.String seqU(Any s) {
    if (s instanceof string) { return javaStringFromUtf8("" + s); }
    if (s instanceof StringBuilder) { StringBuilder b = (StringBuilder) s; return b.buf; }
    if (s instanceof StringBuffer) { StringBuffer f = (StringBuffer) s; return f.buf; }
    throw new UnsupportedOperationException("java.lang.StringBuilder: this CharSequence kind is not supported yet; pass a String, StringBuilder or StringBuffer");
  }
  < a run of char code units as UTF-16 >
  java.lang.String unitsU(char[] str, int offset, int len) {
    String out = javaStringFromCodeUnits();
    int i = 0;
    while (i < len) { out = javaStringConcat(out, codeUnitString(str[offset + i])); i = i + 1; }
    return out;
  }

  < internal helpers >
  StringBuilder appendText(java.lang.String text) {
    this.buf = javaStringConcat(this.buf, toU(text));
    return this;
  }
  StringBuilder spliceIn(int offset, java.lang.String utf16) {
    int n = length();
    this.buf = javaStringConcat(javaStringConcat(javaStringSubstring(this.buf, 0, offset), utf16), javaStringSubstring(this.buf, offset, n));
    return this;
  }
  < one UTF-16 code unit as a String; ASCII 0..126 plus the explicit controls >
  java.lang.String codeUnitString(int c) {
    if (c == 0) { return javaStringFromCodeUnits(0); }
    if (c == 9) { return javaStringFromCodeUnits(9); }
    if (c == 10) { return javaStringFromCodeUnits(10); }
    if (c == 13) { return javaStringFromCodeUnits(13); }
    if (c == 34) { return javaStringFromCodeUnits(34); }
    if (c == 92) { return javaStringFromCodeUnits(92); }
    if (c >= 32 && c <= 126) { return javaStringSubstring(this.asciiTable, c - 32, c - 31); }
    throw new UnsupportedOperationException("java.lang.StringBuilder: code unit " + c + " is outside the ASCII range the VM can build at run time");
  }
  void checkIndex(int index, int n) {
    if (index < 0 || index >= n) { throw new StringIndexOutOfBoundsException("Index " + index + " out of bounds for length " + n); }
  }
  void checkOffset(int offset, int n) {
    if (offset < 0 || offset > n) { throw new StringIndexOutOfBoundsException("Range [" + offset + ", " + n + ") out of bounds for length " + n); }
  }
  void checkRange(int start, int end, int n) {
    if (start < 0 || start > end || end > n) { throw new StringIndexOutOfBoundsException("Range [" + start + ", " + end + ") out of bounds for length " + n); }
  }
