/*
 * lib/crypto/SLCryptoBlock.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLCryptoBlock, the base
 *   unit of a single ordered step in the general-cryptography pipeline.
 *
 * Rationale: The reference AES2 module advances through an explicit ordered
 *   series of passes (one(), two(), three(), ... twentyone()) and the runner
 *   invokes them strictly in order. SLeeLa models each such pass as an
 *   SLCryptoBlock so the series can be driven 1,2,3,...,x,y,z by index rather
 *   than by hand-named method dispatch.
 *
 * The three fixed attributes carried by every block:
 *   - Order:       the 1-based position of this block in the main series (1..255).
 *   - Orientation: the role/direction of the block within the process, one of
 *                  the ORIENT_* constants below (intermix, alteration, calc, call).
 *   - Respect:     a precedence/trust rank honoured by the pipeline so that
 *                  blocks of higher respect are never reordered beneath lower
 *                  ones; equal respect preserves declared Order.
 *
 * Order and Orientation: SLCryptoBlock is the ordered worker. SLCryptoBlockOne,
 *   SLCryptoBlockTwo, ... specialise it with concrete per-step behaviour; the
 *   base here defines the ordering contract and the single advance() entry the
 *   pipeline calls.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLCryptoBlock {
  static final int MIN_ORDER = 1;
  static final int MAX_ORDER = 255;

  // Orientation constants — the orientation of a block within the whole process.
  static final int ORIENT_INTERMIX   = 1;  // combines/weaves fields
  static final int ORIENT_ALTERATION = 2;  // alters a single field in place
  static final int ORIENT_CALCULATION = 3; // numeric/radix calculation
  static final int ORIENT_CALL        = 4; // delegated call (e.g. register)

  int order;        // 1..255, strict position in the main series
  int orientation;  // one of ORIENT_*
  int respect;      // precedence rank; higher is honoured first on ties
  int radixBase;    // base this step converts through, 1..2055 (0 = none)
  int mask;         // OR mask applied during this step (as in the reference)
  String name;      // declared, order/orientation-respectful name
  int state;
  String lastError;

  boolean configure(int stepOrder, int stepOrientation, int stepRespect,
                     int base, int orMask, String stepName) {
    if (stepOrder < MIN_ORDER || stepOrder > MAX_ORDER) {
      lastError = "order out of range 1..255";
      state = 0;
      return false;
    }
    if (stepOrientation < ORIENT_INTERMIX || stepOrientation > ORIENT_CALL) {
      lastError = "unknown orientation";
      state = 0;
      return false;
    }
    order = stepOrder;
    orientation = stepOrientation;
    respect = stepRespect;
    radixBase = base;
    mask = orMask;
    name = stepName;
    lastError = "";
    return true;
  }

  void enable() { state = 1; }
  void disable() { state = 0; }
  boolean active() { return state == 1 && order >= MIN_ORDER && order <= MAX_ORDER; }

  int orderIndex() { return order; }
  int orientationOf() { return orientation; }
  int respectRank() { return respect; }

  // advance() is the single ordered entry the pipeline calls for this step. It
  // takes the running cipher text and returns the transformed cipher text.
  // The base implementation performs the generic radix-then-OR alteration that
  // the reference passes share; specialised blocks override this.
  String advance(String running, SLRadixTable radices) {
    if (!active()) { return running; }
    if (radixBase <= 0) { return running; }
    SLRadix r = radices.converterFor(radixBase);
    if (!r.active()) { lastError = "radix unavailable for base"; return running; }
    return native sleela_crypto_block_advance(order, radixBase, mask, running);
  }
}
