/*
 * lib/gameplay/GameMove.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines GameMove, the base contract for the three moves a Player
 *   may make on a turn: (a) create a help index / friend, (b) ask for help or
 *   new routes, (c) create a new desire. A developer adds a move by subclassing
 *   GameMove and overriding resolve(), which rolls the dice and returns a
 *   MoveOutcome. The base owns identity, the shared context, and the module
 *   contract — exactly the base/subclass pattern used by lib/compiler.
 *
 * GameMove is a NATURAL / LOADABLE MODULE sharing the common module contract
 * (load / loaded / moduleName / describe). A move is handed the shared engine
 * and roller through bind(); resolve() does the rest.
 *
 * Family: gameplay.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class GameMove {

  static final String MODULE = "GameMove";

  // The three move choices a turn offers.
  static final int CHOICE_HELP_INDEX = 1;  // (a) create a help index / friend
  static final int CHOICE_ASK_HELP   = 2;  // (b) ask for help or new routes
  static final int CHOICE_NEW_DESIRE = 3;  // (c) create a new desire

  int loadedFlag;
  String moveName;      // human-readable move name
  int choice;           // one of CHOICE_*
  DiceRoll dice;        // the shared roller for this turn
  InferenceEngine engine; // the shared modeler for this turn
  int turnNumber;       // which turn this move is being played on

  // --- loadable-module contract ------------------------------------------
  void load() {
    loadedFlag = 1;
    moveName = "GameMove";
    choice = 0;
    dice = null;
    engine = null;
    turnNumber = 0;
  }
  boolean loaded() { return loadedFlag == 1; }
  String moduleName() { return MODULE; }

  // A subclass calls this to declare its identity.
  void declare(String name, int whichChoice) {
    moveName = name;
    choice = whichChoice;
  }

  // Bind the shared turn context before resolve().
  void bind(DiceRoll roller, InferenceEngine inf, int turn) {
    dice = roller;
    engine = inf;
    turnNumber = turn;
  }

  // Overridable: run the move and return its outcome. The base move does
  // nothing and reports failure, so an un-overridden move is honest.
  MoveOutcome resolve(Player p) {
    MoveOutcome out = new MoveOutcome();
    out.begin(moveName);
    out.say("Base move does nothing.");
    return out;
  }

  String name() { return moveName; }
  int choiceKind() { return choice; }

  String describe() {
    return MODULE + "/" + moveName + " choice=" + choice
         + " turn=" + turnNumber;
  }
}
