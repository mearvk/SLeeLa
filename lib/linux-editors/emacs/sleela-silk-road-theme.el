;;; sleela-silk-road-theme.el --- SLeeLa Central Asian and Silk Road theme -*- lexical-binding: t; -*-
(deftheme sleela-silk-road "Turquoise, lapis lazuli and desert gold with textile-inspired contrast.")
(custom-theme-set-faces
 'sleela-silk-road
 '(default ((t (:foreground "#F5F0E5" :background "#1C2529"))))
 '(cursor ((t (:background "#45C6C2"))))
 '(region ((t (:background "#315052" :extend t))))
 '(highlight ((t (:background "#26363A"))))
 '(fringe ((t (:foreground "#92A3A0" :background "#1C2529"))))
 '(line-number ((t (:foreground "#92A3A0" :background "#1C2529"))))
 '(line-number-current-line ((t (:foreground "#45C6C2" :weight bold))))
 '(mode-line ((t (:foreground "#F5F0E5" :background "#315052" :weight bold))))
 '(mode-line-inactive ((t (:foreground "#92A3A0" :background "#26363A"))))
 '(minibuffer-prompt ((t (:foreground "#7FADE0" :weight bold))))
 '(font-lock-builtin-face ((t (:foreground "#45C6C2"))))
 '(font-lock-comment-face ((t (:foreground "#92A3A0" :slant italic))))
 '(font-lock-constant-face ((t (:foreground "#E58B79"))))
 '(font-lock-function-name-face ((t (:foreground "#A7C982" :weight bold))))
 '(font-lock-keyword-face ((t (:foreground "#7FADE0" :weight bold))))
 '(font-lock-string-face ((t (:foreground "#D9B56D"))))
 '(font-lock-type-face ((t (:foreground "#45C6C2" :weight bold))))
 '(font-lock-variable-name-face ((t (:foreground "#F5F0E5"))))
 '(font-lock-warning-face ((t (:foreground "#FF7777" :weight bold :underline t))))
 '(error ((t (:foreground "#FF7777" :weight bold))))
 '(warning ((t (:foreground "#D9B56D" :weight bold))))
 '(success ((t (:foreground "#A7C982" :weight bold))))
 '(show-paren-match ((t (:foreground "#F5F0E5" :background "#315052" :weight bold))))
 '(isearch ((t (:foreground "#1C2529" :background "#D9B56D" :weight bold)))))
(provide-theme 'sleela-silk-road)
;;; sleela-silk-road-theme.el ends here
