/*
 * lib/core/SLTransport.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLTransport used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Transport.
// Role: runtime. Responsibility: generic transport contract.
class SLTransport {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
