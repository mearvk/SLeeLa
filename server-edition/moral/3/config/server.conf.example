# SLeeLa Server Edition Service 3
engine=../../../../impl/build/sleela
inbox=../../../../server-edition/inbox/requests.txt
state=../../../../server-edition/state
server_source=../src/Server.sleela
log=../../../../server-edition/state/results.log
recovery_log=../../../../server-edition/state/recovery.log
mode=service
tick=false
foreground=false
preflight=true
sha256_manifest=../../../../security/important-sha256-manifest.json
allow_network=false
port=19866
port_protocol=tcp
firewall=auto
firewall_required=true

http_version=3.0
logical_port=19866
download_size_bytes=0
http_api=../../../../server-edition/http/httpctl

# Named service-discovery / basic-scan port. Kept open while the server is available.
scan_port=22220
scan_port_protocol=tcp
scan_port_firewall=auto
# Mature Services may be negotiated through the scan port and opened only while active.
mature_services=auto

# Basic probe port; kept available while the Server Edition is running.
probe_port=2222
probe_port_protocol=tcp

# Fast server participation / regroup. One or a few rounds per day.
mesh_port=22221
mesh_interval_seconds=28800
mesh_peers_file=../../../../server-edition/participation/known-servers.conf
mesh_timeout_seconds=5
mesh_max_peers=64
traffic_logging=true

# Privacy-preserving traffic consumption / known-connection verification.
traffic_logging=true
log_consume_max_bytes=52428800
active_probing=false
# Comma-separated explicit hosts permitted for active port verification; empty by default.
probe_allowlist=
known_ports=2222,22220,19866,20000,22221
