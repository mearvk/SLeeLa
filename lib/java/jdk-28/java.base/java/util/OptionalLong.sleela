  << A container that may hold one long value. Factories are instance methods
     (new OptionalLong(false, 0).of(5)); the constructor takes presence and value. >>
  boolean present;
  long value;
  OptionalLong(boolean isPresent, long v) { this.present = isPresent; this.value = v; }

  OptionalLong empty() { return new OptionalLong(false, 0); }
  OptionalLong of(long v) { return new OptionalLong(true, v); }
  boolean isPresent() { return present; }
  boolean isEmpty() { return !present; }
  long getAsLong() {
    if (!present) { throw new NoSuchElementException("No value present"); }
    return value;
  }
  long orElseThrow() { return getAsLong(); }
  long orElse(long other) {
    if (present) { return value; }
    return other;
  }
  String toString() {
    if (!present) { return "OptionalLong.empty"; }
    return "OptionalLong[" + value + "]";
  }
  boolean equals(Any obj) {
    if (obj instanceof OptionalLong) {
      OptionalLong o = (OptionalLong) obj;
      if (!present && !o.present) { return true; }
      return present == o.present && value == o.value;
    }
    return false;
  }
