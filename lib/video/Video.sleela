/*
 * lib/video/Video.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type Video used within the video library family.
 */
#sleela 1.3
class Video {
  string title;
  VideoTimeline timeline;
  VideoCodec codec;
  void setTitle(string value){title=value;}
  string getTitle(){return title;}
  boolean ready(){return timeline!=null && codec!=null;}
}