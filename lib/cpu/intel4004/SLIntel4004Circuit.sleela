<< lib/cpu/intel4004/SLIntel4004Circuit.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLIntel4004Circuit, the physical circuit model of the Intel
     4004: P-channel silicon-gate MOS at a 10 micrometre feature size, a negative
     supply of 15 V, a two-phase non-overlapping clock at up to 740 kHz, a 4-bit
     ALU and a multiplexed 4-bit data and address bus.

   Provenance of the figures:
     published  10 micrometre PMOS silicon gate, about 2300 transistors, negative
                supply near 15 V, two-phase clock, up to 740 kHz, 4-bit datapath,
                released 15 November 1971.
     derived    logic thresholds (set at one third and two thirds of the supply
                because the data sheet levels were not checked here), gate delay,
                edge time, fanout, and every block gate count and depth. They
                are planning figures, not die measurements. The block named
                other is the published transistor total minus modelled blocks.
   This family is negative-going: logic 1 is the more negative level, which
   SLLogicFamily.classify handles through its polarity rule.

   Family: cpu. Extends SLCircuitModel. >>
#sleela 2.5
material;
class SLIntel4004Circuit extends SLCircuitModel {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 39543;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-21";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "Intel";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "United States";
  String metaBirthDate = "2026-11-21";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 6;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  void build() {
    SLLogicFamily f = new SLLogicFamily();
    f.configure("PMOS-silicon-gate", 10000, -15000, 750);
    < Negative-going: HIGH at or below -10 V, LOW at or above -5 V. >
    f.setThresholds(-5000, -10000, -2000, -12000);
    f.setSpeed(60000, 150000, 3);
    f.setProvenance("process and supply published; thresholds derived from supply thirds; speed derived");

    SLVoltageRail vdd = new SLVoltageRail();
    vdd.configure("Vdd", -15000, -15750, -14250);

    configure("Intel 4004", f, vdd, 740, 2);
    setWidths(4, 12);
    setTransistors(2300);
    setProvenance("published: 10 um PMOS silicon gate, about 2300 transistors");

    SLCircuitBlock alu = addBlock("alu-4bit", "alu", 4, 12, 28, 112);
    alu.setCellFactor(50);
    alu.setProvenance("derived: 4-bit adder with accumulator and carry");
    SLCircuitBlock regs = addBlock("index-registers", "regfile", 64, 2, 64, 384);
    regs.setCellFactor(50);
    regs.setProvenance("derived: sixteen 4-bit index registers as latch bits");
    SLCircuitBlock stack = addBlock("address-stack", "regfile", 48, 2, 48, 288);
    stack.setCellFactor(50);
    stack.setProvenance("derived: program counter plus three return levels of 12 bits");
    SLCircuitBlock bus = addBlock("multiplexed-bus", "bus", 4, 3, 16, 64);
    bus.setCellFactor(50);
    bus.setProvenance("derived: 4-bit data and address multiplexed pins");
    SLCircuitBlock dec = addBlock("instruction-decode", "decode", 8, 6, 120, 480);
    dec.setCellFactor(50);
    dec.setProvenance("derived: 8-bit instruction decode and cycle control");
    SLCircuitBlock clk = addBlock("two-phase-clock", "clock", 1, 4, 8, 32);
    clk.setCellFactor(50);
    clk.setProvenance("derived: non-overlapping phi1 phi2 input handling");
    SLCircuitBlock rest = addRemainder("other");
    if (rest != null) { rest.setCellFactor(50); }

    SLCircuitPath add = addPath("alu-4bit-add", 100000);
    add.setPeriod(phasePs());
    add.describe("derived: operand latch, 4-bit ripple carry, accumulator latch");
    add.addStage("operand-latch", 60000);
    add.addStage("carry-chain-4-bits", 240000);
    add.addStage("accumulator-latch", 60000);
    add.constrain(60000, 10000, 0);

    SLCircuitPath mux = addPath("bus-nibble-transfer", 100000);
    mux.setPeriod(periodPs());
    mux.describe("derived: one address or data nibble crosses the multiplexed bus per clock");
    mux.addStage("driver", 150000);
    mux.addStage("bus-settle", 300000);
    mux.constrain(100000, 20000, 0);

    SLSignalQuality n0 = addNet("phi1");
    n0.setEdgeLimit(600000);
    SLSignalQuality n1 = addNet("phi2");
    n1.setEdgeLimit(600000);
    SLSignalQuality n2 = addNet("D0");
    SLSignalQuality n3 = addNet("SYNC");

    SLCircuitSemaphore latch = addSemaphore("latch", 1, 2);
    SLCircuitSemaphore bus4 = addSemaphore("multiplexed-bus", 1, 2);
  }
}
