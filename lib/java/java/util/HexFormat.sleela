  public java.lang.String formatHex(byte[] bytes) { return formatHex(bytes, 0, arrayLength(bytes)); }
  public java.lang.String formatHex(byte[] bytes, int fromIndex, int toIndex) {
    int n = arrayLength(bytes);
    if (fromIndex < 0 || fromIndex > toIndex || toIndex > n) {
      throw new IndexOutOfBoundsException("Range [" + fromIndex + ", " + toIndex + ") out of bounds for length " + n);
    }
    String out = "";
    int i = fromIndex;
    while (i < toIndex) {
      if (i > fromIndex) { out = out + this.delim; }
      out = out + this.pfx + byteDigits(bytes[i]) + this.sfx;
      i = i + 1;
    }
    return out;
  }
  public java.lang.String toHexDigits(long value) {
