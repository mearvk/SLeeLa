/*
 * lib/video/VideoProfile.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type VideoProfile used within the video library family.
 */
#sleela 1.3
class VideoProfile {
  string name;
  int level;
  int bitDepth;
  void set(string value,int profileLevel,int depth){name=value;level=profileLevel;bitDepth=depth;}
  boolean valid(){return name!="" && level>=0 && bitDepth>=8;}
}