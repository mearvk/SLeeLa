/*
 * lib/crypto/SLRadixTable.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLRadixTable, a bounded
 *   registry of SLRadix converters addressable by base.
 *
 * Rationale: The reference AES2 module reaches for several distinct bases in a
 *   single pass (e.g. pass three mixes base-11, base-12, and base-17). Rather
 *   than reconstruct a converter per call, the pipeline holds one table of
 *   converters covering bases 1..2055 and asks it for the base it needs.
 *
 * Order and Orientation: SLRadixTable is shared infrastructure consulted by the
 *   intermix stages and the ordered CryptoBlock series. It holds no order of
 *   its own.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. Native implementation crosses an explicit VM/OS bridge.
class SLRadixTable {
  static final int MIN_BASE = 1;
  static final int MAX_BASE = 2055;

  int state;

  void enable() { state = 1; }
  void disable() { state = 0; }
  boolean active() { return state == 1; }

  // Return a configured, enabled converter for the requested base, or a
  // disabled converter when the base is out of range (fail-closed).
  SLRadix converterFor(int base) {
    SLRadix r = new SLRadix();
    if (r.configure(base)) { r.enable(); }
    return r;
  }

  boolean supports(int base) { return base >= MIN_BASE && base <= MAX_BASE; }
  int span() { return MAX_BASE - MIN_BASE + 1; }
}
