<< ============================================================= >>
<< SLCalendarConverter — Old Style / New Style offset (docs 02/04/06). >>
<< ============================================================= >>
class SLCalendarConverter {

  SLCalendarJulian julian;
  SLCalendarGregorian gregorian;

  void create() {
    julian = new SLCalendarJulian();
    gregorian = new SLCalendarGregorian();
  }

  << How many days the Julian (Old Style) date label lags behind the Gregorian
     (New Style) one for a given year. Closed form for the Julian-vs-Gregorian
     divergence: floor(y/100) - floor(y/400) - 2. The calendars agreed in the
     2nd/3rd century (the -2), then diverge by one day at each century that is
     not a multiple of 400. Gives 10 in 1582, 11 in 1752, 13 in 1918. >>
  int offsetForDate(int year, int month, int day) {
    if (gregorian == null) { create(); }
    int centuries = year / 100;
    int fourHundreds = year / 400;
    return (centuries - fourHundreds) - 2;
  }

  int skipPortugal1582() { return 10; }
  int skipBritishColonies1752() { return 11; }
  int skipRussia1918() { return 13; }

  << ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >>
  String metaVersion = "1.0.0";
  int metaId = 3;
  String metaAuthor = "mearvk LLC Calendar Team";
  String metaDate = "2026-11-07";
  String metaCopyright = "(c) 2026 mearvk LLC";
  String metaTrademark = "none";
  String metaCorporation = "mearvk LLC";
  String metaOrigin = "International";
  String metaBirthDate = "2026";
  int metaScienceRating = 9;
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
