#sleela 3.2
class CharText {
  static char up(char c) { return (char)(c - 32); }
  void main() {
    char a = 'a';
    print(a);
    print("x" + a + "y");
    print(a + 1);
    print("n=" + (a + 1));
    print((char)(a + 1));
    char[] cs = {'h', 'i'};
    print(cs[0]);
    print("" + cs[0] + cs[1]);
    String s = "";
    s += a;
    s += 'b';
    print(s);
    print(up('q'));
    print('a' + 'b');
    print("é" + 'é');
    int n = a;
    print(n);
    char z = 65;
    print(z);
    char u = '\u00e9';
    print(u);
    char w = (char)65601;
    print(w);
    print(true ? 'y' : 'n');
    print(-('a'));
    char[] st = new char[2];
    st[0] = 65601;
    st[1] = 66;
    print((int) st[0]);
    print(st[1]);
    char c = 65535;
    c += 2;
    print((int) c);
    char d = 0;
    d--;
    print((int) d);
    char m = 'a';
    m = m + 1;
    print(m);
    print((int) (char) -1);
  }
}
