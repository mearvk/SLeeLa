/*
 * lib/http-3.0/SLPackage.sleela
 * SLeeLa Standard Library Definition for the HTTP 3.0 application protocol.
 */
#sleela 2.1
// H3 is a project-specific application protocol generation, not the IETF HTTP/3 wire protocol.
// Native core includes compact envelopes, keyed integrity checks and a pipeline.
// Native server transport and QUIC/HTTP/3 interoperability must be verified separately.
class SLPackage {
  String packageName;
  void configure(String name){packageName=name;}
  String name(){return packageName;}
  String generation(){return "3.0";}
  String nativeTransport(){return "HTTP/1.x carrier in current reference server";}
  boolean applicationEnvelopeAvailable(){return true;}
  boolean keyedDigestAvailable(){return true;}
  boolean nonceReplayGuardAvailable(){return true;}
  boolean intactxCheckAvailable(){return true;}
  boolean basketSchemaAvailable(){return true;}
  boolean iETFHttp3TransportAvailable(){return false;}
  boolean requiresProtectedTransport(){return true;}
  boolean available(){return packageName!=null;}
}
