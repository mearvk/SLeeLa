#sleela 1.3
// Demonstrates the SLeeLa static+protected memory boundary.
// next is System Degree 1.
// next.next is System Degree 2.
// The compiler back-propagates the degree requirement to the origin and
// admits only the bounded two-step form. Neither form is pointer arithmetic.

class ProtectedSystem {
    static protected int systemDegree = next.next;
    static protected int protectedState = 7;

    static protected int readState() {
        return protectedState;
    }

    void main() {
        print("next = " + next);
        print("next.next = " + next.next);
        print("system degree = " + systemDegree);
        print("protected state = " + readState());
    }
}
