  public int read() {
    if (this.srNext >= this.srLength) { return 0 - 1; }
    int c = javaStringCharAt(this.srText, this.srNext);
    this.srNext = this.srNext + 1;
    return c;
  }
  public int read(char[] cbuf, int off, int len) {
    int n = arrayLength(cbuf);
    if (off < 0 || len < 0 || off > n - len) { throw new IndexOutOfBoundsException("Range [" + off + ", " + off + " + " + len + ") out of bounds for length " + n); }
    if (len == 0) { return 0; }
    if (this.srNext >= this.srLength) { return 0 - 1; }
    int k = this.srLength - this.srNext;
    if (len < k) { k = len; }
    int i = 0;
    while (i < k) { cbuf[off + i] = javaStringCharAt(this.srText, this.srNext + i); i = i + 1; }
    this.srNext = this.srNext + k;
    return k;
  }
  public long skip(long n) {
    if (this.srNext >= this.srLength) { return 0; }
    long r = this.srLength - this.srNext;
    if (n < r) { r = n; }
    if (r < 0 - this.srNext) { r = 0 - this.srNext; }
    this.srNext = this.srNext + (int) r;
    return r;
  }
