/*
 * lib/video/VideoEncoder.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type VideoEncoder used within the video library family.
 */
#sleela 1.3
class VideoEncoder {
  VideoCodec codec;
  VideoFormat format;
  boolean open;
  void configure(VideoCodec c,VideoFormat f){codec=c;format=f;}
  void start(){open=codec!=null && codec.encoder && format!=null;}
  boolean ready(){return open;}
  void stop(){open=false;}
}