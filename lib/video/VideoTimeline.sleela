/*
 * lib/video/VideoTimeline.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type VideoTimeline used within the video library family.
 */
#sleela 1.3
class VideoTimeline {
  long begin;
  long end;
  int frames;
  void setRange(long start,long finish){begin=start;end=finish;}
  void addFrame(){frames=frames+1;}
  long duration(){return end-begin;}
}