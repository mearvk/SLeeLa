/*
 * lib/regex/RegexIterator.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexIterator used within the regex library family.
 */
#sleela 1.3
class RegexIterator {
  int index;
  void reset(){index=0;}
  void next(){index=index+1;}
  int current(){return index;}
}
