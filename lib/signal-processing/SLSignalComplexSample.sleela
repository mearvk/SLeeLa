// Doubly-linked complex sample node.
#sleela 2.5
material;
class SLSignalComplexSample {
  double re;
  double im;
  SLSignalComplexSample previous;
  SLSignalComplexSample next;

  void set(double realPart, double imaginaryPart) {
    re = realPart;
    im = imaginaryPart;
    previous = null;
    next = null;
  }
}
