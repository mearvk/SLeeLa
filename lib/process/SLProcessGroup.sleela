/*
 * lib/process/SLProcessGroup.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLProcessGroup used within the process library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: process. Native implementation crosses an explicit VM/OS bridge.
class SLProcessGroup {
  int state; int count; void start(){state=1;} void stop(){state=0;} void register(){count=count+1;} boolean active(){return state==1;}
}
