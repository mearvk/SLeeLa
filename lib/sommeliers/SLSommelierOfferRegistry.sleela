#sleela 2.1
< Small fixed-capacity in-memory registry. No remote publication or persistent
  storage is implied. >
class SLSommelierOfferRegistry {
  int CAPACITY = 12;
  int count = 0;
  String id0 = "";
  String id1 = "";
  String id2 = "";
  String id3 = "";
  String id4 = "";
  String id5 = "";
  String id6 = "";
  String id7 = "";
  String id8 = "";
  String id9 = "";
  String id10 = "";
  String id11 = "";
  String lastError = "";

  int size() { return count; }
  String error() { return lastError; }

  boolean containsId(String id) {
    return id != "" && (id == id0 || id == id1 || id == id2 || id == id3
      || id == id4 || id == id5 || id == id6 || id == id7 || id == id8
      || id == id9 || id == id10 || id == id11);
  }

  boolean register(String id) {
    if (id == "") { lastError = "empty offer id"; return false; }
    if (containsId(id)) { lastError = "duplicate offer id"; return false; }
    if (count >= CAPACITY) { lastError = "registry full"; return false; }
    if (id0 == "") { id0 = id; }
    else if (id1 == "") { id1 = id; }
    else if (id2 == "") { id2 = id; }
    else if (id3 == "") { id3 = id; }
    else if (id4 == "") { id4 = id; }
    else if (id5 == "") { id5 = id; }
    else if (id6 == "") { id6 = id; }
    else if (id7 == "") { id7 = id; }
    else if (id8 == "") { id8 = id; }
    else if (id9 == "") { id9 = id; }
    else if (id10 == "") { id10 = id; }
    else { id11 = id; }
    count = count + 1;
    lastError = "";
    return true;
  }

  void clear() {
    count = 0;
    id0 = ""; id1 = ""; id2 = ""; id3 = "";
    id4 = ""; id5 = ""; id6 = ""; id7 = "";
    id8 = ""; id9 = ""; id10 = ""; id11 = "";
    lastError = "";
  }
}
