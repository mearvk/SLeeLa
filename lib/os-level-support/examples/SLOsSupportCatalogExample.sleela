< SLeeLa example: enumerate the OS support catalogue and backend symbols. >
#sleela 2.5
material;

class SLOsSupportCatalogExample {
  void printList(String heading, SLList values) {
    print(heading);
    int i = 0;
    while (i < values.length()) {
      print(values.get(i));
      i = i + 1;
    }
  }

  void main() {
    SLOsSupportCatalog catalog = new SLOsSupportCatalog();
    SLOsSupportVMBridge vm = new SLOsSupportVMBridge();
    SLOsSupportVMElements vmElements = new SLOsSupportVMElements();
    SLOsSupportOSLSElements oslsElements = new SLOsSupportOSLSElements();
    SLOsSupportLinux linux = new SLOsSupportLinux();
    SLOsSupportWindows windows = new SLOsSupportWindows();
    SLOsSupportMacOS mac = new SLOsSupportMacOS();
    SLOsSupportLinuxSource linuxSource = new SLOsSupportLinuxSource();
    SLOsSupportWindowsSource windowsSource = new SLOsSupportWindowsSource();
    SLOsSupportMacOSSource macSource = new SLOsSupportMacOSSource();
    SLOsSupportPlatform platform = new SLOsSupportPlatform();

    printList("Capability groups", catalog.getGroupTerms());
    printList("Common OSLS API", catalog.getCommonOSLSFunctions());
    printList("Existing VM opcode bindings", vm.getExistingVMElementBindings());
    printList("Linux native API", linux.getLinuxFunctions());
    printList("Windows native API", windows.getWin32Functions());
    printList("macOS native API", mac.getMacOSFunctions());
    print("Detected source backend:");
    print(platform.detect());
    print("Linux facade matches host:");
    print(linuxSource.isCurrentPlatform());
    print("Windows facade matches host:");
    print(windowsSource.isCurrentPlatform());
    print("macOS facade matches host:");
    print(macSource.isCurrentPlatform());
    printList("Linux extension bindings (catalogued, not registered)", linuxSource.getNativeExtensionSymbols());
    printList("Windows extension bindings (catalogued, not registered)", windowsSource.getNativeExtensionSymbols());
    printList("macOS extension bindings (catalogued, not registered)", macSource.getNativeExtensionSymbols());

    SLOsSupportElement platformElement = vmElements.platform();
    SLOsSupportElement systemInfoElement = oslsElements.getSystemInfo();
    print("VM platform element:");
    print(platformElement.getVMOpcodeTerm());
    print(platformElement.getNativeSymbol());
    print("OSLS system-info element (not yet VM-registered):");
    print(systemInfoElement.getVMOpcodeTerm());
    print(systemInfoElement.getNativeSymbol());

    print("Core VM OS opcode bridge implemented:");
    print(vm.isCoreOSOpcodeBridgeImplemented());
    print("Separate osls C ABI adapter registered:");
    print(vm.isOSLSAbiAdapterRegistered());
  }
}
