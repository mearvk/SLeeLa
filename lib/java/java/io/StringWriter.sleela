  < ---- java.io.StringWriter members (procedural implementation in SLeeLa) ---- >
  << java.io.StringWriter over a java.lang.StringBuffer, as in the JDK, so
     getBuffer() returns the live buffer. Text and CharSequence arguments take
     the StringBuffer rules (plain or UTF-16 Strings, StringBuilder,
     StringBuffer). write(int) writes the low 16 bits as one code unit; building
     text from a code unit covers printable ASCII plus tab, newline and
     carriage return. append(char) cannot be told apart from write(int) by the
     VM and keeps its stub. close is a reserved SLeeLa built-in. >>
  StringBuffer swBuf = null;

  public StringWriter() { this.swBuf = new StringBuffer(); }
  public StringWriter(int initialSize) {
    if (initialSize < 0) { throw new IllegalArgumentException("Negative buffer size"); }
    this.swBuf = new StringBuffer();
  }
  public void write(int c) {
    int v = c % 65536;
    if (v < 0) { v = v + 65536; }
    this.swBuf.appendCodePoint(v);
  }
  public void write(char[] cbuf, int off, int len) {
    int n = arrayLength(cbuf);
    if (off < 0 || len < 0 || off > n - len) { throw new IndexOutOfBoundsException("Range [" + off + ", " + (off + len) + ") out of bounds for length " + n); }
    this.swBuf.append(cbuf, off, len);
  }
  public void write(java.lang.String str) { this.swBuf.append(str); }
  public void write(java.lang.String str, int off, int len) {
    int n = javaStringLength(this.swBuf.toU(str));
    if (off < 0 || len < 0 || off > n - len) { throw new IndexOutOfBoundsException("Range [" + off + ", " + (off + len) + ") out of bounds for length " + n); }
    this.swBuf.append(str, off, off + len);
  }
  public StringWriter append(java.lang.CharSequence csq) {
    if (csq == null) { this.swBuf.append("null"); return this; }
    this.swBuf.append(csq);
    return this;
  }
  public StringWriter append(java.lang.CharSequence csq, int start, int end) {
    this.swBuf.append(csq, start, end);
    return this;
  }
  public java.lang.String toString() { return this.swBuf.toString(); }
  public StringBuffer getBuffer() { return this.swBuf; }
  public void flush() { }
