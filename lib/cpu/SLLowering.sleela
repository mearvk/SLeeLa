<< lib/cpu/SLLowering.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLLowering — the shared compiler backend. It walks an
     SLIR module and emits real machine instructions (via SLAssembler) for the
     SLInstructionSet, performing a simple temporary-to-register allocation and
     two-pass label resolution. Because every language frontend produces the
     same SLIR, this one backend serves C, C++, Java, and Sleela — the ISA is
     multi-language because the backend is shared.
   
   Register convention: IR temporaries map to r1..r15 round-robin (r0 is the
   hardwired zero). Spilling to the stack for programs that exceed the register
   file is described in CPU.md and modeled by PUSH/POP; this pass handles the
   common small-function case directly.
   
   Family: cpu. Composes SLIR, SLAssembler, SLProgram, SLInstructionSet. >>
#sleela 2.5
material;
class SLLowering {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10260;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-10-16";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-06";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  < Local mirrors of constants owned by other classes. The checker does not >
  < resolve cross-class statics reached transitively, so the values are repeated >
  < here under the owner class name. Keep them equal to the owner. >
  static final int SLIRInstruction_IR_ADD = 2;
  static final int SLIRInstruction_IR_AND = 7;
  static final int SLIRInstruction_IR_CALL = 18;
  static final int SLIRInstruction_IR_CMP = 10;
  static final int SLIRInstruction_IR_CONST = 0;
  static final int SLIRInstruction_IR_DIV = 5;
  static final int SLIRInstruction_IR_HALT = 21;
  static final int SLIRInstruction_IR_JNZ = 14;
  static final int SLIRInstruction_IR_JUMP = 12;
  static final int SLIRInstruction_IR_JZ = 13;
  static final int SLIRInstruction_IR_LABEL = 11;
  static final int SLIRInstruction_IR_LOAD = 15;
  static final int SLIRInstruction_IR_MOD = 6;
  static final int SLIRInstruction_IR_MOVE = 1;
  static final int SLIRInstruction_IR_MUL = 4;
  static final int SLIRInstruction_IR_OR = 8;
  static final int SLIRInstruction_IR_PARAM = 17;
  static final int SLIRInstruction_IR_RET = 19;
  static final int SLIRInstruction_IR_STORE = 16;
  static final int SLIRInstruction_IR_SUB = 3;
  static final int SLIRInstruction_IR_SYSCALL = 20;
  static final int SLIRInstruction_IR_XOR = 9;
  static final int SLInstructionSet_ADD = 10;
  static final int SLInstructionSet_AND = 16;
  static final int SLInstructionSet_CALL = 28;
  static final int SLInstructionSet_DIV = 13;
  static final int SLInstructionSet_LOADR = 5;
  static final int SLInstructionSet_MOD = 14;
  static final int SLInstructionSet_MOVR = 3;
  static final int SLInstructionSet_MUL = 12;
  static final int SLInstructionSet_OR = 17;
  static final int SLInstructionSet_PUSH = 30;
  static final int SLInstructionSet_RET = 29;
  static final int SLInstructionSet_STORER = 8;
  static final int SLInstructionSet_SYSCALL = 34;
  static final int SLInstructionSet_SUB = 11;
  static final int SLInstructionSet_XOR = 18;
  SLInstructionSet isa;
  SLAssembler asm;
  SLProgram program;
  SLIR ir;
  < label id -> emitted instruction address >
  SLRAM labelAddr;
  int emitted;

  void configure(SLInstructionSet instructionSet, SLProgram target, SLIR irModule) {
    isa = instructionSet; program = target; ir = irModule;
    asm = new SLAssembler(); asm.configure(instructionSet, target);
    labelAddr = new SLRAM(); labelAddr.configure(1024, 32); labelAddr.allocate();
    emitted = 0;
  }

  < Map an IR temporary id to a machine register (r1..r15). >
  int reg(int temp) { if (temp < 0) { return 0; } return (temp % 15) + 1; }

  < Pass 1: record the address each IR_LABEL will occupy. Because every IR node >
  < lowers to a bounded number of machine ops, we pre-scan to assign label >
  < addresses; here each non-label node lowers to exactly one or two ops and we >
  < account for that when resolving. >
  void resolveLabels() {
    int addr = 0;
    int i = 0;
    while (i < ir.size()) {
      SLIRInstruction n = ir.at(i);
      if (n.operation() == SLIRInstruction_IR_LABEL) {
        labelAddr.writeWord(n.immediate(), addr);
      } else {
        addr = addr + opcodeFootprint(n);
      }
      i = i + 1;
    }
  }

  < How many machine instructions a given IR node expands to. >
  int opcodeFootprint(SLIRInstruction n) {
    int op = n.operation();
    if (op == SLIRInstruction_IR_LABEL) { return 0; }
    if (op == SLIRInstruction_IR_CONST) { return 1; }
    if (op == SLIRInstruction_IR_MOVE)  { return 1; }
    if (op == SLIRInstruction_IR_CALL)  { return 1; }
    if (op == SLIRInstruction_IR_PARAM) { return 1; }
    < binary ops: move a into dst reg, then op with b >
    if (op == SLIRInstruction_IR_ADD || op == SLIRInstruction_IR_SUB || op == SLIRInstruction_IR_MUL || op == SLIRInstruction_IR_DIV ||
        op == SLIRInstruction_IR_MOD || op == SLIRInstruction_IR_AND || op == SLIRInstruction_IR_OR || op == SLIRInstruction_IR_XOR) { return 2; }
    return 1;
  }

  < Pass 2: emit machine code for the whole IR module. >
  SLProgram lower() {
    resolveLabels();
    int i = 0;
    while (i < ir.size()) {
      SLIRInstruction n = ir.at(i);
      lowerNode(n);
      i = i + 1;
    }
    return program;
  }

  void lowerNode(SLIRInstruction n) {
    int op = n.operation();
    int dst = reg(n.destination());
    int ra = reg(n.sourceA());
    int rb = reg(n.sourceB());

    if (op == SLIRInstruction_IR_LABEL) { return; }
    if (op == SLIRInstruction_IR_CONST) { asm.mov(dst, n.immediate()); emitted = emitted + 1; return; }
    if (op == SLIRInstruction_IR_MOVE)  { asm.emit(SLInstructionSet_MOVR, dst, ra, 0); emitted = emitted + 1; return; }

    if (op == SLIRInstruction_IR_ADD) { asm.emit(SLInstructionSet_MOVR, dst, ra, 0); asm.emit(SLInstructionSet_ADD, dst, rb, 0); emitted = emitted + 2; return; }
    if (op == SLIRInstruction_IR_SUB) { asm.emit(SLInstructionSet_MOVR, dst, ra, 0); asm.emit(SLInstructionSet_SUB, dst, rb, 0); emitted = emitted + 2; return; }
    if (op == SLIRInstruction_IR_MUL) { asm.emit(SLInstructionSet_MOVR, dst, ra, 0); asm.emit(SLInstructionSet_MUL, dst, rb, 0); emitted = emitted + 2; return; }
    if (op == SLIRInstruction_IR_DIV) { asm.emit(SLInstructionSet_MOVR, dst, ra, 0); asm.emit(SLInstructionSet_DIV, dst, rb, 0); emitted = emitted + 2; return; }
    if (op == SLIRInstruction_IR_MOD) { asm.emit(SLInstructionSet_MOVR, dst, ra, 0); asm.emit(SLInstructionSet_MOD, dst, rb, 0); emitted = emitted + 2; return; }
    if (op == SLIRInstruction_IR_AND) { asm.emit(SLInstructionSet_MOVR, dst, ra, 0); asm.emit(SLInstructionSet_AND, dst, rb, 0); emitted = emitted + 2; return; }
    if (op == SLIRInstruction_IR_OR)  { asm.emit(SLInstructionSet_MOVR, dst, ra, 0); asm.emit(SLInstructionSet_OR,  dst, rb, 0); emitted = emitted + 2; return; }
    if (op == SLIRInstruction_IR_XOR) { asm.emit(SLInstructionSet_MOVR, dst, ra, 0); asm.emit(SLInstructionSet_XOR, dst, rb, 0); emitted = emitted + 2; return; }

    if (op == SLIRInstruction_IR_CMP)   { asm.cmp(ra, rb); emitted = emitted + 1; return; }
    if (op == SLIRInstruction_IR_JUMP)  { asm.jmp(labelAddr.readWord(n.immediate())); emitted = emitted + 1; return; }
    if (op == SLIRInstruction_IR_JZ)    { asm.jz(labelAddr.readWord(n.immediate())); emitted = emitted + 1; return; }
    if (op == SLIRInstruction_IR_JNZ)   { asm.jnz(labelAddr.readWord(n.immediate())); emitted = emitted + 1; return; }
    if (op == SLIRInstruction_IR_LOAD)  { asm.emit(SLInstructionSet_LOADR, dst, ra, 0); emitted = emitted + 1; return; }
    if (op == SLIRInstruction_IR_STORE) { asm.emit(SLInstructionSet_STORER, ra, rb, 0); emitted = emitted + 1; return; }
    if (op == SLIRInstruction_IR_PARAM) { asm.emit(SLInstructionSet_PUSH, 0, ra, 0); emitted = emitted + 1; return; }
    if (op == SLIRInstruction_IR_CALL)  { asm.emit(SLInstructionSet_CALL, 0, 0, labelAddr.readWord(n.immediate())); emitted = emitted + 1; return; }
    if (op == SLIRInstruction_IR_RET)   { asm.emit(SLInstructionSet_RET, 0, 0, 0); emitted = emitted + 1; return; }
    < The argument register travels in rs so SYS_WRITE prints the right value. >
    if (op == SLIRInstruction_IR_SYSCALL){ asm.emit(SLInstructionSet_SYSCALL, 0, ra, n.immediate()); emitted = emitted + 1; return; }
    if (op == SLIRInstruction_IR_HALT)  { asm.halt(); emitted = emitted + 1; return; }
  }

  int emittedCount() { return emitted; }
  SLProgram lowered() { return program; }
}
