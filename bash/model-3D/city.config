# Phraign(TM) City 3D -- configuration
# Format: key = value, one per line. '#' begins a comment. Unknown keys are
# ignored (forward-compatible). Missing keys keep their documented defaults.

# ---- Model ---------------------------------------------------------------
# The city is a square grid of blocks. 64 x 64 = 4096 (~4000 square blocks).
grid_cols = 64
grid_rows = 64

# Per-user identity. If seed = 0, the seed is derived from this user name, so
# every user gets their own reproducible city.
user      = anon
seed      = 0

# ---- Appearance ----------------------------------------------------------
# Color theme: green | white | blue. Green is the default.
theme = green

# ---- Viewpoint (seen from the top and slightly to the side) --------------
# Oblique projection. Increase tilt_* for a stronger side angle; set them near
# 0 for a near-top-down view. scale_height controls how tall buildings appear.
# Defaults below frame a 64x64 city in a 1024x768 frame, seen from above and
# angled slightly to the side.
tilt_x       = 0.55
tilt_y       = 0.42
scale_x      = 9.0
scale_height = 3.0
block_pitch  = 9.0
origin_x     = 150.0
origin_y     = 210.0

# ---- Frame ---------------------------------------------------------------
# Phraign frame size in pixels (the per-pixel render target).
frame_width  = 1024
frame_height = 768

# ---- Persistence ---------------------------------------------------------
# Where a saved model should live: github | server | local.
#   github -> save_location is an owner/repo slug
#   server -> save_location is a public upload URL
#   local  -> save_location is a filesystem path (defaults to the model file)
save_target   = local
save_location =
