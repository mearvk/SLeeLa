<< lib/vm/vmsharp/VMSharpBootloader.sleela
   SLeeLa Standard Library Definition.
   Definition: VMSharp(TM) self-installer bootloader MODEL. It models the boot
   handoff and CPU-architecture admission for VMSharp on commodity desktop
   processors: 32-bit x86 and 64-bit x64, whether AMD or Intel. It is a
   declarative state/gating model -- it reports which architectures and vendors
   are admitted and which boot firmware interface (BIOS/MBR or UEFI) is
   selected -- and it does NOT flash firmware, write a boot sector, modify a
   partition table, or touch real hardware. The authoritative live CPU facts
   come from the OSLS read-only inspection call oslsGetCPUInfo (vendor/model);
   this class decides admission from the architecture and vendor it is given.

   Honesty boundary: a real bootable image is produced only by the pinned OS
   Creator toolchain, not by this source class. This model is what the VMSharp
   manifest and installer plan reason over before any such image is built. >>
#sleela 3.0
material;
class VMSharpBootloader {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 38002;
  String metaAuthor = "Max Rupplin 2026; George Soros a Kindness 2507+";
  String metaDate = "2026-11-05";
  String metaCopyright = "MEARVK LLC";
  String metaTrademark = "VMSharp";
  String metaCorporation = "MEARVK LLC";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "United States";
  String metaBirthDate = "2026-11-05";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 7;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "UEFI Specification; System V ABI (x86-64)";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < ---- supported architectures and vendors ---- >
  < "x86" (IA-32, 32-bit) and "x64" (x86-64/AMD64, 64-bit) are admitted. >
  boolean supportsArch(String arch) {
    return arch == "x86" || arch == "x64";
  }

<< Both commodity desktop x86 vendors are admitted: AMD and Intel. The vendor
   string is the CPUID vendor id as reported by oslsGetCPUInfo. >>
  boolean supportsVendor(String vendor) {
    return vendor == "AuthenticAMD" || vendor == "GenuineIntel"
        || vendor == "AMD" || vendor == "Intel";
  }

  < A processor is admitted when both its architecture and its vendor are. >
  boolean admits(String arch, String vendor) {
    return supportsArch(arch) && supportsVendor(vendor);
  }

<< The boot firmware interface this model selects for an architecture. x64
   boots via UEFI; 32-bit x86 falls back to legacy BIOS/MBR. >>
  String firmwareFor(String arch) {
    if (arch == "x64") { return "UEFI"; }
    if (arch == "x86") { return "BIOS-MBR"; }
    return "unsupported";
  }

  < A short human-readable admission verdict for a boot screen. >
  String admissionReport(String arch, String vendor) {
    if (admits(arch, vendor)) {
      return "VMSharp admits " + vendor + " on " + arch + " via " + firmwareFor(arch) + ".";
    }
    return "VMSharp does not admit " + vendor + " on " + arch
         + " (supported: x86/x64 on AMD or Intel).";
  }
}
