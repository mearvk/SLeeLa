/*
 * lib/core/SLOption.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLOption used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Option.
// Role: language. Responsibility: optional value semantics.
class SLOption {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
