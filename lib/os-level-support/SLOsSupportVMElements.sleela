    e.configure("setEnv", "Environment", "OSEnvironment", "OP_OS_SETENV:106",
      "osSetEnv", "slos_setenv", "CommonBackend", "StateChangingOperation", "Implemented", 2, 0);
    e.setResultTerm("StatusCode");
    return e;
  }

