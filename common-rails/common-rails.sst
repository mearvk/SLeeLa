#nordshrift 1.0
#sleela     1.1

/// CommonRails — SST (Nordshrift) edition using the 2.0 semantic layer.
sheet common-rails:
  version      1.3.0
  author       "Sleela Design Council"
  description  "Professional printing component: fixed-width lines + 21x21 progress square + Heritage C/C++/Java printing utilities."

source:
  root  "."
  glob  "*.sleela"

subject CommonRailsPrinting:
  domain: formatting
  depends: [ math ]

  quantity printWidth:
    value: "80"
    unit: "character"
    status: specified

  quantity objectIdWidth:
    value: "10"
    unit: "character"
    status: specified

  quantity currentWidth:
    value: "39"
    unit: "character"
    status: specified

  quantity progressSide:
    value: "21"
    unit: "cell"
    status: specified

  quantity progressCells:
    value: "441"
    unit: "cell"
    status: derived

  assumption fixedWidth:
    statement: "organized content lines are padded to exactly printWidth characters when content fits"
    status: specified

  assumption wrapping:
    statement: "content exceeding printWidth is emitted as word-boundary continuation lines"
    status: specified

  assumption integerPercent:
    statement: "percent is clamped to 0..100 and mapped with floor(percent*441/100)"
    status: specified

subject CommonRailsPrintingHeritage:
  domain: formatting
  languages: [ C, C++, Java ]
  responsibilities: [ PrintLayout, PrintField, PrintLine, PrintFormatter, PrintState, PrintProgress, PrintGlyphs, PrintComponent, PrintRenderer, PrintWriter, PrintContractTest ]
  states: [ START, WORKING, PROGRESS, COMPLETE, WARN, ERROR ]
  evidence:
    status: specified
    source: "common-rails/heritage/PRINTING.HERITAGE.md"

  boundaryCases:
    percent: [ -1, 0, 1, 50, 99, 100, 101 ]
    cells: [ 0, 220, 441 ]
    purpose: "normalization, midpoint, full-square, and out-of-range coverage"

target:
  root "out"
  java-version 21
  package-root "com.sleela.commonrails"
