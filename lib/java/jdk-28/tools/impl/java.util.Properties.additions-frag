  < ---- java.util.Properties: store, save, propertyNames, clone, conditional remove and replace ---- >
  << Written from the JDK 28 API specification of java.util.Properties.
     store writes the comments (when not null), then a date comment, then every
     entry of this table (never the defaults) as key=value, one entry per line,
     in the natural order of the keys. The date comment is the current Date.
     Java uses the java.properties.date system property instead when it is
     given at JVM startup (-D); a SLeeLa program has no startup properties, and
     Java also ignores a later System.setProperty of it, so it is never
     consulted here. A key escapes every blank, a value only a
     leading blank; both escape tab, newline, return, form feed, backslash and
     the characters = : # and !. store(OutputStream) also writes each character
     below U+0020 or above U+007E as a backslash-u escape with four upper-case
     hex digits, and then writes the text as ISO 8859-1 bytes. In the comments a
     line break starts a new comment line, which gets a # unless the comment
     text already continues with # or !, and a character above U+00FF is
     written as a backslash-u escape. Writer and OutputStream erase to one
     signature here; the target decides which of the two Java methods runs: a
     java.io.ByteArrayOutputStream takes the byte form, a java.io.StringWriter
     the character form. Any other target fails closed with
     UnsupportedOperationException. A key or value that is not a String throws
     ClassCastException, as in Java. >>
  int[] storeUnits = new int[0];
  int storeCount = 0;

  public void store(java.io.Writer writer, java.lang.String comments) {
    if (writer == null) { throw new NullPointerException(); }
    boolean bytes = false;
    if (writer instanceof ByteArrayOutputStream) { bytes = true; }
    else if (writer instanceof StringWriter) { bytes = false; }
    else { throw new UnsupportedOperationException("java.util.Properties.store: pass a java.io.StringWriter or a java.io.ByteArrayOutputStream"); }
    this.storeUnits = new int[64];
    this.storeCount = 0;
    if (comments != null) { storeComments(comments); }
    Date now = new Date();
    storeComments(now.toString());
    Any[] ks = liveKeys();
    int n = arrayLength(ks);
    String[] names = new String[n];
    int i = 0;
    while (i < n) {
      Any k = ks[i];
      if (!(k instanceof string)) { throw new ClassCastException("java.util.Properties.store: key is not a java.lang.String"); }
      Any v = get(k);
      if (!(v instanceof string)) { throw new ClassCastException("java.util.Properties.store: value is not a java.lang.String"); }
      names[i] = "" + k;
      i = i + 1;
    }
    sortNames(names, n);
    i = 0;
    while (i < n) {
      String key = names[i];
      String value = "" + get(key);
      storeEscaped(unitsOf(key), true, bytes);
      storeUnit(61);
      storeEscaped(unitsOf(value), false, bytes);
      storeUnit(10);
      i = i + 1;
    }
    int j = 0;
    if (bytes) {
      ByteArrayOutputStream bo = (ByteArrayOutputStream) writer;
      while (j < this.storeCount) { bo.write(this.storeUnits[j]); j = j + 1; }
    } else {
      StringWriter sw = (StringWriter) writer;
      while (j < this.storeCount) { sw.write(this.storeUnits[j]); j = j + 1; }
    }
    this.storeUnits = new int[0];
    this.storeCount = 0;
  }

  public void save(java.io.OutputStream out, java.lang.String comments) {
    store(out, comments);
  }

  << propertyNames: every key of this table and of the defaults chain, each
     once. The order is unspecified in Java (a hash order); here it is the
     defaults first, then this table, each in insertion order. A key that is
     not a String throws ClassCastException, as in Java. >>
  public Enumeration propertyNames() {
    Any[] acc = new Any[8];
    int[] count = new int[1];
    count[0] = 0;
    acc = collectAllNames(acc, count);
    Any[] out = new Any[count[0]];
    int i = 0;
    while (i < count[0]) { out[i] = acc[i]; i = i + 1; }
    return new Enumeration(out);
  }
  Any[] collectAllNames(Any[] acc, int[] count) {
    Any[] a = acc;
    if (this.propDefaults != null) { a = this.propDefaults.collectAllNames(a, count); }
    Any[] ks = liveKeys();
    int i = 0;
    while (i < arrayLength(ks)) {
      Any k = ks[i];
      if (!(k instanceof string)) { throw new ClassCastException("java.util.Properties.propertyNames: key is not a java.lang.String"); }
      boolean seen = false;
      int j = 0;
      while (j < count[0]) { if (a[j] == k) { seen = true; } j = j + 1; }
      if (!seen) {
        if (count[0] >= arrayLength(a)) {
          Any[] g = new Any[arrayLength(a) * 2];
          int m = 0;
          while (m < count[0]) { g[m] = a[m]; m = m + 1; }
          a = g;
        }
        a[count[0]] = k;
        count[0] = count[0] + 1;
      }
      i = i + 1;
    }
    return a;
  }

  << clone: a shallow copy with the same entries and the same defaults table. >>
  public synchronized java.lang.Object clone() {
    Properties c = new Properties();
    c.propDefaults = this.propDefaults;
    c.copyPairs(liveKeys(), liveValues());
    return c;
  }
  public synchronized boolean remove(java.lang.Object key, java.lang.Object value) { return removeMapping(key, value); }
  public synchronized boolean replace(java.lang.Object key, java.lang.Object oldValue, java.lang.Object newValue) { return replaceValue(key, oldValue, newValue); }

  < store helpers: the output is collected as UTF-16 code units, then written once >
  void storeUnit(int c) {
    this.storeUnits = pushUnit(this.storeUnits, this.storeCount, c);
    this.storeCount = this.storeCount + 1;
  }
  void storeHex4(int c) {
    storeUnit(92);
    storeUnit(117);
    int shift = 4096;
    while (shift >= 1) {
      int d = (c / shift) % 16;
      if (d < 10) { storeUnit(48 + d); } else { storeUnit(55 + d); }
      shift = shift / 16;
    }
  }
  int[] unitsOf(String s) {
    String u = javaStringFromUtf8(s);
    int n = javaStringLength(u);
    int[] out = new int[n];
    int i = 0;
    while (i < n) { out[i] = javaStringCharAt(u, i); i = i + 1; }
    utfTick();
    return out;
  }
  void storeEscaped(int[] u, boolean isKey, boolean escUnicode) {
    int n = arrayLength(u);
    int i = 0;
    while (i < n) {
      int c = u[i];
      if (c > 61 && c < 127) {
        if (c == 92) { storeUnit(92); storeUnit(92); } else { storeUnit(c); }
      } else if (c == 32) {
        if (i == 0 || isKey) { storeUnit(92); }
        storeUnit(32);
      } else if (c == 9) { storeUnit(92); storeUnit(116); }
      else if (c == 10) { storeUnit(92); storeUnit(110); }
      else if (c == 13) { storeUnit(92); storeUnit(114); }
      else if (c == 12) { storeUnit(92); storeUnit(102); }
      else if (c == 61 || c == 58 || c == 35 || c == 33) { storeUnit(92); storeUnit(c); }
      else if ((c < 32 || c > 126) && escUnicode) { storeHex4(c); }
      else { storeUnit(c); }
      i = i + 1;
    }
  }
  void storeComments(String comments) {
    int[] u = unitsOf(comments);
    int n = arrayLength(u);
    storeUnit(35);
    int i = 0;
    while (i < n) {
      int c = u[i];
      if (c > 255) { storeHex4(c); }
      else if (c == 10 || c == 13) {
        if (c == 13 && i != n - 1 && u[i + 1] == 10) { i = i + 1; }
        storeUnit(10);
        if (i == n - 1 || (u[i + 1] != 35 && u[i + 1] != 33)) { storeUnit(35); }
      } else { storeUnit(c); }
      i = i + 1;
    }
    storeUnit(10);
  }
  << natural String order (UTF-16 code units, as String.compareTo); insertion sort >>
  void sortNames(String[] names, int n) {
    int i = 1;
    while (i < n) {
      String x = names[i];
      int[] xu = unitsOf(x);
      int j = i - 1;
      boolean moving = true;
      while (j >= 0 && moving) {
        if (compareUnits(unitsOf(names[j]), xu) > 0) { names[j + 1] = names[j]; j = j - 1; }
        else { moving = false; }
      }
      names[j + 1] = x;
      i = i + 1;
    }
  }
  int compareUnits(int[] a, int[] b) {
    int na = arrayLength(a);
    int nb = arrayLength(b);
    int k = 0;
    while (k < na && k < nb) {
      if (a[k] != b[k]) { return a[k] - b[k]; }
      k = k + 1;
    }
    return na - nb;
  }
