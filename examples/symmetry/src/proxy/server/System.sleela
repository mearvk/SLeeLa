system Proxy.Server {
  role server

  state upstreams
  state active_connections
  state forwarded_requests

  on start {
    active_connections = 0
    forwarded_requests = 0
  }

  on proxy.connect(client) {
    active_connections = active_connections + 1
  }

  on proxy.request(request) {
    select upstream from upstreams
    forward request to upstream
    forwarded_requests = forwarded_requests + 1
    return upstream.response
  }

  on proxy.disconnect(client) {
    active_connections = active_connections - 1
  }
}
