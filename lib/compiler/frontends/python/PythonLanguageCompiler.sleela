/*
 * lib/compiler/frontends/python/PythonLanguageCompiler.sleela
 * SLeeLa Standard Library Definition.
 * Definition: A modular front end that compiles the Python programming language
 *   into SLeeLa IR and onward to a VM-ready artifact.
 *
 * Python is a dynamically typed scripting language. This front end carries the
 * full pipeline but its semantic phase does lightweight, dynamic-friendly
 * checking rather than static typing — showing that the common contract adapts
 * to a scripting family without changing the pipeline shape.
 *
 * Family: compiler (front end). Native VM/OS work crosses an explicit bridge.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class PythonLanguageCompiler extends SLLanguageCompiler {

  void configure() {
    declare("Python", "scripting", "Python 3.12", ".py", TARGET_SLVM);
    provide(PHASE_SOURCE);
    provide(PHASE_LEX);
    provide(PHASE_PARSE);
    provide(PHASE_RESOLVE);
    provide(PHASE_SEMANTIC);
    provide(PHASE_IR);
    provide(PHASE_LOWER);
    provide(PHASE_CODEGEN);
  }

  boolean runLex(SLCompileRequest request) {
    // Python lexing is indentation-significant: INDENT/DEDENT tokens are
    // produced from leading whitespace alongside the usual token kinds.
    return provides(PHASE_LEX);
  }

  boolean runSemantic(SLCompileRequest request) {
    // Dynamic semantics: scope/binding analysis and name/attribute checks,
    // without static type enforcement.
    return provides(PHASE_SEMANTIC);
  }
}
