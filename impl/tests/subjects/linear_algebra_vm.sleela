#sleela 3.0
class LinearAlgebraVmSmoke {
    static void main() {
        let a = arrayNew(3);
        let b = arrayNew(3);
        let sum = arrayNew(3);
        arraySet(a, 0, 1.0); arraySet(a, 1, 2.0); arraySet(a, 2, 3.0);
        arraySet(b, 0, 4.0); arraySet(b, 1, 5.0); arraySet(b, 2, 6.0);
        mathVectorAdd(a, b, sum, 3);
        print("MATH_VECTOR_ADD");
        print(arrayGet(sum, 0)); print(arrayGet(sum, 1)); print(arrayGet(sum, 2));
        print("MATH_VECTOR_DOT"); print(mathVectorDot(a, b, 3));
        print("MATH_VECTOR_NORM"); print(mathVectorNorm(a, 3));
        let scaled = arrayNew(3);
        mathVectorScale(a, 2.0, scaled, 3);
        print("MATH_VECTOR_SCALE"); print(arrayGet(scaled, 2));

        let ma = arrayNew(4);
        let mb = arrayNew(4);
        let mc = arrayNew(4);
        arraySet(ma, 0, 1.0); arraySet(ma, 1, 2.0);
        arraySet(ma, 2, 3.0); arraySet(ma, 3, 4.0);
        arraySet(mb, 0, 5.0); arraySet(mb, 1, 6.0);
        arraySet(mb, 2, 7.0); arraySet(mb, 3, 8.0);
        mathMatrixMultiply(ma, mb, mc, 2, 2, 2, 2);
        print("MATH_MATRIX_MULTIPLY");
        print(arrayGet(mc, 0)); print(arrayGet(mc, 1));
        print(arrayGet(mc, 2)); print(arrayGet(mc, 3));
        let mt = arrayNew(4);
        mathMatrixTranspose(ma, mt, 2, 2);
        print("MATH_MATRIX_TRANSPOSE");
        print(arrayGet(mt, 0)); print(arrayGet(mt, 1));
        print(arrayGet(mt, 2)); print(arrayGet(mt, 3));
        let diff = arrayNew(3);
        mathVectorSubtract(b, a, diff, 3);
        print("MATH_VECTOR_SUBTRACT"); print(arrayGet(diff, 2));
        let unit = arrayNew(3);
        mathVectorNormalize(a, unit, 3);
        print("MATH_VECTOR_NORMALIZE"); print(arrayGet(unit, 0));
        let cross = arrayNew(3);
        mathVectorCross3(a, b, cross);
        print("MATH_VECTOR_CROSS3"); print(arrayGet(cross, 2));

        let inv = arrayNew(4);
        mathMatrixInverse(ma, inv, 2);
        print("MATH_MATRIX_INVERSE"); print(arrayGet(inv, 0));
        let qrQ = arrayNew(6);
        let qrR = arrayNew(4);
        let tall = arrayNew(6);
        arraySet(tall, 0, 1.0); arraySet(tall, 1, 0.0);
        arraySet(tall, 2, 1.0); arraySet(tall, 3, 1.0);
        arraySet(tall, 4, 1.0); arraySet(tall, 5, 2.0);
        mathMatrixQR(tall, qrQ, qrR, 3, 2);
        print("MATH_MATRIX_QR"); print(arrayGet(qrR, 0));
        let eigenValues = arrayNew(2);
        let eigenVectors = arrayNew(4);
        let symmetric = arrayNew(4);
        arraySet(symmetric, 0, 2.0); arraySet(symmetric, 1, 1.0);
        arraySet(symmetric, 2, 1.0); arraySet(symmetric, 3, 2.0);
        mathSymmetricEigen(symmetric, eigenValues, eigenVectors, 2, 32);
        print("MATH_SYMMETRIC_EIGEN"); print(arrayGet(eigenValues, 0));
        let fftIn = arrayNew(8);
        let fftOut = arrayNew(8);
        arraySet(fftIn, 0, 1.0);
        mathFFT(fftIn, fftOut, 4, 0);
        print("MATH_FFT"); print(arrayGet(fftOut, 0));

        let ca = arrayNew(2);
        let cb = arrayNew(2);
        let cz = arrayNew(2);
        arraySet(ca, 0, 3.0); arraySet(ca, 1, 2.0);
        arraySet(cb, 0, 1.0); arraySet(cb, 1, -1.0);
        mathComplexAdd(ca, cb, cz);
        print("MATH_COMPLEX_ADD"); print(arrayGet(cz, 0));
        mathComplexSubtract(ca, cb, cz);
        print("MATH_COMPLEX_SUBTRACT"); print(arrayGet(cz, 1));
        mathComplexMultiply(ca, cb, cz);
        print("MATH_COMPLEX_MULTIPLY"); print(arrayGet(cz, 0));
        mathComplexDivide(ca, cb, cz);
        print("MATH_COMPLEX_DIVIDE"); print(arrayGet(cz, 1));

        print("NATIVE_MATH_VM_SOURCE=PASS");
    }
}
