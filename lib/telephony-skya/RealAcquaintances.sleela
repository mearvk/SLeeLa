/*
 * lib/telephony-skya/RealAcquaintances.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines RealAcquaintances, the Skya trust-roster Master Class —
 *   the people a node has actually met and confirmed.
 *
 * RealAcquaintances is an emblematic Skya module and a NATURAL / LOADABLE
 * MODULE sharing the common module contract (load / loaded / moduleName /
 * describe). It is the counterpart to Socio: Socio models the social fabric in
 * the abstract; RealAcquaintances records concrete, confirmed acquaintances a
 * node will preferentially reach and admit. An acquaintance becomes "real" only
 * after a confirmed two-way exchange, so the roster never contains unverified
 * entries. It holds roster state only; the confirming exchange is performed by
 * the Communication module. The runnable orchestration example lives in
 * telephony-skya/sleela/RealAcquaintances.sleela.
 *
 * Family: telephony-skya. Native VM/OS work crosses an explicit bridge.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
class RealAcquaintances {

  static final String MODULE = "RealAcquaintances";
  static final int MAX = 256;

  int loadedFlag;
  String[] names;
  int count;
  int pending;

  void load() {
    loadedFlag = 1;
    names = new String[MAX];
    count = 0;
    pending = 0;
  }
  boolean loaded() { return loadedFlag == 1; }
  String moduleName() { return MODULE; }

  void introduce() { pending = pending + 1; }

  boolean confirm(String name) {
    if (name == null || count >= MAX) { return false; }
    if (knows(name)) { return false; }
    names[count] = name;
    count = count + 1;
    if (pending > 0) { pending = pending - 1; }
    return true;
  }

  boolean knows(String name) {
    if (name == null) { return false; }
    int i = 0;
    while (i < count) {
      if (names[i] == name) { return true; }
      i = i + 1;
    }
    return false;
  }

  boolean trusts(String name) { return knows(name); }

  int acquaintanceCount() { return count; }
  int pendingCount() { return pending; }

  String describe() {
    return MODULE + " real=" + count + " pending=" + pending
         + " capacity=" + MAX;
  }
}
