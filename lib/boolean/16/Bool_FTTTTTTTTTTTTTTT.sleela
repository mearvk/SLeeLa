/*
 * lib/boolean/16/Bool_FTTTTTTTTTTTTTTT.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the Boolean/Binary word BOOLEAN.FALSE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE (depth 16) as a SLeeLa standard-library constant. HEAD syllable is the result (FALSE); the remaining 15 syllable(s) are carried caveat structure.
 */
#sleela 1.3
// SLeeLa boolean/16 front-end constant — one Boolean word per file.
// Word: BOOLEAN.FALSE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE
// Family: boolean. The HEAD syllable is the RESULT; trailing syllables are
// CARRY (caveat structure) that must be observed/agree. A FALSE carried behind
// a TRUE result means: result is TRUE, but a concern of carry is noted.
class Bool_FTTTTTTTTTTTTTTT {
  String word() { return "BOOLEAN.FALSE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE.TRUE"; }
  String glyphs() { return "FTTTTTTTTTTTTTTT"; }
  int depth() { return 16; }
  // Head syllable = the asserted result.
  boolean head() { return false; }
  String headSyllable() { return "FALSE"; }
  // Carry = the trailing syllables, read as a caveat structure.
  String carry() { return "TTTTTTTTTTTTTTT"; }
  int carryDepth() { return 15; }
  // A caveat exists when any carried syllable disagrees (a FALSE is carried).
  boolean caveat() { return false; }
  // Agreement: the whole word is uniform (all syllables equal the head).
  boolean agrees() { return false; }
  int trueCount() { return 15; }
  int falseCount() { return 1; }
  // Binary reading: TRUE=1, FALSE=0, head syllable most significant.
  String bits() { return "0111111111111111"; }
  String value() { return "32767"; }
}
