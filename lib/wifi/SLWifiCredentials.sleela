/*
 * lib/wifi/SLWifiCredentials.sleela
 * One-attempt authentication request. Prefer an OS profile/credential vault.
 * SLeeLa Strings are immutable values here; clear() drops references but cannot
 * guarantee memory erasure. The native C API has a secure-zero helper for buffers.
 */
#sleela 2.1
class SLWifiCredentials {
  static final int OS_MANAGED = 0;
  static final int SAVED_PROFILE = 1;
  static final int PASSPHRASE = 2;
  static final int ENTERPRISE_PASSWORD = 3;

  int mode;
  String profileName;
  String username;
  String password;
  String caCertificateFile;
  String expectedServerName;

  void configureOSManaged() {
    mode = OS_MANAGED;
    clearFields();
  }

  void configureSavedProfile(String name) {
    mode = SAVED_PROFILE;
    profileName = name;
    username = "";
    password = "";
    caCertificateFile = "";
    expectedServerName = "";
  }

  void configurePassphrase(String passphrase) {
    mode = PASSPHRASE;
    profileName = "";
    username = "";
    password = passphrase;
    caCertificateFile = "";
    expectedServerName = "";
  }

  void configureEnterprise(String user, String secret, String caFile, String serverName) {
    mode = ENTERPRISE_PASSWORD;
    profileName = "";
    username = user;
    password = secret;
    caCertificateFile = caFile;
    expectedServerName = serverName;
  }

  boolean isValid() {
    if (mode == OS_MANAGED) { return true; }
    if (mode == SAVED_PROFILE) { return profileName != null && profileName != ""; }
    if (mode == PASSPHRASE) { return password != null && password != ""; }
    if (mode == ENTERPRISE_PASSWORD) {
      return username != null && username != "" && password != null && password != "" &&
             caCertificateFile != null && caCertificateFile != "" &&
             expectedServerName != null && expectedServerName != "";
    }
    return false;
  }

  void clearFields() {
    profileName = "";
    username = "";
    password = "";
    caCertificateFile = "";
    expectedServerName = "";
  }

  void clear() {
    clearFields();
    mode = OS_MANAGED;
  }

  boolean prefersOSAuthentication() {
    return mode == OS_MANAGED || mode == SAVED_PROFILE;
  }
}
