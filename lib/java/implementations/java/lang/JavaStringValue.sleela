<< VM-backed SLeeLa facade for java.lang.String.
   The value field is an SL_UTF16 VM value from construction onward.
   charAt returns an integer containing one UTF-16 code unit because SLeeLa
   does not yet define Java's 16-bit char value type. >>
#sleela 3.0
material;

class JavaStringValue {
  String value = javaStringFromCodeUnits();
  // Retained in bind(...) for source compatibility with the former
  // Native Drive adapter. VM-backed String operations do not need a module.
  int nativeModule = 0;

  JavaStringValue fromUtf16(String text) {
    JavaStringValue result = new JavaStringValue();
    result.value = text;
    return result;
  }

  JavaStringValue bind(int moduleHandle, String text) {
    JavaStringValue result = new JavaStringValue();
    result.nativeModule = moduleHandle;
    result.value = javaStringFromUtf8(text);
    return result;
  }

  String toString() { return value; }
  boolean isEmpty() { return javaStringLength(value) == 0; }
  boolean equals(JavaStringValue other) {
    if (other == null) { return false; }
    return javaStringCompareTo(value, other.value) == 0;
  }

  JavaStringValue concat(JavaStringValue other) {
    return fromUtf16(javaStringConcat(value, other.value));
  }

  int length() { return javaStringLength(value); }

  // Returns one UTF-16 code unit in the integer range 0..65535.
  // Supplementary characters occupy two independently addressable positions.
  int charAt(int index) { return javaStringCharAt(value, index); }

  int codePointAt(int index) { return javaStringCodePointAt(value, index); }
  int codePointCount(int beginIndex, int endIndex) {
    return javaStringCodePointCount(value, beginIndex, endIndex);
  }
  int offsetByCodePoints(int index, int codePointOffset) {
    return javaStringOffsetByCodePoints(value, index, codePointOffset);
  }

  JavaStringValue substring(int beginIndex, int endIndex) {
    return fromUtf16(javaStringSubstring(value, beginIndex, endIndex));
  }

  // Java String prefix/suffix/search operations. All offsets and results are
  // UTF-16 code-unit indices, matching Java String rather than code-point
  // indexing. Empty search strings follow the Java String contract.
  boolean startsWith(JavaStringValue prefix) {
    int n = prefix.length();
    if (n > length()) { return false; }
    int i = 0;
    while (i < n) {
      if (charAt(i) != prefix.charAt(i)) { return false; }
      i = i + 1;
    }
    return true;
  }

  boolean endsWith(JavaStringValue suffix) {
    int n = suffix.length();
    int ownLength = length();
    if (n > ownLength) { return false; }
    int i = 0;
    while (i < n) {
      if (charAt(ownLength - n + i) != suffix.charAt(i)) { return false; }
      i = i + 1;
    }
    return true;
  }

  boolean contains(JavaStringValue sequence) {
    return indexOf(sequence) >= 0;
  }

  int indexOf(JavaStringValue sequence) {
    int needleLength = sequence.length();
    int ownLength = length();
    if (needleLength == 0) { return 0; }
    if (needleLength > ownLength) { return -1; }
    int start = 0;
    while (start <= ownLength - needleLength) {
      int j = 0;
      boolean matched = true;
      while (j < needleLength && matched) {
        if (charAt(start + j) != sequence.charAt(j)) { matched = false; }
        j = j + 1;
      }
      if (matched) { return start; }
      start = start + 1;
    }
    return -1;
  }

  int lastIndexOf(JavaStringValue sequence) {
    if (sequence == null) { return -1; }
    int needleLength = sequence.length();
    int ownLength = length();
    if (needleLength == 0) { return ownLength; }
    if (needleLength > ownLength) { return -1; }
    int start = ownLength - needleLength;
    while (start >= 0) {
      int j = 0;
      boolean matched = true;
      while (j < needleLength && matched) {
        if (charAt(start + j) != sequence.charAt(j)) { matched = false; }
        j = j + 1;
      }
      if (matched) { return start; }
      start = start - 1;
    }
    return -1;
  }

  int hashCode() { return javaStringHashCode(value); }
  int compareTo(JavaStringValue other) {
    return javaStringCompareTo(value, other.value);
  }

  boolean supportsUtf16Indexing() { return true; }
  boolean supportsCodePointIteration() { return true; }
  boolean supportsJavaHashCode() { return true; }
  boolean supportsPrefixSuffixSearch() { return true; }
}
