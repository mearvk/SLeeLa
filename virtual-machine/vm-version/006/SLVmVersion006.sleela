/*
 * virtual-machine/vm-version/006/SLVmVersion006.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines SLVmVersion006 — the loadable manifest for VM version 006
 *   ("dispatch profiler"), the OOD selector record the native VM loads on system
 *   start or a user conference. It names this version's native directory and
 *   the C/C++ main the loader builds and boots, declares the hardening units it
 *   composes (cumulative through v006 of the think-tank arc), and carries the
 *   default configuration profile a user starts from. build() returns the
 *   configured SLVmRuntime a selection resolves to.
 *
 * Mirrors the C/C++ in this folder (the 71-file core + the additive vm_* units
 * through v006). It extends SLVmVersion (lib/vm/src/SLVmVersion.sleela).
 *
 * Family: vm. Composes SLVmVersion, SLVmConfig, SLVmRuntime.
 */
#sleela 1.3
class SLVmVersion006 extends SLVmVersion {
  void configure() {
    base(6, "idea-vm-006", "dispatch profiler", "virtual-machine/vm-version/006", "vm_profile_test");
    composeThrough(6);
    // default profile tuning for this version (user-editable in setup/conference)
    profile.setVerbosity(SLVmConfig.VERBOSITY_NORMAL);
  }
}
