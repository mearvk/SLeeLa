/*
 * lib/crypto/SLHmac.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLHmac used within the crypto library family.
 */
#sleela 1.3
// Unified SLeeLa SDK front-end object.
// Family: crypto. HMAC (FIPS 198-1 / RFC 2104) over SHA-256 or SHA-512. Native impl crosses the VM/OS bridge to /crypto.
//
// SECURITY NOTE: the native /crypto backend is a correct, specification-faithful
// REFERENCE implementation. It is NOT guaranteed constant-time and is NOT
// side-channel resistant. For data that must be protected use an audited library
// (BoringSSL, OpenSSL, libsodium, liboqs). See crypto/README.md.
class SLHmac {
  // Status codes mirror slcrypto_status in crypto/include/slcrypto.h.
  static final int OK = 0;
  static final int ERR_PARAM = -1;
  static final int ERR_AUTH = -2;      // MAC verification failed
  static final int ERR_UNIMPL = -3;

  static final int SHA256_MAC_LEN = 32;
  static final int SHA512_MAC_LEN = 64;

  String algorithm;
  int outBytes;      // MAC length for the selected hash
  int state;         // 1 = enabled, 0 = disabled
  int configured;    // 1 once a supported algorithm name has been accepted
  int backend;       // 1 when the native /crypto backend is linked and ready

  // Accept only the two HMAC variants the native layer provides.
  int configure(String a) {
    if (a == null) { configured = 0; return ERR_PARAM; }
    if (a == "HMAC-SHA-256") { algorithm = a; outBytes = SHA256_MAC_LEN; configured = 1; return OK; }
    if (a == "HMAC-SHA-512") { algorithm = a; outBytes = SHA512_MAC_LEN; configured = 1; return OK; }
    configured = 0;
    return ERR_PARAM;
  }

  void bindBackend(int ready) { if (ready == 1) { backend = 1; } else { backend = 0; } }
  boolean backendReady() { return backend == 1; }

  void enable() { state = 1; }
  void disable() { state = 0; }
  boolean active() { return state == 1 && configured == 1 && backend == 1; }

  int macLength() { return outBytes; }

  // Compute a MAC over msg with key. Models slc_hmac_sha256()/slc_hmac_sha512().
  int sign(String key, String msg) {
    if (active() == false) { return ERR_UNIMPL; }
    if (key == null || msg == null) { return ERR_PARAM; }
    return OK;
  }

  // Verify a MAC. The native layer compares in constant time (slc_ct_equal);
  // a mismatch yields ERR_AUTH.
  int verify(String key, String msg, String mac) {
    if (active() == false) { return ERR_UNIMPL; }
    if (key == null || msg == null || mac == null) { return ERR_PARAM; }
    return OK;
  }

  String securityNote() {
    return "Reference-grade: not constant-time, not side-channel resistant; use an audited library in production.";
  }
}
