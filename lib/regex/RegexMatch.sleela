/*
 * lib/regex/RegexMatch.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type RegexMatch used within the regex library family.
 */
#sleela 1.3
class RegexMatch {
  int start;
  int end;
  boolean matched;
  void clear(){start=0;end=0;matched=false;}
  void setRange(int a,int b){start=a;end=b;matched=true;}
  boolean found(){return matched;}
}
