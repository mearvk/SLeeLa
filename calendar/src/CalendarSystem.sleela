}

<< ============================================================= >>
<< CalendarSystemDemo — runnable entry point.                      >>
<< ============================================================= >>
class CalendarSystemDemo {

  void main() {
    print("== SLeeLa Calendar System ==");

    SLCalendarJulian julian = new SLCalendarJulian();
    print("Julian 1900 leap? " + julian.isLeapYear(1900));
    print("Julian days in Feb 1900: " + julian.daysInMonth(1900, 2));

    SLCalendarGregorian greg = new SLCalendarGregorian();
    print("Gregorian 1900 leap? " + greg.isLeapYear(1900));
    print("Gregorian 2000 leap? " + greg.isLeapYear(2000));
    print("Gregorian days in Feb 1900: " + greg.daysInMonth(1900, 2));

    SLCalendarConverter conv = new SLCalendarConverter();
    conv.create();
    print("Offset 1582-10-15 (expect 10): " + conv.offsetForDate(1582, 10, 15));
    print("Offset 1752-09-14 (expect 11): " + conv.offsetForDate(1752, 9, 14));
    print("Offset 1918-02-14 (expect 13): " + conv.offsetForDate(1918, 2, 14));

    SLCalendarIntegrationUS us = new SLCalendarIntegrationUS();
    us.setup();
    print("US adoption: " + us.colonialAdoptionNote());
    print("US adoption skip: " + us.colonialAdoptionSkipDays());
    print("US civil standard: " + us.civilTimeStandard());
    print("US interchange: " + us.interchangeStandard());
    print("US ISO date for 2026-11-7: " + us.isoDate(2026, 11, 7));
    print("Weekday 2000-01-01 (expect 6=Sat): " + us.dayOfWeek(2000, 1, 1));

    SLUnifiedCalendar uni = new SLUnifiedCalendar();
    uni.create();
    print("Civil rule: " + uni.civilRule());
    print("Physical ref: " + uni.physicalReference());
    print("Interchange: " + uni.interchangeForm());
    print("Canonical date 2026-11-7: " + uni.canonicalDate(2026, 11, 7));
    print("Overlay 'chinese' kind: " + uni.overlayKind("chinese"));
    print("Overlay 'hijri' kind: " + uni.overlayKind("hijri"));
    print("Admits 'orthodox'? " + uni.admitsOverlay("orthodox"));
    print("Agreement: " + uni.agreement());

    print("== done ==");
  }

  << ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >>
