/*
 * lib/java/java/lang/Class.sleela
 * SLeeLa JDK 28 Framework Binding.
 * Definition: Controlled SLeeLa binding for the JDK 28 type java.lang.Class.
 * The binding describes the Java framework type without copying Java implementation code.
 */
#sleela 1.3

class Class {
  String javaType = "java.lang.Class";

  String typeName() {
    return javaType;
  }

  boolean available() {
    return javaType != "";
  }
}
