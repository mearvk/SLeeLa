/*
 * lib/core/SLTask.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLTask used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Task.
// Role: runtime. Responsibility: unit of asynchronous work.
class SLTask {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
