/*
 * lib/video/VideoCodecLoader.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type VideoCodecLoader used within the video library family.
 */
#sleela 1.3
// Family: video. The SLeeLa-facing handle to the native video codec registry
// (video/codecs/include/sleela_video_codecs.h). Like the audio SLCodecLoader,
// a program never calls an individual video codec directly: it loads a codec
// by id, uses it, then unloads. The Loader keeps a per-codec loaded flag.
//
// Video codec ids mirror sleela_video_codec_id (0-based, registry order):
//   0 RAW  1 H264  2 HEVC  3 AV1  4 VP8  5 VP9  6 MPEG2  7 THEORA
//   8 MJPEG  9 FFV1  10 PRORES  11 DNX
//
// Video handler states: 0 native, 1 backend, 2 qualified-backend, 3 recognized.
class VideoCodecLoader {
  // Per-codec loaded flag (1 loaded, 0 not), indexed by codec id. Call init().
  int[] loaded;

  // Number of video codecs the native registry knows (SLEELA_VIDEO_CODEC_COUNT).
  int codecCount(){ return 12; }

  void init(){ loaded = new int[12]; }

  void load(int id){ loaded[id] = 1; }
  void unload(int id){ loaded[id] = 0; }
  boolean isLoaded(int id){ return loaded[id] == 1; }

  void unloadAll(){
    int i = 0;
    while(i < 12){ loaded[i] = 0; i = i + 1; }
  }

  // Human-readable codec name by id, matching the native registry.
  string nameOf(int id){
    if(id == 0){ return "Raw Video"; }
    if(id == 1){ return "H.264/AVC"; }
    if(id == 2){ return "H.265/HEVC"; }
    if(id == 3){ return "AV1"; }
    if(id == 4){ return "VP8"; }
    if(id == 5){ return "VP9"; }
    if(id == 6){ return "MPEG-2 Video"; }
    if(id == 7){ return "Theora"; }
    if(id == 8){ return "Motion JPEG"; }
    if(id == 9){ return "FFV1"; }
    if(id == 10){ return "Apple ProRes"; }
    return "DNxHD/DNxHR";
  }

  // Only Raw Video (0) encodes/decodes natively; every other video codec is a
  // backend (ProRes/DNx are qualified backends). Mirrors the registry state.
  boolean isNative(int id){ return id == 0; }

  // ProRes (10) and DNx (11) need a specially qualified backend adapter.
  boolean isQualifiedBackend(int id){ return id == 10 || id == 11; }
}
