/*
 * lib/core/SLPath.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLPath used within the core library family.
 */
#sleela 1.3
// Native foundational bridge contract for Path.
// Role: service. Responsibility: filesystem path value.
class SLPath {
  int state;
  void reset(){state=0;}
  void activate(){state=1;}
  boolean active(){return state==1;}
  int status(){return state;}
}
