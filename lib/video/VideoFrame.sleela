/*
 * lib/video/VideoFrame.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type VideoFrame used within the video library family.
 */
#sleela 2.1
class VideoFrame {
  int width;
  int height;
  VideoPixelFormat format;
  long timestamp;
  boolean valid(){return width>0 && height>0 && format!=null;}
  void resize(int w,int h){width=w;height=h;}
}