{
  "schemaVersion": 1,
  "nativeApi": "sleela_wifi/wifi_manager.h",
  "oodOperations": [
    "scan",
    "select",
    "connect",
    "disconnect"
  ],
  "selectionKey": [
    "ssid",
    "bssid",
    "security"
  ],
  "authentication": [
    "os-managed",
    "saved-profile",
    "personal-passphrase",
    "enterprise-username-password"
  ],
  "defaultSecurityPolicy": {
