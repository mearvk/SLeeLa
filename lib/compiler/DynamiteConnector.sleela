#sleela 1.3
// Compiler-level Dynamite Connector contract.
class DynamiteConnector {
 String importPath;
 String configuration;
 String properties;
 String status;
 function initialize(){status="imported";}
 function resolve(){status="resolved";return status;}
 function deferConstruction(){status="deferred";return status;}
 function load(){status="loadable";return status;}
}