<< lib/crypto/SLHkdf.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines the SLeeLa standard-library type SLHkdf used within the crypto library family. >>
#sleela 2.5
material;
< Unified SLeeLa SDK front-end object. >
< Family: crypto. HKDF extract-and-expand KDF (RFC 5869) over HMAC-SHA-256. Native impl crosses the VM/OS bridge to /crypto. >
<  >
< SECURITY NOTE: the native /crypto backend is a correct, specification-faithful >
< REFERENCE implementation. It is NOT guaranteed constant-time and is NOT >
< side-channel resistant. For data that must be protected use an audited library >
< (BoringSSL, OpenSSL, libsodium, liboqs). See crypto/README.md. >
class SLHkdf {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10246;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-10-16";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-06";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  < Status codes mirror slcrypto_status in crypto/include/slcrypto.h. >
  static final int OK = 0;
  static final int ERR_PARAM = -1;
  static final int ERR_AUTH = -2;
  static final int ERR_UNIMPL = -3;

  < RFC 5869 caps expand output at 255 * HashLen; HashLen is 32 for SHA-256. >
  < 255 * 32 >
  static final int MAX_OUT_BYTES = 8160;

  String algorithm;
  < requested output keying material length >
  int outBytes;
  < 1 = enabled, 0 = disabled >
  int state;
  < 1 once a supported algorithm name has been accepted >
  int configured;
  < 1 once a valid output size has been accepted >
  int outSet;
  < 1 when the native /crypto backend is linked and ready >
  int backend;

  int configure(String a) {
    if (a == null) { configured = 0; return ERR_PARAM; }
    if (a == "HKDF-SHA-256") { algorithm = a; configured = 1; return OK; }
    configured = 0;
    return ERR_PARAM;
  }

  < outputSize must be in 1 .. 255*HashLen (RFC 5869). >
  int outputSize(int n) {
    if (n >= 1 && n <= MAX_OUT_BYTES) { outBytes = n; outSet = 1; return OK; }
    outSet = 0;
    return ERR_PARAM;
  }

  void bindBackend(int ready) { if (ready == 1) { backend = 1; } else { backend = 0; } }
  boolean backendReady() { return backend == 1; }

  void enable() { state = 1; }
  void disable() { state = 0; }

  boolean active() {
    return state == 1 && configured == 1 && outSet == 1 && backend == 1;
  }

  int outputLength() { return outBytes; }

  < Extract-and-expand in one call. Models slc_hkdf_sha256(salt, ikm, info -> okm). >
  int derive(String salt, String ikm, String info) {
    if (active() == false) { return ERR_UNIMPL; }
    if (ikm == null) { return ERR_PARAM; }
    return OK;
  }

  String securityNote() {
    return "Reference-grade: not constant-time, not side-channel resistant; use an audited library in production.";
  }
}
