# Repository hygiene
.idea/
.vscode/
*.iml

# Build outputs
impl/build/
**/build/
# Premium SLVM runnable-VM build output (kept separate from committed
# build/<platform>/ entry points under sleela-virtual-machine/0NN).
**/vm-build/
*.o
*.obj
*.a
*.so
*.dll
*.dylib
*.exe
*.out

# Temporary/editor files
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local generated/runtime state
*.log

# Generated compile outputs (syntax 2.4 author-marked documents)
*.originated.sleela
*.wiki
# ...but the hand-authored, sourced wiki corpora under wiki/ are committed
# content, not compiler output -- keep them tracked.
!wiki/**/*.wiki
!wiki/*.wiki
