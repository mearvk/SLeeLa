  int[] members;
  int size;
  int capacity;
  void configure(int cap) { capacity = cap; members = new int[cap]; size = 0; }
  boolean contains(int v) {
    int i = 0;
    while (i < size) { if (members[i] == v) { return true; } i = i + 1; }
    return false;
  }
  boolean add(int v) {
    if (contains(v) || size >= capacity) { return false; }
    members[size] = v;
    size = size + 1;
    return true;
  }
  int cardinality() { return size; }
}

