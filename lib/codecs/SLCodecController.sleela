/*
 * lib/codecs/SLCodecController.sleela
 * SLeeLa Standard Library Definition.
 * Definition: Defines the SLeeLa standard-library type SLCodecController used within the codecs library family.
 */
#sleela 1.11
// Family: codecs. The SLeeLa-facing Codec Management Controller — the single
// surface a GUI or application drives to use codecs, mirroring the native
// "Codec Loader / Unloader / Management Controller"
// (codecs/include/sleela_codec_manager.h). The Controller owns each codec's
// loaded/unloaded lifecycle and the backend-registration table, and cooperates
// with the sibling classes:
//
//   * SLCodecLoader    — classification (nameOf / isNative) and the standalone
//                        plugin-load contract;
//   * SLCodecVerifier  — extension/magic resolution and result-code text;
//   * SLCodecProcessor — the standalone decode/encode dispatch contract.
//
// As of syntax 1.11 the Controller holds its collaborators as fields and calls
// through them directly (method calls resolve on class-typed fields). create()
// wires an SLCodecVerifier; the Controller keeps its own lifecycle state in
// int[] tables.
//
// Codec ids mirror sleela_codec_id (0-based, registry order):
//   0 PCM_WAV  1 AIFF  2 FLAC  3 ALAC  4 MP3  5 AAC  6 HE_AAC  7 VORBIS
//   8 OPUS  9 SPEEX  10 WMA  11 AC3  12 EAC3  13 AMR_NB  14 AMR_WB
//   15 G711_MULAW  16 G711_ALAW  17 MIDI  18 MATROSKA_AUDIO  19 WEBM_AUDIO
//
// Handler states: 0 native, 1 backend, 2 recognized, 3 container, 4 event.
// Result codes (sleela_codec_result): 0 ok, -1 unsupported, -2 invalid,
// -3 format, -4 io, -5 state(not loaded).
class SLCodecController {

  // Per-codec loaded flag (1 loaded, 0 not), indexed by codec id.
  int[] loaded;
  // Per-codec backend-registered flag (1 if an approved adapter is wired).
  int[] backend;
  // The verification collaborator, wired by create() and called via the field.
  SLCodecVerifier verifier;
  // 1 once create() has allocated the tables and wired the verifier.
  int ready;

  // ---- lifecycle of the controller itself -----------------------------

  // Build the controller with every codec registered but none loaded.
  // Mirrors sleela_codec_manager_create.
  void create() {
    loaded = new int[20];
    backend = new int[20];
    verifier = new SLCodecVerifier();
    ready = 1;
  }

  boolean isReady() { return ready == 1; }

  // Release every loaded codec. Mirrors sleela_codec_manager_destroy's cleanup.
  void destroy() {
    int i = 0;
    while (i < 20) { loaded[i] = 0; i = i + 1; }
  }

  // ---- registry inspection --------------------------------------------

  int count() { return 20; }
  boolean validId(int id) { return id >= 0 && id < 20; }

  // Native codecs encode/decode in-package: PCM/WAV (0), AIFF (1),
  // G.711 mu-law (15), G.711 A-law (16).
  boolean isNative(int id) { return id == 0 || id == 1 || id == 15 || id == 16; }

  // ---- loader / unloader (controller lifecycle for an app) ------------

  // load(id): make a codec usable. Returns 0 ok, -2 invalid id. Idempotent.
  int load(int id) {
    if (!validId(id)) { return -2; }
    loaded[id] = 1;
    return 0;
  }

  // unload(id): release a codec. Returns 0 ok, -2 invalid id. Idempotent.
  int unload(int id) {
    if (!validId(id)) { return -2; }
    loaded[id] = 0;
    return 0;
  }

  void unloadAll() {
    int i = 0;
    while (i < 20) { loaded[i] = 0; i = i + 1; }
  }

  boolean isLoaded(int id) {
    if (!validId(id)) { return false; }
    return loaded[id] == 1;
  }

  // How many codecs are currently loaded — handy for GUI status.
  int loadedCount() {
    int n = 0;
    int i = 0;
    while (i < 20) {
      if (loaded[i] == 1) { n = n + 1; }
      i = i + 1;
    }
    return n;
  }

  // ---- backend registration (for backend-state codecs) ----------------

  // registerBackend(id): record that an approved backend adapter is available
  // for a backend codec. Returns 0 ok, -2 invalid id.
  int registerBackend(int id) {
    if (!validId(id)) { return -2; }
    backend[id] = 1;
    return 0;
  }

  int clearBackend(int id) {
    if (!validId(id)) { return -2; }
    backend[id] = 0;
    return 0;
  }

  boolean hasBackend(int id) {
    if (!validId(id)) { return false; }
    return backend[id] == 1;
  }

  // ---- resolution (delegated to the wired Verifier) -------------------

  // Resolve a codec id from a file extension via the Controller's Verifier.
  int resolveExtension(String extension) {
    return verifier.resolveExtension(extension);
  }

  // ---- dispatch (requires load; honest capability result) -------------

  // canProcess(id): can this codec encode/decode right now? True for a loaded
  // native codec, or a loaded backend codec with a backend registered — what a
  // GUI checks before enabling a convert action.
  boolean canProcess(int id) {
    if (!validId(id)) { return false; }
    if (loaded[id] == 0) { return false; }
    if (isNative(id)) { return true; }
    return backend[id] == 1;
  }

  // decode(id): returns a result code: -2 invalid, -5 not loaded,
  // -1 backend absent, 0 ok.
  int decode(int id) {
    if (!validId(id)) { return -2; }
    if (loaded[id] == 0) { return -5; }
    if (isNative(id)) { return 0; }
    if (backend[id] == 1) { return 0; }
    return -1;
  }

  int encode(int id) {
    if (!validId(id)) { return -2; }
    if (loaded[id] == 0) { return -5; }
    if (isNative(id)) { return 0; }
    if (backend[id] == 1) { return 0; }
    return -1;
  }

  // Human-readable text for a result code (via the wired Verifier).
  String resultText(int code) {
    return verifier.resultText(code);
  }
}
