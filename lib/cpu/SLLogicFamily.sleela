<< lib/cpu/SLLogicFamily.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLLogicFamily, the electrical identity of the gates a CPU
     is built from: process feature size, supply, the input and output voltage
     thresholds that decide what counts as a logic 0 or 1, the typical gate
     delay and edge time, and the allowed fanout. Every voltage is in
     millivolts (signed, so a negative-supply PMOS part is expressed directly)
     and every time is in picoseconds.

   Classification is polarity-aware. For a positive-going family the high
   threshold lies above the low threshold. For a negative-going family (for
   example early PMOS) the high threshold lies below the low threshold. The
   same classify() call serves both.

   Each family carries a provenance string saying whether its numbers are
   published (cite the datasheet), derived (computed from published values),
   or unknown. Unknown values are left at zero rather than invented.

   Family: cpu. Pure Sleela electrical model; no native bridge. >>
#sleela 2.5
material;
class SLLogicFamily {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 39534;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-21";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-21";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 7;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < family label, for example NMOS-depletion-load, PMOS-silicon-gate, CMOS >
  String name;
  < drawn feature size in nanometres; 0 when unknown >
  int featureNm;
  < nominal supply in millivolts, signed >
  int vddMv;
  < supply tolerance in millivolts (plus or minus) >
  int vddTolMv;
  < the highest voltage still read as logic LOW on an input, for positive-going >
  int vilMv;
  < the lowest voltage still read as logic HIGH on an input, for positive-going >
  int vihMv;
  < worst-case output voltage when driving LOW >
  int volMv;
  < worst-case output voltage when driving HIGH >
  int vohMv;
  < typical single-gate propagation delay in picoseconds >
  int gateDelayPs;
  < typical 10 to 90 percent edge time in picoseconds >
  int edgePs;
  < how many gate inputs one output may drive before timing is no longer valid >
  int fanoutMax;
  < published, derived, or unknown, plus the citation in words >
  String provenance;

  void configure(String familyName, int nm, int vdd, int tol) {
    name = familyName; featureNm = nm; vddMv = vdd; vddTolMv = tol;
    vilMv = 0; vihMv = 0; volMv = 0; vohMv = 0;
    gateDelayPs = 0; edgePs = 0; fanoutMax = 1; provenance = "unknown";
  }

  < Declare the four logic thresholds in millivolts. >
  void setThresholds(int vil, int vih, int vol, int voh) {
    vilMv = vil; vihMv = vih; volMv = vol; vohMv = voh;
  }

  < Declare the speed of one gate: delay, edge time and allowed fanout. >
  void setSpeed(int delayPs, int edgeTimePs, int fanout) {
    gateDelayPs = delayPs; edgePs = edgeTimePs;
    if (fanout >= 1) { fanoutMax = fanout; }
  }

  void setProvenance(String p) { provenance = p; }

  < True when logic HIGH is the more positive level. >
  boolean positiveGoing() { return vihMv >= vilMv; }

  < Return 0 for LOW, 1 for HIGH, 2 for the forbidden zone between them, and >
  < 3 when the level lies outside the supply window by more than the tolerance. >
  int classify(int levelMv) {
    int lo = vddMv;
    int hi = 0;
    if (vddMv < 0) { lo = vddMv; hi = 0; } else { lo = 0; hi = vddMv; }
    if (levelMv < lo - vddTolMv) { return 3; }
    if (levelMv > hi + vddTolMv) { return 3; }
    if (positiveGoing()) {
      if (levelMv >= vihMv) { return 1; }
      if (levelMv <= vilMv) { return 0; }
      return 2;
    }
    if (levelMv <= vihMv) { return 1; }
    if (levelMv >= vilMv) { return 0; }
    return 2;
  }

  < Margin between what a driver guarantees for HIGH and what a receiver needs. >
  int noiseMarginHighMv() {
    if (positiveGoing()) { return vohMv - vihMv; }
    return vihMv - vohMv;
  }

  < Margin between what a driver guarantees for LOW and what a receiver needs. >
  int noiseMarginLowMv() {
    if (positiveGoing()) { return vilMv - volMv; }
    return volMv - vilMv;
  }

  < A family is sound when both noise margins are positive. >
  boolean sound() { return noiseMarginHighMv() > 0 && noiseMarginLowMv() > 0; }

  < Voltage swing between the guaranteed output levels, always positive. >
  int swingMv() {
    int s = vohMv - volMv;
    if (s < 0) { s = 0 - s; }
    return s;
  }

  String familyName() { return name; }
  int nodeNm() { return featureNm; }
  int supplyMv() { return vddMv; }
  int toleranceMv() { return vddTolMv; }
  int delayPs() { return gateDelayPs; }
  int edgeTimePs() { return edgePs; }
  int fanout() { return fanoutMax; }
  String source() { return provenance; }
}
