  << java.util.GregorianCalendar over a millisecond count since the epoch, in
     UTC (what Java reports when the default zone is UTC), with the US week
     rules (Sunday first, minimal days in first week 1) and lenient fields.
     Field numbers are the java.util.Calendar constants, written as integers
     because a class cannot read another class static constants here: 0 ERA,
     1 YEAR, 2 MONTH, 3 WEEK_OF_YEAR, 4 WEEK_OF_MONTH, 5 DAY_OF_MONTH,
     6 DAY_OF_YEAR, 7 DAY_OF_WEEK, 8 DAY_OF_WEEK_IN_MONTH, 9 AM_PM, 10 HOUR,
     11 HOUR_OF_DAY, 12 MINUTE, 13 SECOND, 14 MILLISECOND, 15 ZONE_OFFSET,
     16 DST_OFFSET. Dates use proleptic Gregorian rules, so results before the
     1582 Julian cutover differ from Java. Time zones, locales, roll, week
     dates, clone, hashCode and the Date / ZonedDateTime bridges keep their
     exact-signature stubs. >>
  long gcTime = 0;

  public GregorianCalendar() { this.gcTime = timeUtcMillis(); }
  public GregorianCalendar(int year, int month, int dayOfMonth) { compose(year, month, dayOfMonth, 0, 0, 0, 0); }
  public GregorianCalendar(int year, int month, int dayOfMonth, int hourOfDay, int minute) { compose(year, month, dayOfMonth, hourOfDay, minute, 0, 0); }
  public GregorianCalendar(int year, int month, int dayOfMonth, int hourOfDay, int minute, int second) { compose(year, month, dayOfMonth, hourOfDay, minute, second, 0); }

  public long getTimeInMillis() { return this.gcTime; }
  public void setTimeInMillis(long millis) { this.gcTime = millis; }
  public boolean before(GregorianCalendar when) { return this.gcTime < when.gcTime; }
  public boolean after(GregorianCalendar when) { return this.gcTime > when.gcTime; }
  public int compareTo(GregorianCalendar anotherCalendar) {
    if (this.gcTime < anotherCalendar.gcTime) { return 0 - 1; }
    if (this.gcTime > anotherCalendar.gcTime) { return 1; }
    return 0;
  }
  public boolean equals(java.lang.Object obj) {
    if (obj == null) { return false; }
    GregorianCalendar other = (GregorianCalendar) obj;
    return this.gcTime == other.gcTime;
