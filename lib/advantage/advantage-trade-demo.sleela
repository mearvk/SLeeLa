<< lib/advantage/advantage-trade-demo.sleela
   SLeeLa Standard Library Definition.
   Definition: Runnable demonstration + validation of the bilateral trade math
   (SLAdvantageTrade): joint profit maximization, Nash bargaining, and the
   bilateral newsvendor critical ratio. >>
#sleela 2.5
material;
< `run` auto-links the sibling SLAdvantageTrade in this directory, so no >
< imports are needed. Curves used throughout: >
<   R_B(Q) = 100*Q - Q^2    (buyer revenue / utility) >
<   C_S(Q) =  20*Q + Q^2    (seller cost) >
< Hand-computed anchors: Q* = 20, Pi_total(Q*) = 800, Nash price (alpha=0.5, >
< zero reservations) = 60 splitting 400/400, critical ratio(100,20,5) ~ 0.8421. >
class AdvantageTradeDemo {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs. A worker-class
     demo carries the baseline identity record. >>
  String metaVersion = "1.0.0";
  int metaId = 10520;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-08";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-08";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 8;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }

  < True if |a-b| < tol. >
  boolean near(double a, double b, double tol) {
    double d = a - b;
    if (d < 0.0) { d = 0.0 - d; }
    return d < tol;
  }

  void main() {
    SLAdvantageTrade t = new SLAdvantageTrade();
    t.configureCurves(100.0, 1.0, 20.0, 1.0);

    print("== 1. Joint Profit Maximization (integrated surplus) ==");
    double qstar = t.optimalQuantity();
    double piMax = t.maxJointProfit();
    print("  Q* (MR = MC)         = " + qstar);
    print("  Pi_total(Q*)         = " + piMax);
    print("  MR(Q*)               = " + t.marginalRevenue(qstar));
    print("  MC(Q*)               = " + t.marginalCost(qstar));

    print("");
    print("== 2. Nash Bargaining split (alpha = 0.5, zero reservations) ==");
    double s0 = 0.0;
    double b0 = 0.0;
    double alpha = 0.5;
    double pstar = t.nashPrice(s0, b0, alpha);
    double sProf = t.sellerProfit(pstar, qstar);
    double bProf = t.buyerProfit(pstar, qstar);
    double surplus = t.bargainableSurplus(s0, b0);
    print("  bargainable surplus  = " + surplus);
    print("  Nash price P*        = " + pstar);
    print("  seller profit        = " + sProf);
    print("  buyer profit         = " + bProf);
    print("  Nash objective@P*    = " + t.nashObjective(pstar, qstar, s0, b0, alpha));

    print("");
    print("== 2b. Bargaining power shifts the split (alpha = 0.75 to seller) ==");
    double pPow = t.nashPrice(s0, b0, 0.75);
    print("  P*(alpha=0.75)       = " + pPow);
    print("  seller profit        = " + t.sellerProfit(pPow, qstar));
    print("  buyer profit         = " + t.buyerProfit(pPow, qstar));

    print("");
    print("== 3. Bilateral Newsvendor critical ratio ==");
    double r = 100.0;
    double cs = 20.0;
    double vb = 5.0;
    double vs = 2.0;
    double wholesale = 60.0;
    print("  overage(seller)      = " + t.overageSeller(cs, vs));
    print("  underage(seller)     = " + t.underageSeller(wholesale, cs));
    print("  overage(buyer)       = " + t.overageBuyer(wholesale, vb));
    print("  underage(buyer)      = " + t.underageBuyer(r, wholesale));
    double cr = t.criticalRatio(r, cs, vb);
    print("  centralized F(Q*)    = " + cr);
    double gap = t.coordinationGap(r, cs, wholesale, vb);
    print("  coordination gap     = " + gap);

    print("");
    print("== validation ==");
    boolean okQ   = near(qstar, 20.0, 0.00001);
    boolean okPi  = near(piMax, 800.0, 0.00001);
    boolean okP   = near(pstar, 60.0, 0.00001);
    boolean okSB  = near(sProf, 400.0, 0.00001);
    boolean okBB  = near(bProf, 400.0, 0.00001);
    < alpha=0.75 gives seller 600, buyer 200. >
    boolean okPow = near(t.sellerProfit(pPow, qstar), 600.0, 0.00001);
    < critical ratio = 80 / 95 = 0.842105... >
    boolean okCR  = near(cr, 0.8421052631578947, 0.0001);
    < powAB sanity: 2^10 = 1024, and 9^0.5 = 3. >
    boolean okPowFn = near(t.powAB(2.0, 10.0), 1024.0, 0.01);
    boolean okSqrt  = near(t.powAB(9.0, 0.5), 3.0, 0.0001);
    print("  Q* == 20             ? " + okQ);
    print("  Pi_total == 800      ? " + okPi);
    print("  Nash P* == 60        ? " + okP);
    print("  seller == 400        ? " + okSB);
    print("  buyer == 400         ? " + okBB);
    print("  alpha .75 seller=600 ? " + okPow);
    print("  critical ratio ~.842 ? " + okCR);
    print("  powAB 2^10 == 1024   ? " + okPowFn);
    print("  powAB 9^.5 == 3      ? " + okSqrt);
    if (okQ) {
      if (okPi) {
        if (okP) {
          if (okSB) {
            if (okBB) {
              if (okPow) {
                if (okCR) {
                  if (okPowFn) {
                    if (okSqrt) {
                      print("ALL CHECKS PASSED");
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
